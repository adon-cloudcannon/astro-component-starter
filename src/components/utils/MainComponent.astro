---
import Components from "@component-utils/renderBlock.astro";

/* Defaulted, never bare. The editor re-renders this component on its own with
   nothing but its data, so a prop the shell passes in the template is gone by
   then: left undefined, `data-prop` came off the array entirely and the whole
   page was replaced by "Array editable regions require a 'data-prop' HTML
   attribute but none was provided". The site's key is the default because it
   is the one an editor is ever looking at; the docs shell passes its own and
   falls back to this if it is ever re-rendered alone, which is a wrong path
   rather than a blank page. */
const { sections, sectionsProp = "pageSections" } = Astro.props;
---

<!--
  Renders a page's block tree for both shells (`Page.astro`, `LibraryLayout`).

  `data-prop` is the shell's own frontmatter key, handed down as `sectionsProp`
  — `pageSections` on the site, `contentSections` in the docs. It used to name
  this component's own `sections` prop and lean on the wrapper's
  `data-prop-sections` to map it back, which read well and did not hold: once
  each row became a component region of its own the two were concatenated and
  a heading asked for `pageSections.sections.4.heading`, a path no file has.

  The wrapper cannot live here: the editor's re-render would nest a second
  copy of the region inside the first. Search indexing is the shell's business
  too — the site shell marks the wrapper as a Pagefind body, the docs shell
  deliberately does not.
-->
<div
  data-editable="array"
  data-prop={sectionsProp || "pageSections"}
  data-component-key="_component"
>
  <Components contentSections={sections} />
</div>
