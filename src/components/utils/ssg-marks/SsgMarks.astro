---
/**
 * The generators an agency works in, one disc each.
 *
 * The marks are drawn as masks so the disc's own ink colours them: the files
 * carry each brand's colours and the design draws them white on a dark disc.
 * One disc per generator rather than the design's single chip — nine of them
 * do not fit a third of a column on one line, and separate discs wrap without
 * the row becoming a shape of its own.
 */
import { ssgName } from "@component-utils/ssgNames.mjs";

interface Props {
  ssgs?: string[];
  class?: string;
}

const { ssgs = [], class: className } = Astro.props;

const marks: Record<string, { src: string }> = Object.fromEntries(
  Object.entries(
    import.meta.glob("../../../assets/images/marketing/ssgs/*.svg", {
      eager: true,
      query: "?url",
    })
  ).map(([file, url]) => [
    file.split("/").pop()!.replace(".svg", ""),
    { src: (url as any).default },
  ])
);

const shown = ssgs.filter((ssg) => marks[ssg]);
---

{shown.length > 0 && (
  <p class:list={["ssg-marks", className]}>
    {shown.map((ssg) => (
      <span
        class="ssg-mark"
        style={`--ssg-mark: url("${marks[ssg].src}")`}
        role="img"
        aria-label={ssgName(ssg)}
        title={ssgName(ssg)}
      />
    ))}
  </p>
)}

<style is:global>
  @layer components {
    .ssg-marks {
      display: flex;
      flex-wrap: wrap;
      gap: var(--spacing-sm);
      margin: 0;
    }

    .ssg-mark {
      aspect-ratio: 1;
      background-color: var(--midnight);
      border-radius: var(--radius-full);
      display: grid;
      inline-size: 2.1875rem;
      place-items: center;
    }

    .ssg-mark::before {
      background-color: var(--light-sand);
      block-size: 1.125rem;
      content: "";
      display: block;
      inline-size: 1.125rem;
      mask-image: var(--ssg-mark);
      mask-position: center;
      mask-repeat: no-repeat;
      mask-size: contain;
    }
  }
</style>
