---
import { componentKeyFromPath } from "@component-utils/componentKey.mjs";
import type { ContentBlock } from "../../types";

export interface Props {
  contentSections: ContentBlock[];
  useDefaultEditableBinding?: boolean;
}

type AstroComponent = (_props: Record<string, unknown>) => unknown;

type ComponentLoader = () => Promise<Record<string, AstroComponent>>;

const loaders: Record<string, ComponentLoader> = {};
// `utils/` holds composition helpers, not placeable components — without the
// exclusion they show up as registry keys (`utils/avatar`, …) in the
// "Available components" warning and read as authorable.
const componentImports = import.meta.glob(["../**/*.{jsx,astro}", "!../utils/**"]);

Object.entries(componentImports).forEach(([path, loader]) => {
  const componentName = componentKeyFromPath(path.replace("../", ""));

  loaders[componentName] = loader as ComponentLoader;
});

const { contentSections, useDefaultEditableBinding = true } = Astro.props;

const resolved = await Promise.all(
  (contentSections ?? []).map(async (block) => {
    const loader = block._component ? loaders[block._component] : undefined;

    if (!loader) {
      if (block._component) {
        console.warn(
          `Component not found: ${block._component}. Available components:`,
          Object.keys(loaders)
        );
      } else {
        console.warn(
          "Skipping content block with no _component key:",
          JSON.stringify(block).slice(0, 200)
        );
      }
      return { block, Component: null as AstroComponent | null };
    }

    const module = await loader();

    return { block, Component: module.default };
  })
);
---

{
  // Array-level editable attributes are owned by the caller's container element.
  //
  // `data-component` is the renderer the editor redraws a row with. An array
  // item on its own gets the CRUD controls and nothing else: the primitives
  // inside it update because each binds its own region, and everything the
  // component derives from its props stays as the page was built. Only the
  // page's own section list escaped that, because `MainComponent` puts
  // `data-component-key` on the wrapper; every nested array of blocks had no
  // such key and no renderer either.
  resolved.map(({ block, Component }) =>
    Component ? (
      <Component
        data-editable={useDefaultEditableBinding ? "array-item" : undefined}
        data-id={block._component}
        data-component={useDefaultEditableBinding ? block._component : undefined}
        {...block}
        useDefaultEditableBinding={useDefaultEditableBinding}
      />
    ) : null
  )
}
