---
import { bandPattern, bandHaze } from "@component-utils/bandStyle.mjs";
import { nestedProps } from "@component-utils/nestedProps.mjs";
import { subtextMeasure } from "@component-utils/subtextMeasure.mjs";
/**
 * A short, full-width band: a heading, a link, and a drawing in the corner.
 *
 * Neither of the CTAs already here fits it. The centred one stacks its parts
 * down the middle of the column and the split one gives the picture half the
 * band; this is a strip about a fifth as tall as either, with the copy hard
 * left and the artwork bleeding off the bottom-right corner rather than
 * sitting in a column of its own.
 *
 * Read off 3806:70514: 1281x217, the heading at 46/49.7 in white, the link
 * beneath it, and "Ferns_Rocks" hanging 7 over the top edge and 10 under the
 * bottom one.
 */
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Text from "@core-elements/text/Text.astro";
import Image from "@core-elements/image/Image.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";

/* `content` and `style` are the editor's tabs, flattened straight back into
   the names below. `at()` writes the frontmatter path a binding needs. */
const { props, at } = nestedProps(Astro.props, {
  nest: {
    heading: ["heading", "headingLevel", "headingSize"],
    link: ["linkText", "link"],
    secondaryLink: ["secondaryLinkText", "secondaryLink"],
    image: ["imageSource", "imageAlt"],
    imageStart: ["imageSourceStart", "imageAltStart"],
  },
});

const {
  heading = "",
  headingLevel = "h2",
  headingSize = "lg",
  subtext = "",
  subtextSize = "lg",
  /**
   * The measure the supporting line is set in.
   *
   * The band's own 608 is what most of the design's banners are drawn at;
   * Hosting's runs to 760, and at 608 it takes a fourth line.
   */
  subtextWidth = "",
  alignmentHorizontal = "start",
  imageSourceStart = "",
  imageAltStart = "",
  buttonSections = [],
  imageSource = "",
  imageAlt = "",
  sectionLabel,
  maxContentWidth = "xl",
  paddingHorizontal = "gutter",
  paddingVertical = "2xl",
  colorScheme = "inherit",
  lockColorScheme = true,
  backgroundColor = "pacific",
  /** Scratches through the band's colour, the way the design's banners are. */
  scratched = false,
  /** The texture behind the band, by name. */
  pattern = "none",
  /** Which edge the texture fades out towards. */
  fade = "none",
  /** Whether the heading sits on a pool of the band’s own colour. */
  haze = false,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = props;

const subtextCap = subtextMeasure(subtextWidth);
---

<CustomSection
  class:list={["cta-banner", `align-${alignmentHorizontal}`, className]}
  scratched={scratched}
  sectionLabel={sectionLabel}
  maxContentWidth={maxContentWidth}
  paddingHorizontal={paddingHorizontal}
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  lockColorScheme={lockColorScheme}
  backgroundColor={backgroundColor}
  background={bandPattern(pattern, fade)}
  haze={bandHaze(haze)}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  <Heading
    level={headingLevel}
    size={headingSize}
    alignmentHorizontal={alignmentHorizontal}
    data-prop={at("heading")}
    text={heading}
  />
  {subtext && (
    <Text
      class="cta-banner-subtext"
      alignmentHorizontal={alignmentHorizontal}
      style={subtextCap ? `max-inline-size: ${subtextCap}` : undefined}
      size={subtextSize}
      data-prop={at("subtext")}
      text={subtext}
    />
  )}
  <ButtonGroup
    class="cta-banner-actions"
    buttonSections={buttonSections}
    alignmentHorizontal={alignmentHorizontal}
    data-children-prop={at("buttonSections")}
  />
  {imageSourceStart && (
    <Image
      class="cta-banner-art cta-banner-art-start"
      source={imageSourceStart}
      alt={imageAltStart}
      data-prop-src={at("imageSourceStart")}
      data-prop-alt={at("imageAltStart")}
    />
  )}
  {imageSource && (
    <Image
      class="cta-banner-art cta-banner-art-end"
      source={imageSource}
      alt={imageAlt}
      data-prop-src={at("imageSource")}
      data-prop-alt={at("imageAlt")}
    />
  )}
</CustomSection>

<style is:global>
  /* Flat, because rules nested deeper than a couple of levels get dropped (see
     CLAUDE.md). */
  @layer page-sections {
    /* Centred, the band is the pricing page's migration strip: the copy runs
       down the middle and the art sits in both bottom corners rather than one.
       `align-start` is the shape Low Maintenance and Templates already draw,
       so it is left exactly as it was. */
    .cta-banner.align-center .content {
      align-items: center;
      text-align: center;
    }

    /* Mirrors the end art's reach below: `0` is the content column's edge,
       which left the drawing a gutter short of the band's corner while its
       opposite number sat flush. */
    .cta-banner .cta-banner-art-start {
      inset-inline-start: calc(50% - 50vw);
      inset-inline-end: auto;
    }

    /* The pill is light whatever the band is, so its label is dark whatever
       the band is. A scratched band locks a dark scheme, which flips the
       surface token and drew a dark pill with a light label. The variant
       class sits on `.button-inner`, not on `.button`. */
    .cta-banner .button-inner.variant-secondary,
    .cta-banner .button-inner.variant-secondary:hover,
    .cta-banner .button-inner.variant-secondary:focus-visible {
      background-color: var(--light-sand);
      border-color: transparent;
      color: var(--midnight);
    }

    .cta-banner.align-center .cta-banner-subtext {
      margin-inline: auto;
      max-inline-size: 38rem;
    }

    /* The band clips, which is how the design draws it: the frame is set to
       clip its contents and the drawing is 227 tall inside 217, so it is cut
       off at the foot rather than hanging past it. Left to overhang it read as
       a sticker sitting on the band instead of something behind its edge. */
    .cta-banner {
      overflow: hidden;
      position: relative;
    }

    .cta-banner .heading,
    .cta-banner .cta-banner-actions {
      position: relative;
      z-index: var(--layer-1);
    }

    .cta-banner .cta-banner-actions {
      --space-before: var(--space-before-loose);
    }

    .cta-banner .cta-banner-actions > .button-group__items {
      gap: var(--spacing-lg);
    }

    /* The copy sits tight over a lone text link, in a band 217 tall. A pill,
       or a pill beside a link, stands off it by the design's 48. */
    .cta-banner .cta-banner-actions:has(.button:only-child > .variant-text) {
      --space-before: var(--spacing-md);
    }

    /* Only the text link runs to the column's edge. Unscoped this flattened
       the pill variant too: the label filled the button edge to edge with no
       room either side, which read as the button being unable to stretch. */
    .cta-banner .cta-banner-actions .button-inner.variant-text {
      padding-inline: 0;
    }

    /* The link keeps its colour under the pointer and takes a rule instead.

       `variant-text` hovers to the brand colour, which is right for a link on
       a cream page and exactly wrong on the brand itself: this one sits on
       the Pacific band, so hovering took a cream label to a muted blue and
       sank it into the ground behind it. It read as the link fading out
       rather than lighting up, and the ease-out made it look like it was
       still going long after it had stopped.

       Pinned rather than pointed somewhere else, because there is nowhere
       brighter to go from cream. The underline is what answers the pointer. */
    .cta-banner .cta-banner-actions .button:hover .button-inner,
    .cta-banner .cta-banner-actions .button:focus-visible .button-inner {
      color: inherit;
    }

    /* The arrow brightens to meet it, so the whole link answers rather than
       half of it. */
    .cta-banner .cta-banner-actions .button:hover .icon,
    .cta-banner .cta-banner-actions .button:focus-visible .icon {
      color: inherit;
    }

    /* Only the words are ruled. Ruled across the whole link the line runs
       under the arrow as well, which reads as struck out. */
    .cta-banner .cta-banner-actions .button:hover .label-text,
    .cta-banner .cta-banner-actions .button:focus-visible .label-text {
      text-decoration: underline;
      text-underline-offset: 0.35em;
    }

    /* Bottom-right, hanging over the foot of the band by about 10. The design
       draws it 263 wide against 1281, so it is a corner flourish rather than a
       column: it takes its own size and is pinned, not laid out. */
    .cta-banner .cta-banner-art {
      --space-before: 0;
      /* The design puts the drawing 3 below the band's foot and 7 above its
         head, both cut off by the band. Flush would leave its base sitting on
         the edge like a line. */
      inset-block-end: -3px;
      /* Out to the edge of the window. CustomSection positions `.content` for
         its own background layer, so that is the containing block whatever
         this component does, and `inset-inline-end: 0` left the drawing a
         gutter short of the band's corner. This reaches past the column by
         exactly the gutter, whatever the gutter happens to be. */
      inset-inline-end: calc(50% - 50vw);
      margin: 0;
      position: absolute;
      z-index: 0;
    }

    .cta-banner .cta-banner-art img {
      block-size: auto;
      inline-size: auto;
      max-block-size: 14.1875rem;
      max-inline-size: 100%;
    }
  }

  /* Narrow: the drawing would sit under the copy, so it goes. */
  @layer page-sections {
    @media (width < 48rem) {
      .cta-banner .cta-banner-art {
        display: none;
      }
    }
  }
</style>
