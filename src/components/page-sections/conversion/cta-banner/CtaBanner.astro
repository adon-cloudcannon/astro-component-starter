---
/**
 * A short, full-width band: a heading, a link, and a drawing in the corner.
 *
 * Neither of the CTAs already here fits it. The centred one stacks its parts
 * down the middle of the column and the split one gives the picture half the
 * band; this is a strip about a fifth as tall as either, with the copy hard
 * left and the artwork bleeding off the bottom-right corner rather than
 * sitting in a column of its own.
 *
 * Read off 3806:70514: 1281x217, the heading at 46/49.7 in white, the link
 * beneath it, and "Ferns_Rocks" hanging 7 over the top edge and 10 under the
 * bottom one.
 */
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Image from "@core-elements/image/Image.astro";
import Button from "@core-elements/button/Button.astro";

const {
  heading = "",
  headingLevel = "h2",
  headingSize = "lg",
  linkText = "",
  link = "",
  imageSource = "",
  imageAlt = "",
  sectionLabel,
  maxContentWidth = "xl",
  paddingHorizontal = "gutter",
  paddingVertical = "2xl",
  colorScheme = "inherit",
  lockColorScheme = true,
  backgroundColor = "brand",
  /**
   * Draws the band's scratched sheet in this colour instead of loading one.
   *
   * The export was a flat #004AD7 with the whole texture in its alpha, which
   * is Pacific. It also had to be backed with the page's cream, because the
   * scratches were holes: painted, that whole dance goes away.
   */
  scratch = "",
  background,
  haze = false,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;
---

<CustomSection
  class:list={[
    "cta-banner",
    background?.type === "image" && "has-sheet",
    { scratched: scratch },
    className,
  ]}
  style={scratch
    ? `--scratch-fill: ${scratch.startsWith("#") ? scratch : `var(--${scratch})`}`
    : undefined}
  label={sectionLabel}
  maxContentWidth={maxContentWidth}
  paddingHorizontal={paddingHorizontal}
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  lockColorScheme={lockColorScheme}
  backgroundColor={scratch ? "none" : backgroundColor}
  background={background}
  haze={haze}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  <Heading
    level={headingLevel}
    size={headingSize}
    alignmentHorizontal="start"
    data-prop="heading"
    text={heading}
  />
  {linkText && (
    <Button
      class="cta-banner-link"
      variant="text"
      iconName="arrow-right"
      iconPosition="after"
      text={linkText}
      link={link}
      data-prop="linkText"
    />
  )}
  {imageSource && (
    <Image
      class="cta-banner-art"
      source={imageSource}
      alt={imageAlt}
      data-prop-src="imageSource"
      data-prop-alt="imageAlt"
    />
  )}
</CustomSection>

<style is:global>
  /* Flat, because rules nested deeper than a couple of levels get dropped (see
     CLAUDE.md). */
  @layer page-sections {
    /* The band clips, which is how the design draws it: the frame is set to
       clip its contents and the drawing is 227 tall inside 217, so it is cut
       off at the foot rather than hanging past it. Left to overhang it read as
       a sticker sitting on the band instead of something behind its edge. */
    .cta-banner {
      overflow: hidden;
      position: relative;
    }

    /* The band's fill is a sheet of brand blue with the scratches punched
       clean through it, so whatever sits behind becomes the scratches. Backed
       with the band's own blue they disappear; backed with the dark base they
       come out black, which is what `backgroundColor: base` gives here because
       the scheme is locked dark and `base` resolves with it. It wants the
       page's own light ground, the way the design has the sheet sitting on the
       cream page.

       Two rules, because the colour layer is drawn AFTER the picture and so
       paints over it — any background image under a background colour is
       hidden. The sheet has to come back up on top of its own backing. */
    .cta-banner.has-sheet .background {
      background-color: var(--cta-banner-backing, #fffcf3);
    }

    .cta-banner.has-sheet .background-image {
      position: absolute;
      z-index: 1;
    }

    /* The drawing pins to the band, not to the column, so `.content` stays
       static: positioned, it became the containing block and the art sat a
       gutter's width in from the edge. The copy is lifted instead. */
    .cta-banner .heading,
    .cta-banner .cta-banner-link {
      position: relative;
      z-index: var(--layer-1);
    }

    /* The copy sits tight: 46 over a link, in a band 217 tall. */
    .cta-banner .cta-banner-link {
      --space-before: var(--spacing-md);
    }

    .cta-banner .cta-banner-link .button-inner {
      padding-inline: 0;
    }

    /* Bottom-right, hanging over the foot of the band by about 10. The design
       draws it 263 wide against 1281, so it is a corner flourish rather than a
       column: it takes its own size and is pinned, not laid out. */
    .cta-banner .cta-banner-art {
      --space-before: 0;
      /* The design puts the drawing 3 below the band's foot and 7 above its
         head, both cut off by the band. Flush would leave its base sitting on
         the edge like a line. */
      inset-block-end: -3px;
      /* Out to the edge of the window. CustomSection positions `.content` for
         its own background layer, so that is the containing block whatever
         this component does, and `inset-inline-end: 0` left the drawing a
         gutter short of the band's corner. This reaches past the column by
         exactly the gutter, whatever the gutter happens to be. */
      inset-inline-end: calc(50% - 50vw);
      margin: 0;
      position: absolute;
      z-index: 0;
    }

    .cta-banner .cta-banner-art img {
      block-size: auto;
      inline-size: auto;
      max-block-size: 14.1875rem;
      max-inline-size: 100%;
    }
  }

  /* Narrow: the drawing would sit under the copy, so it goes. */
  @layer page-sections {
    @media (width < 48rem) {
      .cta-banner .cta-banner-art {
        display: none;
      }
    }
  }
</style>
