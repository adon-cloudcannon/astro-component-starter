---
import { bandPattern, bandHaze } from "@component-utils/bandStyle.mjs";
import { nestedProps } from "@component-utils/nestedProps.mjs";
import { rootMirror } from "@component-utils/rootMirror.mjs";
import CustomSection from "@builders/custom-section/CustomSection.astro";
import { subtextMeasure } from "@component-utils/subtextMeasure.mjs";
import Heading from "@core-elements/heading/Heading.astro";
import AgentTerminal from "@wrappers/agent-terminal/AgentTerminal.astro";
import PolaroidCamera from "@wrappers/polaroid-camera/PolaroidCamera.astro";
import CharacterChat from "@wrappers/character-chat/CharacterChat.astro";
import Image from "@core-elements/image/Image.astro";
import Text from "@core-elements/text/Text.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";
import Split from "@wrappers/split/Split.astro";

/* `content` and `style` are the editor's tabs, flattened straight back into
   the names below. `at()` writes the frontmatter path a binding needs. */
const { props, at } = nestedProps(Astro.props);

const {
  heading = "",
  headingLevel = "h2",
  headingSize = "xl",
  subtext = "",
  // Body 3 at 19 or Subtitle 1 at 22 in the design; `md` keeps the 16 every
  // section rendered before either was carried through.
  subtextSize = "md",
  /**
   * The measure the design sets the supporting line in, in pixels.
   *
   * Not the column it sits in: a centred subtext is drawn at about 580 in the
   * 1040 column, and run the full width it reads as a different block.
   */
  subtextWidth,
  buttonSections = [],
  imageSource = "",
  /**
   * A terminal session in place of the picture.
   *
   * An object rather than a handful of flat props, because it is one thing:
   * `{ path, script, loop }`. Present and carrying a script, it takes the
   * media side; absent, nothing about this section changes.
   */
  terminal,
  /**
   * Turns the picture into a camera you can take a picture with.
   *
   * `{ shots: [{ source, alt }], label }`. Present, the media side becomes the
   * camera and its pile; absent, nothing about this section changes.
   */
  camera,
  /**
   * Two characters in conversation in place of the picture.
   *
   * `{ characters: [{ source, alt, width }], gap, ratio }`. The design draws
   * the Enterprise card's pair as one bitmap with the speech bubble baked into
   * it; placed separately they hold their proportions whatever shape the card
   * takes. Absent, nothing about this section changes.
   */
  characters,
  /**
   * A second picture of the same subject, crossfaded in when the section is
   * scrolled to. The two have to be the same size with their artwork on the
   * same pixels, or the swap reads as a jump rather than as one thing
   * changing: the truck's two hoods are one 1600x746 upload each, and both
   * draw the body between x 7 and 1591.
   */
  imageReveal = "",
  /** What a reader who cannot see the swap is told the control does. */
  imageRevealLabel = "Show the other view of this picture",
  imageAlt = "",
  reverse = false,
  /**
   * A card behind the picture.
   *
   * The design draws the person as a cut-out on a textured panel: two images,
   * not one. Taken as a single picture the generator picked the panel and blew
   * it up to fill the column, which is a large yellow rectangle and no person.
   */
  imageBackdrop = "",
  imageBackdropAlt = "",
  /**
   * How far past the content column the drawing runs.
   *
   * The design draws the truck 915 wide starting at 580, so it leaves the
   * 1040 column by 335 and the frame cuts it off at its own edge. Boxed into
   * the column it reads as a small picture with air around it. Measured per
   * section, like the heroes: `imageBleed` remains the all-the-way case.
   */
  imageBleed = false,
  imageOverflow = 0,
  /**
   * Draws the split on a card instead of straight on the band.
   *
   * The design's closing CTA on High Performance is a 1040x445 white panel,
   * 18px corners and a 1px sand rule, floating on a dotted band: the pattern
   * runs the full width and the copy and the drawing both sit inside the
   * panel. Without it the section reads as a CTA printed on the dots.
   *
   * It carries the column split with it. The design draws the two halves of
   * the panel at 512 and 471, where the band-level split fixes one column at
   * 400 for the trucks, so a card would put the drawing in a column a
   * quarter too narrow.
   */
  contentCard = false,
  /**
   * The card's own colour, as a palette name.
   *
   * White on the two patterned bands, which state #FFFFFF outright. Partner
   * Program's Enterprise card is #FFFCF3 on a Sand band instead, which is the
   * usual rule: a card is a shade off its band, and here the band is the
   * darker of the two sands.
   */
  contentCardColor = "white",
  /**
   * Sits the drawing on the card's bottom edge instead of inside its padding.
   *
   * The design draws the Enterprise card's creatures from y=19 to y=269 in a
   * card 268 tall, so they run to the foot and the card cuts them off. Boxed
   * into the padding they float with a gap under them.
   */
  imageFlush = false,
  sectionLabel,
  maxContentWidth = "xl",
  paddingHorizontal = "gutter",
  paddingVertical = "4xl",
  colorScheme = "inherit",
  lockColorScheme = false,
  // Was hardcoded to landscape, which crops anything that is not 4:3. The
  // design places these at their own proportions: the truck is 915x427, so a
  // 4:3 frame cuts a third of it away.
  imageAspectRatio = "none",
  backgroundColor = "light-sand",
  /** The texture behind the band, by name. */
  pattern = "none",
  /** Whether the heading sits on a pool of the band’s own colour. */
  haze = false,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = props;

/* The measure the subtext is set in, as a length. */
const subtextCap = subtextMeasure(subtextWidth);

/* Astro takes a component expression here, so the wrapper can be a real
   element or nothing at all. Rendering the div either way and styling it only
   when it is a card would put a flow child between the section and the split,
   which every cta-split already laid out without. */
const Wrapper = contentCard ? "div" : Fragment;
const wrapperProps = contentCard
  ? {
      class: imageFlush ? "cta-split-card image-flush" : "cta-split-card",
      style: `--cta-split-card-bg: var(--${contentCardColor === "base" ? "color-bg" : contentCardColor})`,
    }
  : {};

const overflow = Number(imageOverflow) || 0;
const bleedSide =
  imageBleed || overflow > 0 ? (reverse ? "inline-start" : "inline-end") : undefined;
const bleedLimit = !imageBleed && overflow > 0 ? `${overflow}px` : undefined;

/* Mirrored onto the builder's `.content`, because the flag lands on the
   section's root and the editor never rewrites a region root. */
const mirror = rootMirror({ "data-picture-first": reverse ? "" : null });
---

<CustomSection
  mirror={mirror}
  class:list={["cta-split", className]}
  data-picture-first={reverse ? "" : undefined}
  label={sectionLabel}
  maxContentWidth={maxContentWidth}
  paddingHorizontal={paddingHorizontal}
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  lockColorScheme={lockColorScheme}
  backgroundColor={backgroundColor}
  background={bandPattern(pattern)}
  haze={bandHaze(haze, { reverse, split: true })}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  {/* Split flips the distribution when it reverses, so the fixed column stays
      on the same side of the page while the content swaps across it. That is
      right when the fixed column is the copy, and wrong here: reversed, the
      picture went into the flexible column and the copy into the fixed 400,
      which pushed the heading 119 further right than the design draws it.
      Asking for the opposite mode lands it back on fixed-flexible, so the
      fixed width travels with the picture. */}
  <Wrapper {...wrapperProps}>
  <Split
    distributionMode={contentCard ? "half" : reverse ? "flexible-fixed" : "fixed-flexible"}
    fixedWidth={contentCard ? undefined : "400"}
    data-bleed={bleedSide}
    style={bleedLimit ? { "--split-bleed-limit": bleedLimit } : undefined}
    alignmentVertical="center"
    reverse={reverse}
    minSplitWidth={640}
  >
    <Fragment slot="first">
      <Heading
        level={headingLevel}
        size={headingSize}
        data-prop={at("heading")}
      >
        {heading}
      </Heading>
      <Text
        style={subtextCap ? `max-inline-size: ${subtextCap}; margin-inline: auto; justify-self: center` : undefined}        size={subtextSize}
        data-prop={at("subtext")}
        text={subtext}
      />
      <ButtonGroup
        buttonSections={buttonSections}
        direction="row"
        alignmentHorizontal="start"
        data-children-prop={at("buttonSections")}
      />
    </Fragment>
    <Fragment slot="second">
      {characters?.characters?.length ? (
        <CharacterChat
          class="cta-split-media cta-split-characters"
          characters={characters.characters}
          conversation={characters.conversation}
          conversationLabel={characters.conversationLabel}
          seed={characters.seed}
          threadHeight={characters.threadHeight}
          insetStart={characters.insetStart}
          insetEnd={characters.insetEnd}
          castInsetStart={characters.castInsetStart}
          castInsetEnd={characters.castInsetEnd}
          scale={characters.scale}
        />
      ) : camera?.shots?.length ? (
        <PolaroidCamera
          alt={imageAlt}
          class="cta-split-camera"
          fit={camera.fit}
          label={camera.label}
          shots={camera.shots}
          source={imageSource}
        />
      ) : terminal?.script?.length ? (
        <AgentTerminal
          class="cta-split-terminal"
          loop={terminal.loop !== false}
          path={terminal.path}
          script={terminal.script}
        />
      ) : imageBackdrop ? (
        <div class="cta-split-portrait">
          <Image
            class="cta-split-backdrop"
            source={imageBackdrop}
            alt={imageBackdropAlt}
            rounded={true}
            aspectRatio="square"
            data-prop-src={at("imageBackdrop")}
            data-prop-alt={at("imageBackdropAlt")}
          />
          <Image
            class="cta-split-subject"
            source={imageSource}
            alt={imageAlt}
            data-prop-src={at("imageSource")}
            data-prop-alt={at("imageAlt")}
          />
        </div>
      ) : imageReveal ? (
        <button
          type="button"
          class="cta-split-reveal"
          aria-pressed="false"
          aria-label={imageRevealLabel}
        >
          {/* A button rather than a div with a handler: it is a real toggle, so
              it has to be reachable by keyboard and announce its state.
              `aria-pressed` carries that state and the CSS reads the same
              attribute, so there is one source of truth rather than a data
              attribute sitting beside it.

              The comment lives in here rather than above the element: a JSX
              expression takes one root, and a comment before it is a second
              one — "Expected `,` or `)` but found `type`". */}
          <Image
            source={imageSource}
            rounded={true}
            alt={imageAlt}
            aspectRatio={imageAspectRatio}
            data-prop-src={at("imageSource")}
            data-prop-alt={at("imageAlt")}
          />
          {/* Decorative on purpose: it is the same subject as the one above,
              so a reader who cannot see the change should be told once. */}
          <Image
            class="cta-split-reveal-top"
            source={imageReveal}
            rounded={true}
            decorative={true}
            aspectRatio={imageAspectRatio}
            data-prop-src={at("imageReveal")}
          />
        </button>
      ) : (
        <Image
          class="cta-split-media"
          source={imageSource}
          rounded={true}
          alt={imageAlt}
          aspectRatio={imageAspectRatio}
          data-prop-src={at("imageSource")}
          data-prop-alt={at("imageAlt")}
        />
      )}
    </Fragment>
  </Split>
  </Wrapper>
</CustomSection>

<script>
  import { onPageLoad } from "@component-utils/onPageLoad";
  import { setupAllCtaSplitReveals } from "./setup";

  onPageLoad(setupAllCtaSplitReveals);
</script>

<style is:global>
  /* A cut-out on a card. The design draws the panel 366 square with the person
     filling it and sitting on its bottom edge, so the subject is placed rather
     than laid out: stacked in flow it pushed the panel to twice the height.

     Flat, because rules nested deeper than a couple of levels get dropped (see
     CLAUDE.md). */
  @layer page-sections {
    /* The panel the design floats on the dotted band. White rather than the
       page's light sand: the design states #FFFFFF, which on a sand band is a
       step up rather than the usual step down. */
    .cta-split .cta-split-card {
      background-color: var(--cta-split-card-bg, var(--white));
      border: 1px solid var(--color-border-subtle);
      border-radius: var(--radius-card);
      /* So a drawing on the foot is cut by the card's own corners rather than
         hanging past them. */
      overflow: hidden;
      padding: var(--spacing-2xl) 69px;
    }

    /* Except where the card holds a camera: its prints are meant to spill
       past the edges, and the clip above is there for a drawing standing on
       the foot, which this card does not have. */
    .cta-split .cta-split-card:has(.polaroid-camera) {
      overflow: visible;
    }

    /* The drawing stands on the card's bottom edge.
    
       Two rules, because the grid item is the pane and not the picture: an
       `align-self` on the image did nothing, since the pane is an ordinary
       block, and the picture hung 24px short off the centred pane's foot
       rather than the card's. The pane goes to the end of the row and the
       picture then sinks through the card's own bottom padding. The copy
       beside it is untouched. */
    .cta-split .cta-split-card.image-flush .split-inner > .pane:has(.cta-split-media) {
      align-self: end;
    }

    .cta-split .cta-split-card.image-flush .cta-split-media {
      margin-block-end: calc(-1 * var(--spacing-2xl));
    }

    /* flow's space-before is what sets the gap from the section above, and on
       a card it would print inside the rule instead. */
    .cta-split .cta-split-card > .split {
      --space-before: 0;
      margin-block: 0;
    }

    /* Two pictures of one subject in a single box. They are the same size with
       their artwork on the same pixels, so nothing moves across the change:
       only the hood opens. Stacked in one grid cell rather than positioned, so
       the box still takes its height from the picture. */
    .cta-split .cta-split-reveal {
      appearance: none;
      background: none;
      border: 0;
      color: inherit;
      cursor: pointer;
      display: grid;
      font: inherit;
      /* A button shrinks to its content where the div it replaced filled the
         column, which left the picture at its own width and off to one side. */
      inline-size: 100%;
      padding: 0;
      text-align: inherit;
    }

    .cta-split .cta-split-reveal:focus-visible {
      outline: var(--focus-ring-width) var(--focus-ring-style) var(--color-focus-ring);
      outline-offset: var(--spacing-xs);
    }

    /* flow puts a space-before on every child after the first, which here is
       the whole point of the stack undone: the second picture would sit a
       margin below the first instead of on top of it. */
    .cta-split .cta-split-reveal > * {
      --space-before: 0;
      grid-area: 1 / 1;
      margin-block: 0;
    }

    /* A cut, not a fade. These are flat line illustrations, so a dissolve
       shows both bonnet outlines at once for the length of it and reads as a
       double exposure rather than as a hood opening. The two frames are
       pixel-aligned, so a straight swap reads as the thing popping open.

       Nothing to soften for reduced motion either: a cut is not motion. */
    .cta-split .cta-split-reveal > .cta-split-reveal-top {
      opacity: 0;
    }

    .cta-split .cta-split-reveal[aria-pressed="true"] > .cta-split-reveal-top {
      opacity: 1;
    }

    .cta-split .cta-split-portrait {
      max-inline-size: 22.875rem;
      position: relative;
    }

    .cta-split .cta-split-subject {
      --space-before: 0;
      inset-block-end: 0;
      inset-inline: 0;
      margin: 0;
      position: absolute;
    }

    .cta-split .cta-split-subject img {
      block-size: auto;
      inline-size: 100%;
      object-fit: contain;
    }

    .cta-split .cta-split-backdrop img {
      block-size: 100%;
      inline-size: 100%;
      object-fit: cover;
    }
  }
</style>

<style is:global>
  /* The design puts 121 between the picture column and the copy: the portrait
     sits at 122 in a 400 column and the heading starts at 641. The spacing
     utilities stop at 64, so this is set directly rather than rounded down to
     half what the design draws.

     Flat, because rules nested deeper than a couple of levels get dropped (see
     CLAUDE.md). */
  @layer overrides {
    .cta-split[data-picture-first] .split-inner {
      column-gap: 7.5625rem;
    }
  }
</style>
