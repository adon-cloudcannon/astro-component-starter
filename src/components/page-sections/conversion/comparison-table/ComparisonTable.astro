---
import { bandPattern, bandHaze } from "@component-utils/bandStyle.mjs";
import { nestedProps } from "@component-utils/nestedProps.mjs";
import BillingSwitch from "@page-sections/conversion/pricing-tiers/BillingSwitch.astro";
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Button from "@core-elements/button/Button.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Icon from "@core-elements/icon/Icon.astro";
import Text from "@core-elements/text/Text.astro";
import { isNonEmptyString } from "@component-utils/isNonEmptyString";

type Plan = {
  name?: string;
  price?: string;
  annualPrice?: string;
  highlight?: boolean;
  buttonText?: string;
  buttonLink?: string;
};
type Row = { feature?: string; values?: (string | null)[] };

/* `content` and `style` are the editor's tabs, flattened straight back into
   the names below. `at()` writes the frontmatter path a binding needs. */
const { props, at } = nestedProps(Astro.props, {
  nest: { heading: ["eyebrow", "heading", "headingLevel", "headingSize"] },
});

const {
  eyebrow = "",
  heading = "",
  headingLevel = "h2",
  headingSize = "lg",
  subtext = "",
  plans = [],
  rows = [],
  /**
   * A line of small print in the table's corner, under whatever heading is
   * there.
   *
   * The comparison of CloudCannon against other tools puts its "accurate as
   * of" note here rather than under the table, and has no heading at all —
   * the corner is a slot, not a heading's seat.
   */
  footnote = "",
  /**
   * Where each column's action sits.
   *
   * The plan comparison puts its trial buttons in the header, under the
   * price. The comparison against other tools hangs a "Deep dive" link off
   * the foot of each column instead, after the last row.
   */
  buttonPosition = "header",
  /**
   * How the line under each column's name is set.
   *
   * `strong` is a price — 14.5 bold in the strong ink, which is what the
   * plan comparison draws. `muted` is a description, 13 regular in the body
   * colour, which is what the comparison against other tools draws. Same
   * field either way; what differs is whether it is a figure or a sentence.
   */
  columnLine = "strong",
  /**
   * How a highlighted column is marked.
   *
   * `action` is the plan comparison's: the primary CTA in its header marks
   * it and nothing else does. `tint` fills the column, which is what the
   * comparison against other tools draws for CloudCannon's.
   */
  highlightStyle = "action",
  striped = true,
  /**
   * Draws a second monthly/yearly control over the table.
   *
   * It is a label for the switch the plan cards own, not one of its own, so
   * the two stay in step and a reader deep in the table does not have to
   * scroll back up. On a page with no plan cards there is nothing to point
   * at, so leave it off.
   */
  showAnnualPricing = false,
  monthlyLabel = "Monthly",
  annualLabel = "Yearly",
  sectionLabel,
  maxContentWidth = "xl",
  paddingHorizontal = "gutter",
  paddingVertical = "4xl",
  colorScheme = "inherit",
  lockColorScheme = false,
  backgroundColor = "light-sand",
  /** The texture behind the band, by name. */
  pattern = "none",
  /** Which edge the texture fades out towards. */
  fade = "none",
  /** Whether the heading sits on a pool of the band’s own colour. */
  haze = false,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = props;

// Not filtered: a row's `values` are positional, so dropping an unnamed plan
// would shift every later column's cells onto the wrong plan.
const planList = (plans ?? []) as Plan[];

// One cell per plan on every row, so a short row renders empty cells instead
// of shifting the columns (same normalization rule as the Table block).
const cellFor = (row: Row, index: number) => {
  const raw = row?.values?.[index];

  return raw == null ? "" : String(raw).trim();
};

// "yes"/"no" are the two marks; anything else is shown as text (e.g. "5 seats",
// "Unlimited"). Case-insensitive so editors can type Yes or YES.
//
// An empty value is NOT "excluded": a row an editor has not filled in yet
// would otherwise tell customers the feature is absent. Blank renders blank;
// "no" or "-" is how you say excluded.
const markFor = (value: string) => {
  const token = value.toLowerCase();

  if (token === "yes" || token === "true" || token === "✓") return "included";
  if (token === "no" || token === "false" || token === "-") return "excluded";
  return "text";
};

const hasTable = planList.length > 0 && rows?.length > 0;

// A plan priced both ways slides between its two figures; one figure stays a
// plain cell.
const slidesPrice = (plan: Plan) =>
  showAnnualPricing && isNonEmptyString(plan.price) && isNonEmptyString(plan.annualPrice);
---

<CustomSection
  class:list={["comparison-table", `line-${columnLine}`, `highlight-${highlightStyle}`, className]}
  label={sectionLabel}
  maxContentWidth={maxContentWidth}
  paddingHorizontal={paddingHorizontal}
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  lockColorScheme={lockColorScheme}
  backgroundColor={backgroundColor}
  background={bandPattern(pattern, fade)}
  haze={bandHaze(haze)}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  <Text
    class="section-subtext comparison-table-subtext"
    alignmentHorizontal="center"
    data-prop={at("subtext")}
    text={subtext}
  />

  {hasTable && showAnnualPricing && (
    <BillingSwitch
      class="comparison-table-billing"
      monthlyLabel={monthlyLabel}
      annualLabel={annualLabel}
    />
  )}

  {hasTable && (
    <div class:list={["comparison-table-frame", striped && "striped"]}>
      <p
        class="comparison-table-hint"
        aria-hidden="true"
      >
        Scroll →
      </p>
      <div
        class="comparison-table-scroller"
        role="region"
        tabindex="0"
        aria-label={heading || "Plan comparison"}
      >
        <table>
          <thead>
            {/* The only place `plans` is bound — the body and footer cells
                  are copies of the same items, and duplicate bindings compete
                  for the same rows on the canvas. */}
            <tr
              data-editable="array"
              data-prop={at("plans")}
              data-direction="row"
            >
              {/* The heading sits in the table's corner cell rather than
                  centred above it: the design levels "Features" with the plan
                  names, because the left column labels the rows under it and
                  is not a heading for the whole band. */}
              {/* Nothing in this cell is bound: a region reads its prop path
                  relative to the nearest region above it, which here is the
                  row holding the plans, so `content.heading` would be looked
                  for inside that array and never found. These two are edited
                  in the side panel. */}
              <td class="comparison-table-corner">
                <Heading
                  eyebrow={eyebrow}
                  level={headingLevel}
                  size={headingSize}
                  alignmentHorizontal="start"
                >
                  {heading}
                </Heading>
                {isNonEmptyString(footnote) && <p class="comparison-table-footnote">{footnote}</p>}
              </td>
              {planList.map((plan) => (
                <th
                  scope="col"
                  class:list={[plan.highlight && "highlight"]}
                  data-editable="array-item"
                >
                  <span
                    class="comparison-table-plan"
                    data-editable="text"
                    data-prop="name"
                  >
                    {plan.name}
                  </span>
                  {slidesPrice(plan) ? (
                    <span class="comparison-table-price billing-figures">
                      <span
                        class="billing-figure is-monthly"
                        data-editable="text"
                        data-prop="price"
                      >
                        {plan.price}
                      </span>
                      <span
                        class="billing-figure is-annual"
                        data-editable="text"
                        data-prop="annualPrice"
                      >
                        {plan.annualPrice}
                      </span>
                    </span>
                  ) : (
                    plan.price && (
                      <span
                        class="comparison-table-price"
                        data-editable="text"
                        data-prop="price"
                      >
                        {plan.price}
                      </span>
                    )
                  )}
                  {buttonPosition === "header" && plan.buttonText && (
                    <Button
                      class="comparison-table-action"
                      text={plan.buttonText}
                      link={plan.buttonLink}
                      variant={plan.highlight ? "primary" : "tertiary"}
                      size="sm"
                      data-outline={plan.highlight ? undefined : ""}
                      data-prop="buttonText"
                    />
                  )}
                </th>
              ))}
            </tr>
          </thead>
          <tbody
            data-editable="array"
            data-prop={at("rows")}
          >
            {rows?.map((row: Row) => (
              <tr data-editable="array-item">
                <th
                  scope="row"
                  data-editable="text"
                  data-prop="feature"
                >
                  {row?.feature}
                </th>
                {planList.map((plan, index) => {
                  const value = cellFor(row, index);
                  const mark = markFor(value);

                  return (
                    <td class:list={[plan.highlight && "highlight", `mark-${mark}`]}>
                      {mark === "text" ? (
                        value
                      ) : (
                        <>
                          <Icon
                            name={mark === "included" ? "circle-check" : "minus"}
                            size="sm"
                          />
                          <span class="visually-hidden">
                            {mark === "included" ? "Included" : "Not included"}
                          </span>
                        </>
                      )}
                    </td>
                  );
                })}
              </tr>
            ))}
          </tbody>
          {buttonPosition === "foot" && planList.some((plan) => plan.buttonText) && (
            <tfoot>
              <tr class="comparison-table-actions">
                <td />
                {planList.map((plan) => (
                  <td class:list={[plan.highlight && "highlight"]}>
                    {plan.buttonText && (
                      <Button
                        class="comparison-table-action"
                        text={plan.buttonText}
                        link={plan.buttonLink}
                        iconName="arrow-right"
                        iconPosition="after"
                        variant="text"
                        size="sm"
                      />
                    )}
                  </td>
                ))}
              </tr>
            </tfoot>
          )}
        </table>
      </div>
    </div>
  )}
</CustomSection>

<style is:global>
  @layer page-sections {
    /* The design's table, measured off 4146:56867.

       "Features" sits in the left column level with the plan names rather than
       centred above the whole table: the left column is a label for the rows
       under it, not a heading for the band. The plan columns are ruled from
       each other, and the action sits under its own price. */
    .comparison-table-corner {
      /* The same padding the plan cells carry, so the heading's foot lands
         level with the buttons beside it. On the cell's own 1px it sat hard
         against the row's rule with its descenders over the line, while the
         buttons stopped 16 short of it. */
      padding: var(--spacing-md);
      vertical-align: bottom;
    }

    .comparison-table-corner .heading {
      --space-before: 0;
      margin-block: 0;
    }

    .comparison-table-action {
      display: flex;
      justify-content: center;
      padding-block-start: var(--spacing-md);
    }

    .comparison-table-action[data-outline] > .button-inner {
      border-color: var(--pacific);
      color: var(--pacific);
    }

    .comparison-table-action[data-outline] > .button-inner:hover,
    .comparison-table-action[data-outline] > .button-inner:focus-visible {
      background-color: color-mix(in srgb, var(--pacific) 8%, transparent);
      border-color: var(--pacific);
      color: var(--pacific);
    }

    /* A rule between every pair of columns, which is what separates columns
       of ticks into readable plans. Not on the first cell: the feature names
       are a column of labels, not a plan — and that cell is a `th`, so
       `td + td` skipped the first plan as well and drew one rule where the
       design draws three. */
    .comparison-table tbody tr > *:not(:first-child) {
      border-inline-start: var(--border-width-sm) solid var(--dark-sand);
    }

    /* The floor only. The design rules the plan columns apart from the first
       body row down and leaves the header open, on this table and on the
       pricing one; carried up into the header the rules read as four boxes
       rather than one row of plans. */
    .comparison-table thead th + th {
      box-shadow: inset 0 calc(-1 * var(--border-width-md)) 0 var(--color-border-strong);
    }

    .comparison-table {
      /* One transparent gray on even rows only. The same mix over --color-bg
         is used on the sticky feature column so it matches on screen and
         stays opaque when the table pans underneath. */
      --pricing-stripe: color-mix(in srgb, var(--gray-500) 10%, transparent);
      --pricing-stripe-solid: color-mix(in srgb, var(--gray-500) 10%, var(--band-color));
      .comparison-table-frame {
        --space-before: var(--space-before-loose);
      }

      .comparison-table-hint {
        color: var(--color-text-muted);
        display: none;
        font-size: var(--font-size-xs);
        font-weight: var(--font-weight-semibold);
        letter-spacing: 0.08em;
        margin: 0 0 var(--spacing-xs);
        text-transform: uppercase;
      }

      /* Not a scroll container at this width, so the header row sticks to
         the window rather than to a box that never scrolls vertically:
         `overflow-x: auto` computes `overflow-y: auto` too, and a scrollport
         that fits its content never offsets anything inside it. Panning is
         turned back on below 640, where the table stops fitting. */
      .comparison-table-scroller {
        overflow: visible;

        &:focus-visible {
          outline: var(--focus-ring-width) var(--focus-ring-style) var(--color-focus-ring);
          outline-offset: 2px;
        }
      }

      table {
        border-collapse: collapse;
        min-width: 34rem;
        width: 100%;
      }

      thead th {
        background: none;
        border: 0;
        padding: var(--spacing-md);
        text-align: center;
        vertical-align: bottom;
      }

      /* The row rides the page so the plan a tick belongs to is still named
         forty rows down. Both the plan cells and the corner, or the corner
         scrolls away and the row is left floating.

         The rules are shadows rather than borders: under
         `border-collapse: collapse` a border belongs to the table, not the
         cell, so it stays behind when a sticky cell moves and the header
         travels with no floor under it. */
      thead th,
      .comparison-table-corner {
        background-color: var(--band-color);
        box-shadow: inset 0 calc(-1 * var(--border-width-md)) 0 var(--color-border-strong);
        position: sticky;
        /* Under the main nav, which is sticky at the top of the window
           itself: at 0 the plan names and prices pinned behind it and only
           the buttons showed. Below its layer too, so the nav still wins. */
        top: var(--main-nav-height);
        z-index: 1;
      }

      .comparison-table-frame.striped thead th,
      .comparison-table-frame.striped .comparison-table-corner {
        background-color: var(--band-color);
      }

      /* Both lines of the header are Header styles in the design, bold and
         in the strong ink: the name is 20/700 and the figure under it 14/700,
         against the 14.5/400 muted body the rest of the table is set in. Read
         as body they sat level with the row labels under them and the header
         stopped reading as a header. */
      /* Small print, in the corner under whatever heading is there. */
      .comparison-table-footnote {
        color: var(--color-text-muted);
        font-size: var(--font-size-xs);
        font-style: italic;
        margin: var(--spacing-sm) 0 0;
        max-inline-size: 18ch;
      }

      .comparison-table-plan {
        color: var(--color-text-strong);
        display: block;
        font-size: var(--font-size-heading-xs);
        font-weight: var(--font-weight-bold);
      }

      /* A description rather than a price: regular, muted, and a step down.
         `&` because this sits inside the block's own nest — written out in
         full it compiles to a `.comparison-table` inside a
         `.comparison-table`, which matches nothing. */
      &.line-muted .comparison-table-price {
        color: var(--color-text-muted);
        font-size: var(--font-size-xs);
        font-weight: var(--font-weight-normal);
      }

      .comparison-table-price {
        color: var(--color-text-strong);
        display: block;
        font-size: var(--font-size-sm);
        font-weight: var(--font-weight-bold);
      }

      /* `display` has to be restated here: the rule above it is a class
         deeper, so a price cell kept `block`, `grid-area` meant nothing and
         the two figures sat side by side instead of stacking. */
      .comparison-table-price.billing-figures {
        display: grid;
      }

      .comparison-table-billing {
        --space-before: var(--spacing-xl);

        margin-block-start: var(--spacing-xl);
      }

      tbody th,
      tbody td,
      tfoot td {
        border: 0;
        font-size: var(--font-size-sm);
        padding: var(--spacing-md);
        text-align: center;
      }

      tbody th,
      tbody td {
        border-bottom: var(--border-width-sm) solid var(--color-border);
      }

      tbody th[scope="row"] {
        font-weight: var(--font-weight-semibold);
        text-align: start;
      }

      .mark-included .icon {
        color: var(--color-success);
      }

      .mark-excluded .icon {
        color: var(--color-text-muted);
        opacity: 0.6;
      }

      /* Highlighted plans are marked by the primary CTA, not a tinted column
         — column fills read as a second zebra axis and fight the row stripe.
         That is still the default, and `highlightStyle` is what asks for
         the other: a table with its stripe off has nothing for a column fill
         to fight, and the comparison against other tools marks its own
         column exactly that way. */
      .comparison-table-actions td {
        padding-top: var(--spacing-lg);

        .button {
          margin-top: 0;
        }
      }

      /* The tinted column, asked for rather than inferred. Harbour at 22% is
         the pale blue the design draws, and the header cell rounds at the
         top because the fill starts there. */
      &.highlight-tint :is(th, td).highlight {
        background-color: var(--harbour-100);
      }

      &.highlight-tint thead th.highlight {
        border-start-end-radius: var(--radius-card);
        border-start-start-radius: var(--radius-card);
      }

      /* The striped class rides on the frame — a prop-driven class on a region
         root goes stale in the editor. */
      .comparison-table-frame.striped tbody tr:nth-child(2n) th,
      .comparison-table-frame.striped tbody tr:nth-child(2n) td {
        background-color: var(--pricing-stripe);
      }

      /* 640px = canonical mobile breakpoint — pans with the feature column
         pinned, matching the Table block. */
      @media (width < 640px) {
        .comparison-table-hint {
          display: block;
        }

        .comparison-table-scroller {
          mask-image: linear-gradient(90deg, #000 calc(100% - var(--spacing-xl)), transparent);
          overflow-x: auto;
        }

        /* The row cannot stick to the window from inside a scroll container,
           and the narrow table is a scroll container again. */
        thead th,
        .comparison-table-corner {
          position: static;
        }

        tbody th[scope="row"] {
          background-color: var(--band-color);
          border-inline-end: var(--border-width-sm) solid var(--color-border);
          inset-inline-start: 0;
          position: sticky;
        }

        .comparison-table-frame.striped tbody tr:nth-child(2n) th[scope="row"] {
          background-color: var(--pricing-stripe-solid);
        }
      }
    }
  }
</style>
