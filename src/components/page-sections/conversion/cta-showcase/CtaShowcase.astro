---
import Component from "@component-utils/renderBlock.astro";
import type { ContentBlock } from "../../../../types";
import { bandPattern, bandHaze } from "@component-utils/bandStyle.mjs";
import { nestedProps } from "@component-utils/nestedProps.mjs";
import { rootMirror } from "@component-utils/rootMirror.mjs";
import CustomSection from "@builders/custom-section/CustomSection.astro";
import { subtextMeasure } from "@component-utils/subtextMeasure.mjs";
import Heading from "@core-elements/heading/Heading.astro";
import Text from "@core-elements/text/Text.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";
import Split from "@wrappers/split/Split.astro";

/* `content` and `style` are the editor's tabs, flattened straight back into
   the names below. `at()` writes the frontmatter path a binding needs. */
const { props, at } = nestedProps(Astro.props, {
  nest: {
    heading: ["heading", "headingLevel", "headingSize"],
    subtext: ["subtext", "subtextSize", "subtextWidth"],
  },
});

const {
  heading = "",
  headingLevel = "h2",
  headingSize = "xl",
  subtext = "",
  // Body 3 at 19 or Subtitle 1 at 22 in the design; `md` keeps the 16 every
  // section rendered before either was carried through.
  subtextSize = "md",
  /**
   * A CTA beside one of the built things.
   *
   * The copy half is the same as any CTA — a heading, a line, a button or two.
   * The other half holds something drawn for this site rather than a picture
   * dropped in: the truck with its hood opening, the camera that prints, the
   * terminal that types, the two illustrated characters talking.
   *
   * Which one it is decides the shape of the band, and that is the whole point
   * of this being its own section. Each was built to a width — the camera and
   * the chat to 438, the terminal to 616, the truck to 736 with its nose over
   * the edge — so the columns and the overhang are read off the media rather
   * than offered as fields. An editor picks the thing and gets the band it was
   * drawn for. The generic split next door is where a plain picture or a video
   * goes, and that one still takes a layout.
   */
  subtextWidth,
  buttonSections = [],
  /**
   * The one thing in the other half.
   *
   * An object rather than a list of one: there is exactly one of these per
   * band, and a list said otherwise. It still arrives through the structures
   * picker, so it is chosen the same way and can be cleared again — the shape
   * just matches what it is.
   */
  illustration = null,
  /**
   * A terminal session in place of the picture.
   *
   * An object rather than a handful of flat props, because it is one thing:
   * `{ path, script, loop }`. Present and carrying a script, it takes the
   * media side; absent, nothing about this section changes.
   */
  /**
   * Turns the picture into a camera you can take a picture with.
   *
   * `{ shots: [{ source, alt }], label }`. Present, the media side becomes the
   * camera and its pile; absent, nothing about this section changes.
   */
  /**
   * Two characters in conversation in place of the picture.
   *
   * `{ characters: [{ source, alt, width }], gap, ratio }`. The design draws
   * the Enterprise card's pair as one bitmap with the speech bubble baked into
   * it; placed separately they hold their proportions whatever shape the card
   * takes. Absent, nothing about this section changes.
   */
  /**
   * A second picture of the same subject, crossfaded in when the section is
   * scrolled to. The two have to be the same size with their artwork on the
   * same pixels, or the swap reads as a jump rather than as one thing
   * changing: the truck's two hoods are one 1600x746 upload each, and both
   * draw the body between x 7 and 1591.
   */
  /** What a reader who cannot see the swap is told the control does. */
  reverse = false,
  /**
   * A card behind the picture.
   *
   * The design draws the person as a cut-out on a textured panel: two images,
   * not one. Taken as a single picture the generator picked the panel and blew
   * it up to fill the column, which is a large yellow rectangle and no person.
   */
  sectionLabel,
  maxContentWidth = "xl",
  paddingHorizontal = "gutter",
  paddingVertical = "4xl",
  colorScheme = "inherit",
  lockColorScheme = false,
  // Was hardcoded to landscape, which crops anything that is not 4:3. The
  // design places these at their own proportions: the truck is 915x427, so a
  // 4:3 frame cuts a third of it away.
  backgroundColor = "light-sand",
  /** The texture behind the band, by name. */
  pattern = "none",
  /** Which edge the texture fades out towards. */
  fade = "none",
  /** Whether the heading sits on a pool of the band’s own colour. */
  haze = false,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = props;

/* The measure the subtext is set in, as a length. */
const subtextCap = subtextMeasure(subtextWidth);

const block: ContentBlock | null =
  illustration && typeof illustration === "object" && !Array.isArray(illustration)
    ? (illustration as ContentBlock)
    : null;

/**
 * The band's shape, read off what is in the media half.
 *
 * Each of these was drawn to a width and the band was built around it, so the
 * columns and the overhang belong to the thing rather than to the page. Held
 * here as constants for the same reason the repo card's chrome is: they are
 * what makes the band that band, and there is nothing in them an editor would
 * want to reach for.
 *
 * `overflow` is how far it runs past its column. The truck was drawn at 333,
 * 334 and 336 on the three bands that carry it; one value for the variant is
 * the same intent measured three times.
 *
 * `panel` is the colour of the panel it sits on, or false where it sits
 * straight on the band. It was a field, and on the three truck bands it was
 * set to white while the truck draws no panel at all — a colour for something
 * that is not there. The two that do draw one disagree and always will: the
 * camera is on white, the chat on the page's own cream against a Sand band.
 * So it goes with the shape, which is what it is part of.
 */
const MEDIA_LAYOUT: Record<
  string,
  {
    panel: false | string;
    overflow: number;
    fixed?: "copy" | "media";
    gap?: string;
    minSplit?: number;
  }
> = {
  "building-blocks/wrappers/image-reveal": { panel: false, overflow: 334 },
  "building-blocks/wrappers/agent-terminal": { panel: false, overflow: 0 },
  "building-blocks/wrappers/polaroid-camera": { panel: "white", overflow: 0 },
  "building-blocks/wrappers/character-chat": { panel: "color-bg", overflow: 0 },
  /* The card is a fixed width hard right and the drawing takes what is left,
     so the media half carries its own shape and sits straight on the band —
     the design draws it on #FFFCF3 with nothing behind it either time. */
  "building-blocks/wrappers/offer-card": { panel: false, overflow: 0 },
  /* The pile is the one that takes the fixed column rather than giving it to
     the copy: it is drawn 664 against the design's 400 pane and reaches the
     other 264 back over the copy, which only holds if the pane is the 400.
     The reach itself is the CSS below, not a bleed — it runs inwards. */
  "building-blocks/wrappers/shape-pile": {
    panel: false,
    overflow: 0,
    fixed: "media",
    /* The pile reaches over the copy, so the two sides are held apart by the
       design's 48 rather than the 24 a picture in a column of its own
       wants. */
    gap: "2xl",
    /* And they stop being two sides sooner than the rest: a picture in its
       own column is fine beside a narrow copy, where the pile is laid over
       it and would cover the heading. */
    minSplit: 800,
  },
};
const DEFAULT_LAYOUT = { panel: "white" as const, overflow: 0 };

const layout = MEDIA_LAYOUT[String(block?._component ?? "")] ?? DEFAULT_LAYOUT;

/* Astro takes a component expression here, so the wrapper can be a real
   element or nothing at all. Rendering the div either way and styling it only
   when it is a card would put a flow child between the section and the split,
   which every one of these already laid out without. */
const Wrapper = layout.panel ? "div" : Fragment;
const wrapperProps = layout.panel
  ? {
      class: "cta-showcase-card",
      style: `--cta-showcase-card-bg: var(--${layout.panel})`,
    }
  : {};

const bleedSide = layout.overflow > 0 ? (reverse ? "inline-start" : "inline-end") : undefined;
const bleedLimit = layout.overflow > 0 ? `${layout.overflow}px` : undefined;

/* Mirrored onto the builder's `.content`, because the flag lands on the
   section's root and the editor never rewrites a region root. */
const mirror = rootMirror({ "data-picture-first": reverse ? "" : null });
---

<CustomSection
  mirror={mirror}
  class:list={["cta-showcase", className]}
  data-picture-first={reverse ? "" : undefined}
  sectionLabel={sectionLabel}
  maxContentWidth={maxContentWidth}
  paddingHorizontal={paddingHorizontal}
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  lockColorScheme={lockColorScheme}
  backgroundColor={backgroundColor}
  background={bandPattern(pattern, fade)}
  haze={bandHaze(haze, { reverse, split: true })}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  {/* Split flips the distribution when it reverses, so the fixed column stays
      on the same side of the page while the content swaps across it. That is
      right when the fixed column is the copy, and wrong here: reversed, the
      picture went into the flexible column and the copy into the fixed 400,
      which pushed the heading 119 further right than the design draws it.
      Asking for the opposite mode lands it back on fixed-flexible, so the
      fixed width travels with the picture. */}
  <Wrapper {...wrapperProps}>
    <Split
      distributionMode={
        layout.panel
          ? "half"
          : layout.fixed === "media"
            ? "flexible-fixed"
            : reverse
              ? "flexible-fixed"
              : "fixed-flexible"
      }
      fixedWidth={layout.panel ? undefined : "400"}
      data-bleed={bleedSide}
      style={bleedLimit ? { "--split-bleed-limit": bleedLimit } : undefined}
      alignmentVertical="center"
      gap={layout.gap}
      reverse={reverse}
      minSplitWidth={layout.minSplit ?? 640}
    >
      <Fragment slot="first">
        <Heading
          level={headingLevel}
          size={headingSize}
          data-prop={at("heading")}
        >
          {heading}
        </Heading>
        <Text /* Its measure, not its place: the copy in this band runs from the
              left, and the centring here only ever showed on a band whose
              column was wider than the measure. */
          style={subtextCap ? `max-inline-size: ${subtextCap}` : undefined}
          size={subtextSize}
          data-prop={at("subtext")}
          text={subtext}
        />
        <ButtonGroup
          buttonSections={buttonSections}
          direction="row"
          alignmentHorizontal="start"
          data-children-prop={at("buttonSections")}
        />
      </Fragment>
      <Fragment slot="second">
        {/* Whatever the band puts here, rather than a branch over six kinds
            of media.

            It used to be a chain: characters, then a camera, then a terminal,
            then a backdrop portrait, then a two-picture reveal, then a plain
            image — each with its own props sitting on the section whether the
            band used them or not. Five of those ten image props were set on no
            page at all, and the backdrop arm on none. A CTA that wants a
            picture drops in an Image; the three that want the truck drop in an
            Image Reveal. */}
        <Component
          contentSections={block ? [block] : []}
          useDefaultEditableBinding={false}
        />
      </Fragment>
    </Split>
  </Wrapper>
</CustomSection>

<style is:global>
  /* A cut-out on a card. The design draws the panel 366 square with the person
     filling it and sitting on its bottom edge, so the subject is placed rather
     than laid out: stacked in flow it pushed the panel to twice the height.

     Flat, because rules nested deeper than a couple of levels get dropped (see
     CLAUDE.md). */
  @layer page-sections {
    /* The pile is drawn 664 wide and the media column is 400, so it reaches
       264 back over the copy — a share of the column rather than a length,
       because the column shrinks with the band and a fixed reach would eat
       the heading. It stands on the band's foot and hangs over it, and the
       headroom is what keeps the card that leans furthest back out of the
       heading: the design's band is 527 tall with the 340 pile on its floor,
       so 187 sits above it, of which the band's own padding is 80. */
    .cta-showcase .shape-pile {
      --cta-showcase-pile-reach: 66%;

      /* A stacked pile fills its rows from the band's edge, so it needs the
         room a drawn one takes but not the reach: at 66 a row of three
         started over the heading. */
      &.is-auto {
        --cta-showcase-pile-reach: 34%;

        /* It stands on the band's floor like the drawn one, over the padding
           rather than on it. Less far over: the drawn pile's foot is a band
           of colour with nothing in it, where a stacked card carries its
           label down to within 24 of its own foot. */
        margin-block-end: calc(-1 * var(--spacing-2xl));
      }

      align-self: end;
      inline-size: calc(100% + var(--cta-showcase-pile-reach));
      margin-inline-start: calc(-1 * var(--cta-showcase-pile-reach));
    }

    /* The pile's own column, made to hold it at the foot. A drawn pile is
       placed by its headroom and a stacked one is not placed at all, so
       without this it sat at the top of the column and the cards came to
       rest in mid-air. */
    .cta-showcase .pane:has(> .shape-pile.is-auto) {
      /* The band centres its two columns, which leaves this one shorter than
         the row and the floor somewhere in the middle of it. */
      align-self: stretch;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
    }

    /* The headroom and the overhang belong to the drawn pile, whose height is
       fixed: it stands on the band's floor and hangs over it by design. A
       stacked pile grows a row at a time, and both of those were measured
       against a height it no longer has — the band came up short and the top
       row went out through its head. */
    .cta-showcase .shape-pile:not(.is-auto) {
      margin-block-end: calc(-1 * var(--spacing-4xl));
      margin-block-start: 107px;
    }

    /* Stacked, there is no copy beside it to reach over. */
    @media (width < 700px) {
      .cta-showcase .shape-pile {
        --cta-showcase-pile-reach: 0%;
      }
    }

    /* The panel the design floats on the dotted band. White rather than the
       page's light sand: the design states #FFFFFF, which on a sand band is a
       step up rather than the usual step down. */
    .cta-showcase .cta-showcase-card {
      background-color: var(--cta-showcase-card-bg, var(--white));
      border: 1px solid var(--color-border-subtle);
      border-radius: var(--radius-card);
      /* So a drawing on the foot is cut by the card's own corners rather than
         hanging past them. */
      overflow: hidden;
      padding: var(--spacing-2xl) 69px;
    }

    /* Except where the card holds a camera: its prints are meant to spill
       past the edges, and the clip above is there for a drawing standing on
       the foot, which this card does not have. */
    .cta-showcase .cta-showcase-card:has(.polaroid-camera) {
      overflow: visible;
    }

    /* flow's space-before is what sets the gap from the section above, and on
       a card it would print inside the rule instead. */
    .cta-showcase .cta-showcase-card > .split {
      --space-before: 0;
      margin-block: 0;
    }
  }
</style>

<style is:global>
  /* The design puts 121 between the picture column and the copy: the portrait
     sits at 122 in a 400 column and the heading starts at 641. The spacing
     utilities stop at 64, so this is set directly rather than rounded down to
     half what the design draws.

     Flat, because rules nested deeper than a couple of levels get dropped (see
     CLAUDE.md). */
  @layer overrides {
    .cta-showcase[data-picture-first] .split-inner {
      column-gap: 7.5625rem;
    }
  }
</style>
