---
import { isNonEmptyString } from "@component-utils/isNonEmptyString";
import { slugifyLabel } from "@component-utils/slugify";
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Text from "@core-elements/text/Text.astro";
import Toggle from "@forms/toggle/Toggle.astro";
import PricingTiersItem from "@page-sections/conversion/pricing-tiers/PricingTiersItem.astro";
import Grid from "@wrappers/grid/Grid.astro";
import { nextHeadingLevel } from "@component-utils/headingLevel";

type TierProps = Record<string, unknown>;

const {
  eyebrow = "",
  heading = "",
  headingLevel = "h2",
  headingSize = "lg",
  subtext = "",
  // The design sets a section's supporting line in one of two styles, Body 3
  // at 19 or Subtitle 1 at 22. `md` is the 16 every section rendered before
  // either was carried through, so nothing moves unless the design named it.
  subtextSize = "md",
  /**
   * The measure the design sets the supporting line in, in pixels.
   *
   * Not the column it sits in: a centred subtext is drawn at about 580 in the
   * 1040 column, and run the full width it reads as a different block.
   */
  subtextWidth,
  showAnnualPricing = false,
  monthlyLabel = "Monthly",
  annualLabel = "Annual",
  annualBadge = "",
  defaultInterval = "monthly",
  tiers = [],
  /**
   * How the header sits over the tiers.
   *
   * The design does both: "Pricing plans" is centred and "Climb as your
   * portfolio grows" runs from the column's left edge, with the same eyebrow,
   * heading and measured line either way.
   */
  alignmentHorizontal = "center",
  sectionLabel,
  maxContentWidth = "xl",
  paddingHorizontal = "gutter",
  paddingVertical = "4xl",
  colorScheme = "inherit",
  lockColorScheme = false,
  backgroundColor = "base",
  background,
  haze = false,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const itemHeadingLevel = nextHeadingLevel(headingLevel);

// A radio group's name must be unique per section on the page, so a section
// with nothing to name it still needs a generated suffix.
const billingLabel = sectionLabel || heading;
const billingName = `pricing-billing-${billingLabel ? slugifyLabel(billingLabel) : crypto.randomUUID()}`;
const annualSelected = defaultInterval === "annual";
---

<CustomSection
  class:list={["pricing-tiers", className]}
  label={sectionLabel}
  maxContentWidth={maxContentWidth}
  paddingHorizontal={paddingHorizontal}
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  lockColorScheme={lockColorScheme}
  backgroundColor={backgroundColor}
  background={background}
  haze={haze}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  <SimpleText
    alignmentHorizontal={alignmentHorizontal}
    class="eyebrow"
    data-prop="eyebrow"
    text={eyebrow}
    size="sm"
  />
  <Heading
    level={headingLevel}
    size={headingSize}
    alignmentHorizontal={alignmentHorizontal}
    data-prop="heading"
  >
    {heading}
  </Heading>
  <Text
    class="pricing-tiers-subtext"
    alignmentHorizontal={alignmentHorizontal}
    style={subtextWidth
      ? `max-inline-size: ${Number(subtextWidth)}px;${
          alignmentHorizontal === "center" ? " margin-inline: auto; justify-self: center" : ""
        }`
      : undefined}    size={subtextSize}
    data-prop="subtext"
    text={subtext}
  />
  {showAnnualPricing && (
    <div class="pricing-tiers-billing">
      <Toggle
        class="pricing-tiers-billing-toggle"
        name={billingName}
        value="annual"
        offLabel={monthlyLabel}
        label={annualLabel}
        checked={annualSelected}
      >
        {annualLabel}
        {isNonEmptyString(annualBadge) && (
          <>
            {" "}
            <span
              class="pricing-tiers-billing-saving"
              data-prop="annualBadge"
            >
              ({annualBadge})
            </span>
          </>
        )}
      </Toggle>
    </div>
  )}
  <Grid
    gap="lg"
    minItemWidth={tiers.length >= 4 ? 240 : 272}
    class:list={["pricing-tiers-grid", tiers.length >= 4 && "pricing-tiers-wide"]}
    spaceBefore="loose"
    data-children-prop="tiers"
  >
    {tiers?.map((tier: TierProps) => (
      <PricingTiersItem
        data-id="page-sections/conversion/pricing-tiers/pricing-tiers-item"
        data-editable="array-item"
        {...tier}
        headingLevel={itemHeadingLevel}
        showAnnualPricing={showAnnualPricing}
      />
    ))}
  </Grid>
</CustomSection>

<style is:global>
  @layer page-sections {
    /* Not Grid's maxItemWidth: auto-fill counts tracks at the max, so three
       420px-capped cards wrapped 2 + 1 until ~1300px. The cap is on the row. */
    .pricing-tiers-grid > .grid-inner.columns-auto {
      --pricing-tier-max-width: 420px;

      grid-template-columns: repeat(auto-fit, minmax(min(var(--min-item-width), 100%), 1fr));
      margin-inline: auto;
      max-width: calc(var(--pricing-tier-max-width) * 3 + var(--grid-spacing) * 2);

      &:not(:has(> :nth-child(3))) {
        max-width: calc(var(--pricing-tier-max-width) * 2 + var(--grid-spacing));
      }

      &:not(:has(> :nth-child(2))) {
        max-width: var(--pricing-tier-max-width);
      }
    }

    .pricing-tiers-billing {
      display: flex;
      justify-content: center;

      > .pricing-tiers-billing-toggle {
        width: auto;
      }

      .pricing-tiers-billing-saving {
        color: var(--color-success);
        font-weight: var(--font-weight-semibold);
      }
    }
  }

  @layer page-sections {
    /* Four tiers want the file's other column, 1180, and step up to the right:
       the design draws them 274, 328, 399 and 454 tall on one baseline.

       Only the row. Widening the section took the header out with it, and the
       design keeps that in the 1040 column — the eyebrow, heading and line all
       start at 125 while the cards run 52 to 1226. So the row breaks out of
       the column by half the difference instead. */
    .pricing-tiers .pricing-tiers-wide {
      /* `inline-size: auto` as well as the margins: Grid sets width: 100%,
         which resolves against the 1040 column, so negative margins alone slid
         the row left instead of widening it. */
      inline-size: auto;
      margin-inline: calc((var(--content-width-xl) - var(--content-width-wide)) / 2);
    }

    /* 11 between them, not the 24 three cards take: the design draws 285-wide
       cards at 52, 348, 645 and 941. */
    .pricing-tiers .pricing-tiers-wide > .grid-inner {
      gap: 0.6875rem;
      max-inline-size: none;
    }

    .pricing-tiers .pricing-tiers-wide > .grid-inner {
      align-items: end;
    }
  }
</style>
