---
import { isNonEmptyString } from "@component-utils/isNonEmptyString";
import Badge from "@core-elements/badge/Badge.astro";
import Button from "@core-elements/button/Button.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Icon from "@core-elements/icon/Icon.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import GridItem from "@wrappers/grid/GridItem.astro";

type TierFeature = { text?: string; included?: boolean };

const {
  name = "",
  headingLevel = "h3",
  price = "",
  priceSuffix = "",
  annualPrice = "",
  annualPriceSuffix = "",
  description = "",
  features = [],
  buttonText = "",
  buttonLink = "",
  highlight = false,
  badgeText = "",
  /**
   * Where the figure sits relative to what is included.
   *
   * The design puts it at the foot of the card, after the list, and the
   * shipped order is the other way round. Measured per section rather than
   * switched globally.
   */
  pricePosition = "top",
  /** The height the design draws this card at, in pixels. */
  height,
  showAnnualPricing = false,
  /** Which of the two sands this card is. Set for the whole grid. */
  cardColor = "surface",
  cardAlignment = "start",
  badgeColor = "",
  /**
   * A palette colour for this tier, mixed into the card at 12%.
   *
   * Not in the design, which paints all four the same Sand: a decision to let
   * the ladder read as a ladder. 12% because 5%, the tint the rest of the site
   * uses, leaves bronze and silver indistinguishable, and 20% reads as four
   * different components rather than four tiers of one.
   */
  accent = "",
  class: className,
  _component,
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  ...htmlAttributes
} = Astro.props;

/* The design draws the plan cards #FFFFFF on a #FFFCF3 band, which no
   `--color-bg-*` holds: white is lighter than the lightest of them, and read
   as `base` the card came out the band's own colour with only its rule to
   separate it. */
const CARD_SURFACES: Record<string, string> = {
  white: "var(--white)",
  base: "var(--color-bg)",
  surface: "var(--color-bg-surface)",
  muted: "var(--color-bg-muted)",
};
const sand = CARD_SURFACES[cardColor] ?? CARD_SURFACES.surface;

/* The card declares its own scheme, the way the bento's and the quote's cards
   do. `data-theme` steers anything nested that reads a theme token — a
   Button's arrow, a link's hover — but the site is light only, so it does not
   flip the text colour by itself: the card states its own ink below. Without
   both, a dark card drew near-black copy on near-black. */
const cardScheme = cardColor === "muted" || cardColor === "dark" ? "dark" : undefined;

const priceRows = [
  {
    interval: "monthly",
    amount: price,
    suffix: priceSuffix,
    amountProp: "price",
    suffixProp: "priceSuffix",
  },
  ...(showAnnualPricing && isNonEmptyString(annualPrice)
    ? [
        {
          interval: "annual",
          amount: annualPrice,
          suffix: annualPriceSuffix,
          amountProp: "annualPrice",
          suffixProp: "annualPriceSuffix",
        },
      ]
    : []),
];

const shownRows = priceRows.filter((row) => isNonEmptyString(row.amount));

/* A tier that prices both ways slides between the two figures in one row,
   rather than hiding a second row. Both numbers share a grid cell, so the
   cell is as wide as the longer of them and the suffix beside it does not
   step across as the control is thrown. Below two figures there is nothing
   to slide, so the single row is left exactly as it was. */
const slides = shownRows.length > 1;
const figures = slides
  ? [
      { part: "amount", monthly: price, annual: annualPrice },
      { part: "suffix", monthly: priceSuffix, annual: annualPriceSuffix },
    ].filter((f) => isNonEmptyString(f.monthly) || isNonEmptyString(f.annual))
  : [];
---

<GridItem {...htmlAttributes}>
  <article
    class:list={[
      "pricing-tier",
      highlight && "highlight",
      `price-${pricePosition}`,
      `align-${cardAlignment}`,
      className,
    ]}
    data-theme={cardScheme}
    style={[
      height ? `--pricing-tier-height: ${Number(height)}px` : "",
      badgeColor
        ? `--pricing-tier-badge: var(--${badgeColor}); --pricing-tier-badge-ink: var(--white)`
        : "",
      `--pricing-tier-bg: ${accent ? `color-mix(in srgb, ${accent.startsWith("#") ? accent : `var(--${accent})`} 12%, ${sand})` : sand}`,
    ].filter(Boolean).join("; ")}
  >
    {/* The badge sits in a row with the name rather than floating over the
        card, so a name long enough to reach it pushes it down instead of
        running underneath it. A centred card lifts it out of the row and
        onto the top edge, which is the only placement that reads as centred:
        beside a centred name it sits off to one side of nothing.

        Not gated on `highlight`: the design badges the recommended plan and
        rules all three cards the same, where highlight also draws a heavier
        ring around the card. */}
    <div class="pricing-tier-head">
      {/* Before the name, because the badge floats and a float only shortens
          the lines that come after it in the source.

          `md` rather than the design's own size: the file sets this label at
          10px, which is legible in Figma at 100% and is not on a real screen.
          One step up is 14 and still reads as a badge beside a 29px name. */}
      {badgeText && (
        <Badge
          class="pricing-tier-badge"
          variant="neutral"
          size="md"
          text={badgeText}
          data-prop="badgeText"
        />
      )}
      <Heading
        class="pricing-tier-name"
        level={headingLevel}
        size="xs"
        alignmentHorizontal={cardAlignment === "center" ? "center" : "start"}
        data-prop="name"
      >
        {name}
      </Heading>
    </div>
    <SimpleText
      class="pricing-tier-description"
      size="sm"
      alignmentHorizontal={cardAlignment === "center" ? "center" : "start"}
      data-prop="description"
      text={description}
    />
    {slides && (
      <p
        class="pricing-tier-price pricing-tier-price-both"
        aria-live="polite"
      >
        {figures.map((figure) => (
          <span class:list={[`pricing-tier-${figure.part}`, "billing-figures"]}>
            <span
              class="billing-figure is-monthly"
              data-editable="text"
              data-prop={figure.part === "amount" ? "price" : "priceSuffix"}
            >
              {figure.monthly}
            </span>
            <span
              class="billing-figure is-annual"
              data-editable="text"
              data-prop={figure.part === "amount" ? "annualPrice" : "annualPriceSuffix"}
            >
              {figure.annual}
            </span>
          </span>
        ))}
      </p>
    )}
    {!slides && shownRows.map((row) => (
      <p
        class:list={[
          "pricing-tier-price",
          showAnnualPricing && `pricing-tier-price-${row.interval}`,
        ]}
        aria-live={showAnnualPricing ? "polite" : undefined}
      >
        <span
          class="pricing-tier-amount"
          data-editable="text"
          data-prop={row.amountProp}
        >
          {row.amount}
        </span>
        {row.suffix && (
          <span
            class="pricing-tier-suffix"
            data-editable="text"
            data-prop={row.suffixProp}
          >
            {row.suffix}
          </span>
        )}
      </p>
    ))}
    <Button
      class="pricing-tier-button"
      text={buttonText}
      link={buttonLink}
      variant={highlight ? "primary" : "tertiary"}
      data-outline={highlight ? undefined : ""}
      data-prop="buttonText"
    />
    {features?.length > 0 && (
      <ul
        class="pricing-tier-features"
        data-editable="array"
        data-prop="features"
      >
        {features?.map((feature: TierFeature) => (
          <li
            class:list={["pricing-tier-feature", feature.included === false && "excluded"]}
            data-editable="array-item"
          >
            <Icon
              name={feature.included === false ? "circle-minus" : "circle-check"}
              size="sm"
              color={feature.included === false ? "default" : "moss"}
            />
            <span
              data-editable="text"
              data-prop="text"
            >
              {feature.text}
            </span>
          </li>
        ))}
      </ul>
    )}
  </article>
</GridItem>

<style is:global>
  @layer page-sections {
    .pricing-tier {
      /* A shade off the band, whichever way the band goes. The design draws
         both: Sand cards on a light sand band on Partner Program, and light
         sand cards on a Sand band on Pricing. */
      background-color: var(--pricing-tier-bg, var(--color-bg-surface));
      border: var(--border-width-sm) solid var(--color-border);
      /* 18, the file's card radius, not the starter's 12. */
      border-radius: var(--radius-card);
      display: flex;
      flex-direction: column;
      height: 100%;
      padding: var(--spacing-xl);
      position: relative;

      /* A dark card states its own ink. The band's colour scheme stops at
         the band: the fill here is the card's, so the copy on it has to be
         the card's too. */
      &[data-theme="dark"] {
        --pricing-tier-ink: var(--light-sand);
        --pricing-tier-quiet: var(--gray-400, #9a9a9a);
        border-color: color-mix(in srgb, var(--light-sand) 12%, transparent);
        color: var(--pricing-tier-ink);
      }

      &[data-theme="dark"] .pricing-tier-name .heading-inner,
      &[data-theme="dark"] .pricing-tier-amount,
      &[data-theme="dark"] .pricing-tier-suffix {
        color: var(--pricing-tier-ink);
      }

      &[data-theme="dark"] .pricing-tier-description .simple-text-inner,
      &[data-theme="dark"] .pricing-tier-feature {
        color: var(--pricing-tier-quiet);
      }

      /* The add-on card: copy centred, and the category badge sitting on the
         card's top edge rather than inline beside the name. Driven by
         `badgeColor` being set, because a coloured badge is only ever the
         add-on shape — the plan cards' badge is the neutral pill inline. */
      &.align-center {
        text-align: center;
      }

      &.align-center .pricing-tier-description,
      &.align-center .pricing-tier-price {
        justify-content: center;
        text-align: center;
      }

      /* A floor under the gap the price's `auto` margin opens. On its own the
         auto only gives what is left over, so the card with the shortest copy
         had 93px above its figure and the one with the longest had none at
         all — the panel sat straight under the last line. */
      &.align-center .pricing-tier-description {
        margin-block-end: var(--spacing-xl);
      }

      /* The price sits in a panel of its own, a shade off the card. */
      &.align-center .pricing-tier-price {
        background-color: color-mix(in srgb, var(--light-sand) 8%, transparent);
        border-radius: var(--radius-card);
        display: flex;
        padding: var(--spacing-md) var(--spacing-lg);
      }

      &.highlight {
        /* Inset ring doubles the border to 2px without shifting layout
           against the sibling cards. Pacific rather than the neutral strong
           border: the design marks the recommended plan in the brand colour,
           and a near-black ring reads as a disabled card beside the others. */
        border-color: var(--pacific);
        box-shadow:
          inset 0 0 0 1px var(--pacific),
          var(--shadow-md);
      }

      .pricing-tier-name .heading-inner {
        margin: 0;
      }

      .pricing-tier-description .simple-text-content {
        color: var(--color-text-muted);
        margin-block: var(--spacing-xs) 0;
      }

      .pricing-tier-price {
        align-items: baseline;
        display: flex;
        gap: var(--spacing-xs);
        /* The base layer's paragraph margin, cleared: margins do not collapse
           in a flex column, so it stacked on the button's own and the gap
           under the figure came out double the one the design draws. */
        margin-block-end: 0;
        margin-top: var(--spacing-lg);

        &.pricing-tier-price-annual {
          display: none;
        }

        > .pricing-tier-amount {
          font-family: var(--font-headings);
          font-size: var(--font-size-heading-lg);
          font-variant-numeric: lining-nums;
          font-weight: var(--font-weight-bold);
          letter-spacing: -0.02em;
          line-height: var(--line-height-tight);
        }

        > .pricing-tier-suffix {
          color: var(--color-text-muted);
          font-size: var(--font-size-sm);
        }
      }

      .pricing-tier-features {
        border-top: var(--border-width-sm) solid var(--color-border);
        display: flex;
        flex-direction: column;
        gap: var(--spacing-sm);
        list-style: none;
        margin: var(--spacing-lg) 0 0;
        padding: var(--spacing-lg) 0 0;

        > .pricing-tier-feature {
          display: flex;
          font-size: var(--font-size-sm);
          gap: var(--spacing-sm);

          > .icon {
            flex-shrink: 0;
            margin-top: var(--spacing-xs);
          }

          &.excluded {
            color: var(--color-text-muted);
          }
        }
      }

      /* Under the price, above the rule, which is where the design draws it:
         the list is what runs to the card's foot. `price-bottom` puts the
         price last and the action after it, so there it does hang off the
         foot and the rule stays with the list. */
      /* The gap is a margin on the button rather than padding inside it, so
         it can differ by what it follows. Carried as padding it was the same
         24 either way, which lands differently: a figure leaves a band of
         descender space under it, so the button read far off the price,
         while a tier with no figure — Enterprise — had its button straight
         under the copy. The design draws about 15 under a price and 35 under
         a line of copy. */
      .pricing-tier-button {
        display: flex;
        margin-block-start: var(--spacing-xl);

        > .button-inner {
          flex: 1;
        }
      }

      .pricing-tier-price + .pricing-tier-button {
        margin-block-start: var(--spacing-md);
      }

      /* Pacific, not the neutral rule a tertiary draws: beside the filled
         action on the recommended card a grey outline reads as disabled. */
      .pricing-tier-button[data-outline] > .button-inner {
        border-color: var(--pacific);
        color: var(--pacific);
      }

      .pricing-tier-button[data-outline] > .button-inner:hover,
      .pricing-tier-button[data-outline] > .button-inner:focus-visible {
        background-color: color-mix(in srgb, var(--pacific) 8%, transparent);
        border-color: var(--pacific);
        color: var(--pacific);
      }

      /* The list is what reaches the foot now the action does not. */
      .pricing-tier-features {
        margin-block-end: auto;
      }

      /* The tick's colour is the Icon's own `color` prop, not a rule here:
         the paint lands on `.icon-inner`, so a rule on `.icon` sets a colour
         on a wrapper that draws nothing. */
    }

    :root:has([data-billing-switch]:checked) .pricing-tier:has(.pricing-tier-price-annual) .pricing-tier-price-monthly {
      display: none;
    }

    :root:has([data-billing-switch]:checked) .pricing-tier .pricing-tier-price-annual {
      display: flex;
    }
  }

  /* The design's own card: a set height, the figure at the foot after the list,
     and the row hanging from its baseline so four cards of rising height step
     up rather than sitting in a line.

     Flat, because rules nested deeper than a couple of levels get dropped (see
     CLAUDE.md). */
  @layer page-sections {
    .pricing-tier {
      min-block-size: var(--pricing-tier-height, auto);
    }

    .pricing-tier.price-bottom {
      display: flex;
      flex-direction: column;
    }

    .pricing-tier.price-bottom .pricing-tier-features {
      order: 1;
    }

    .pricing-tier.price-bottom .pricing-tier-price {
      margin-block-start: auto;
      order: 2;
    }

    .pricing-tier.price-bottom .pricing-tier-button {
      margin-block-start: 0;
      order: 3;
    }

    .pricing-tier.price-bottom .pricing-tier-features {
      margin-block-end: 0;
    }
  }

  /* The design's own pricing card, measured off 3806:72337. The shipped card
     is close but not it: the badge is a brand-filled pill hung off the top-left
     corner where the design sets a pale Harbour one inside the card level with
     the name, the name and figure come out larger and heavier, the lines are
     set tighter, and the ticks are bare checks rather than circled ones.

     Flat, because rules nested deeper than a couple of levels get dropped (see
     CLAUDE.md). */
  @layer page-sections {
    /* The sand rule, like every other card on these pages: the design draws
       #EBE1C9 where the generic border token is a neutral grey. */
    .pricing-tier {
      border-color: var(--dark-sand);
    }

    /* The name and its badge share a row. `flex-wrap` is the whole point: a
       name that will not fit beside the badge drops it to its own line, where
       the badge floating over the card had the name running underneath it. */
    /* The badge holds the card's top-right corner and the name wraps to the
       left of it. A float rather than a flex row: in a row the name is
       narrowed for every line, so "Standard for growing content teams" came
       out a word at a time down a column half the card wide. A float only
       shortens the lines beside it, so the name wraps under the badge and
       the rest of it runs the card's full measure. */
    .pricing-tier-head {
      display: block;
    }

    .pricing-tier-head > .pricing-tier-badge {
      float: inline-end;
      margin-inline-start: var(--spacing-sm);
      position: static;
    }

    /* Centred, the badge leaves the flow and straddles the card's top edge:
       beside a centred name it would sit off to one side of nothing.

       `inset-inline: 0` sets both edges; a `left: auto` after it leaves
       `right: 0` standing and the badge hugs the right. Both edges stay at 0
       and the margin does the centring. */
    .pricing-tier.align-center {
      overflow: visible;
    }

    .pricing-tier.align-center .pricing-tier-head > .pricing-tier-badge {
      float: none;
      inset-block-start: calc(-1 * var(--spacing-md));
      inset-inline: 0;
      margin-inline: auto;
      position: absolute;
      width: fit-content;
    }

    /* A pill on the card's top edge is the card's label rather than a note
       beside its name, and the design draws it at 18 in a 100 x 43 pill —
       the size the offer card's pill is. The inline one keeps its own size,
       which is already a step over what the design sets (see above). */
    .pricing-tier.align-center .pricing-tier-head > .pricing-tier-badge > .badge-inner {
      font-size: 1.125rem;
      padding: 0.5rem 1.625rem;
    }

    /* On .badge-inner, which is the element that is actually drawn: the
       background, the border and the radius all live there, so painting the
       wrapper left the shipped surface and its grey edge showing underneath
       (see CLAUDE.md on measuring the leaf). */
    /* The fill is whatever the card was given, defaulting to the design's
       own Recommended pill: harbour behind Pacific. A chosen colour is a
       strong one, so its label goes white. */
    .pricing-tier .pricing-tier-badge > .badge-inner {
      background-color: var(--pricing-tier-badge, var(--harbour));
      border-color: transparent;
      color: var(--pricing-tier-badge-ink, var(--pacific));
      /* 13, not the file's 10. The design's label is legible in Figma at
         100% and is not on a real screen — it came back as "at the top,
         small, can't read". The pill is still the design's: harbour behind
         Pacific, beside the name. */
      font-size: 0.8125rem;
      font-weight: var(--font-weight-semibold, 600);
      letter-spacing: 0;
      line-height: 1.3;
      padding-block: 0.375rem;
      padding-inline: 0.75rem;
      text-transform: none;
    }

    .pricing-tier .pricing-tier-name,
    .pricing-tier .pricing-tier-name .heading-inner {
      color: var(--black);
      font-size: 1.8125rem;
      font-weight: var(--font-weight-semibold, 600);
      line-height: 1.27;
    }

    .pricing-tier .pricing-tier-description .simple-text-content {
      color: var(--black);
      font-size: var(--font-size-lg);
      line-height: 1.37;
    }

    /* 34 of leading and nothing between the rows: the design steps these every
       34px exactly, and a gap on top of the line box pushed them to 39. */
    .pricing-tier .pricing-tier-features {
      gap: 0;
    }

    /* The tick sits on the middle of its line, not on the first baseline: the
       shipped card nudges it down with a top margin, which reads as hanging
       under the text on a line this tall. */
    /* The design's 34 on 14.5 is the distance between one feature and the
       next, not the leading inside one. Set as line-height it was fine while
       every feature fitted on a line and broke the moment one did not:
       Platinum's "Bronze, Silver, and Gold benefits" wraps, and its two
       halves sat 34px apart, reading as two separate items.

       So the leading is ordinary and the 34 is a gap. Baseline to baseline
       across single-line features is unchanged. */
    .pricing-tier .pricing-tier-features {
      display: flex;
      flex-direction: column;
      row-gap: 14px;
    }

    .pricing-tier .pricing-tier-feature {
      align-items: flex-start;
      color: var(--black);
      line-height: 1.38;
    }

    .pricing-tier .pricing-tier-feature .icon {
      block-size: 1.25rem;
      /* The design's own grey, which is not one of the text tokens: --color-text
         is #6B6157 and these are drawn #393939. */
      color: #393939;
      inline-size: 1.25rem;
      margin-block-start: 0;
    }

    /* Through .pricing-tier-price, or the shipped rule for the figure ties on
       specificity and wins on source order — it sets heading-lg, which is 46
       where the design draws 42. */
    .pricing-tier .pricing-tier-price > .pricing-tier-amount {
      color: var(--black);
      font-size: 2.625rem;
      font-weight: var(--font-weight-semibold, 600);
    }

    .pricing-tier .pricing-tier-price > .pricing-tier-suffix {
      color: var(--black);
      font-size: var(--font-size-lg);
    }

    /* A dark card's figure is the card's ink, not the design's black. These
       two rules go through `.pricing-tier-price` to beat the shipped size
       rule, which also puts them above the dark-card block higher up — so the
       add-on cards drew a near-black figure on a near-black panel. */
    .pricing-tier[data-theme="dark"] .pricing-tier-price > .pricing-tier-amount,
    .pricing-tier[data-theme="dark"] .pricing-tier-price > .pricing-tier-suffix {
      color: var(--white);
    }


  }
</style>
