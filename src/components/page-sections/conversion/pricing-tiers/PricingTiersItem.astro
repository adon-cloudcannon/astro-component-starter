---
import { isNonEmptyString } from "@component-utils/isNonEmptyString";
import Badge from "@core-elements/badge/Badge.astro";
import Button from "@core-elements/button/Button.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Icon from "@core-elements/icon/Icon.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import GridItem from "@wrappers/grid/GridItem.astro";

type TierFeature = { text?: string; included?: boolean };

const {
  name = "",
  headingLevel = "h3",
  price = "",
  priceSuffix = "",
  annualPrice = "",
  annualPriceSuffix = "",
  description = "",
  features = [],
  buttonText = "",
  buttonLink = "",
  highlight = false,
  badgeText = "",
  /**
   * Where the figure sits relative to what is included.
   *
   * The design puts it at the foot of the card, after the list, and the
   * shipped order is the other way round. Measured per section rather than
   * switched globally.
   */
  pricePosition = "top",
  /** The height the design draws this card at, in pixels. */
  height,
  showAnnualPricing = false,
  class: className,
  _component,
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  ...htmlAttributes
} = Astro.props;

const priceRows = [
  {
    interval: "monthly",
    amount: price,
    suffix: priceSuffix,
    amountProp: "price",
    suffixProp: "priceSuffix",
  },
  ...(showAnnualPricing && isNonEmptyString(annualPrice)
    ? [
        {
          interval: "annual",
          amount: annualPrice,
          suffix: annualPriceSuffix,
          amountProp: "annualPrice",
          suffixProp: "annualPriceSuffix",
        },
      ]
    : []),
];
---

<GridItem {...htmlAttributes}>
  <article
    class:list={["pricing-tier", highlight && "highlight", `price-${pricePosition}`, className]}
    style={height ? `--pricing-tier-height: ${Number(height)}px` : undefined}
  >
    {highlight && badgeText && (
      <Badge
        class="pricing-tier-badge"
        variant="brand"
        size="sm"
        text={badgeText}
        data-prop="badgeText"
      />
    )}
    <Heading
      class="pricing-tier-name"
      level={headingLevel}
      size="xs"
      data-prop="name"
    >
      {name}
    </Heading>
    <SimpleText
      class="pricing-tier-description"
      size="sm"
      data-prop="description"
      text={description}
    />
    {priceRows.filter((row) => isNonEmptyString(row.amount)).map((row) => (
      <p
        class:list={[
          "pricing-tier-price",
          showAnnualPricing && `pricing-tier-price-${row.interval}`,
        ]}
        aria-live={showAnnualPricing ? "polite" : undefined}
      >
        <span
          class="pricing-tier-amount"
          data-editable="text"
          data-prop={row.amountProp}
        >
          {row.amount}
        </span>
        {row.suffix && (
          <span
            class="pricing-tier-suffix"
            data-editable="text"
            data-prop={row.suffixProp}
          >
            {row.suffix}
          </span>
        )}
      </p>
    ))}
    {features?.length > 0 && (
      <ul
        class="pricing-tier-features"
        data-editable="array"
        data-prop="features"
      >
        {features?.map((feature: TierFeature) => (
          <li
            class:list={["pricing-tier-feature", feature.included === false && "excluded"]}
            data-editable="array-item"
          >
            <Icon
              name={feature.included === false ? "minus" : "check"}
              size="sm"
            />
            <span
              data-editable="text"
              data-prop="text"
            >
              {feature.text}
            </span>
          </li>
        ))}
      </ul>
    )}
    <Button
      class="pricing-tier-button"
      text={buttonText}
      link={buttonLink}
      variant={highlight ? "primary" : "tertiary"}
      data-prop="buttonText"
    />
  </article>
</GridItem>

<style is:global>
  @layer page-sections {
    .pricing-tier {
      background-color: var(--color-bg);
      border: var(--border-width-sm) solid var(--color-border);
      border-radius: var(--radius-md);
      display: flex;
      flex-direction: column;
      height: 100%;
      padding: var(--spacing-xl);
      position: relative;

      &.highlight {
        /* Inset ring doubles the border to 2px without shifting layout
           against the sibling cards. */
        border-color: var(--color-border-strong);
        box-shadow:
          inset 0 0 0 1px var(--color-border-strong),
          var(--shadow-md);
      }

      .pricing-tier-badge {
        left: var(--spacing-xl);
        position: absolute;
        top: calc(-1 * var(--spacing-md));
      }

      .pricing-tier-name .heading-inner {
        margin: 0;
      }

      .pricing-tier-description .simple-text-content {
        color: var(--color-text-muted);
        margin-block: var(--spacing-xs) 0;
      }

      .pricing-tier-price {
        align-items: baseline;
        display: flex;
        gap: var(--spacing-xs);
        margin-top: var(--spacing-lg);

        &.pricing-tier-price-annual {
          display: none;
        }

        > .pricing-tier-amount {
          font-family: var(--font-headings);
          font-size: var(--font-size-heading-lg);
          font-variant-numeric: lining-nums;
          font-weight: var(--font-weight-bold);
          letter-spacing: -0.02em;
          line-height: var(--line-height-tight);
        }

        > .pricing-tier-suffix {
          color: var(--color-text-muted);
          font-size: var(--font-size-sm);
        }
      }

      .pricing-tier-features {
        border-top: var(--border-width-sm) solid var(--color-border);
        display: flex;
        flex-direction: column;
        gap: var(--spacing-sm);
        list-style: none;
        margin: var(--spacing-lg) 0 0;
        padding: var(--spacing-lg) 0 0;

        > .pricing-tier-feature {
          display: flex;
          font-size: var(--font-size-sm);
          gap: var(--spacing-sm);

          > .icon {
            flex-shrink: 0;
            margin-top: var(--spacing-xs);
          }

          &.excluded {
            color: var(--color-text-muted);
          }
        }
      }

      .pricing-tier-button {
        display: flex;
        margin-top: auto;
        padding-top: var(--spacing-xl);

        > .button-inner {
          flex: 1;
        }
      }
    }

    .pricing-tiers:has(.pricing-tiers-billing .toggle-input:checked) {
      .pricing-tier:has(.pricing-tier-price-annual) .pricing-tier-price-monthly {
        display: none;
      }

      .pricing-tier .pricing-tier-price-annual {
        display: flex;
      }
    }
  }

  /* The design's own card: a set height, the figure at the foot after the list,
     and the row hanging from its baseline so four cards of rising height step
     up rather than sitting in a line.

     Flat, because rules nested deeper than a couple of levels get dropped (see
     CLAUDE.md). */
  @layer page-sections {
    .pricing-tier {
      min-block-size: var(--pricing-tier-height, auto);
    }

    .pricing-tier.price-bottom {
      display: flex;
      flex-direction: column;
    }

    .pricing-tier.price-bottom .pricing-tier-features {
      order: 1;
    }

    .pricing-tier.price-bottom .pricing-tier-price {
      margin-block-start: auto;
      order: 2;
    }

    .pricing-tier.price-bottom .pricing-tier-button {
      order: 3;
    }
  }
</style>
