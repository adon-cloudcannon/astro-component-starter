---
import Image from "@core-elements/image/Image.astro";
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Text from "@core-elements/text/Text.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";

const {
  /**
   * The small label above the heading. The design draws one on several of
   * these — "HOW IT WORKS" over "Here's the whole setup" — and with nowhere to
   * put it the mapping bound it to `sectionLabel`, which names the section in
   * the editor and renders nothing.
   */
  eyebrow = "",
  heading = "",
  headingLevel = "h2",
  headingSize = "xl",
  subtext = "",
  // The design sets a section's supporting line in one of two styles, Body 3
  // at 19 or Subtitle 1 at 22. `md` is the 16 every section rendered before
  // either was carried through, so nothing moves unless the design named it.
  subtextSize = "md",
  /**
   * The measure the design sets the supporting line in, in pixels.
   *
   * Not the column it sits in: a centred subtext is drawn at about 580 in the
   * 1040 column, and run the full width it reads as a different block.
   */
  subtextWidth,
  buttonSections = [],
  /**
   * A picture beneath the call to action, full width. The design uses this
   * shape in three places — "Own your content, always", "Your content is
   * yours", "Publishing took up to five weeks" — each a centred heading and
   * button over a wide illustration. Read as a split, they put the picture
   * beside the text and the heading on the left.
   */
  imageSource = "",
  imageAlt = "",
  /**
   * Drawings hung off the band's own bottom corners.
   *
   * `{ source, alt, width, drop }`, with `width` and `drop` as shares of the
   * band: how wide the drawing is, and how far it runs past the foot before
   * the band cuts it off. The design's closing CTA on Partner Program draws
   * ferns 300 wide out of the left corner, 52 past the foot, and rocks 231
   * wide out of the right, 4 past it.
   *
   * Both are shares rather than lengths because the band is full-bleed: on a
   * wider window the drawings grow with it, which is what keeps them in the
   * corners rather than stranded a few hundred pixels inside them.
   */
  cornerStart,
  cornerEnd,
  sectionLabel,
  maxContentWidth = "xl",
  paddingHorizontal = "gutter",
  paddingVertical = "4xl",
  /** Override one end of the vertical padding; empty follows paddingVertical. */
  paddingVerticalStart = "",
  paddingVerticalEnd = "",
  colorScheme = "inherit",
  lockColorScheme = false,
  backgroundColor = "base",
  background,
  haze = false,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;
---

<CustomSection
  class:list={["cta-center", className]}
  label={sectionLabel}
  maxContentWidth={maxContentWidth}
  paddingHorizontal={paddingHorizontal}
  paddingVertical={paddingVertical}
  paddingVerticalStart={paddingVerticalStart}
  paddingVerticalEnd={paddingVerticalEnd}
  colorScheme={colorScheme}
  lockColorScheme={lockColorScheme}
  backgroundColor={backgroundColor}
  background={background}
  haze={haze}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>

  {(cornerStart?.source || cornerEnd?.source) && (
    <Fragment slot="band">
      {cornerStart?.source && (
        <Image
          class="cta-center-corner is-start"
          source={cornerStart.source}
          alt={cornerStart.alt}
          decorative={!cornerStart.alt}
          style={`--corner-width: ${Number(cornerStart.width) || 20}%; --corner-drop: ${Number(cornerStart.drop) || 0}%`}
        />
      )}
      {cornerEnd?.source && (
        <Image
          class="cta-center-corner is-end"
          source={cornerEnd.source}
          alt={cornerEnd.alt}
          decorative={!cornerEnd.alt}
          style={`--corner-width: ${Number(cornerEnd.width) || 20}%; --corner-drop: ${Number(cornerEnd.drop) || 0}%`}
        />
      )}
    </Fragment>
  )}
  <SimpleText
    class="eyebrow"
    size="sm"
    alignmentHorizontal="center"
    data-prop="eyebrow"
    text={eyebrow}
  />
  <Heading
    level={headingLevel}
    size={headingSize}
    alignmentHorizontal="center"
    data-prop="heading"
    text={heading}
  />
  <Text
    class="subtext"
    style={subtextWidth ? `max-inline-size: ${Number(subtextWidth)}px; margin-inline: auto; justify-self: center` : undefined}    size={subtextSize}
    alignmentHorizontal="center"
    data-prop="subtext"
    text={subtext}
  />
  <ButtonGroup
    buttonSections={buttonSections}
    alignmentHorizontal="center"
    data-children-prop="buttonSections"
  />
  {imageSource && (
    <Image
      class="cta-center-image"
      source={imageSource}
      alt={imageAlt}
      rounded={true}
      sizes="100vw"
      widths={[640, 1280, 1920]}
      width={1280}
      data-prop-src="imageSource"
      data-prop-alt="imageAlt"
    />
  )}
</CustomSection>

<style is:global>
  @layer page-sections {
    /* Full width of the column, under the copy. */
    .cta-center .cta-center-image {
      inline-size: 100%;
      margin-block-start: var(--spacing-2xl);
    }

    .cta-center .cta-center-image img {
      block-size: auto;
      inline-size: 100%;
    }
  }
</style>

<style is:global>
  @layer page-sections {
    /* The heading takes the whole column and the line under it is held to the
       design's measure, rather than both sharing one width. Flat, because a
       rule nested deeper than this gets dropped (see CLAUDE.md). */
    .cta-center .subtext {
      margin-inline: auto;
      max-inline-size: var(--content-width-measure);
    }

    /* Clip, not hidden: hidden makes a scroll container and kills sticky
       descendants, which is CustomSection's own note about this element. */
    .cta-center:has(.cta-center-corner) > .outer-content {
      overflow: clip;
    }

    /* Hung off the band's corners and cut off by its foot.
 
       `inset-block-end` would take its percentage from the band's height,
       which is the wrong measure: the drawings are sized against its width, so
       the overhang has to be too. A percentage margin on an absolutely
       positioned box resolves against the containing block's inline size,
       which is the one number both of them can share. */
    .cta-center .cta-center-corner {
      block-size: auto;
      inline-size: var(--corner-width, 20%);
      inset-block-end: 0;
      margin-block-end: calc(-1 * var(--corner-drop, 0%));
      position: absolute;
      /* `.content` carries `--layer-1`, so it stays over these without
         anything here having to be told about it. */
      z-index: 0;
    }

    .cta-center .cta-center-corner.is-start {
      inset-inline-start: 0;
    }

    .cta-center .cta-center-corner.is-end {
      inset-inline-end: 0;
    }

    /* Image puts an `.image-inner` inside that takes the full width, so the
       size has to land on it and on the picture too. */
    .cta-center .cta-center-corner .image-inner,
    .cta-center .cta-center-corner img {
      block-size: auto;
      inline-size: 100%;
    }
  }
</style>
