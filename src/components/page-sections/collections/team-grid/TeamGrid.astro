---
import { bandPattern, bandHaze } from "@component-utils/bandStyle.mjs";
import { nestedProps } from "@component-utils/nestedProps.mjs";
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Text from "@core-elements/text/Text.astro";
import TeamItem from "@page-sections/collections/team-grid/TeamItem.astro";
import CardGrid from "@wrappers/card-grid/CardGrid.astro";
import { nextHeadingLevel } from "@component-utils/headingLevel";

type MemberProps = Record<string, unknown>;

/* `content` and `style` are the editor's tabs, flattened straight back into
   the names below. `at()` writes the frontmatter path a binding needs. */
const { props, at } = nestedProps(Astro.props);

const {
  eyebrow = "",
  heading = "",
  headingLevel = "h2",
  subtext = "",
  teamMembers = [],
  sectionLabel,
  maxContentWidth = "xl",
  paddingHorizontal = "gutter",
  paddingVertical = "4xl",
  colorScheme = "inherit",
  lockColorScheme = false,
  backgroundColor = "light-sand",
  /** The texture behind the band, by name. */
  pattern = "none",
  /** Whether the heading sits on a pool of the band’s own colour. */
  haze = false,
  useDefaultEditableBinding = false,
  _component,
  class: className,
  ...htmlAttributes
} = props;

const itemHeadingLevel = nextHeadingLevel(headingLevel);
---

<CustomSection
  class:list={["team-grid", className]}
  label={sectionLabel}
  maxContentWidth={maxContentWidth}
  paddingHorizontal={paddingHorizontal}
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  lockColorScheme={lockColorScheme}
  backgroundColor={backgroundColor}
  background={bandPattern(pattern)}
  haze={bandHaze(haze)}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  <SimpleText
    alignmentHorizontal="center"
    class="eyebrow"
    data-prop={at("eyebrow")}
    text={eyebrow}
    size="sm"
  />
  <Heading
    class="team-grid-heading"
    level={headingLevel}
    size="lg"
    alignmentHorizontal="center"
    data-prop={at("heading")}
  >
    {heading}
  </Heading>
  <Text
    class="section-subtext"
    alignmentHorizontal="center"
    data-prop={at("subtext")}
    text={subtext}
  />
  <CardGrid
    columns={3}
    gap="md"
    aspectRatio="square"
    data-children-prop={at("teamMembers")}
  >
    {teamMembers?.map((member: MemberProps) => (
      <TeamItem
        data-id="page-sections/collections/team-grid/team-item"
        data-component="page-sections/collections/team-grid/team-item"
        data-editable="array-item"
        {...member}
        headingLevel={itemHeadingLevel}
        class="team-grid-item"
      />
    ))}
  </CardGrid>
</CustomSection>

<style is:global>
  @layer page-sections {
    .team-grid-heading {
      margin-bottom: var(--spacing-sm);
    }
  }
</style>
