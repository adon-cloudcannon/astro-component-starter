---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Text from "@core-elements/text/Text.astro";
import CardGrid from "@wrappers/card-grid/CardGrid.astro";

const {
  eyebrow = "",
  heading = "",
  headingLevel = "h2",
  headingSize = "lg",
  subtext = "",
  items = [],
  /**
   * A name a `collection-toolbar` can find this grid by.
   *
   * The toolbar and the grid it filters are two sections, so the tie between
   * them is a name rather than a wrapper. Empty leaves the grid unfindable,
   * which is right for a grid nothing filters.
   */
  collection = "",
  layout = "grid",
  columns = 3,
  gap = "lg",
  aspectRatio = "landscape",
  sectionLabel,
  maxContentWidth = "xl",
  paddingHorizontal = "gutter",
  paddingVertical = "4xl",
  colorScheme = "inherit",
  lockColorScheme = false,
  backgroundColor = "light-sand",
  background,
  haze = false,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;
---

<CustomSection
  class:list={["card-collection", className]}
  label={sectionLabel}
  maxContentWidth={maxContentWidth}
  paddingHorizontal={paddingHorizontal}
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  lockColorScheme={lockColorScheme}
  backgroundColor={backgroundColor}
  background={background}
  haze={haze}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  <SimpleText
    alignmentHorizontal="center"
    class="eyebrow"
    data-prop="eyebrow"
    text={eyebrow}
    size="sm"
  />
  <Heading
    level={headingLevel}
    size={headingSize}
    alignmentHorizontal="center"
    data-prop="heading"
  >
    {heading}
  </Heading>
  <Text
    class="section-subtext card-collection-subtext"
    alignmentHorizontal="center"
    data-prop="subtext"
    text={subtext}
  />

  <CardGrid
    class="card-collection-grid"
    data-collection={collection || undefined}
    items={items}
    layout={layout}
    columns={columns}
    gap={gap}
    aspectRatio={aspectRatio}
    data-children-prop="items"
  />
</CustomSection>
