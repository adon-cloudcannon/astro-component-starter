---
import { rootMirror } from "@component-utils/rootMirror.mjs";
/**
 * One cell of TestimonialBento.
 *
 * Rebuilt to the design's own card: the quote, a rule, and then the person
 * and the link sharing one row. It renders the quote itself rather than
 * wrapping the Testimonial element, because the card's parts are interleaved
 * with it now: the rule sits between the quote and the attribution, and the
 * link sits beside the attribution rather than under the whole thing.
 *
 * Measured off `downloaded-nodes/Testimonial Bento.html`: the quote 24 at
 * weight 500, the name 20, the role and company 13, the link 15. The last two
 * are one value here, 13, which is the only place this departs from the
 * export and is explained on `--testimonial-bento-meta` below.
 */
import Button from "@core-elements/button/Button.astro";
import Image from "@core-elements/image/Image.astro";
import { renderMarkdown } from "@component-utils/markdown";

const {
  text = "",
  authorName = "",
  /** The person's role. The company is its own prop so it can be emphasised. */
  authorDescription = "",
  authorImage = "",
  authorImageAlt = "",
  size = "standard",
  /**
   * The quote's size. `large` is 28 against the standard 24.
   *
   * The design does set two: the export draws the top pair at 24 and the
   * bottom pair at 32. 28 is this project's step, close enough to read as the
   * emphasis the design means without the jump a third again makes in a face
   * that is wider than the export's.
   */
  quoteSize = "standard",
  /**
   * `base` is the design's near-black card. `light` is the lighter option,
   * and it moves the accent's shade with it: Harbour and Golden are tuned to
   * glow on near-black and are close to invisible on a pale card, so the two
   * travel together rather than being separately settable.
   */
  tone = "base",
  /** Shown after the role, in the card's brighter ink. */
  company = "",
  linkText = "",
  link = "",
  /**
   * Wraps the quote in the card's own colour. Off for a card whose quote is a
   * figure rather than something somebody said, which is how the design draws
   * the 400% one.
   */
  quoteMarks = true,
  /**
   * Makes the whole card the link.
   *
   * Off by default, and that is a decision rather than a default: a card-wide
   * link swallows text selection, so the quote cannot be copied, which is the
   * one thing people do with a testimonial. On, it is drawn as an overlay on
   * the link that is already there, so the accessibility tree still has one
   * link and the text stays selectable.
   */
  cardLink = false,
  /**
   * The card's own colour, as a palette name. It does three jobs the design
   * ties together: the emphasised words in the quote take it, the quote marks
   * are drawn in it, and the card's border and link take it on hover.
   */
  accentColor = "",
  class: className,
  _component,
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  ...htmlAttributes
} = Astro.props;

const quote = text ? renderMarkdown(text) : "";
/* These five have to resolve on the card itself: the theme tokens, the tone's
   surface, the quote's size and the whole-card link all key off the root. The
   card is placed as an array item, so that root is a region root the editor
   never rewrites — the mirror is what carries them back. */
const mirror = rootMirror({
  "data-card-link": cardLink && link ? "" : null,
  "data-size": size,
  "data-quote-size": quoteSize === "large" ? "large" : null,
  "data-tone": tone,
  "data-theme": tone === "light" ? "light" : "dark",
});
---

<div
  class:list={["testimonial-bento-item", className]}
  data-card-link={cardLink && link ? "" : undefined}
  data-size={size}
  data-quote-size={quoteSize === "large" ? "large" : undefined}
  data-tone={tone}
  data-theme={tone === "light" ? "light" : "dark"}
  {...htmlAttributes}
>
  {/* The marks are drawn in CSS rather than written here. The quote renders
      as paragraphs, so a mark put beside them as an element is a block of its
      own and lands on a line by itself above and below the text. As generated
      content it sits inside the first and last line, which is where the design
      draws it, and it stays out of the accessibility tree without needing to
      be hidden. */}
  <blockquote
    {...mirror}
    class="testimonial-bento-quote"
    data-marks={quoteMarks ? "" : undefined}
    data-prop="text"
    set:html={quote}
  />

  {/* The accent rides here and is lifted back to the card in CSS.

      It was an inline style on the card itself, which is this component's
      root, and a prop-driven style there goes stale in the Visual Editor:
      CloudCannon keeps a region's root and swaps only its contents, so
      changing a card's accent repainted nothing. The card's own hover border
      and focus outline read the property, so it cannot simply move down; the
      foot carries the name instead and `:has()` lifts it, which is the same
      trick `_flow.css` plays with `data-space-before`.

      One rule per colour, which is the price of a lift: a selector can test
      for a descendant but cannot read a value off one. The list is the same
      one the component's YAML offers. */}
  <div class="testimonial-bento-foot" data-accent={accentColor || undefined}>
    <div class="testimonial-bento-who">
      {/* Drawn whether or not there is a picture for it. The circle is part
          of the card's composition: without it the attribution starts hard
          against the card's edge and the row reads differently from every
          other card that does have one. Empty, it is a plain disc rather than
          a broken image. */}
      <span class="testimonial-bento-avatar">
        {authorImage && (
          <Image
            source={authorImage}
            alt={authorImageAlt}
            decorative={!authorImageAlt}
            data-prop-src="authorImage"
            data-prop-alt="authorImageAlt"
          />
        )}
      </span>
      <div class="testimonial-bento-attribution">
        {authorName && (
          <p class="testimonial-bento-name" data-prop="authorName">{authorName}</p>
        )}
        {(authorDescription || company) && (
          <p class="testimonial-bento-role">
            <span data-prop="authorDescription">{authorDescription}</span>
            {company && (
              <>
                {authorDescription && " "}
                <span class="testimonial-bento-company" data-prop="company">{company}</span>
              </>
            )}
          </p>
        )}
      </div>
    </div>

    {/* The Button, like every other arrow link on the site. Its own
        `.label-text` span takes the underline, since text-decoration
        propagates down and a child cannot take it off: ruled on the whole
        link the line ran under the arrow. The hidden words after the label
        name the destination, because "Read case study" on four cards says the
        same thing four times. */}
    {linkText && (
      <Button
        class="testimonial-bento-link"
        variant="text"
        size="sm"
        iconName="move-right"
        iconPosition="after"
        link={link || undefined}
        data-prop="linkText"
      >
        {linkText}
        {company && <span class="visually-hidden"> about {company}</span>}
      </Button>
    )}
  </div>
</div>

<style is:global>
  /* Flat, because rules nested deeper get dropped (see CLAUDE.md). */
  @layer page-sections {
    .testimonial-bento-item {
      /**
       * One scale for the card, three steps rather than four.
       *
       * The export sets the role and company at 13 and the link at 15, which
       * is two sizes doing one job. They share 13 here and the link is marked
       * by its weight, its underline and its arrow instead: a secondary action
       * inside a card does not need to be the second largest thing in it.
       */
      /* 24, which is the export's own size. It read small for a while against
         the 20px name, but that was a rule landing on the blockquote while the
         paragraph inside it kept the base 16; at the weight below it carries
         the card. */
      --testimonial-bento-quote: 1.5rem;
      /* 18, two off the export's 20. The name is the second thing in the card
         and at 20 it sat close enough to the 24 quote to compete with it. */
      --testimonial-bento-name: 1.125rem;
      --testimonial-bento-meta: 0.8125rem;

      /* #1B1A18 with a #D9D9D9 rule at 8%, which is what the design draws:
         the card is barely lighter than the band, so it is the rule that
         makes it a card rather than the fill. */
      --testimonial-bento-surface: var(--black);
      --testimonial-bento-edge: color-mix(in srgb, var(--gray-200, #d9d9d9) 8%, transparent);
      --testimonial-bento-ink: var(--color-text-strong);
      --testimonial-bento-quiet: var(--gray-400, #9a9a9a);

      background: var(--testimonial-bento-surface);
      border: var(--border-width-sm) solid var(--testimonial-bento-edge);
      border-radius: var(--radius-card);
      display: flex;
      flex-direction: column;
      /* The foot sits at the bottom however short the quote is, so a row of
         cards keeps its rules on one line. */
      justify-content: space-between;
      /* Less below than above. The quote is the subject and the attribution
         is a footnote to it, so the weight of the padding sits with the
         quote: 40 over it and 28 under the person. */
      padding: 40px 40px 28px;
      position: relative;
      transition: border-color var(--animation-normal) var(--ease-in-out);
    }

    /* The lighter card. The accent moves with the surface rather than being
       separately settable: Harbour and Golden are tuned to glow on near-black
       and are close to invisible on a pale card, so a card that let any accent
       sit on any ground could be set to something unreadable. */
    .testimonial-bento-item[data-tone="light"] {
      --testimonial-bento-surface: var(--light-sand);
      --testimonial-bento-edge: color-mix(in srgb, var(--midnight) 12%, transparent);
      --testimonial-bento-ink: var(--midnight);
      --testimonial-bento-quiet: var(--gray-700, #5c5c5c);
      /* Two steps down the ramp, which is where these colours hold their hue
         against a pale ground. */
      --testimonial-bento-accent-shade: 700;
    }

    /* 28, the card marked as the louder one. */
    .testimonial-bento-item[data-quote-size="large"] {
      --testimonial-bento-quote: 1.75rem;
    }

    /* Lifted from the foot. See the note on the element itself. */
    .testimonial-bento-item:has(> .testimonial-bento-foot[data-accent="sunset"]) {
      --testimonial-bento-accent: var(--sunset);
    }

    .testimonial-bento-item:has(> .testimonial-bento-foot[data-accent="golden"]) {
      --testimonial-bento-accent: var(--golden);
    }

    .testimonial-bento-item:has(> .testimonial-bento-foot[data-accent="pacific"]) {
      --testimonial-bento-accent: var(--pacific);
    }

    .testimonial-bento-item:has(> .testimonial-bento-foot[data-accent="moss"]) {
      --testimonial-bento-accent: var(--moss);
    }

    .testimonial-bento-item:has(> .testimonial-bento-foot[data-accent="peachy"]) {
      --testimonial-bento-accent: var(--peachy);
    }

    .testimonial-bento-item:has(> .testimonial-bento-foot[data-accent="harbour"]) {
      --testimonial-bento-accent: var(--harbour);
    }

    .testimonial-bento-item:hover {
      border-color: var(--testimonial-bento-accent, var(--testimonial-bento-edge));
    }

    .testimonial-bento-quote {
      /* The base layer gives every blockquote a rule down its left and padding
         to clear it, which is right for a quote in running text and wrong for
         one that is the whole card. */
      border-left: 0;
      padding-left: 0;
      color: var(--testimonial-bento-ink);
      margin: 0;
    }

    /* The type goes on the paragraph, not only on the blockquote.

       The quote is markdown, so what carries the words is a <p> inside, and
       the base layer sets a size on every <p>. Set on the blockquote alone the
       size measured as applied and drew at 16 regardless, which reads as the
       quote being too small next to the 20px name rather than as a rule
       landing on the wrong element. */
    .testimonial-bento-quote,
    .testimonial-bento-quote p {
      font-size: var(--testimonial-bento-quote);
      font-weight: 700;
      line-height: 1.3;
    }

    .testimonial-bento-quote p {
      margin: 0;
    }

    .testimonial-bento-quote p + p {
      margin-block-start: 0.6em;
    }

    /* The emphasis and the marks are the same colour, which is what ties the
       card together: the design marks a phrase in the card's own colour and
       draws the quotes around the whole thing in it too. */
    .testimonial-bento-quote strong {
      color: var(--testimonial-bento-accent, inherit);
      font-weight: inherit;
    }

    .testimonial-bento-quote[data-marks] > p:first-child::before {
      color: var(--testimonial-bento-accent, inherit);
      content: open-quote;
    }

    .testimonial-bento-quote[data-marks] > p:last-child::after {
      color: var(--testimonial-bento-accent, inherit);
      content: close-quote;
    }

    /* `open-quote` needs the element to be a quotes context, and a blockquote
       is, but the depth resets per element: without this the paragraphs inside
       would each open their own. */
    .testimonial-bento-quote[data-marks] {
      quotes: "\201C" "\201D";
    }

    /* The rule, and the row under it. 28 above the rule and 20 below, which is
       the export's own spacing. */
    /* One row: the person at the start of it, the link at the end.

       What moved the link around before was `flex-wrap`. The link cannot
       shrink, so on a card whose role ran long the row broke and the link
       dropped to a second line, where `space-between` then put it on the
       left: its place changed card to card with the length of a job title.
       Without the wrap the role gives up the width instead and runs to a
       second line of its own, which is what the design draws too — the
       export's foot is 65 tall on a two-line role with the link still in the
       row beside it. */
    .testimonial-bento-foot {
      align-items: end;
      border-block-start: var(--border-width-sm) solid var(--testimonial-bento-edge);
      display: flex;
      flex-wrap: nowrap;
      /* Wide, because the two sides of this row are a sentence and a button:
         at the body gap the role ran straight into the link. */
      gap: var(--spacing-xl);
      justify-content: space-between;
      margin-block-start: 28px;
      padding-block-start: 20px;
    }

    .testimonial-bento-who {
      align-items: center;
      display: flex;
      /* Takes the row's spare width and gives it back first, so the role
         wraps where it has to rather than pushing the link out of the row. */
      flex: 1 1 auto;
      gap: var(--spacing-md);
      min-inline-size: 0;
    }

    /* A flex item will not shrink below its content without this, so the role
       would otherwise set the width of the row. */
    /* The name and the byline sit in a measure, not in whatever the foot has
       left over.

       Unbounded, "Vice President Operations, Gabriel Maggio Construction" ran
       339 across before it broke, which reads as a line of copy rather than
       as a byline — and it broke late, leaving one word on the second line.
       15rem makes it break nearer the middle.

       Sized off the design, which draws these bylines at 356 on one line,
       217 over two and 141 over two: 240 is inside the widest of the wrapped
       ones, so the long bylines take two lines and a short one like "CEO, DX"
       still takes one. */
    .testimonial-bento-attribution {
      max-inline-size: 15rem;
      min-inline-size: 0;
    }

    .testimonial-bento-avatar {
      /* The card's own edge colour, a shade up from the surface, so an empty
         one reads as a place for a face rather than as a hole. */
      background: color-mix(in srgb, var(--testimonial-bento-ink) 10%, transparent);
      block-size: 56px;
      border-radius: 50%;
      display: block;
      flex-shrink: 0;
      inline-size: 56px;
      overflow: hidden;
    }

    .testimonial-bento-avatar img {
      block-size: 100%;
      display: block;
      inline-size: 100%;
      object-fit: cover;
    }

    .testimonial-bento-name {
      color: var(--testimonial-bento-ink);
      font-size: var(--testimonial-bento-name);
      font-weight: 500;
      line-height: 1.2;
      margin: 0;
    }

    /* Mono, which is what the design sets on the role: it reads as a label
       rather than as more of the quote. */
    .testimonial-bento-role {
      color: var(--testimonial-bento-quiet);
      font-family: var(--font-monospace, ui-monospace, monospace);
      font-size: var(--testimonial-bento-meta);
      line-height: 1.4;
      margin: 0.25rem 0 0;
    }

    /* The company is the emphasis on that line, and it is a brightness rather
       than a weight or a size: in mono at 13 a bolder cut reads as noise. */
    .testimonial-bento-company {
      color: var(--testimonial-bento-ink);
    }

    .testimonial-bento-link {
      /* Level with the last line of the role beside it. */
      align-self: end;
      flex-shrink: 0;
    }

    /* The card's own colour and size over the Button's. This file is in
       `page-sections`, which out-ranks `components`, so these win without
       having to out-specify anything. */
    .testimonial-bento-link .button-inner {
      color: var(--testimonial-bento-quiet);
      font-size: var(--testimonial-bento-meta);
      padding-block: 0;
      transition: color var(--animation-normal) var(--ease-in-out);
    }

    /* Only the words are ruled. The arrow is a glyph doing the same job as
       the underline, and run through by it as well it reads as struck out. */
    .testimonial-bento-link .label-text {
      text-decoration: underline;
      text-underline-offset: 0.35em;
    }

    /* The card's hover carries the link with it.

       The border and the link are the same gesture, so lighting only the rule
       left the link grey until the pointer reached it, and from a step back
       that reads as the link not having a hover at all. */
    .testimonial-bento-item:hover .testimonial-bento-link .button-inner,
    .testimonial-bento-link:hover .button-inner,
    .testimonial-bento-link:focus-visible .button-inner,
    .testimonial-bento-item:hover .testimonial-bento-link .icon,
    .testimonial-bento-link:hover .icon {
      color: var(--testimonial-bento-accent, var(--testimonial-bento-ink));
    }

    /* The whole card as the target, when the option is on.
    
       An overlay on the link that is already there rather than a wrapper
       around the card: wrapping puts the quote inside an anchor, which stops
       it being selectable and makes a screen reader read the entire card as
       one link's name. This way there is still one link, it still says what it
       goes to, and the text can still be copied. */
    .testimonial-bento-item[data-card-link] .testimonial-bento-link::after {
      content: "";
      inset: 0;
      position: absolute;
    }

    /* The card marks itself when the link inside it is the thing being
       reached, since the link's own underline is easy to miss at this size. */
    .testimonial-bento-item[data-card-link]:has(.testimonial-bento-link:focus-visible) {
      border-color: var(--testimonial-bento-accent, var(--testimonial-bento-ink));
      outline: var(--border-width-sm) solid var(--testimonial-bento-accent, currentColor);
      outline-offset: 2px;
    }

    /* Narrow: the link takes its own line and stays at the end of it.
    
       It was going to the start, under the person, which reads as a second
       line of the attribution rather than as the card's action. The space
       above it does the separating instead, since there is no rule here. */
    @media (max-width: 47.5rem) {
      .testimonial-bento-item {
        padding: 28px 24px 24px;
      }

    }
  }
</style>
