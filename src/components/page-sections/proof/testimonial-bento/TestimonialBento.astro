---
import { bandPattern, bandHaze } from "@component-utils/bandStyle.mjs";
import { nestedProps } from "@component-utils/nestedProps.mjs";
import CustomSection from "@builders/custom-section/CustomSection.astro";
import { subtextMeasure } from "@component-utils/subtextMeasure.mjs";
import Heading from "@core-elements/heading/Heading.astro";
import Text from "@core-elements/text/Text.astro";
import TestimonialBentoItem from "./TestimonialBentoItem.astro";

type TestimonialProps = Record<string, unknown>;

/* `content` and `style` are the editor's tabs, flattened straight back into
   the names below. `at()` writes the frontmatter path a binding needs. */
const { props, at } = nestedProps(Astro.props, {
  nest: {
    heading: ["eyebrow", "heading", "headingLevel", "headingSize"],
    subtext: ["subtext", "subtextSize", "subtextWidth"],
  },
});

const {
  eyebrow = "",
  heading = "",
  headingLevel = "h2",
  headingSize = "lg",
  subtext = "",
  // Body 3 at 19 or Subtitle 1 at 22 in the design; `md` keeps the 16 every
  // section rendered before either was carried through.
  subtextSize = "md",
  /**
   * The measure the design sets the supporting line in, in pixels.
   *
   * Not the column it sits in: a centred subtext is drawn at about 580 in the
   * 1040 column, and run the full width it reads as a different block.
   */
  subtextWidth,
  testimonials = [],
  columns = "3",
  /**
   * The design's own two-up bento: a wide card beside a narrow one, then the
   * two the other way round on the next row.
   *
   * Measured off `downloaded-nodes/Testimonial Bento.html`, which draws the
   * four cards at 709.8, 450.2, 450.2 and 709.8 in an 1180 row. Only an
   * option at two columns; three and four across are drawn even.
   */
  stagger = false,
  sectionLabel,
  maxContentWidth = "xl",
  paddingHorizontal = "gutter",
  paddingVertical = "4xl",
  colorScheme = "inherit",
  lockColorScheme = false,
  backgroundColor = "light-sand",
  /** The texture behind the band, by name. */
  pattern = "none",
  /** Which edge the texture fades out towards. */
  fade = "none",
  /** Whether the heading sits on a pool of the band’s own colour. */
  haze = false,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = props;

/* The measure the subtext is set in, as a length. */
const subtextCap = subtextMeasure(subtextWidth);

// The design's developer-page bento is two across, two down, so two is a real
// option rather than something that falls back to three.
const columnCount = ["2", "4"].includes(String(columns)) ? String(columns) : "3";
---

<CustomSection
  class:list={["testimonial-bento", className]}
  label={sectionLabel}
  maxContentWidth={maxContentWidth}
  paddingHorizontal={paddingHorizontal}
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  lockColorScheme={lockColorScheme}
  backgroundColor={backgroundColor}
  background={bandPattern(pattern, fade)}
  haze={bandHaze(haze)}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  <Heading
    eyebrow={eyebrow}
    data-eyebrow-prop={at("eyebrow")}
    level={headingLevel}
    size={headingSize}
    alignmentHorizontal="center"
    data-prop={at("heading")}
  >
    {heading}
  </Heading>
  <Text
    class="section-subtext testimonial-bento-subtext"
    alignmentHorizontal="center"
    data-prop={at("subtext")}
    style={
      subtextCap
        ? `max-inline-size: ${subtextCap}; margin-inline: auto; justify-self: center`
        : undefined
    }
    size={subtextSize}
    text={subtext}
  />

  {testimonials?.length > 0 && (
    <div class="testimonial-bento-frame">
      <div
        class="testimonial-bento-grid"
        data-columns={columnCount}
        data-stagger={stagger && columnCount === "2" ? "" : undefined}
        data-editable="array"
        data-prop={at("testimonials")}
        data-direction="row"
      >
        {testimonials.map((testimonial: TestimonialProps) => (
          /* `data-component` is what makes a card redraw when its own fields
             change. An array item on its own gets the CRUD controls and
             nothing else: the editor updates the primitives inside it, the
             quote and the names, because each of those binds its own region,
             and leaves everything else as the page was built. So changing a
             card's accent or its tone saved the value and changed nothing
             until a reload. Naming the component here gives the editor a
             renderer to redraw the row with. */
          <TestimonialBentoItem
            data-editable="array-item"
            data-component="page-sections/proof/testimonial-bento/testimonial-bento-item"
            data-id="page-sections/proof/testimonial-bento/testimonial-bento-item"
            {...testimonial}
          />
        ))}
      </div>
    </div>
  )}
</CustomSection>

<style is:global>
  @layer page-sections {
    .testimonial-bento {
      .testimonial-bento-frame {
        --space-before: var(--space-before-loose);

        container-type: inline-size;
      }

      /* The cards sit in the file's other column, 1180, and the copy above
         them stays in 1040. The export is 1180 wide exactly.

         Only the row breaks out, by half the difference, which is the pattern
         the pricing tiers use. `inline-size: auto` as well, because the frame
         is sized against the 1040 column and negative margins alone slide it
         left rather than widening it. Guarded on there being room for it:
         1180 and both gutters. */
      @media (width >= 1236px) {
        .testimonial-bento-frame {
          inline-size: auto;
          margin-inline: calc((var(--content-width-xl) - var(--content-width-wide)) / 2);
        }
      }

      .testimonial-bento-grid {
        display: grid;
        gap: var(--spacing-md);
        grid-auto-flow: dense;
        grid-template-columns: repeat(3, minmax(0, 1fr));

        &[data-columns="2"] {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        /* Staggered, the row is a flex line rather than a grid.

           Grid sizes a track once for every row in it, so the pattern the
           design draws — wide beside narrow, then narrow beside wide — cannot
           be a two-column template however the items are placed. Flex sizes
           each item, which is also how the file itself writes it: the export
           carries four cards at 709.8, 450.2, 450.2 and 709.8 of an 1180 row.

           The shares are of the space left after the gap, so the pair adds up
           to the row whatever the container is. */
        &[data-columns="2"][data-stagger] {
          /* 55/45, not the design's 61/39.

             The file draws 709.8 against 450.2 of an 1180 row, which is a
             third again. That much difference reads as one card having been
             widened rather than as a pair, and it squeezes the narrow card's
             attribution to three lines. Nearer even keeps the stagger
             legible. This is a decision, not a gap in the reading. */
          --testimonial-bento-wide: 0.55;
          --testimonial-bento-narrow: 0.45;
          /* 1180 less 709.8 and 450.2. */
          --testimonial-bento-gap: 20px;

          display: flex;
          flex-wrap: wrap;
          gap: var(--testimonial-bento-gap);
        }

        &[data-columns="2"][data-stagger] > * {
          flex: 0 1 calc((100% - var(--testimonial-bento-gap)) * var(--testimonial-bento-wide));
        }

        /* Second of one row and first of the next, which is what turns the
           pair over. */
        &[data-columns="2"][data-stagger] > :nth-child(4n + 2),
        &[data-columns="2"][data-stagger] > :nth-child(4n + 3) {
          flex: 0 1 calc((100% - var(--testimonial-bento-gap)) * var(--testimonial-bento-narrow));
        }

        &[data-columns="4"] {
          grid-template-columns: repeat(4, minmax(0, 1fr));
        }

        /* Container widths, not viewport breakpoints: a bento in a narrow
           column on a wide screen must still collapse. Each step is where a
           standard cell drops below ~240px, too narrow for a quote and byline. */
        @container (width <= 1000px) {
          &[data-columns="4"] {
            grid-template-columns: repeat(3, minmax(0, 1fr));
          }
        }

        @container (width <= 800px) {
          &,
          &[data-columns="4"] {
            grid-template-columns: repeat(2, minmax(0, 1fr));
          }
        }

        /* The narrow card is 39% of the row, so it reaches a width a quote
           cannot be set in well before a plain half does. One per line from
           here rather than carrying the stagger down into it. */
        @container (width <= 680px) {
          &[data-columns="2"][data-stagger] > *,
          &[data-columns="2"][data-stagger] > :nth-child(4n + 2),
          &[data-columns="2"][data-stagger] > :nth-child(4n + 3) {
            flex: 1 1 100%;
          }
        }

        @container (width <= 450px) {
          &,
          &[data-columns="4"] {
            grid-template-columns: minmax(0, 1fr);
          }
        }
      }
    }
  }
</style>
