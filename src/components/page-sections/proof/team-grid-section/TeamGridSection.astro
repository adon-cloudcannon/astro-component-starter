---
/**
 * The team beside a line about the team.
 *
 * Copy on one side, a wall of team member cards on the other, clipped by the
 * band. Read off 3806:69424: two columns at 685 and 932, cards every 246, and
 * the column runs from -811 to 1078 in a band only 585 tall — so most of it is
 * outside the frame and the second column is offset against the first.
 *
 * The cards are the same block the team member CTA uses, so a person shown
 * here and a person shown there are one thing described once.
 */
import CustomSection from "@builders/custom-section/CustomSection.astro";
import { subtextMeasure } from "@component-utils/subtextMeasure.mjs";
import Heading from "@core-elements/heading/Heading.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Text from "@core-elements/text/Text.astro";
import Button from "@core-elements/button/Button.astro";
import TeamMember from "@wrappers/team-member/TeamMember.astro";

type Member = Record<string, unknown>;

const {
  eyebrow = "",
  heading = "",
  headingLevel = "h2",
  headingSize = "lg",
  subtext = "",
  subtextSize = "lg",
  /**
   * The measure the design sets the supporting line in, in pixels.
   *
   * Not the column it sits in: a centred subtext is drawn at about 580 in the
   * 1040 column, and run the full width it reads as a different block.
   */
  subtextWidth,
  linkText = "",
  link = "",
  members = [] as Member[],
  columns = 2,
  sectionLabel,
  maxContentWidth = "xl",
  paddingHorizontal = "gutter",
  paddingVertical = "4xl",
  colorScheme = "inherit",
  lockColorScheme = false,
  backgroundColor = "light-sand",
  background,
  haze = false,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

/* The measure the subtext is set in, as a length. */
const subtextCap = subtextMeasure(subtextWidth);

const list: Member[] = Array.isArray(members) ? members : [];
const laneCount = Math.max(1, Number(columns) || 1);

/**
 * Laid out in the order they are written, never dealt into lanes.
 *
 * The cards used to be pushed round the columns and rendered lane by lane,
 * which put six members into the DOM as 1, 3, 5, 2, 4, 6. A row-major grid
 * reaches the same picture from the order they are written, because it
 * already sends items 1, 3 and 5 down the left column.
 *
 * The reorder is what broke CloudCannon. The wall is `data-editable="array"`
 * and each card an `array-item`, and the editor maps those children onto
 * `members` by walking them in DOM order, so it wrote the second member's
 * name, role and portrait onto the third member's card. The panel colour is
 * an inline custom property rather than a bound prop, so it stayed where it
 * was drawn and the two came apart: Mike's name on Olivia's Pacific panel.
 * The first and last cards sit at the same index in both orders, which is
 * why the ends looked right.
 *
 * Nothing may reorder this list. A card's place is its index.
 */
const offsetAt = (index: number) => (index % laneCount) % 2 === 1;
---

<CustomSection
  class:list={["team-grid", className]}
  label={sectionLabel}
  maxContentWidth={maxContentWidth}
  paddingHorizontal={paddingHorizontal}
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  lockColorScheme={lockColorScheme}
  backgroundColor={backgroundColor}
  background={background}
  haze={haze}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  <div class="team-grid-copy">
    <SimpleText
      class="eyebrow"
      data-prop="eyebrow"
      text={eyebrow}
    />
    <Heading
      level={headingLevel}
      size={headingSize}
      alignmentHorizontal="start"
      data-prop="heading"
      text={heading}
    />
    <Text
      class="subtext"
      style={subtextCap ? `max-inline-size: ${subtextCap}` : undefined}      size={subtextSize}
      alignmentHorizontal="start"
      data-prop="subtext"
      text={subtext}
    />
    {linkText && (
      <Button
        class="team-grid-link"
        variant="text"
        iconName="arrow-right"
        iconPosition="after"
        text={linkText}
        link={link}
        data-prop="linkText"
      />
    )}
  </div>

    {/* Both halves together. `data-editable="array"` with no `data-prop` is
        not a weaker region, it is a fatal one: the editor replaces the whole
        thing with "Array editable regions require a 'data-prop' HTML
        attribute but none was provided". The prop is conditional, so the
        region has to be. */}
  <div
    class="team-grid-wall"
    data-editable={useDefaultEditableBinding ? "array" : undefined}
    data-prop={useDefaultEditableBinding ? "members" : undefined}
  >
    <div class="team-grid-lanes" style={`--team-grid-lanes: ${laneCount}`}>
      {list.map((member, index) => (
        <TeamMember
          class:list={[offsetAt(index) && "is-offset"]}
          data-editable="array-item"
          data-id="building-blocks/wrappers/team-member"
          data-component="building-blocks/wrappers/team-member"
          {...member}
        />
      ))}
    </div>
  </div>
</CustomSection>

<style is:global>
  /* Flat, because rules nested deeper than a couple of levels get dropped (see
     CLAUDE.md). */
  @layer page-sections {
    /* 460 of copy, 104 of air, 476 of wall: 1040 exactly. Measured off
       3806:69424, where the copy runs 121 to 581 and the first column of
       cards starts at 685.

       `column-gap`, not `gap` — this grid stacks to one column on a narrow
       screen and the row gap there is its own decision. */
    .team-grid .content {
      align-items: center;
      column-gap: 6.5rem;
      display: grid;
      grid-template-columns: minmax(0, 460fr) minmax(0, 476fr);
    }

    /* The flow layer writes margin-block-start from --space-before, so a plain
       margin loses to it. Both columns sit in their own cell. */
    .team-grid .content > * {
      --space-before: 0;
      margin-block: 0;
    }

    /* The band carries no vertical padding, so the wall of cards runs to the
       top and bottom edges the way the design draws it. The copy keeps its
       own, or it would sit against the nav. */
    .team-grid .team-grid-copy {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-lg);
      padding-block: 6rem;
    }

    .team-grid .team-grid-copy > * {
      --space-before: 0;
      margin-block: 0;
    }

    .team-grid .team-grid-link .button-inner {
      padding-inline: 0;
    }

    /* The wall runs past the band top and bottom and is clipped by it. The
       design draws the columns mid-flow, one offset against the other. */
    /* The band's height comes from the copy, and the cards overflow it. The
       lanes are taken out of flow so they cannot push the row taller: left in
       it, six cards made the band 792 where the design draws 585, and the
       design has fourteen names, so it is meant to overflow rather than fit. */
    .team-grid .team-grid-wall {
      align-self: stretch;
      overflow: hidden;
      position: relative;
    }

    /* One grid, filled in the order the cards are written. Row-major puts the
       odd ones down the first column on its own, which is what the lanes were
       doing by hand. */
    .team-grid .team-grid-lanes {
      /* How far a column drifts either way, and the lift that keeps the drift
         inside the wall.

         The wall clips its columns, so a column that drifts down uncovers the
         band at the top: at the moment the band enters, the rising column was
         36 lower than it rests and a strip of band showed over the first
         card. Lifting the whole grid by that same 36 means the drift's lowest
         point is where the cards used to rest, and the top edge stays covered
         the whole way past. The JS reads the range from here. */
      --team-grid-range: 72px;

      display: grid;
      translate: 0 calc(var(--team-grid-range) / -2);
      gap: 1rem;
      grid-template-columns: repeat(var(--team-grid-lanes, 2), minmax(0, 1fr));
      inset-block-start: 0;
      inset-inline: 0;
      position: absolute;
    }

    /* Every other column starts half a card further down, which is the offset
       the design draws between them.

       A translate, not a margin: the cards all share the 410/412 ratio, so
       lifting each card in those columns by half a card is the same picture
       as lifting the whole column, and it leaves the grid's own rows where
       they are. The wall is out of flow and clipped, so the height it reports
       is not load-bearing either way. */
    /* The design's offset and the drift compose in one translate: a second
       `translate` on the same element replaces the first rather than adding
       to it. */
    .team-grid .team-grid-lanes > * {
      translate: 0 calc(var(--team-grid-offset, 0px) + var(--team-grid-drift, 0px));
    }

    .team-grid .team-grid-lanes > .is-offset {
      --team-grid-offset: -7.6875rem;
    }
  }

  /* The wall takes the band's full height and clips the columns against it.
     Capped at a fixed height instead it fought `align-self: stretch` and left
     a 5px strip of background under the cards. The band's height comes from
     the copy column, which is the only thing in here with a natural one. */
  @layer page-sections {
    @media (width < 48rem) {
      .team-grid .content {
        grid-template-columns: minmax(0, 1fr);
        row-gap: var(--spacing-2xl);
      }

      /* Stacked, the columns are one column: no offset and no drift. */
      .team-grid .team-grid-lanes > * {
        --team-grid-drift: 0px;
        --team-grid-offset: 0px;
      }

      .team-grid .team-grid-lanes {
        position: static;
      }

      .team-grid .team-grid-wall {
        overflow: visible;
      }

      /* The copy's 96 top and bottom hold it off the wall's edges where the
         two sit side by side. Stacked there is no wall beside it: the 96 above
         lands on top of the band's own padding, and the 96 below lands on top
         of the row gap, which put 144 between "Meet the team" and the first
         face. Half above, and the gap below is the grid's to set. */
      .team-grid .team-grid-copy {
        padding-block: 3rem 0;
      }
    }
  }
</style>

<script>
  import { onPageLoad } from "@component-utils/onPageLoad";
  import { setupAllTeamGrids } from "./setup";

  onPageLoad(() => setupAllTeamGrids());
</script>
