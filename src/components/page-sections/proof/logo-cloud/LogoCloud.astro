---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Image from "@core-elements/image/Image.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Carousel from "@wrappers/carousel/Carousel.astro";
import CarouselSlide from "@wrappers/carousel/CarouselSlide.astro";

type LogoProps = {
  image?: string;
  alt?: string;
  url?: string;
  /* Draw the mark as a mask in the surrounding colour rather than as an image.
     The exported marks have their fill baked in, so an image of one is white
     on a cream strip. */
  monochrome?: boolean;
  /* The size the mark is drawn at. A 2x export is twice this, and
     without it the file's own size is what gets drawn. */
  width?: number;
  height?: number;
};

const {
  heading = "",
  logos = [],
  grayscale = true,
  headingPlacement = "above",
  scrolling = false,
  sectionLabel,
  maxContentWidth = "xl",
  paddingHorizontal = "gutter",
  paddingVertical = "2xl",
  colorScheme = "inherit",
  lockColorScheme = false,
  backgroundColor = "base",
  background,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;
---

<CustomSection
  class:list={["logo-cloud", headingPlacement === "inline" && "heading-inline", className]}
  label={sectionLabel}
  maxContentWidth={maxContentWidth}
  paddingHorizontal={paddingHorizontal}
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  lockColorScheme={lockColorScheme}
  backgroundColor={backgroundColor}
  background={background}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  <SimpleText
    class="eyebrow"
    size="md"
    alignmentHorizontal={headingPlacement === "inline" ? "start" : "center"}
    data-prop="heading"
    text={heading}
  />
  {logos?.length > 0 &&
    (scrolling ? (
      /* Marquee mode: the Carousel wrapper's auto-scroll does the work — it
           already hides the arrows and indicators, and honors
           prefers-reduced-motion (the strip then sits still, fully readable). */
      <Carousel
        class:list={["logo-cloud-marquee", grayscale && "grayscale"]}
        label={sectionLabel || heading || "Client logos"}
        autoScroll={true}
        loop={true}
        slideWidthPercent={20}
        minSlideWidth={150}
        alignmentHorizontal="start"
        data-children-prop="logos"
      >
        {logos?.map((logo: LogoProps) => {
          const LogoWrapper = logo.url ? "a" : "span";
          const wrapperProps = logo.url ? { href: logo.url } : {};

          return (
            <CarouselSlide
              class="logo-cloud-item"
              data-editable="array-item"
            >
              <LogoWrapper
                class="logo-cloud-logo"
                {...wrapperProps}
              >
                {logo.monochrome ? (
                  <span
                    class="logo-mark"
                    role="img"
                    aria-label={logo.alt}
                    style={{
                      "--logo-mark-source": `url("${logo.image}")`,
                      ...(logo.width ? { inlineSize: `${logo.width}px` } : {}),
                      ...(logo.height ? { blockSize: `${logo.height}px` } : {}),
                    }}
                    data-prop-src="image"
                    data-prop-alt="alt"
                  />
                ) : (
                  <Image
                    source={logo.image}
                    alt={logo.alt}
                    width={logo.width}
                    height={logo.height}
                    widths={[320]}
                    sizes="320px"
                    data-prop-src="image"
                    data-prop-alt="alt"
                  />
                )}
              </LogoWrapper>
            </CarouselSlide>
          );
        })}
      </Carousel>
    ) : (
      <ul
        class:list={["logo-cloud-grid", grayscale && "grayscale"]}
        data-editable="array"
        data-prop="logos"
        data-direction="row"
      >
        {logos?.map((logo: LogoProps) => {
          const LogoWrapper = logo.url ? "a" : "span";
          const wrapperProps = logo.url ? { href: logo.url } : {};

          return (
            <li
              class="logo-cloud-item"
              data-editable="array-item"
            >
              <LogoWrapper
                class="logo-cloud-logo"
                {...wrapperProps}
              >
                {logo.monochrome ? (
                  <span
                    class="logo-mark"
                    role="img"
                    aria-label={logo.alt}
                    style={{
                      "--logo-mark-source": `url("${logo.image}")`,
                      ...(logo.width ? { inlineSize: `${logo.width}px` } : {}),
                      ...(logo.height ? { blockSize: `${logo.height}px` } : {}),
                    }}
                    data-prop-src="image"
                    data-prop-alt="alt"
                  />
                ) : (
                  <Image
                    source={logo.image}
                    alt={logo.alt}
                    width={logo.width}
                    height={logo.height}
                    widths={[320]}
                    sizes="320px"
                    data-prop-src="image"
                    data-prop-alt="alt"
                  />
                )}
              </LogoWrapper>
            </li>
          );
        })}
      </ul>
    ))}
</CustomSection>

<style is:global>
  @layer page-sections {
    .logo-cloud {
      .logo-cloud-grid {
        align-items: center;
        display: grid;
        gap: var(--spacing-lg) var(--spacing-xl);
        grid-template-columns: repeat(auto-fit, minmax(min(140px, 100%), 1fr));
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .logo-cloud-item {
        display: flex;
        justify-content: center;
      }

      /* The strip's label is an eyebrow by treatment but not by colour: the
         design draws it in Earth, where a section eyebrow is Sunset. It also
         colours the masked marks beside it, which take currentColor. */
      > .outer-content > .content > .eyebrow {
        --color-accent-text: var(--color-text-muted);
      }

      /* The design runs the label and the marks along one line rather than
         stacking them, with the label on the left. Zeroing --space-before on
         the children is what turns the flow column into a row: the flow rule
         reads that property, and setting it on .content itself loses to
         utils, which resets it there. */
      &.heading-inline > .outer-content > .content {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        /* The design leaves 24px between the label and the first mark, and
           space-between opens the rest out from there. A wider minimum tips
           the row over the column and wraps it. */
        gap: var(--spacing-lg);

        > * {
          --space-before: 0px;
        }

        > .eyebrow {
          flex: 0 0 auto;
        }

        > .logo-cloud-grid,
        > .logo-cloud-marquee {
          flex: 1 1 auto;
        }

        > .logo-cloud-grid {
          display: flex;
          flex-wrap: wrap;
          gap: var(--spacing-lg);
          grid-template-columns: none;
          justify-content: space-between;
        }
      }

      /* Marquee mode: the carousel replaces the grid, so it inherits the
         grid's top spacing and its slides carry the item centring. */
      .logo-cloud-marquee {
        .slide__content {
          display: flex;
          justify-content: center;
        }
      }

      .logo-cloud-logo {
        display: block;

        /* Editor-uploaded logos come in arbitrary aspect ratios, so the height
           is capped rather than set. A mark drawn at or below the cap renders
           at the size it was drawn, which is what keeps a short wide wordmark
           from towering over a square monogram just because they share a line.
           Anything larger scales down to fit. */
        /* The marks are held to one line rather than drawn at the size the
           design draws them. Their width and height reach the element
           correctly, but Image's own .image-inner is width: 100%, so the mark
           fills whatever the flex item gives it and its drawn size never gets
           a say. Undoing that means changing Image for every caller, so the
           line stays for now. The cost is a short wide wordmark reading larger
           than it should: Twitch is drawn 75x17 and renders 141x32. */
        img {
          height: auto;
          max-height: var(--logo-cloud-logo-height, var(--spacing-xl));
          max-width: 100%;
          object-fit: contain;
          width: auto;
        }

        /* A masked mark carries its drawn size inline and takes the strip's
           own colour, which is what a bitmap of a white logo could not do.
           The cap still applies, for a mark declared larger than the line. */
        > .logo-mark {
          max-block-size: var(--logo-cloud-logo-height, var(--spacing-xl));
          max-inline-size: 100%;
        }
      }

      /* The grayscale class rides on the grid/marquee, the only elements that
         carry it — a prop-driven class on a region root goes stale in the
         editor. */
      .grayscale .logo-cloud-logo {
        filter: grayscale(1);
        opacity: 0.75;
      }

      /* Link affordances only — static marks do not react. Grayscale
         restores brand color; full-color logos scale up instead. */
      .grayscale a.logo-cloud-logo {
        transition:
          filter var(--animation-normal) var(--ease-in-out),
          opacity var(--animation-normal) var(--ease-in-out);

        &:hover,
        &:focus-visible {
          filter: none;
          opacity: 1;
        }
      }

      &:not(:has(> .grayscale)) a.logo-cloud-logo {
        transition: transform var(--animation-normal) var(--ease-in-out);

        &:hover,
        &:focus-visible {
          transform: scale(1.08);
        }

        @media (prefers-reduced-motion: reduce) {
          &:hover,
          &:focus-visible {
            transform: none;
          }
        }
      }
    }
  }
</style>
