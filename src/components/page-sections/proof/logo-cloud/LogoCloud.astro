---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Image from "@core-elements/image/Image.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Carousel from "@wrappers/carousel/Carousel.astro";
import CarouselSlide from "@wrappers/carousel/CarouselSlide.astro";

type LogoProps = { image?: string; alt?: string; url?: string };

const {
  heading = "",
  logos = [],
  grayscale = true,
  headingPlacement = "above",
  scrolling = false,
  sectionLabel,
  maxContentWidth = "xl",
  paddingHorizontal = "gutter",
  paddingVertical = "2xl",
  colorScheme = "inherit",
  lockColorScheme = false,
  backgroundColor = "base",
  background,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;
---

<CustomSection
  class:list={["logo-cloud", headingPlacement === "inline" && "heading-inline", className]}
  label={sectionLabel}
  maxContentWidth={maxContentWidth}
  paddingHorizontal={paddingHorizontal}
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  lockColorScheme={lockColorScheme}
  backgroundColor={backgroundColor}
  background={background}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  <SimpleText
    class="eyebrow"
    size="sm"
    alignmentHorizontal={headingPlacement === "inline" ? "start" : "center"}
    data-prop="heading"
    text={heading}
  />
  {logos?.length > 0 &&
    (scrolling ? (
      /* Marquee mode: the Carousel wrapper's auto-scroll does the work — it
           already hides the arrows and indicators, and honors
           prefers-reduced-motion (the strip then sits still, fully readable). */
      <Carousel
        class:list={["logo-cloud-marquee", grayscale && "grayscale"]}
        label={sectionLabel || heading || "Client logos"}
        autoScroll={true}
        loop={true}
        slideWidthPercent={20}
        minSlideWidth={150}
        alignmentHorizontal="start"
        data-children-prop="logos"
      >
        {logos?.map((logo: LogoProps) => {
          const LogoWrapper = logo.url ? "a" : "span";
          const wrapperProps = logo.url ? { href: logo.url } : {};

          return (
            <CarouselSlide
              class="logo-cloud-item"
              data-editable="array-item"
            >
              <LogoWrapper
                class="logo-cloud-logo"
                {...wrapperProps}
              >
                <Image
                  source={logo.image}
                  alt={logo.alt}
                  widths={[320]}
                  sizes="320px"
                  data-prop-src="image"
                  data-prop-alt="alt"
                />
              </LogoWrapper>
            </CarouselSlide>
          );
        })}
      </Carousel>
    ) : (
      <ul
        class:list={["logo-cloud-grid", grayscale && "grayscale"]}
        data-editable="array"
        data-prop="logos"
        data-direction="row"
      >
        {logos?.map((logo: LogoProps) => {
          const LogoWrapper = logo.url ? "a" : "span";
          const wrapperProps = logo.url ? { href: logo.url } : {};

          return (
            <li
              class="logo-cloud-item"
              data-editable="array-item"
            >
              <LogoWrapper
                class="logo-cloud-logo"
                {...wrapperProps}
              >
                <Image
                  source={logo.image}
                  alt={logo.alt}
                  widths={[320]}
                  sizes="320px"
                  data-prop-src="image"
                  data-prop-alt="alt"
                />
              </LogoWrapper>
            </li>
          );
        })}
      </ul>
    ))}
</CustomSection>

<style is:global>
  @layer page-sections {
    .logo-cloud {
      .logo-cloud-grid {
        align-items: center;
        display: grid;
        gap: var(--spacing-lg) var(--spacing-xl);
        grid-template-columns: repeat(auto-fit, minmax(min(140px, 100%), 1fr));
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .logo-cloud-item {
        display: flex;
        justify-content: center;
      }

      /* The design runs the label and the marks along one line rather than
         stacking them, with the label on the left. Zeroing --space-before on
         the children is what turns the flow column into a row: the flow rule
         reads that property, and setting it on .content itself loses to
         utils, which resets it there. */
      &.heading-inline > .outer-content > .content {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: var(--spacing-xl) var(--spacing-2xl);

        > * {
          --space-before: 0px;
        }

        > .eyebrow {
          flex: 0 0 auto;
        }

        > .logo-cloud-grid,
        > .logo-cloud-marquee {
          flex: 1 1 auto;
        }

        > .logo-cloud-grid {
          display: flex;
          flex-wrap: wrap;
          gap: var(--spacing-lg) var(--spacing-2xl);
          grid-template-columns: none;
          justify-content: space-between;
        }
      }

      /* Marquee mode: the carousel replaces the grid, so it inherits the
         grid's top spacing and its slides carry the item centring. */
      .logo-cloud-marquee {
        .slide__content {
          display: flex;
          justify-content: center;
        }
      }

      .logo-cloud-logo {
        display: block;

        /* Editor-uploaded logos come in arbitrary aspect ratios, so the height
           is capped rather than set. A mark drawn at or below the cap renders
           at the size it was drawn, which is what keeps a short wide wordmark
           from towering over a square monogram just because they share a line.
           Anything larger scales down to fit. */
        img {
          height: auto;
          max-height: var(--logo-cloud-logo-height, var(--spacing-xl));
          max-width: 100%;
          object-fit: contain;
          width: auto;
        }
      }

      /* The grayscale class rides on the grid/marquee, the only elements that
         carry it — a prop-driven class on a region root goes stale in the
         editor. */
      .grayscale .logo-cloud-logo {
        filter: grayscale(1);
        opacity: 0.75;
      }

      /* Link affordances only — static marks do not react. Grayscale
         restores brand color; full-color logos scale up instead. */
      .grayscale a.logo-cloud-logo {
        transition:
          filter var(--animation-normal) var(--ease-in-out),
          opacity var(--animation-normal) var(--ease-in-out);

        &:hover,
        &:focus-visible {
          filter: none;
          opacity: 1;
        }
      }

      &:not(:has(> .grayscale)) a.logo-cloud-logo {
        transition: transform var(--animation-normal) var(--ease-in-out);

        &:hover,
        &:focus-visible {
          transform: scale(1.08);
        }

        @media (prefers-reduced-motion: reduce) {
          &:hover,
          &:focus-visible {
            transform: none;
          }
        }
      }
    }
  }
</style>
