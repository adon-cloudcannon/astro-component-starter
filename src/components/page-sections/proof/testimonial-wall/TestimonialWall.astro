---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Text from "@core-elements/text/Text.astro";
import Grid from "@wrappers/grid/Grid.astro";
import Masonry from "@wrappers/masonry/Masonry.astro";
import TestimonialWallItem from "./TestimonialWallItem.astro";

type TestimonialProps = Record<string, unknown>;

const {
  eyebrow = "",
  heading = "",
  headingLevel = "h2",
  headingSize = "lg",
  subtext = "",
  // Body 3 at 19 or Subtitle 1 at 22 in the design; `md` keeps the 16 every
  // section rendered before either was carried through.
  subtextSize = "md",
  /**
   * The measure the design sets the supporting line in, in pixels.
   *
   * Not the column it sits in: a centred subtext is drawn at about 580 in the
   * 1040 column, and run the full width it reads as a different block.
   */
  subtextWidth,
  testimonials = [],
  columns = 3,
  /**
   * Staggered, or an even row.
   *
   * Masonry is the shipped behaviour and stays the default. The design draws
   * the Agencies wall as three cards of one height, top and bottom aligned,
   * which a stagger reads as three cards knocked out of line.
   */
  layout = "masonry",
  sectionLabel,
  maxContentWidth = "xl",
  paddingHorizontal = "gutter",
  paddingVertical = "4xl",
  colorScheme = "inherit",
  lockColorScheme = false,
  backgroundColor = "base",
  background,
  haze = false,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;
---

<CustomSection
  class:list={["testimonial-wall", className]}
  label={sectionLabel}
  maxContentWidth={maxContentWidth}
  paddingHorizontal={paddingHorizontal}
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  lockColorScheme={lockColorScheme}
  backgroundColor={backgroundColor}
  background={background}
  haze={haze}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  <SimpleText
    alignmentHorizontal="center"
    class="eyebrow"
    data-prop="eyebrow"
    text={eyebrow}
    size="sm"
  />
  <Heading
    level={headingLevel}
    size={headingSize}
    alignmentHorizontal="center"
    data-prop="heading"
  >
    {heading}
  </Heading>
  <Text
    class="section-subtext testimonial-wall-subtext"
    alignmentHorizontal="center"
    data-prop="subtext"
    style={subtextWidth ? `max-inline-size: ${Number(subtextWidth)}px; margin-inline: auto; justify-self: center` : undefined}    size={subtextSize}    text={subtext}
  />

  {testimonials?.length > 0 && (
    /* Quotes are uneven by nature, so the wall is a Masonry by default — the
         wrapper's JS enhancement keeps reading order while packing the
         columns. A row is for where the design draws one height. */
    layout === "row" ? (
      <Grid
        class="testimonial-wall-row"
        columns={columns}
        gap="md"
        data-children-prop="testimonials"
      >
        {testimonials?.map((testimonial: TestimonialProps) => (
          <TestimonialWallItem
            data-editable="array-item"
            data-id="page-sections/proof/testimonial-wall/testimonial-wall-item"
            {...testimonial}
          />
        ))}
      </Grid>
    ) : (
      <Masonry
        class="testimonial-wall-masonry"
        columns={columns}
        gap="md"
        data-children-prop="testimonials"
      >
        {testimonials?.map((testimonial: TestimonialProps) => (
          <TestimonialWallItem
            data-editable="array-item"
            data-id="page-sections/proof/testimonial-wall/testimonial-wall-item"
            {...testimonial}
          />
        ))}
      </Masonry>
    )
  )}
</CustomSection>

<style is:global>
  /* An even row: three cards of one height, top and bottom aligned, with the
     attribution hanging from the foot of each. The design draws them that way
     and sizes each quote to suit, so a stagger reads as three cards knocked
     out of line.

     Flat, because rules nested deeper than a couple of levels get dropped
     (see CLAUDE.md). */
  @layer page-sections {
    /* A card a shade off the band, not the same cream as the page. The design
       paints #FBF6E9 with a #EBE1C9 rule — --sand on --light-sand, which is
       `surface` against `base` — where Testimonial's own chrome is the page
       colour with the generic grey border. Same correction the illustrated
       feature cards needed. 16 is the nearest radius token to the 16 and 18
       the three cards are drawn at. */
    .testimonial-wall .testimonial-inner {
      background-color: var(--color-bg-surface);
      border-color: var(--dark-sand);
      border-radius: var(--radius-lg);
    }

    .testimonial-wall .testimonial-wall-row .masonry-item,
    .testimonial-wall .testimonial-wall-row .masonry-item-content,
    .testimonial-wall .testimonial-wall-row .testimonial-wall-item {
      block-size: 100%;
    }

    .testimonial-wall .testimonial-wall-row .testimonial-inner {
      block-size: 100%;
      display: flex;
      flex-direction: column;
    }

    .testimonial-wall .testimonial-wall-row .author {
      margin-block-start: auto;
    }
  }
</style>
