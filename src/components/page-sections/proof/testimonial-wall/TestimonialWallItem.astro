---
import Testimonial from "@core-elements/testimonial/Testimonial.astro";
import MasonryItem from "@wrappers/masonry/MasonryItem.astro";

const {
  text = "",
  authorName = "",
  authorDescription = "",
  authorImage = "",
  /**
   * Whether this one reads as a quotation.
   *
   * Per card, not per section: the design marks one of the three on Agencies
   * and leaves the other two bare, and Testimonial adds a pair regardless.
   */
  quoted = true,
  /**
   * How big the design sets this card's quote, in pixels.
   *
   * It is not one size. The design runs 27, 19 and 27 side by side, sizing the
   * type so three cards of different lengths come out the same height, which
   * is a judgement no rule here can make for itself.
   */
  quoteSize,
  class: className,
  _component,
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  ...htmlAttributes
} = Astro.props;
---

<MasonryItem {...htmlAttributes}>
  {/* The card chrome (background, border, padding) comes from Testimonial
      itself — the wall only supplies the layout and the start alignment that
      suits a column of quotes. */}
  <Testimonial
    class:list={["testimonial-wall-item", { "not-quoted": !quoted }, className]}
    style={quoteSize ? `--testimonial-wall-quote: ${Number(quoteSize)}px` : undefined}
    text={text}
    authorName={authorName}
    authorDescription={authorDescription}
    authorImage={authorImage}
    alignmentHorizontal="start"
    avatarSize={48}
    data-prop="text"
    data-prop-author-name="authorName"
    data-prop-author-description="authorDescription"
    data-prop-author-image="authorImage"
  />
</MasonryItem>

<style is:global>
  @layer page-sections {
    .testimonial-wall-item {
      /* Card height stays content-driven on purpose — it feeds the masonry
         span measurement. */
      margin-top: 0;
    }

    /* Flat, because rules nested deeper than a couple of levels get dropped
       (see CLAUDE.md). The marks are drawn by Testimonial as ::before and
       ::after on the quote's first and last child. */
    .testimonial-wall-item.not-quoted .quote > *:first-child::before,
    .testimonial-wall-item.not-quoted .quote > *:last-child::after {
      content: none;
    }

    .testimonial-wall-item .quote,
    .testimonial-wall-item .quote :is(p, blockquote) {
      font-size: var(--testimonial-wall-quote, inherit);
    }
  }
</style>
