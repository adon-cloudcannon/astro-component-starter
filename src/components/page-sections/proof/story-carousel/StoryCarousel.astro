---
/**
 * A row of customer story cards that slides.
 *
 * The design uses this to carry proof: a heading and a line of copy, then a
 * row of cards each marked with its own colour, showing a client's logo, the
 * figure they moved, what it means, and a link to the story. The last card
 * runs off the edge of the page on purpose, which is how a reader knows there
 * are more.
 *
 * Built rather than composed from card-collection, which lays out a grid or a
 * masonry and has nowhere to put the accent or the figure. The card itself is
 * the shared part: the same shape, at the same 18px radius, appears around
 * forty times across the site in light and dark, so it stays in Card and this
 * section only arranges them.
 */
import { bandPattern, bandHaze } from "@component-utils/bandStyle.mjs";
import { nestedProps } from "@component-utils/nestedProps.mjs";
import CustomSection from "@builders/custom-section/CustomSection.astro";
import { subtextMeasure } from "@component-utils/subtextMeasure.mjs";
import { resolveImageSource } from "@component-utils/resolveImageSource";
import Carousel from "@wrappers/carousel/Carousel.astro";
import CarouselSlide from "@wrappers/carousel/CarouselSlide.astro";
import Card from "@wrappers/card/Card.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Text from "@core-elements/text/Text.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Image from "@core-elements/image/Image.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";

type StoryProps = {
  accentColor?: string;
  logoSource?: string;
  /* Draw the mark in the surrounding text colour rather than its own. */
  logoMonochrome?: boolean;
  /* The file's own width/height, since a mask has no intrinsic size. */
  logoAspect?: string;
  logoAlt?: string;
  figure?: string;
  label?: string;
  linkText?: string;
  link?: string;
};

/* `content` and `style` are the editor's tabs, flattened straight back into
   the names below. `at()` writes the frontmatter path a binding needs. */
const { props, at } = nestedProps(Astro.props, {
  nest: {
    heading: ["eyebrow", "heading", "headingLevel", "headingSize"],
    subtext: ["subtext", "subtextSize", "subtextWidth"],
  },
});

const {
  eyebrow = "",
  heading = "",
  headingLevel = "h2",
  headingSize = "lg",
  subtext = "",
  // The design sets a section's supporting line in one of two styles, Body 3
  // at 19 or Subtitle 1 at 22. `md` is the 16 every section rendered before
  // either was carried through, so nothing moves unless the design named it.
  subtextSize = "md",
  /**
   * The measure the design sets the supporting line in, in pixels.
   *
   * Not the column it sits in: a centred subtext is drawn at about 580 in the
   * 1040 column, and run the full width it reads as a different block.
   */
  subtextWidth,
  stories = [],
  buttonSections = [],
  sectionLabel,
  maxContentWidth = "xl",
  paddingHorizontal = "gutter",
  paddingVertical = "4xl",
  colorScheme = "inherit",
  lockColorScheme = false,
  backgroundColor = "light-sand",
  /** The texture behind the band, by name. */
  pattern = "none",
  /** Which edge the texture fades out towards. */
  fade = "none",
  /** Whether the heading sits on a pool of the band’s own colour. */
  haze = false,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  "data-children-prop": childrenDataProp,
  ...htmlAttributes
} = props;

/* The measure the subtext is set in, as a length. */
const subtextCap = subtextMeasure(subtextWidth);
---

<CustomSection
  label={sectionLabel}
  maxContentWidth={maxContentWidth}
  paddingHorizontal={paddingHorizontal}
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  lockColorScheme={lockColorScheme}
  backgroundColor={backgroundColor}
  background={bandPattern(pattern, fade)}
  haze={bandHaze(haze)}
  class:list={["story-carousel", className]}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  <Heading
    eyebrow={eyebrow}
    data-eyebrow-prop={at("eyebrow")}
    level={headingLevel}
    size={headingSize}
    alignmentHorizontal="center"
    data-prop={at("heading")}
  >
    {heading}
  </Heading>
  <Text
    class="subtext"
    style={
      subtextCap
        ? `max-inline-size: ${subtextCap}; margin-inline: auto; justify-self: center`
        : undefined
    }
    size={subtextSize}
    alignmentHorizontal="center"
    data-prop={at("subtext")}
    text={subtext}
  />

  {stories?.length > 0 && (
    <Carousel
      class="story-slides"
      label={
        sectionLabel || heading || "Customer stories"
      } /* The design draws these at a fixed 300 with 20 between, four across a
          1040 column and the fourth running off the edge. The carousel spends
          its gap as padding on the slide, so the slide is the card plus the
          gap: 324 for a 300 card. The slide takes the larger of the
          percentage and the minimum, and 25% of the column is 260. */
      slideWidthPercent={25}
      minSlideWidth={324}
      gap="lg"
      alignmentHorizontal="start"
      showIndicators={false}
      data-children-prop={at("stories")}
    >
      {stories.map((story: StoryProps) => (
        <CarouselSlide data-editable="array-item">
          <Card
            accentColor={story.accentColor || "none"}
            accentRule={true}
            backgroundColor="muted"
            border={true}
            rounded={true}
            paddingHorizontal="lg"
            paddingVertical="lg"
            link={story.link}
          >
            {story.logoSource &&
              (story.logoMonochrome ? (
                <span
                  class="story-logo logo-mark"
                  role="img"
                  aria-label={story.logoAlt}
                  style={{
                    "--logo-mark-source": `url("${resolveImageSource(story.logoSource)}")`,
                    ...(story.logoAspect ? { "--logo-mark-aspect": story.logoAspect } : {}),
                  }}
                  data-prop-src="logoSource"
                  data-prop-alt="logoAlt"
                />
              ) : (
                <Image
                  class="story-logo"
                  source={story.logoSource}
                  alt={story.logoAlt}
                  data-prop-src="logoSource"
                  data-prop-alt="logoAlt"
                />
              ))}
            <span
              class="story-figure"
              data-prop="figure"
            >
              {story.figure}
            </span>
            <SimpleText
              class="story-label"
              size="sm"
              data-prop="label"
              text={story.label}
            />
            {story.linkText && (
              <SimpleText
                class="story-link"
                size="sm"
                data-prop="linkText"
                text={story.linkText}
              />
            )}
          </Card>
        </CarouselSlide>
      ))}
    </Carousel>
  )}

  <ButtonGroup
    class="story-actions"
    buttonSections={buttonSections}
    direction="row"
    alignmentHorizontal="center"
    data-children-prop={at("buttonSections")}
  />
</CustomSection>

<style is:global>
  @layer page-sections {
    .story-carousel {
      /* The row breaks out of the content column, which is what makes the last
         card read as "there is more" rather than as cut off. Clipped at the
         column, the fourth card showed 68px of itself and read as broken.

         It is cropped to the page frame, not to the window: 1280 against the
         1040 column, so 120 either side. Symmetric on purpose — a card sliding
         off the left has to be cut on the same line the fourth is cut on at
         the right, and a band that only broke out rightwards also carried the
         prev/next arrows 46px off the page's centre. */
      --story-crop: 120px;
      /* The first card sits 30 inside that crop, at 90 on a 1280 page, which
         is where the design draws it. */
      --story-inset: 90px;

      .story-slides {
        /* Carousel sets `width: 100%`, and a fixed width is not something a
           negative margin can grow: the margins applied, the left edge moved
           and the box stayed exactly the column's 1040, so the bleed did
           nothing. This layer out-ranks `components`, so auto is enough. */
        inline-size: auto;
      }

      /* The design draws no arrows at this width, so there is no measurement
         to take from it. Carousel gives them 8px of its own `margin-top`,
         which sits them right under the cards; this is not the flow layer, so
         --space-before reaches nothing. A plain margin from `page-sections`
         out-ranks the one in `components`. */
      .story-slides .controls-wrapper {
        margin-block-start: var(--spacing-xl);
      }

      /* The cards are a fixed shape in the design, 300 wide by 380 tall, and
         the row is meant to run past the edge rather than fit. Without this
         the slides shrink to share the track and the cards come out narrow. */
      .story-slides .slide {
        flex-shrink: 0;
      }

      /* The slide is the 300 the design draws; the card fills it rather than
         sitting inside the slide's own padding at 276. Spacing between cards
         is the carousel's gap. */
      .story-slides .slide__content {
        block-size: 100%;
      }

      .story-slides .card {
        block-size: 100%;
        inline-size: 100%;
      }

      .story-logo {
        /* start, not stretch: the card content is a flex column, so a mark
           left to stretch fills the card and its ratio never gets to set the
           width. Every mark then comes out the same size. */
        align-self: start;
        block-size: 1.75rem;
        inline-size: auto;
        max-inline-size: 70%;

        img {
          block-size: auto;
          max-block-size: 100%;
          object-fit: contain;
          width: auto;
        }
      }

      /* A masked mark has no intrinsic size, so its shape comes from the
         ratio the file declares. Without it every mark stretches to one box
         and a wide wordmark ends up the same width as a square monogram. */
      .story-logo.logo-mark {
        aspect-ratio: var(--logo-mark-aspect, 4 / 1);
        mask-position: left center;
      }

      /* The figure carries the card's own accent, which is the one thing that
         tells these cards apart at a glance. */
      .story-figure {
        color: var(--card-accent, var(--color-text-strong));
        display: block;
        font-size: var(--font-size-heading-xl);
        font-weight: var(--font-weight-heading-xl);
        letter-spacing: var(--letter-spacing-heading-xl);
        line-height: 1.1;
        /* Pushed to the foot of the card, so the figures line up across a row
           whose logos are all different heights. Set through --space-before
           because the flow layer writes margin-block-start from it, and a
           plain margin here loses to that. */
        --space-before: auto;
      }

      .story-slides .card-content {
        display: flex;
        flex-direction: column;
        min-block-size: 380px;
      }

      .story-label {
        color: var(--color-text-muted);
      }

      /* A rule above the link, the way the design separates it from the copy.
         The colour has to reach the inner span too: SimpleText sets its own,
         so colouring only the wrapper leaves the text as it was. */
      .story-link {
        border-block-start: var(--border-width-sm) solid var(--color-border);
        padding-block-start: var(--spacing-md);

        &,
        :where(.simple-text-content, .simple-text-inner, p, span) {
          color: var(--color-brand);
        }
      }
    }

    /* Only once the column has stopped growing with the window. Narrower than
       that it is already a gutter from the edge, so a gutter of break-out puts
       the first card flush against the screen. 1096 is the column plus its two
       gutters, which is the width it stops being gutter-bound at.

       Written flat rather than nested in the block above: a rule three levels
       deep gets dropped without a warning. */
    @media (min-width: 1096px) {
      /* Never past the window: between 1096 and 1280 there is less than the
         crop to give, so the band takes what there is. `100%` is the column,
         since a percentage margin resolves against its containing block. */
      .story-carousel .story-slides {
        margin-inline: calc(-1 * min(var(--story-crop), (100vw - 100%) / 2));
      }

      /* Padding on the clip rather than a margin on the track: the clip is
         this element's own box, so a card sliding out passes underneath the
         inset and is cut at the band's edge instead of stopping short of it. */
      .story-carousel .story-slides .viewport {
        padding-inline-start: var(--story-inset);
      }
    }
  }
</style>
