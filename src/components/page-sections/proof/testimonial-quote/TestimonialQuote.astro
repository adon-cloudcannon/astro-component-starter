---
/**
 * One quote, drawn as a card, in the four layouts the design draws it in.
 *
 * `downloaded-nodes/testimonial-quote-block.html` is a comparison sheet: four
 * layouts, each shown twice, once in Absoluttweb's colour and once in DX's.
 * Labelled there as 2a/2b (static, with the quote stepping down a size as it
 * gets longer), 2c (carousel), 2d (split, person left) and 2e (split, quote
 * left). The two static examples are one layout at two quote sizes rather
 * than two layouts, so there are four:
 *
 *   static        quote, a rule, then the person with the company's mark
 *   carousel      the same card, several quotes, dots and arrows
 *   split-person  the person in a column, a rule, the quote beside it
 *   split-quote   the same the other way round
 *
 * The sheet is drawn at about a 1280 card and this is built at the content
 * column, and its type is Outfit where the site sets Red Hat Display, so the
 * numbers do not carry across. What carries across is the structure. The type,
 * the colour and the spacing follow the testimonial bento instead, which is
 * the card this project has already settled: the quote bold at 1.3, the name
 * 18, the role and company 13 in mono, the marks and the emphasis in the
 * card's own accent, a rule between the quote and the person.
 */
import { nestedProps } from "@component-utils/nestedProps.mjs";
import CustomSection from "@builders/custom-section/CustomSection.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import TestimonialQuoteItem from "./TestimonialQuoteItem.astro";

type Quote = {
  text?: string;
  authorName?: string;
  authorDescription?: string;
  company?: string;
  authorImage?: string;
  authorImageAlt?: string;
  logoSource?: string;
  logoAlt?: string;
  logoAspect?: string;
  linkText?: string;
  link?: string;
  accentColor?: string;
  quoteMarks?: boolean;
};

/* `content` and `style` are the editor's tabs, flattened straight back into
   the names below. `at()` writes the frontmatter path a binding needs. */
const { props, at } = nestedProps(Astro.props);

const {
  /**
   * Which of the four the design draws.
   *
   * `carousel` is the only one that reads more than the first quote.
   */
  variant = "static",
  /**
   * A label over the card, in the band rather than on it.
   *
   * Our Values puts "WE BELIEVE" above its statement. It sits outside the
   * card on purpose: with `plain` there is no card to sit on, and on the
   * other tones a label inside the surface reads as part of the quote.
   */
  eyebrow = "",
  /**
   * Which way the card sets its words.
   *
   * `start` is the card as the sheet draws it, and is what every quote with
   * a person wants: the face and the name hang off the left edge. `center`
   * is the band given over to a statement, where the design centres the
   * words under a centred label.
   *
   * It does nothing on the splits. There the quote and the person are two
   * columns against a rule, and centring either one pulls it off that rule.
   */
  alignment = "start",
  quotes = [],
  /**
   * The quote's size, which the sheet steps down as the quote gets longer:
   * `lg` is Header 4 and `sm` is Header 5, the two the theme already sets.
   */
  quoteSize = "sm",
  /**
   * The card's own outline.
   *
   * Off. The design draws one, but it draws it on a card sitting on a flat
   * band; on a patterned band the rule reads as a box around the quote rather
   * than as the edge of a surface, and the fill is already enough to separate
   * the card from the band. The rule between the quote and the person is a
   * different thing and is always drawn.
   */
  bordered = false,
  /**
   * `base` is the design's near-black card, for a dark band. `light` is the
   * card for a cream one: light sand against the band's sand, which is the
   * "a shade off its band" relationship the project settles on.
   *
   * The accent does not move with it. On this band the design draws its
   * emphasis in the full-strength colour, #034AD8 on cream, so stepping it
   * down would be a correction the design has not asked for. The pastel
   * accents are for a dark ground and will not hold on a pale one.
   */
  tone = "base",
  /**
   * How much of the column the card takes.
   *
   * `medium`, 72%, is the default: it is what every testimonial on the site
   * was set to one at a time, so it is the house width rather than a per-band
   * choice. `full` runs the card to the whole column, and `narrow` is the
   * bento's wide card at 55% of the row.
   *
   * The splits stack below 680 of card. 72% of the 1040 column is 749, so a
   * split still draws side by side at the default.
   */
  cardWidth = "medium",
  sectionLabel,
  maxContentWidth = "xl",
  paddingHorizontal = "gutter",
  paddingVertical = "4xl",
  /**
   * Override one end of the vertical padding; empty follows paddingVertical.
   *
   * The band above a testimonial already carries its own bottom padding, so
   * the two stack: after the editor demo on Content Editors that came to 96
   * between the demo and the card. Trimming the top alone keeps the space
   * under the card where the design has it.
   */
  paddingVerticalStart = "",
  paddingVerticalEnd = "",
  colorScheme = "inherit",
  lockColorScheme = false,
  backgroundColor = "light-sand",
  background,
  haze = false,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = props;

const LAYOUTS = ["static", "carousel", "split-person", "split-quote"];
const layout = LAYOUTS.includes(String(variant)) ? String(variant) : "static";
const isCarousel = layout === "carousel";

/* Every quote, in every layout.

   Only the carousel used to read past the first, so a static card with two
   quotes drew one. That is not what an editor sees: CloudCannon draws the
   item it has just added, so a second quote appeared in the Visual Editor and
   was gone on the next load. The layouts that are not a carousel stack them,
   with a gap. */
const items: Quote[] = quotes as Quote[];

/* The card declares its own scheme, the way the bento's cards do. Anything
   inside it that reads a theme token rather than one of the card's own (a
   Button's arrow, a link's hover) otherwise follows the band, so a cream card
   on a dark band drew a Harbour arrow that all but vanished into it. `plain`
   has no card, so it keeps the band's.

   A comment cannot go between the attributes themselves: a JSX comment in
   attribute position is a parse error in Astro, not a comment. */
const cardScheme = tone === "plain" ? undefined : tone === "light" ? "light" : "dark";

/* See the note on the prop: a split is two columns against a rule and has
   nothing to centre. */
const isSplit = layout === "split-person" || layout === "split-quote";
const align = alignment === "center" && !isSplit ? "center" : undefined;
---

{items.length > 0 && (
  <CustomSection
    class:list={["testimonial-quote", className]}
    label={sectionLabel}
    maxContentWidth={maxContentWidth}
    paddingHorizontal={paddingHorizontal}
    paddingVertical={paddingVertical}
    paddingVerticalStart={paddingVerticalStart}
    paddingVerticalEnd={paddingVerticalEnd}
    colorScheme={colorScheme}
    lockColorScheme={lockColorScheme}
    backgroundColor={backgroundColor}
    background={background}
    haze={haze}
    useDefaultEditableBinding={useDefaultEditableBinding}
    {...htmlAttributes}
  >
    {eyebrow && (
      <SimpleText
        class="eyebrow testimonial-quote-eyebrow"
        size="sm"
        alignmentHorizontal={align === "center" ? "center" : "start"}
        text={eyebrow}
        data-prop={at("eyebrow")}
      />
    )}

    <div
      class="testimonial-quote-frame"
      data-width={cardWidth === "full" ? undefined : cardWidth}
      data-align={align}
    >
    <div
      class="testimonial-quote-card"
      data-align={align}
      data-layout={layout}
      data-quote-size={quoteSize === "lg" ? "lg" : undefined}
      data-bordered={bordered ? "" : undefined}
      data-tone={tone !== "base" ? tone : undefined}
      data-theme={cardScheme}
      data-editable="array"
      data-prop={at("quotes")}
    >
      {items.map((quote, index) => (
        <TestimonialQuoteItem
          {...quote}
          layout={layout}
          index={index}
          isCarousel={isCarousel}
          slideCount={items.length}
          data-editable="array-item"
          data-id="page-sections/proof/testimonial-quote/testimonial-quote-item"
          data-component="page-sections/proof/testimonial-quote/testimonial-quote-item"
        />
      ))}

      {isCarousel && items.length > 1 && (
        /* One set of controls for the card rather than one per slide: the
           slides swap, the controls do not. */
        <div class="testimonial-quote-nav">
          <div class="testimonial-quote-dots" role="tablist" aria-label="Quotes">
            {items.map((_, index) => (
              <button
                type="button"
                class="testimonial-quote-dot"
                role="tab"
                data-goto={index}
                aria-selected={index === 0 ? "true" : "false"}
                aria-label={`Quote ${index + 1}`}
              ></button>
            ))}
          </div>
          <div class="testimonial-quote-arrows">
            <button type="button" class="testimonial-quote-arrow" data-step="-1" aria-label="Previous quote">
              <span aria-hidden="true">&lsaquo;</span>
            </button>
            <button type="button" class="testimonial-quote-arrow" data-step="1" aria-label="Next quote">
              <span aria-hidden="true">&rsaquo;</span>
            </button>
          </div>
        </div>
      )}
    </div>
    </div>
  </CustomSection>
)}

<style is:global>
  @layer page-sections {
    .testimonial-quote {
      /* The frame carries the width and is what the card is measured against.

         A query container rather than a viewport breakpoint, because a card
         set to 55% of the column is as narrow at 1280 as a full-width one is
         on a tablet, and the splits have to stack for the same reason in
         both: a 22% person column is narrower than the face that goes in it.

         `justify-self`, not an auto inline margin: on a grid item the margin
         shrinks the item rather than centring it. */
      .testimonial-quote-frame {
        container-type: inline-size;
        inline-size: 100%;
        justify-self: center;
      }

      /* 55% is the bento's wide card, the one width this project has already
         decided on. */
      .testimonial-quote-frame[data-width="narrow"] {
        inline-size: 55%;
      }

      .testimonial-quote-frame[data-width="medium"] {
        inline-size: 72%;
      }

      /* Both widths are measures for a desktop column, and on a phone they
         are just a narrower page. 72% of the column at 375 left the card 248
         wide and the quote 200: "maintenance" needs 216 at this size, so
         `overflow-wrap` dropped its last letter onto the next line. The card
         takes the width it is given instead. */
      @media (width < 48rem) {
        .testimonial-quote-frame[data-width="narrow"],
        .testimonial-quote-frame[data-width="medium"] {
          inline-size: 100%;
        }
      }

      .testimonial-quote-card {
        /* The bento's card, at this one's size.

           Same surface, same edge, same ink: a quote card on a dark band has
           to be the same object whether it is one of four in a bento or on
           its own in a band, or the two read as different components. The
           padding is a step up from the bento's 40, because this card is the
           content column wide rather than a third of it. */
        --testimonial-quote-surface: var(--black);
        --testimonial-quote-edge: color-mix(in srgb, var(--gray-200, #d9d9d9) 8%, transparent);
        /* The card's own ink, not the band's. Read from `--color-text-strong`
           this followed the section instead: a near-black card dropped onto a
           cream band got midnight type on black, and the light card below got
           cream on cream. The tone decides what the card is, so it decides
           what colour the words are. */
        --testimonial-quote-ink: var(--white);
        --testimonial-quote-quiet: var(--gray-400, #9a9a9a);
        --testimonial-quote-pad: 48px;
        /* Taller than it is wide, which is how the approved card is drawn: 80
           above and below against 88 either side, on a card the full width of
           its frame. Ours sits at 72% of the column, so the sides come in but
           the vertical stays generous. */
        --testimonial-quote-pad-y: 64px;
        /* Header 5. The sheet steps the quote down as it gets longer, and
           these are the two sizes the theme already draws. */
        --testimonial-quote-size: var(--font-size-heading-sm);
        --testimonial-quote-name: 1.125rem;
        --testimonial-quote-meta: 0.8125rem;

        background: var(--testimonial-quote-surface);
        border: 0;
        border-radius: var(--radius-card);
        padding: var(--testimonial-quote-pad-y, var(--testimonial-quote-pad)) var(--testimonial-quote-pad);
        position: relative;
      }

      /* The cream card. The edge is a midnight tint rather than the dark
         card's white one, or the rule between the quote and the person
         disappears into the fill. */
      .testimonial-quote-card[data-tone="light"] {
        --testimonial-quote-surface: var(--light-sand);
        --testimonial-quote-edge: color-mix(in srgb, var(--midnight) 12%, transparent);
        --testimonial-quote-ink: var(--midnight);
        --testimonial-quote-quiet: var(--gray-700, #5c5c5c);
      }

      .testimonial-quote-card[data-bordered] {
        border: var(--border-width-sm) solid var(--testimonial-quote-edge);
      }

      /* Header 4. */
      .testimonial-quote-card[data-quote-size="lg"] {
        --testimonial-quote-size: var(--font-size-heading-md);
      }

      /* Even, top and bottom. A lighter foot was a reading of the card as
         quote-with-a-footnote; the approved card draws 80 at both ends and the
         card looked cramped against its own quote without it. */

      .testimonial-quote-slide[hidden] {
        display: none;
      }

      /* Two quotes in one card are two quotes, not one long one.

         The card draws 80 at its own ends, so the space between a pair sits
         under that at the card's 48: enough to read as a break, not so much
         that the second quote looks like it belongs to the next band. The
         carousel's slides are `display: none` rather than hidden in flow, so
         they take no gap and a one-quote card is unchanged.

         `--space-before` as well as the margin: the flow layer writes
         `margin-block-start` from that property and `utils` out-ranks
         `page-sections`, so a plain margin here loses to it wherever the card
         lands inside a flow. */
      .testimonial-quote-slide + .testimonial-quote-slide {
        --space-before: var(--testimonial-quote-pad);

        margin-block-start: var(--testimonial-quote-pad);
      }

      /* --- the label -------------------------------------------------- */

      /* The gap under it is flow's own 24, which is what the design draws
         between the label and the words. Nothing to set: the eyebrow and the
         frame are both children of CustomSection's flow container, and the
         site-wide rule that pulls an eyebrow tight to a heading only fires on
         a heading, which the card is not. */
      .testimonial-quote-eyebrow {
        /* Centred, it is centred against the band, not against a card that
           may be 72% of it. The frame below does its own centring. */
        inline-size: 100%;
      }

      /* --- centred ------------------------------------------------------ */

      /* A band given over to a statement rather than to something somebody
         said. The words centre, and so does everything that hangs off them:
         left where they were, a centred quote came out with its face and its
         name tucked against the left edge of a card they were no longer
         anywhere near. */
      .testimonial-quote-card[data-align="center"] {
        text-align: center;
      }

      .testimonial-quote-card[data-align="center"] .testimonial-quote-foot,
      .testimonial-quote-card[data-align="center"] .testimonial-quote-who {
        justify-content: center;
      }

      /* The foot is a row with the mark pushed to its far end, which is what
         `space-between` is for and is wrong once the row is centred: with two
         things in it the person went left and the mark right, either side of
         the space they were meant to share. */
      .testimonial-quote-card[data-align="center"] .testimonial-quote-foot {
        flex-wrap: wrap;
      }

      .testimonial-quote-card[data-align="center"] .testimonial-quote-link {
        display: flex;
        justify-content: center;
      }

      /* --- the quote ------------------------------------------------- */

      .testimonial-quote-text {
        /* The base layer rules every blockquote down its left and pads it to
           clear that, which is right in running text and wrong for one that
           is the card. */
        border-left: 0;
        padding-left: 0;
        margin: 0;
      }

      /* On the paragraph as well as the blockquote. The quote is markdown, so
         what carries the words is a <p>, and the base layer sets a size and a
         colour on every <p>: set on the blockquote alone these measure as
         applied and draw at 16 in the band's own text colour. Colour is the
         one that shows: a light card on a dark band drew its quote cream on
         cream while the blockquote around it carried the midnight. */
      .testimonial-quote-text,
      .testimonial-quote-text p {
        color: var(--testimonial-quote-ink);
        font-size: var(--testimonial-quote-size);
        font-weight: 700;
        line-height: 1.3;
      }

      .testimonial-quote-text p {
        margin: 0;
      }

      .testimonial-quote-text p + p {
        margin-block-start: 0.6em;
      }

      /* The emphasis and the marks are the same colour, which is what ties
         the card together: the design marks a phrase in the card's accent and
         draws the quotes around the whole thing in it too. */
      /* Lifted from the quote. See the note on the element itself. */
      .testimonial-quote-slide:has(> .testimonial-quote-text[data-accent="sunset"]) {
        --testimonial-quote-accent: var(--sunset);
      }

      .testimonial-quote-slide:has(> .testimonial-quote-text[data-accent="golden"]) {
        --testimonial-quote-accent: var(--golden);
      }

      .testimonial-quote-slide:has(> .testimonial-quote-text[data-accent="pacific"]) {
        --testimonial-quote-accent: var(--pacific);
      }

      .testimonial-quote-slide:has(> .testimonial-quote-text[data-accent="moss"]) {
        --testimonial-quote-accent: var(--moss);
      }

      .testimonial-quote-slide:has(> .testimonial-quote-text[data-accent="peachy"]) {
        --testimonial-quote-accent: var(--peachy);
      }

      .testimonial-quote-slide:has(> .testimonial-quote-text[data-accent="harbour"]) {
        --testimonial-quote-accent: var(--harbour);
      }

      .testimonial-quote-slide:has(> .testimonial-quote-text[data-accent="blush"]) {
        --testimonial-quote-accent: var(--blush);
      }

      .testimonial-quote-text strong {
        color: var(--testimonial-quote-accent, inherit);
        font-weight: inherit;
      }

      .testimonial-quote-text[data-marks] {
        quotes: "\201C" "\201D";
      }

      .testimonial-quote-text[data-marks] > p:first-child::before {
        color: var(--testimonial-quote-accent, inherit);
        content: open-quote;
      }

      .testimonial-quote-text[data-marks] > p:last-child::after {
        color: var(--testimonial-quote-accent, inherit);
        content: close-quote;
      }

      /* --- the person ------------------------------------------------ */

      .testimonial-quote-who {
        align-items: center;
        display: flex;
        gap: var(--spacing-md);
        min-inline-size: 0;
      }

      .testimonial-quote-avatar {
        background: color-mix(in srgb, var(--testimonial-quote-ink) 10%, transparent);
        block-size: 56px;
        border-radius: 50%;
        display: block;
        flex-shrink: 0;
        inline-size: 56px;
        overflow: hidden;
      }

      .testimonial-quote-avatar img {
        block-size: 100%;
        display: block;
        inline-size: 100%;
        object-fit: cover;
      }

      /* The name and the role sit in a measure, not in whatever the foot has
         left over.

         Unbounded, "Director of Front-End Development, Insight Creative, Inc"
         ran 428 wide across the card's foot, which reads as a second line of
         copy rather than as a byline. The design sets these between 234 and
         330 — 271 for this one — so 21rem holds every one of them in the two
         lines it draws without wrapping the shorter ones. */
      .testimonial-quote-attribution {
        max-inline-size: 21rem;
        min-inline-size: 0;
      }

      .testimonial-quote-name {
        color: var(--testimonial-quote-ink);
        font-size: var(--testimonial-quote-name);
        font-weight: 500;
        line-height: 1.2;
        margin: 0;
      }

      /* Mono, which is what the design sets on the role: it reads as a label
         rather than as more of the quote. */
      /* The role and the company take a line each.

         Run together they wrapped wherever the measure happened to fall, so
         "Insight Creative, Inc" broke across two lines with "Development,"
         stranded beside it. A column breaks them where the meaning does. */
      .testimonial-quote-role {
        display: flex;
        flex-direction: column;

        color: var(--testimonial-quote-quiet);
        font-family: var(--font-monospace, ui-monospace, monospace);
        font-size: var(--testimonial-quote-meta);
        line-height: 1.4;
        margin: 0.25rem 0 0;
      }

      /* The company is the emphasis on that line, and it is a brightness
         rather than a weight: in mono at 13 a bolder cut reads as noise. */
      .testimonial-quote-company {
        color: var(--testimonial-quote-ink);
      }

      /* The link is the last thing in the card and it hangs off the right.

         The foot is a row with the person at one end and the client's mark at
         the other, so the link joins that row as its final item and the mark
         moves in beside it. On a card with no mark the link is simply the
         right-hand end. */
      .testimonial-quote-tail {
        display: flex;
        justify-content: flex-end;
        margin-inline-start: auto;
      }

      /* The right-hand end of the foot: the client's mark over the link,
         both aligned to the card's edge. The person keeps the left end and
         this takes whatever is left, so the two never meet in the middle. */
      .testimonial-quote-foot-end {
        display: grid;
        gap: var(--spacing-md);
        justify-items: end;
        margin-inline-start: auto;
      }

      .testimonial-quote-link {
        margin-block-start: 0;
      }

      /* The card's own colour and size, over the Button's. This file is in
         `page-sections`, which out-ranks `components`, so these win without
         having to out-specify anything. */
      .testimonial-quote-link .button-inner {
        color: var(--testimonial-quote-quiet);
        font-size: var(--testimonial-quote-meta);
        padding-block: 0;
        transition: color var(--animation-normal) var(--ease-in-out);
      }

      /* Only the words are ruled. The arrow is a glyph doing the same job as
         the underline, and run through by it as well it reads as struck out. */
      .testimonial-quote-link .label-text {
        text-decoration: underline;
        text-underline-offset: 0.35em;
      }

      /* The card's hover carries the link with it: the two are one gesture. */
      .testimonial-quote-card:hover .testimonial-quote-link .button-inner,
      .testimonial-quote-link:hover .button-inner,
      .testimonial-quote-link:focus-visible .button-inner,
      .testimonial-quote-card:hover .testimonial-quote-link .icon,
      .testimonial-quote-link:hover .icon {
        color: var(--testimonial-quote-accent, var(--testimonial-quote-ink));
      }

      /* --- static and carousel: quote, rule, person ------------------ */

      .testimonial-quote-foot {
        align-items: center;
        border-block-start: var(--border-width-sm) solid var(--testimonial-quote-edge);
        display: flex;
        flex-wrap: nowrap;
        gap: var(--spacing-xl);
        justify-content: space-between;
        margin-block-start: 32px;
        padding-block-start: 24px;
      }

      /* One box every client mark fits inside, whatever shape it is.

         Height alone does not hold: the marks are drawn at 239x50, 213x70 and
         201x66 in the design, so a single height gives a wide wordmark nearly
         twice the footprint of a squarer one — Firebrand came out 191 across
         against Insight's 120.

         So both dimensions are capped and whichever binds first wins. The
         width is the definite one and the height is left auto, because
         `aspect-ratio` only re-derives the other dimension while one of them
         is auto: set both and the cap squashes the mask instead of scaling
         it. A wide mark lands on the width cap, a tall one on the height,
         and neither leaves the box. */
      .testimonial-quote-logo {
        --logo-mark-width: 132px;
        --logo-mark-height: 34px;

        aspect-ratio: var(--logo-mark-aspect, 81 / 40);
        background-color: var(--testimonial-quote-quiet);
        /* The height is the definite one and the width follows from the
           ratio, so the mark always scales. Which cap binds is decided here
           rather than by `max-inline-size`: clamping a definite width against
           `aspect-ratio` does not re-derive the height, it just squashes —
           Insight Creative came out 132x34 where its own proportions want
           132x44. */
        block-size: min(
          var(--logo-mark-height),
          calc(var(--logo-mark-width) / var(--logo-mark-ratio, 2.025))
        );
        flex-shrink: 0;
        inline-size: auto;
      }

      /* A card with nothing drawn behind it.
 
         The case-study band has no quote card: the design paints the band,
         puts the client's mark in a box of its own and sets the quote straight
         on the pegboard beside it. Left on the default surface the card prints
         a near-black rectangle over the pattern, which reads as the band
         having a hole in it. */
      .testimonial-quote-card[data-tone="plain"] {
        background: none;
        padding: 0;
      }

      /* --- the splits ------------------------------------------------ */

      /* The rule is the column's own border rather than an element between
         them, so it runs the height of the taller side without being measured.

         22/78 is the sheet's: a 219 person column against a 771 quote in an
         1104 content box. */
      .testimonial-quote-card[data-layout="split-person"] .testimonial-quote-slide,
      .testimonial-quote-card[data-layout="split-quote"] .testimonial-quote-slide {
        /* Stretch, not start.

           The rule is the column's own border, so its length is that column's
           height: top-aligned, it stopped where the shorter side's text
           stopped and left a different amount of card under it than over it.
           Stretched, it runs the row, which puts the card's own padding above
           and below it equally. The content inside each column is held at the
           top separately. */
        align-items: stretch;
        column-gap: var(--testimonial-quote-pad);
        display: grid;
      }

      .testimonial-quote-card[data-layout="split-person"] .testimonial-quote-slide {
        grid-template-columns: minmax(0, 22%) minmax(0, 1fr);
      }

      .testimonial-quote-card[data-layout="split-quote"] .testimonial-quote-slide {
        grid-template-columns: minmax(0, 1fr) minmax(0, 22%);
      }

      /* Column order. The person is written after the quote in the markup
         either way, so the quote stays first for a reader and for a copy. */
      .testimonial-quote-card[data-layout="split-person"] .testimonial-quote-text {
        border-inline-start: var(--border-width-sm) solid var(--testimonial-quote-edge);
        grid-column: 2;
        padding-inline-start: var(--testimonial-quote-pad);
      }

      .testimonial-quote-card[data-layout="split-person"] .testimonial-quote-who {
        grid-column: 1;
        grid-row: 1;
      }

      /* The whole row, whichever side the quote is on.

         `1 / -1` is "every column there is", so one rule covers both splits
         and goes on working if the card is ever drawn in one column. Named
         columns meant a rule each, and each of them was the wrong end of the
         card for the other layout. Right-aligned, so the link lands on the
         card's own edge either way.

         `--space-before` as well as the margin: the flow layer writes
         `margin-block-start` from that property and `utils` out-ranks this
         layer, so a plain margin loses to it. */
      .testimonial-quote-card[data-layout="split-person"] .testimonial-quote-tail,
      .testimonial-quote-card[data-layout="split-quote"] .testimonial-quote-tail {
        --space-before: var(--spacing-xl);

        grid-column: 1 / -1;
        grid-row: 2;
        justify-self: end;
        margin-block-start: var(--spacing-xl);
      }

      /* Whichever column carries the rule spans both rows, so the rule still
         runs the card's full height with the link row under it.

         It is the column with the border on it that has to span, and that is
         not the same column in both layouts: `split-person` rules the quote
         and `split-quote` rules the person. Spanning the other one left the
         rule stopping 115 short of the card's foot, which reads as a line
         that ran out rather than as an edge between two columns. */
      .testimonial-quote-card[data-layout="split-person"] .testimonial-quote-slide,
      .testimonial-quote-card[data-layout="split-quote"] .testimonial-quote-slide {
        grid-template-rows: 1fr auto;
      }

      .testimonial-quote-card[data-layout="split-person"] .testimonial-quote-who,
      .testimonial-quote-card[data-layout="split-quote"] .testimonial-quote-text {
        grid-row: 1;
      }

      .testimonial-quote-card[data-layout="split-person"] .testimonial-quote-text,
      .testimonial-quote-card[data-layout="split-quote"] .testimonial-quote-who {
        grid-row: 1 / span 2;
      }

      .testimonial-quote-card[data-layout="split-quote"] .testimonial-quote-who {
        border-inline-start: var(--border-width-sm) solid var(--testimonial-quote-edge);
        grid-column: 2;
        padding-inline-start: var(--testimonial-quote-pad);
      }

      /* In a column of its own the person stacks, with a bigger face: the
         sheet draws 98 against the foot row's 78. Beside a quote this is the
         block's own heading rather than a byline under it. */
      .testimonial-quote-card[data-layout="split-person"] .testimonial-quote-who,
      .testimonial-quote-card[data-layout="split-quote"] .testimonial-quote-who {
        /* `align-content` as well as `align-items`: a grid's auto rows absorb
           the spare height a stretched column now has, so without it the face
           and the name drift apart to fill the card. */
        align-content: start;
        align-items: start;
        display: grid;
        gap: var(--spacing-lg);
      }

      .testimonial-quote-card[data-layout="split-person"] .testimonial-quote-avatar,
      .testimonial-quote-card[data-layout="split-quote"] .testimonial-quote-avatar {
        block-size: 72px;
        inline-size: 72px;
      }

      /* --- the carousel's controls ----------------------------------- */

      /* Placed against the card rather than inside a slide, because the
         slides swap and the controls do not. Level with the middle of the
         face in the foot, which is a fixed 56 from the card's bottom
         padding. */
      .testimonial-quote-nav {
        align-items: center;
        display: flex;
        gap: var(--spacing-lg);
        inset-block-end: calc(40px + 28px - 16px);
        inset-inline-end: var(--testimonial-quote-pad);
        position: absolute;
      }

      .testimonial-quote-dots {
        align-items: center;
        display: flex;
        gap: 0.5rem;
      }

      /* A dash rather than a dot, which is what the sheet draws, and the
         selected one takes the card's accent. */
      .testimonial-quote-dot {
        background: var(--testimonial-quote-quiet);
        block-size: 2px;
        border: 0;
        border-radius: 2px;
        cursor: pointer;
        inline-size: 12px;
        opacity: 0.5;
        padding: 0;
        transition:
          inline-size var(--animation-normal) var(--ease-in-out),
          opacity var(--animation-normal) var(--ease-in-out);
      }

      .testimonial-quote-dot[aria-selected="true"] {
        background: var(--testimonial-quote-accent, var(--testimonial-quote-ink));
        inline-size: 28px;
        opacity: 1;
      }

      .testimonial-quote-arrows {
        display: flex;
        gap: 0.5rem;
      }

      .testimonial-quote-arrow {
        align-items: center;
        background: none;
        block-size: 32px;
        border: var(--border-width-sm) solid var(--testimonial-quote-edge);
        border-radius: 50%;
        color: var(--testimonial-quote-quiet);
        cursor: pointer;
        display: flex;
        font-size: 1rem;
        inline-size: 32px;
        justify-content: center;
        line-height: 1;
        padding: 0;
        transition:
          border-color var(--animation-normal) var(--ease-in-out),
          color var(--animation-normal) var(--ease-in-out);
      }

      .testimonial-quote-arrow:hover,
      .testimonial-quote-arrow:focus-visible {
        border-color: var(--testimonial-quote-accent, var(--testimonial-quote-ink));
        color: var(--testimonial-quote-accent, var(--testimonial-quote-ink));
      }

      /* --- narrow ----------------------------------------------------- */

      /* The splits stack, and the padding comes in. Measured on the card
         rather than on the window, so a narrow card does this on a desktop
         too. */
      @container (width <= 680px) {
        .testimonial-quote-card {
          --testimonial-quote-pad: 24px;
          --testimonial-quote-pad-y: 32px;
        }

        /* The foot wraps rather than crushing the person.

           `nowrap` with a shrinkable `who` meant the mark and the link kept
           their width and the attribution gave up all of its: at 390 it came
           out 61 wide with the role over nine lines, one word to a line. The
           stack drops under the person instead. */
        .testimonial-quote-foot {
          flex-wrap: wrap;
          row-gap: var(--spacing-lg);
        }

        .testimonial-quote-foot-end {
          margin-inline-start: 0;
        }

        .testimonial-quote-card[data-layout="split-person"] .testimonial-quote-slide,
        .testimonial-quote-card[data-layout="split-quote"] .testimonial-quote-slide {
          display: block;
        }

        .testimonial-quote-card[data-layout="split-person"] .testimonial-quote-text,
        .testimonial-quote-card[data-layout="split-quote"] .testimonial-quote-who {
          border-inline-start: 0;
          padding-inline-start: 0;
        }

        .testimonial-quote-card[data-layout="split-person"] .testimonial-quote-who,
        .testimonial-quote-card[data-layout="split-quote"] .testimonial-quote-who {
          border-block-start: var(--border-width-sm) solid var(--testimonial-quote-edge);
          margin-block-start: 28px;
          padding-block-start: 24px;
        }

        .testimonial-quote-nav {
          inset-block-end: var(--testimonial-quote-pad);
        }
      }
    }
  }
</style>

