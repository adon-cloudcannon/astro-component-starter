---
/**
 * One quote, drawn as a card, in the four layouts the design draws it in.
 *
 * `downloaded-nodes/testimonial-quote-block.html` is a comparison sheet: four
 * layouts, each shown twice, once in Absoluttweb's colour and once in DX's.
 * Labelled there as 2a/2b (static, with the quote stepping down a size as it
 * gets longer), 2c (carousel), 2d (split, person left) and 2e (split, quote
 * left). The two static examples are one layout at two quote sizes rather
 * than two layouts, so there are four:
 *
 *   static        quote, a rule, then the person with the company's mark
 *   carousel      the same card, several quotes, dots and arrows
 *   split-person  the person in a column, a rule, the quote beside it
 *   split-quote   the same the other way round
 *
 * The sheet is drawn at about a 1280 card and this is built at the content
 * column, and its type is Outfit where the site sets Red Hat Display, so the
 * numbers do not carry across. What carries across is the structure. The type,
 * the colour and the spacing follow the testimonial bento instead, which is
 * the card this project has already settled: the quote bold at 1.3, the name
 * 18, the role and company 13 in mono, the marks and the emphasis in the
 * card's own accent, a rule between the quote and the person.
 */
import CustomSection from "@builders/custom-section/CustomSection.astro";
import { resolveImageSource } from "@component-utils/resolveImageSource";
import Button from "@core-elements/button/Button.astro";
import Image from "@core-elements/image/Image.astro";
import { renderMarkdown } from "@component-utils/markdown";

type Quote = {
  text?: string;
  authorName?: string;
  authorDescription?: string;
  company?: string;
  authorImage?: string;
  authorImageAlt?: string;
  logoSource?: string;
  logoAlt?: string;
  logoAspect?: string;
  linkText?: string;
  link?: string;
  accentColor?: string;
  quoteMarks?: boolean;
};

const {
  /**
   * Which of the four the design draws.
   *
   * `carousel` is the only one that reads more than the first quote.
   */
  variant = "static",
  quotes = [],
  /**
   * The quote's size, which the sheet steps down as the quote gets longer:
   * `lg` is Header 4 and `sm` is Header 5, the two the theme already sets.
   */
  quoteSize = "sm",
  /**
   * The card's own outline.
   *
   * Off. The design draws one, but it draws it on a card sitting on a flat
   * band; on a patterned band the rule reads as a box around the quote rather
   * than as the edge of a surface, and the fill is already enough to separate
   * the card from the band. The rule between the quote and the person is a
   * different thing and is always drawn.
   */
  bordered = false,
  /**
   * `base` is the design's near-black card, for a dark band. `light` is the
   * card for a cream one: light sand against the band's sand, which is the
   * "a shade off its band" relationship the project settles on.
   *
   * The accent does not move with it. On this band the design draws its
   * emphasis in the full-strength colour, #034AD8 on cream, so stepping it
   * down would be a correction the design has not asked for. The pastel
   * accents are for a dark ground and will not hold on a pale one.
   */
  tone = "base",
  /**
   * How much of the column the card takes.
   *
   * `medium`, 72%, is the default: it is what every testimonial on the site
   * was set to one at a time, so it is the house width rather than a per-band
   * choice. `full` runs the card to the whole column, and `narrow` is the
   * bento's wide card at 55% of the row.
   *
   * The splits stack below 680 of card. 72% of the 1040 column is 749, so a
   * split still draws side by side at the default.
   */
  cardWidth = "medium",
  sectionLabel,
  maxContentWidth = "xl",
  paddingHorizontal = "gutter",
  paddingVertical = "4xl",
  /**
   * Override one end of the vertical padding; empty follows paddingVertical.
   *
   * The band above a testimonial already carries its own bottom padding, so
   * the two stack: after the editor demo on Content Editors that came to 96
   * between the demo and the card. Trimming the top alone keeps the space
   * under the card where the design has it.
   */
  paddingVerticalStart = "",
  paddingVerticalEnd = "",
  colorScheme = "inherit",
  lockColorScheme = false,
  backgroundColor = "light-sand",
  background,
  haze = false,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const LAYOUTS = ["static", "carousel", "split-person", "split-quote"];
const layout = LAYOUTS.includes(String(variant)) ? String(variant) : "static";
const isSplit = layout.startsWith("split");
const isCarousel = layout === "carousel";

// Only the carousel reads past the first. Everything else draws one card, so a
// section left with four quotes and switched to `static` shows the first
// rather than four stacked cards.
const items: Quote[] = (isCarousel ? quotes : quotes.slice(0, 1)) as Quote[];
---

{items.length > 0 && (
  <CustomSection
    class:list={["testimonial-quote", className]}
    label={sectionLabel}
    maxContentWidth={maxContentWidth}
    paddingHorizontal={paddingHorizontal}
    paddingVertical={paddingVertical}
    paddingVerticalStart={paddingVerticalStart}
    paddingVerticalEnd={paddingVerticalEnd}
    colorScheme={colorScheme}
    lockColorScheme={lockColorScheme}
    backgroundColor={backgroundColor}
    background={background}
    haze={haze}
    useDefaultEditableBinding={useDefaultEditableBinding}
    {...htmlAttributes}
  >
    <div class="testimonial-quote-frame" data-width={cardWidth === "full" ? undefined : cardWidth}>
    <div
      class="testimonial-quote-card"
      data-layout={layout}
      data-quote-size={quoteSize === "lg" ? "lg" : undefined}
      data-bordered={bordered ? "" : undefined}
      data-tone={tone !== "base" ? tone : undefined}
      data-editable="array"
      data-prop="quotes"
    >
      {items.map((quote, index) => {
        const accent = quote.accentColor ? `var(--${quote.accentColor})` : undefined;
        const body = quote.text ? renderMarkdown(quote.text) : "";
        const marks = quote.quoteMarks !== false;

        /* Lifted out of the attribution: on the case-study band the link sits
           under the quote rather than under a name, and it is the same Button
           either way. */
        const linkButton = quote.linkText ? (
          <Button
            class="testimonial-quote-link"
            variant="text"
            size="sm"
            iconName="arrow-right"
            iconPosition="after"
            link={quote.link || undefined}
            data-prop="linkText"
          >
            {quote.linkText}
            {quote.company && <span class="visually-hidden"> about {quote.company}</span>}
          </Button>
        ) : null;

        const person = (
          <div class="testimonial-quote-who">
            {/* Always a disc, even with nothing in it: the design's card has
                a face at the head of its column, and without one the name
                starts hard against the card's edge and the whole block reads
                as a different composition. */}
            <span class="testimonial-quote-avatar">
              {quote.authorImage && (
                <Image
                  source={quote.authorImage}
                  alt={quote.authorImageAlt}
                  decorative={!quote.authorImageAlt}
                  data-prop-src="authorImage"
                  data-prop-alt="authorImageAlt"
                />
              )}
            </span>
            <div class="testimonial-quote-attribution">
              {quote.authorName && (
                <p class="testimonial-quote-name" data-prop="authorName">{quote.authorName}</p>
              )}
              {(quote.authorDescription || quote.company) && (
                <p class="testimonial-quote-role">
                  <span data-prop="authorDescription">{quote.authorDescription}</span>
                  {quote.company && (
                    <>
                      {quote.authorDescription && " "}
                      <span class="testimonial-quote-company" data-prop="company">{quote.company}</span>
                    </>
                  )}
                </p>
              )}
              {/* The Button, like every other arrow link on the site, so a
                  change to the button changes this one too. Its own
                  `.label-text` span is what takes the underline:
                  text-decoration propagates down and a child cannot take it
                  off, so ruled on the whole link the line ran under the arrow.
                  The card sets the size, the colour and the hover; the
                  component sets everything else. */}
              {linkButton}
            </div>
          </div>
        );

        return (
          <article
            class="testimonial-quote-slide"
            data-editable="array-item"
            data-id="page-sections/proof/testimonial-quote/testimonial-quote-item"
            data-component="page-sections/proof/testimonial-quote/testimonial-quote-item"
            data-index={index}
            data-active={index === 0 ? "" : undefined}
            hidden={isCarousel && index > 0}
            aria-roledescription={isCarousel ? "slide" : undefined}
            aria-label={isCarousel ? `${index + 1} of ${items.length}` : undefined}
          >
            {/* The marks are drawn in CSS. Written into the text they land on
                their own lines when the quote is more than one paragraph, and
                an editor has to remember to type them. */}
            {/* The accent rides on the quote and is lifted back to the slide
                in CSS.

                It was an inline style on the `<article>`, which is this
                slide's array-item root. CloudCannon keeps a region's root
                element and swaps only its contents, so an attribute set there
                from a prop never changes in the Visual Editor: picking a
                colour saved it and repainted nothing until a reload. The
                emphasised run, the quote marks and the link's arrow all read
                the property and all sit inside this slide, so a lift puts it
                back where they can see it.

                `lint:roots` does not catch this one. It reads the first
                element of a component's template, and an array item built
                inside a `.map()` is a region root it never looks at. */}
            <blockquote
              data-accent={quote.accentColor || undefined}
              class="testimonial-quote-text"
              data-marks={marks ? "" : undefined}
              data-prop="text"
              set:html={body}
            />

            {!isSplit && (
              <div class="testimonial-quote-foot">
                {person}
                {quote.logoSource && (
                  /* The repo's mask utility rather than a picture. A client
                     mark has its fills baked in, so an `<img>` of a white one
                     is invisible on a light card and a dark one is invisible
                     on a dark card; as a mask it takes the card's own quiet
                     ink either way. Same mechanism the logo row uses. */
                  <span
                    class="testimonial-quote-logo logo-mark"
                    role="img"
                    aria-label={quote.logoAlt || quote.company}
                    style={{
                      "--logo-mark-source": `url("${resolveImageSource(quote.logoSource)}")`,
                      ...(quote.logoAspect ? { "--logo-mark-aspect": quote.logoAspect } : {}),
                    }}
                    data-prop-src="logoSource"
                    data-prop-alt="logoAlt"
                  />
                )}
              </div>
            )}

            {isSplit && person}
          </article>
        );
      })}

      {isCarousel && items.length > 1 && (
        /* One set of controls for the card rather than one per slide: the
           slides swap, the controls do not. */
        <div class="testimonial-quote-nav">
          <div class="testimonial-quote-dots" role="tablist" aria-label="Quotes">
            {items.map((_, index) => (
              <button
                type="button"
                class="testimonial-quote-dot"
                role="tab"
                data-goto={index}
                aria-selected={index === 0 ? "true" : "false"}
                aria-label={`Quote ${index + 1}`}
              ></button>
            ))}
          </div>
          <div class="testimonial-quote-arrows">
            <button type="button" class="testimonial-quote-arrow" data-step="-1" aria-label="Previous quote">
              <span aria-hidden="true">&lsaquo;</span>
            </button>
            <button type="button" class="testimonial-quote-arrow" data-step="1" aria-label="Next quote">
              <span aria-hidden="true">&rsaquo;</span>
            </button>
          </div>
        </div>
      )}
    </div>
    </div>
  </CustomSection>
)}

<style is:global>
  @layer page-sections {
    .testimonial-quote {
      /* The frame carries the width and is what the card is measured against.

         A query container rather than a viewport breakpoint, because a card
         set to 55% of the column is as narrow at 1280 as a full-width one is
         on a tablet, and the splits have to stack for the same reason in
         both: a 22% person column is narrower than the face that goes in it.

         `justify-self`, not an auto inline margin: on a grid item the margin
         shrinks the item rather than centring it. */
      .testimonial-quote-frame {
        container-type: inline-size;
        inline-size: 100%;
        justify-self: center;
      }

      /* 55% is the bento's wide card, the one width this project has already
         decided on. */
      .testimonial-quote-frame[data-width="narrow"] {
        inline-size: 55%;
      }

      .testimonial-quote-frame[data-width="medium"] {
        inline-size: 72%;
      }

      /* Both widths are measures for a desktop column, and on a phone they
         are just a narrower page. 72% of the column at 375 left the card 248
         wide and the quote 200: "maintenance" needs 216 at this size, so
         `overflow-wrap` dropped its last letter onto the next line. The card
         takes the width it is given instead. */
      @media (width < 48rem) {
        .testimonial-quote-frame[data-width="narrow"],
        .testimonial-quote-frame[data-width="medium"] {
          inline-size: 100%;
        }
      }

      .testimonial-quote-card {
        /* The bento's card, at this one's size.

           Same surface, same edge, same ink: a quote card on a dark band has
           to be the same object whether it is one of four in a bento or on
           its own in a band, or the two read as different components. The
           padding is a step up from the bento's 40, because this card is the
           content column wide rather than a third of it. */
        --testimonial-quote-surface: var(--black);
        --testimonial-quote-edge: color-mix(in srgb, var(--gray-200, #d9d9d9) 8%, transparent);
        --testimonial-quote-ink: var(--color-text-strong);
        --testimonial-quote-quiet: var(--gray-400, #9a9a9a);
        --testimonial-quote-pad: 48px;
        /* Taller than it is wide, which is how the approved card is drawn: 80
           above and below against 88 either side, on a card the full width of
           its frame. Ours sits at 72% of the column, so the sides come in but
           the vertical stays generous. */
        --testimonial-quote-pad-y: 64px;
        /* Header 5. The sheet steps the quote down as it gets longer, and
           these are the two sizes the theme already draws. */
        --testimonial-quote-size: var(--font-size-heading-sm);
        --testimonial-quote-name: 1.125rem;
        --testimonial-quote-meta: 0.8125rem;

        background: var(--testimonial-quote-surface);
        border: 0;
        border-radius: var(--radius-card);
        padding: var(--testimonial-quote-pad-y, var(--testimonial-quote-pad)) var(--testimonial-quote-pad);
        position: relative;
      }

      /* The cream card. The edge is a midnight tint rather than the dark
         card's white one, or the rule between the quote and the person
         disappears into the fill. */
      .testimonial-quote-card[data-tone="light"] {
        --testimonial-quote-surface: var(--light-sand);
        --testimonial-quote-edge: color-mix(in srgb, var(--midnight) 12%, transparent);
        --testimonial-quote-ink: var(--midnight);
        --testimonial-quote-quiet: var(--gray-700, #5c5c5c);
      }

      .testimonial-quote-card[data-bordered] {
        border: var(--border-width-sm) solid var(--testimonial-quote-edge);
      }

      /* Header 4. */
      .testimonial-quote-card[data-quote-size="lg"] {
        --testimonial-quote-size: var(--font-size-heading-md);
      }

      /* Even, top and bottom. A lighter foot was a reading of the card as
         quote-with-a-footnote; the approved card draws 80 at both ends and the
         card looked cramped against its own quote without it. */

      .testimonial-quote-slide[hidden] {
        display: none;
      }

      /* --- the quote ------------------------------------------------- */

      .testimonial-quote-text {
        /* The base layer rules every blockquote down its left and pads it to
           clear that, which is right in running text and wrong for one that
           is the card. */
        border-left: 0;
        padding-left: 0;
        color: var(--testimonial-quote-ink);
        margin: 0;
      }

      /* On the paragraph as well as the blockquote. The quote is markdown, so
         what carries the words is a <p>, and the base layer sets a size on
         every <p>: set on the blockquote alone this measures as applied and
         draws at 16. */
      .testimonial-quote-text,
      .testimonial-quote-text p {
        font-size: var(--testimonial-quote-size);
        font-weight: 700;
        line-height: 1.3;
      }

      .testimonial-quote-text p {
        margin: 0;
      }

      .testimonial-quote-text p + p {
        margin-block-start: 0.6em;
      }

      /* The emphasis and the marks are the same colour, which is what ties
         the card together: the design marks a phrase in the card's accent and
         draws the quotes around the whole thing in it too. */
      /* Lifted from the quote. See the note on the element itself. */
      .testimonial-quote-slide:has(> .testimonial-quote-text[data-accent="sunset"]) {
        --testimonial-quote-accent: var(--sunset);
      }

      .testimonial-quote-slide:has(> .testimonial-quote-text[data-accent="golden"]) {
        --testimonial-quote-accent: var(--golden);
      }

      .testimonial-quote-slide:has(> .testimonial-quote-text[data-accent="pacific"]) {
        --testimonial-quote-accent: var(--pacific);
      }

      .testimonial-quote-slide:has(> .testimonial-quote-text[data-accent="moss"]) {
        --testimonial-quote-accent: var(--moss);
      }

      .testimonial-quote-slide:has(> .testimonial-quote-text[data-accent="peachy"]) {
        --testimonial-quote-accent: var(--peachy);
      }

      .testimonial-quote-slide:has(> .testimonial-quote-text[data-accent="harbour"]) {
        --testimonial-quote-accent: var(--harbour);
      }

      .testimonial-quote-slide:has(> .testimonial-quote-text[data-accent="blush"]) {
        --testimonial-quote-accent: var(--blush);
      }

      .testimonial-quote-text strong {
        color: var(--testimonial-quote-accent, inherit);
        font-weight: inherit;
      }

      .testimonial-quote-text[data-marks] {
        quotes: "\201C" "\201D";
      }

      .testimonial-quote-text[data-marks] > p:first-child::before {
        color: var(--testimonial-quote-accent, inherit);
        content: open-quote;
      }

      .testimonial-quote-text[data-marks] > p:last-child::after {
        color: var(--testimonial-quote-accent, inherit);
        content: close-quote;
      }

      /* --- the person ------------------------------------------------ */

      .testimonial-quote-who {
        align-items: center;
        display: flex;
        gap: var(--spacing-md);
        min-inline-size: 0;
      }

      .testimonial-quote-avatar {
        background: color-mix(in srgb, var(--testimonial-quote-ink) 10%, transparent);
        block-size: 56px;
        border-radius: 50%;
        display: block;
        flex-shrink: 0;
        inline-size: 56px;
        overflow: hidden;
      }

      .testimonial-quote-avatar img {
        block-size: 100%;
        display: block;
        inline-size: 100%;
        object-fit: cover;
      }

      .testimonial-quote-attribution {
        min-inline-size: 0;
      }

      .testimonial-quote-name {
        color: var(--testimonial-quote-ink);
        font-size: var(--testimonial-quote-name);
        font-weight: 500;
        line-height: 1.2;
        margin: 0;
      }

      /* Mono, which is what the design sets on the role: it reads as a label
         rather than as more of the quote. */
      .testimonial-quote-role {
        color: var(--testimonial-quote-quiet);
        font-family: var(--font-monospace, ui-monospace, monospace);
        font-size: var(--testimonial-quote-meta);
        line-height: 1.4;
        margin: 0.25rem 0 0;
      }

      /* The company is the emphasis on that line, and it is a brightness
         rather than a weight: in mono at 13 a bolder cut reads as noise. */
      .testimonial-quote-company {
        color: var(--testimonial-quote-ink);
      }

      .testimonial-quote-link {
        margin-block-start: var(--spacing-sm);
      }

      /* The card's own colour and size, over the Button's. This file is in
         `page-sections`, which out-ranks `components`, so these win without
         having to out-specify anything. */
      .testimonial-quote-link .button-inner {
        color: var(--testimonial-quote-quiet);
        font-size: var(--testimonial-quote-meta);
        padding-block: 0;
        transition: color var(--animation-normal) var(--ease-in-out);
      }

      /* Only the words are ruled. The arrow is a glyph doing the same job as
         the underline, and run through by it as well it reads as struck out. */
      .testimonial-quote-link .label-text {
        text-decoration: underline;
        text-underline-offset: 0.35em;
      }

      /* The card's hover carries the link with it: the two are one gesture. */
      .testimonial-quote-card:hover .testimonial-quote-link .button-inner,
      .testimonial-quote-link:hover .button-inner,
      .testimonial-quote-link:focus-visible .button-inner,
      .testimonial-quote-card:hover .testimonial-quote-link .icon,
      .testimonial-quote-link:hover .icon {
        color: var(--testimonial-quote-accent, var(--testimonial-quote-ink));
      }

      /* --- static and carousel: quote, rule, person ------------------ */

      .testimonial-quote-foot {
        align-items: center;
        border-block-start: var(--border-width-sm) solid var(--testimonial-quote-edge);
        display: flex;
        flex-wrap: nowrap;
        gap: var(--spacing-xl);
        justify-content: space-between;
        margin-block-start: 32px;
        padding-block-start: 24px;
      }

      /* The reference draws the mark 81x40 at the foot's far end. Height is
         what holds across marks of different proportions: a width would draw a
         wide wordmark and a square monogram at wildly different sizes. */
      .testimonial-quote-logo {
        aspect-ratio: var(--logo-mark-aspect, 81 / 40);
        background-color: var(--testimonial-quote-quiet);
        block-size: 40px;
        flex-shrink: 0;
        inline-size: auto;
        max-inline-size: 200px;
      }

      /* A card with nothing drawn behind it.
 
         The case-study band has no quote card: the design paints the band,
         puts the client's mark in a box of its own and sets the quote straight
         on the pegboard beside it. Left on the default surface the card prints
         a near-black rectangle over the pattern, which reads as the band
         having a hole in it. */
      .testimonial-quote-card[data-tone="plain"] {
        background: none;
        padding: 0;
      }

      /* --- the splits ------------------------------------------------ */

      /* --- the carousel's controls ----------------------------------- */

      /* Placed against the card rather than inside a slide, because the
         slides swap and the controls do not. Level with the middle of the
         face in the foot, which is a fixed 56 from the card's bottom
         padding. */
      .testimonial-quote-nav {
        align-items: center;
        display: flex;
        gap: var(--spacing-lg);
        inset-block-end: calc(40px + 28px - 16px);
        inset-inline-end: var(--testimonial-quote-pad);
        position: absolute;
      }

      .testimonial-quote-dots {
        align-items: center;
        display: flex;
        gap: 0.5rem;
      }

      /* A dash rather than a dot, which is what the sheet draws, and the
         selected one takes the card's accent. */
      .testimonial-quote-dot {
        background: var(--testimonial-quote-quiet);
        block-size: 2px;
        border: 0;
        border-radius: 2px;
        cursor: pointer;
        inline-size: 12px;
        opacity: 0.5;
        padding: 0;
        transition:
          inline-size var(--animation-normal) var(--ease-in-out),
          opacity var(--animation-normal) var(--ease-in-out);
      }

      .testimonial-quote-dot[aria-selected="true"] {
        background: var(--testimonial-quote-accent, var(--testimonial-quote-ink));
        inline-size: 28px;
        opacity: 1;
      }

      .testimonial-quote-arrows {
        display: flex;
        gap: 0.5rem;
      }

      .testimonial-quote-arrow {
        align-items: center;
        background: none;
        block-size: 32px;
        border: var(--border-width-sm) solid var(--testimonial-quote-edge);
        border-radius: 50%;
        color: var(--testimonial-quote-quiet);
        cursor: pointer;
        display: flex;
        font-size: 1rem;
        inline-size: 32px;
        justify-content: center;
        line-height: 1;
        padding: 0;
        transition:
          border-color var(--animation-normal) var(--ease-in-out),
          color var(--animation-normal) var(--ease-in-out);
      }

      .testimonial-quote-arrow:hover,
      .testimonial-quote-arrow:focus-visible {
        border-color: var(--testimonial-quote-accent, var(--testimonial-quote-ink));
        color: var(--testimonial-quote-accent, var(--testimonial-quote-ink));
      }

      /* --- narrow ----------------------------------------------------- */

      /* The splits stack, and the padding comes in. Measured on the card
