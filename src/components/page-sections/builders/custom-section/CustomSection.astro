---
import { overlayColor } from "@component-utils/overlayColor";
import Component from "@component-utils/renderBlock.astro";
import { resolveImageSource } from "@component-utils/resolveImageSource";
import { slugifyLabel } from "@component-utils/slugify";
import Image from "@core-elements/image/Image.astro";
import Video from "@core-elements/video/Video.astro";

const {
  label,
  contentSections,
  maxContentWidth,
  paddingHorizontal,
  paddingVertical = "4xl",
  /**
   * Override just one end of the vertical padding.
   *
   * The design is asymmetric where it matters and `paddingVertical` is one
   * value for both ends: the Partner Program form frame is 26 above its step
   * row and 120 below its submit, and the band above it is 136 over its
   * heading and 86 under it. Left empty, both follow `paddingVertical`.
   */
  paddingVerticalStart = "",
  paddingVerticalEnd = "",
  colorScheme = "inherit",
  lockColorScheme = false,
  backgroundColor = "base",
  background,
  /**
   * A soft pool of the band's own colour behind the content, so a heading
   * stays readable where an illustration or a pattern runs underneath. The
   * design uses it in fourteen places and leaves it off where the band is
   * plain — the Developers hero has none.
   */
  haze = false,
  rounded = false,
  useDefaultEditableBinding = false,
  class: className,
  _component,
  "data-children-prop": childrenDataProp,
  ...htmlAttributes
} = Astro.props;

const {
  type: bgType = "image",
  positionVertical = "top",
  positionHorizontal = "center",
  priority = false,
  imageSource = "",
  imageAlt = "",
  videoSource = "",
  overlay = 0,
  fixed = false,
  patternSize = "natural",
  pattern = "",
  mask = bgType === "pattern" ? "frame" : "none",
} = background || {};

// One layer per pool. A section can carry several: the AI Ready hero pools
// behind its heading and again behind its illustration, and `true` on its own
// still means one centred pool.
const hazePools = haze === true ? [{}] : Array.isArray(haze) ? haze : haze ? [haze] : [];

// Held in place while the page scrolls past. For an image that is parallax,
// which is what this was written for; for a colour or a pattern it is the band
// keeping still while its own content moves through it, which is what the
// design draws on the homepage deck and the dark steppers. The colour needs no
// source to be worth holding, so only the image type asks for one.
const usesFixedBackground = fixed && (bgType !== "image" || !!imageSource);

// A named shape is drawn rather than fetched, and beats any file still set on
// the block. `grid` and `pegboard` are the whole set the Design System page
// names, along with the scratched sheets: the denser band turned out to be
// the same peg board on a 33px pitch rather than a pattern of its own.
const patternShape = bgType === "pattern" && pattern ? pattern : null;
const patternImageUrl =
  bgType === "pattern" && !patternShape && imageSource ? resolveImageSource(imageSource) : null;

if (!htmlAttributes.id && label) {
  htmlAttributes.id = slugifyLabel(label);
}

const hasContentSections = contentSections !== undefined;
const effectiveChildrenProp =
  childrenDataProp ?? (useDefaultEditableBinding ? "contentSections" : null);
const arrayDataAttributes =
  effectiveChildrenProp && hasContentSections
    ? { "data-editable": "array", "data-prop": effectiveChildrenProp }
    : {};
---

<section
  class:list={["custom-section", className]}
  {...htmlAttributes}
>
  <div
    class:list={[
      "outer-content",
      rounded && "rounded",
      usesFixedBackground && "background-fixed",
      mask !== "none" && `background-mask-${mask}`,
    ]}
    data-theme={colorScheme && colorScheme !== "inherit" ? colorScheme : undefined}
    data-theme-lock={lockColorScheme || undefined}
  >
    {bgType === "image" && (
      <Image
        class:list={["background-image"]}
        source={imageSource}
        alt={imageAlt}
        priority={priority}
        positionVertical={positionVertical}
        positionHorizontal={positionHorizontal}
        background={true}
        sizes="100vw"
        widths={[640, 1280, 1920, 2560]}
      />
    )}
    {bgType === "video" && (
      <Video
        type="local-source"
        source={videoSource}
        background={true}
        style={{ "--background-position": `${positionHorizontal} ${positionVertical}` }}
      />
    )}
    {(patternShape || patternImageUrl) && (
      <div
        class:list={[
          "background-pattern",
          patternShape ? `pattern-${patternShape}` : `pattern-size-${patternSize}`,
        ]}
        aria-hidden="true"
        style={{
          ...(patternImageUrl ? { backgroundImage: `url("${patternImageUrl}")` } : {}),
        }}
      />
    )}
    {overlay !== 0 && (
      <div
        class="background-overlay"
        aria-hidden="true"
        style={{
          backgroundColor: overlayColor(overlay),
        }}
      />
    )}
    {backgroundColor && (
      <div class:list={["background", backgroundColor && `bg-${backgroundColor}`]} />
    )}
    {hazePools.map((pool) => (
      <div
        class="background-haze"
        aria-hidden="true"
        style={{
          ...(pool?.x !== undefined ? { "--haze-x": String(pool.x) } : {}),
          ...(pool?.rx ? { "--haze-rx": pool.rx } : {}),
          ...(pool?.y ? { "--haze-y": pool.y } : {}),
          ...(pool?.ry ? { "--haze-ry": pool.ry } : {}),
          ...(maxContentWidth ? { "--haze-track": `min(100%, var(--content-width-${maxContentWidth}))` } : {}),
        }}
      />
    ))}

    {/* Band-level art: drawn against the full width of the section rather than
        inside its content column. The closing CTAs hang illustrations off the
        band's own corners, and the content column cannot hold them — it is
        1040 or 1180 wide and centred, so a corner drawing placed in it sits
        well inside the edge it is supposed to run off. */}
    <slot name="band" />

    <div
      class:list={[
        "content",
        "flow",
        "uses-spacing-utils",
        paddingHorizontal && `pad-x-${paddingHorizontal}`,
        paddingVertical && `pad-y-${paddingVertical}`,
        maxContentWidth && `max-width-${maxContentWidth}`,
      ]}
      style={[
        paddingVerticalStart ? `padding-block-start: var(--spacing-${paddingVerticalStart})` : "",
        paddingVerticalEnd ? `padding-block-end: var(--spacing-${paddingVerticalEnd})` : "",
      ].filter(Boolean).join("; ") || undefined}
      {...arrayDataAttributes}
    >
      <slot>
        {contentSections && (
          <Component
            contentSections={contentSections}
            useDefaultEditableBinding={!!effectiveChildrenProp}
          />
        )}
      </slot>
    </div>
  </div>
</section>

<style is:global>
  @layer components {
    @property --section-inline-size {
      syntax: "<length>";
      inherits: true;
      initial-value: 0px;
    }

    .custom-section {
      /* Re-declared per section so a nested section never inherits an
         ancestor's mask. */
      --bg-mask: none;

      > .outer-content {
        container-type: inline-size;
        height: 100%;
        position: relative;

        /* clip, not hidden — hidden makes a scroll container and kills sticky
           descendants. */
        &:has([data-bleed]) {
          overflow-x: clip;
        }

        &.rounded {
          border-radius: var(--radius-xl);
          overflow: hidden;
        }

        &.background-fixed {
          /* Clips the held layers back to the band. It also makes this the
             containing block for them, which is what keeps a fixed layer the
             size of the section rather than the size of the window. */
          clip-path: inset(0);

          > .background,
          > .background-image,
          > .background-pattern {
            position: fixed;
          }

          &.rounded {
            clip-path: inset(0 round var(--radius-xl));
          }
        }

        > .content {
          --section-inline-size: 100cqi;
          /* Distance from the container edge to the content edge. Above the
             content width that is the centring margin; below it the element is
             full width and the gutter is all there is. */
          --section-bleed: max(
            calc(
              (
                  var(--section-inline-size) -
                    var(--section-max-width, var(--section-inline-size))
                ) /
                2
            ),
            var(--section-pad-x, 0px)
          );

          container-type: inline-size;
          height: 100%;
          margin-inline: auto;
          position: relative;
          z-index: var(--layer-1);

          &.max-width-none {
            max-width: none;
          }

          &.max-width-xs {
            --section-max-width: var(--content-width-xs);

            max-width: calc(
              var(--content-width-xs) + var(--section-pad-x, 0px) * 2
            );
          }

          &.max-width-sm {
            --section-max-width: var(--content-width-sm);

            max-width: calc(
              var(--content-width-sm) + var(--section-pad-x, 0px) * 2
            );
          }

          &.max-width-md {
            --section-max-width: var(--content-width-md);

            max-width: calc(
              var(--content-width-md) + var(--section-pad-x, 0px) * 2
            );
          }

          &.max-width-lg {
            --section-max-width: var(--content-width-lg);

            max-width: calc(
              var(--content-width-lg) + var(--section-pad-x, 0px) * 2
            );
          }

          &.max-width-xl {
            --section-max-width: var(--content-width-xl);

            max-width: calc(
              var(--content-width-xl) + var(--section-pad-x, 0px) * 2
            );
          }

          &.max-width-2xl {
            --section-max-width: var(--content-width-2xl);

            max-width: calc(
              var(--content-width-2xl) + var(--section-pad-x, 0px) * 2
            );
          }

          &.max-width-3xl {
            --section-max-width: var(--content-width-3xl);

            max-width: calc(
              var(--content-width-3xl) + var(--section-pad-x, 0px) * 2
            );
          }

          &.pad-x-xs {
            --section-pad-x: var(--spacing-xs);
          }

          &.pad-x-sm {
            --section-pad-x: var(--spacing-sm);
          }

          &.pad-x-md {
            --section-pad-x: var(--spacing-md);
          }

          &.pad-x-lg {
            --section-pad-x: var(--spacing-lg);
          }

          &.pad-x-xl {
            --section-pad-x: var(--spacing-xl);
          }

          &.pad-x-2xl {
            --section-pad-x: var(--spacing-2xl);
          }

          &.pad-x-3xl {
            --section-pad-x: var(--spacing-3xl);
          }

          &.pad-x-4xl {
            --section-pad-x: var(--spacing-4xl);
          }

          &.pad-x-5xl {
            --section-pad-x: var(--spacing-5xl);
          }

          &.pad-x-6xl {
            --section-pad-x: var(--spacing-6xl);
          }

          &.pad-x-gutter {
            --section-pad-x: var(--spacing-gutter);
          }
        }

        /* Text on a brand band. Deliberately not a colour scheme: a scheme
           re-themes the band as well as the text, and under dark
           --color-brand is Harbour, so asking for Pacific got a pale blue
           band instead. --color-text-on-brand already flips with the theme,
           so this stays right in both. */
        /* On the content only, never on the wrapper: .bg-brand is a sibling
           that reads --color-brand for its own fill, so rebinding it higher up
           repaints the band with the text colour. --color-brand goes with them
           because a text button and a link both draw in it, and Pacific on a
           Pacific band is invisible, which is how the second button in the
           homepage's closing CTA disappeared. */
        &:has(> .bg-brand) > .content {
          --color-text: var(--color-text-on-brand);
          --color-text-muted: var(--color-text-on-brand);
          --color-text-strong: var(--color-text-on-brand);

          /* A text button draws in --color-brand, which is the band it is
             sitting on, so it came out invisible. Set here rather than by
             rebinding --color-brand, because --color-bg-brand was already
             substituted from it at the root and would not follow. */
          .button-inner.variant-text {
            color: var(--color-text-on-brand);

            /* The arrow goes with it. Off a brand band it is the only part
               drawn in the brand colour, which here is the band itself. */
            .icon {
              color: var(--color-text-on-brand);
            }
          }

          /* The design inverts the pill on a brand band: light fill, dark
             label, which is the one pairing that reads on the colour. */
          .button-inner.variant-primary {
            background-color: var(--color-text-on-brand);
            color: var(--color-text-on-muted);
          }
        }

        > .background-overlay {
          inset: 0;
          position: absolute;
          z-index: var(--layer-1);
        }

        > .background {
          inset: 0;
          position: absolute;
        }

        > .background-image {
          z-index: var(--layer-1);
        }

        /* Pooled behind the heading and blurred, which is what keeps the text
           readable where art or a pattern runs under it. The design draws the
           same shape every time: opaque at the centre, 80% at 38%, 55% at 60%,
           gone by 78%, under a 20px blur.

           Above the image and the pattern, below the content. The colour is
           --color-bg rather than a fixed cream, so a band that locks itself
           dark hazes in #1D1B17 the way the design has it. */
        > .background-haze {
          /* Measured against the content column, not the band. The design's
             numbers are shares of a 1280 frame, but the text a pool sits
             behind is in the 1040 column, so on a wider window the column
             moves right while a band-relative percentage stays put and the
             pool slides off to the left of the heading.

             The layer itself stays full-bleed, because the pool spills past
             the column — the homepage hero's starts 198px outside it — and a
             gradient is only painted within its own box.

             The radius is a length, not a calc: a radial-gradient's *size*
             rejects math functions where its position accepts them, and a
             calc there makes the whole declaration invalid, so the pool
             disappears rather than degrading. */
          background-image: radial-gradient(
            ellipse var(--haze-rx, 50%) var(--haze-ry, 80%) at
              calc(
                50% - var(--haze-track, 100%) / 2 + var(--haze-track, 100%) *
                  var(--haze-x, 0.5)
              )
              var(--haze-y, 50%),
            var(--haze-color, var(--color-bg)) 0%,
            color-mix(in srgb, var(--haze-color, var(--color-bg)) 80%, transparent) 38%,
            color-mix(in srgb, var(--haze-color, var(--color-bg)) 55%, transparent) 60%,
            transparent 78%
          );
          filter: blur(20px);
          /* Clipped to its own band. A blur paints outside the box it is on,
             and a pool whose vertical radius is larger than the section — the
             homepage team wall's reaches 237% of it — is still at full
             strength when it meets the edge, so the blur smeared a bar of
             colour into the sections above and below. clip-path runs after
             filter, so this cuts the blurred result rather than the source. */
          clip-path: inset(0);
          inset: 0;
          pointer-events: none;
          position: absolute;
          /* The same layer as the pattern and the content, which both sit at
             --layer-1. All three tie, so DOM order decides, and this is
             written between them: above the pattern, below the content.

             Neither neighbour works. Left at `auto` it drops under the
             pattern and does nothing at all, since the pool is the same cream
             as the band and only shows by hiding the grid. At --layer-2 it
             clears the content and fogs the heading and the illustration. */
          z-index: var(--layer-1);
        }

        > .background-pattern {
          /* One pitch, one rule, one dot, for every band.

             The design is not actually this consistent — it draws the peg
             board at 40, 33 and 21, with a 6px dot on the first and about 4.2
             on the other two — but those are near-identical patterns, and
             carrying them meant every band had to choose between them.
             Deliberately dropped: one peg board and one grid is the whole set,
             which is the count the Design System page gives too. See
             CLAUDE.md.

             The numbers themselves are measured. The rule is 2px solid with no
             anti-aliasing of its own, read off the tile this replaced where it
             sits at x=38,39 of 40; the dot is 6px across. Overridable in CSS
             if a band ever genuinely needs it, but not from content. */
          --pattern-pitch: 40px;
          --pattern-rule: 2px;
          --pattern-dot: 6px;

          background-position: top left;
          background-repeat: repeat;
          inset: 0;
          position: absolute;
          z-index: var(--layer-1);

          /* Drawn, not fetched. The ink is a tint of the band (see
             --pattern-ink in the theme files), so one rule covers a cream
             band, a dark sand one and a black one. */
          &.pattern-grid {
            background-image:
              repeating-linear-gradient(
                to right,
                var(--pattern-ink) 0 var(--pattern-rule),
                transparent var(--pattern-rule) var(--pattern-pitch)
              ),
              repeating-linear-gradient(
                to bottom,
                var(--pattern-ink) 0 var(--pattern-rule),
                transparent var(--pattern-rule) var(--pattern-pitch)
              );
          }

          /* Half a pixel of feather on the edge. The tile these replaced
             carried its own anti-aliasing — a 6px dot was 16 core pixels with
             16 more part-way — and a hard colour stop draws a stair instead. */
          &.pattern-pegboard {
            background-image: radial-gradient(
              circle at center,
              var(--pattern-ink-pegboard) 0 calc(var(--pattern-dot) / 2 - 0.5px),
              transparent calc(var(--pattern-dot) / 2 + 0.5px)
            );
            background-size: var(--pattern-pitch) var(--pattern-pitch);
          }

          &.pattern-size-natural {
            background-size: auto;
          }

          &.pattern-size-sm {
            background-size: 2rem auto;
          }

          &.pattern-size-md {
            background-size: 4rem auto;
          }

          &.pattern-size-lg {
            background-size: 8rem auto;
          }
        }

        > .video.background {
          z-index: var(--layer-1);
        }

        /* Each variant below only sets --bg-mask; this is the one rule that
           applies it to the media layers. */
        > :is(.background-image, .background-pattern, .background-overlay, .video.background) {
          -webkit-mask-image: var(--bg-mask, none);
          mask-image: var(--bg-mask, none);
        }

        &.background-mask-frame {
          --bg-mask: radial-gradient(ellipse 90% 90% at 50% 50%, transparent 30%, #000 80%);
        }

        &.background-mask-vignette {
          --bg-mask: radial-gradient(ellipse 90% 90% at 50% 50%, #000 40%, transparent 88%);
        }

        &.background-mask-top {
          --bg-mask: linear-gradient(to top, #000 30%, transparent 85%);
        }

        /* Full at the top edge and gone before the bottom. The design's
           pegboard thins out down the band rather than holding one strength,
           and measuring it off the export gives a straight ramp reaching
           nothing at about 92%. `bottom` below holds full to 30% first, which
           is too strong through the middle. */
        &.background-mask-fade {
          --bg-mask: linear-gradient(to bottom, #000, transparent 92%);
        }

        &.background-mask-bottom {
          --bg-mask: linear-gradient(to bottom, #000 30%, transparent 85%);
        }

        &.background-mask-left {
          --bg-mask: linear-gradient(to left, #000 30%, transparent 85%);
        }

        &.background-mask-right {
          --bg-mask: linear-gradient(to right, #000 30%, transparent 85%);
        }

        &.background-mask-blend {
          --bg-mask: linear-gradient(to bottom, transparent, #000 20%, #000 80%, transparent);
        }

        > .bg-base {
          background-color: var(--color-bg);
        }

        > .bg-surface {
          background-color: var(--color-bg-surface);
        }

        /* The token has always been here; the section just had no way to ask
           for it. The design paints a handful of bands in the deeper sand. */
        > .bg-muted {
          background-color: var(--color-bg-muted);
        }

        > .bg-accent {
          background-color: var(--color-bg-accent);
        }

        /* The design bands three CTAs in the brand colour. The accent slot
           holds Harbour, a far lighter blue, so this is its own slot rather
           than a retarget. */
        > .bg-brand {
          background-color: var(--color-bg-brand);
        }

        > .bg-highlight {
          background-color: var(--color-bg-highlight);
        }
      }
    }

    /* Parallax scrolling is a common vestibular trigger — fall back to a
       regular background image. */
    @media (prefers-reduced-motion: reduce) {
      .custom-section > .outer-content.background-fixed > .background-image {
        position: absolute;
      }
    }
  }
</style>
