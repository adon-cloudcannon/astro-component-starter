---
import { bandPattern, bandHaze } from "@component-utils/bandStyle.mjs";
import { nestedProps } from "@component-utils/nestedProps.mjs";
import CustomSection from "@builders/custom-section/CustomSection.astro";
import { subtextMeasure } from "@component-utils/subtextMeasure.mjs";
import Heading from "@core-elements/heading/Heading.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Text from "@core-elements/text/Text.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";

/* `content` and `style` are the editor's tabs, flattened straight back into
   the names below. `at()` writes the frontmatter path a binding needs. */
const { props, at } = nestedProps(Astro.props, {
  nest: {
    heading: ["eyebrow", "heading", "headingLevel", "headingSize"],
    subtext: ["subtext", "subtextSize", "subtextWidth"],
  },
});

const {
  eyebrow = "",
  heading = "",
  headingLevel = "h1",
  headingSize = "2xl",
  subtext = "",
  /** Body 4, 3 or Subtitle 1. The design sets Large on this hero. */
  subtextSize = "lg",
  /**
   * The measure the supporting line is set in.
   *
   * A centred line wants one: run to the full column it reads as a different
   * block from the design's, which draws this one at 581 in the 1040 column.
   */
  subtextWidth = "",
  buttonSections = [],
  sectionLabel,
  maxContentWidth = "xl",
  paddingHorizontal = "gutter",
  paddingVertical = "4xl",
  colorScheme = "inherit",
  lockColorScheme = false,
  backgroundColor = "light-sand",
  /** The texture behind the band, by name. */
  pattern = "none",
  /** Which edge the texture fades out towards. */
  fade = "none",
  /** Whether the heading sits on a pool of the band’s own colour. */
  haze = false,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = props;

const subtextCap = subtextMeasure(subtextWidth);
---

<CustomSection
  class:list={["hero-center", className]}
  label={sectionLabel}
  maxContentWidth={maxContentWidth}
  paddingHorizontal={paddingHorizontal}
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  lockColorScheme={lockColorScheme}
  backgroundColor={backgroundColor}
  background={bandPattern(pattern, fade)}
  haze={bandHaze(haze)}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  <SimpleText
    alignmentHorizontal="center"
    class="eyebrow"
    data-prop={at("eyebrow")}
    text={eyebrow}
    size="sm"
  />
  <Heading
    level={headingLevel}
    size={headingSize}
    alignmentHorizontal="center"
    data-prop={at("heading")}
  >
    {heading}
  </Heading>
  <Text
    alignmentHorizontal="center"
    class="subtext"
    style={subtextCap ? `max-inline-size: ${subtextCap}; margin-inline: auto` : undefined}
    size={subtextSize}
    data-prop={at("subtext")}
    text={subtext}
  />
  <ButtonGroup
    buttonSections={buttonSections}
    alignmentHorizontal="center"
    data-children-prop={at("buttonSections")}
  />
</CustomSection>
