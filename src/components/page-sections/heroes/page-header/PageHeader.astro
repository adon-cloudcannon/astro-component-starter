---
import { bandPattern, bandHaze } from "@component-utils/bandStyle.mjs";
import { nestedProps } from "@component-utils/nestedProps.mjs";
import CustomSection from "@builders/custom-section/CustomSection.astro";
import { subtextMeasure } from "@component-utils/subtextMeasure.mjs";
import Heading from "@core-elements/heading/Heading.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Text from "@core-elements/text/Text.astro";
import Breadcrumbs from "@navigation/breadcrumbs/Breadcrumbs.astro";
import { trailFromPathname } from "@component-utils/breadcrumbTrail";

/* `content` and `style` are the editor's tabs, flattened straight back into
   the names below. `at()` writes the frontmatter path a binding needs. */
const { props, at } = nestedProps(Astro.props);

const {
  eyebrow = "",
  heading = "",
  headingLevel = "h1",
  subtext = "",
  // Body 3 at 19 or Subtitle 1 at 22 in the design; `md` keeps the 16 every
  // section rendered before either was carried through.
  subtextSize = "md",
  /**
   * The measure the design sets the supporting line in, in pixels.
   *
   * Not the column it sits in: a centred subtext is drawn at about 580 in the
   * 1040 column, and run the full width it reads as a different block.
   */
  subtextWidth,
  showBreadcrumbs = true,
  alignmentHorizontal = "start",
  sectionLabel,
  maxContentWidth = "xl",
  paddingHorizontal = "gutter",
  paddingVertical = "2xl",
  colorScheme = "inherit",
  lockColorScheme = false,
  backgroundColor = "light-sand",
  /** The texture behind the band, by name. */
  pattern = "none",
  /** Which edge the texture fades out towards. */
  fade = "none",
  /** Whether the heading sits on a pool of the band’s own colour. */
  haze = false,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = props;

/* The measure the subtext is set in, as a length. */
const subtextCap = subtextMeasure(subtextWidth);

// The trail comes from the page's own URL — nested paths become linked
// ancestors, and the heading names the current page. CloudCannon re-renders a
// component region by running this file in the browser, where there is no
// request and `Astro.url` is undefined; the shells stamp the path onto
// `<html data-pathname>` so the trail survives that render instead of
// disappearing for the whole editing session.
const pathname =
  Astro.url?.pathname ??
  (typeof document === "undefined" ? "" : (document.documentElement.dataset.pathname ?? ""));
const trail = showBreadcrumbs && pathname ? trailFromPathname(pathname, heading) : [];
---

<CustomSection
  class:list={["page-header", className]}
  label={sectionLabel}
  maxContentWidth={maxContentWidth}
  paddingHorizontal={paddingHorizontal}
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  lockColorScheme={lockColorScheme}
  backgroundColor={backgroundColor}
  background={bandPattern(pattern, fade)}
  haze={bandHaze(haze)}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  {showBreadcrumbs && trail.length > 0 && (
    <Breadcrumbs
      class:list={["page-header-breadcrumbs", `align-${alignmentHorizontal}`]}
      items={trail}
    />
  )}
  <SimpleText
    alignmentHorizontal={alignmentHorizontal}
    class="eyebrow"
    data-prop={at("eyebrow")}
    text={eyebrow}
    size="sm"
  />
  <Heading
    class="page-header-heading"
    level={headingLevel}
    size="lg"
    alignmentHorizontal={alignmentHorizontal}
    data-prop={at("heading")}
  >
    {heading}
  </Heading>
  <Text
    class="page-header-subtext"
    alignmentHorizontal={alignmentHorizontal}
    data-prop={at("subtext")}
    style={subtextCap ? `max-inline-size: ${subtextCap}; margin-inline: auto; justify-self: center` : undefined}    size={subtextSize}    text={subtext}
  />
</CustomSection>

<style is:global>
  @layer page-sections {
    .page-header {
      .page-header-breadcrumbs {
        margin-bottom: var(--spacing-md);
      }

      .page-header-subtext {
        max-width: 42rem;
      }

      /* Alignment is read off the children that carry it — a prop-driven class
         on this region root goes stale in the editor. */
      .page-header-breadcrumbs.align-center .breadcrumbs-trail {
        justify-content: center;
      }

      .page-header-subtext:has(> .text-inner.align-center) {
        margin-inline: auto;
      }
    }
  }
</style>
