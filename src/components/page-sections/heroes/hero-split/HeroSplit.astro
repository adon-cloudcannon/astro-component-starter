---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Image from "@core-elements/image/Image.astro";
import List from "@core-elements/list/List.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Text from "@core-elements/text/Text.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";
import Split from "@wrappers/split/Split.astro";

const {
  eyebrow = "",
  heading = "",
  headingLevel = "h1",
  headingSize = "2xl",
  subtext = "",
  imageSource = "",
  imageAlt = "",
  imageAspectRatio = "none",
  imageBleed = false,
  // The design's hero images run from 38% to 73% of the content column, because
  // they are drawn oversized and overlap the text rather than sitting beside
  // it. No single ratio reproduces all of them; half is the closest one, and
  // sits on the cluster four of the ten pages fall in. Pages whose illustration
  // is drawn past the frame edge are what imageBleed is for.
  distributionMode = "half",
  buttonSections = [],
  note = [],
  reverse = false,
  imageRounded = true,
  sectionLabel,
  maxContentWidth = "xl",
  paddingHorizontal = "gutter",
  paddingVertical = "4xl",
  colorScheme = "inherit",
  lockColorScheme = false,
  backgroundColor = "base",
  background,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const bleedSide = imageBleed ? (reverse ? "inline-start" : "inline-end") : undefined;
const imagePositionHorizontal = imageBleed ? (reverse ? "right" : "left") : "center";
const imagePositionVertical = imageBleed ? "top" : "center";
---

<CustomSection
  label={sectionLabel}
  maxContentWidth={maxContentWidth}
  paddingHorizontal={paddingHorizontal}
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  lockColorScheme={lockColorScheme}
  backgroundColor={backgroundColor}
  background={background}
  class:list={["hero-split", className]}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  <Split
    distributionMode={distributionMode}
    data-bleed={bleedSide}
    alignmentVertical="center"
    reverse={reverse}
    minSplitWidth={800}
    gap="2xl"
    class="hero-split-layout"
  >
    <Fragment slot="first">
      <SimpleText
        class="eyebrow"
        data-prop="eyebrow"
        text={eyebrow}
        size="sm"
      />
      <Heading
        level={headingLevel}
        size={headingSize}
        data-prop="heading"
      >
        {heading}
      </Heading>
      <Text
        class="subtext"
        data-prop="subtext"
        text={subtext}
        size="xl"
      />
      <ButtonGroup
        class="buttons-container"
        buttonSections={buttonSections}
        data-children-prop="buttonSections"
      />
      <List
        class="note"
        items={note}
        listType="icon"
        direction="horizontal"
        size="sm"
        spaceBefore="snug"
        data-children-prop="note"
      />
    </Fragment>
    <Fragment slot="second">
      <Image
        source={imageSource}
        alt={imageAlt}
        rounded={imageRounded}
        aspectRatio={imageAspectRatio}
        positionHorizontal={imagePositionHorizontal}
        positionVertical={imagePositionVertical}
        sizes={imageBleed ? "(max-width: 800px) 100vw, 60vw" : undefined}
        widths={imageBleed ? [640, 1280, 1920, 2560] : undefined}
        data-prop-src="imageSource"
        data-prop-alt="imageAlt"
        priority={true}
      />
    </Fragment>
  </Split>
</CustomSection>
