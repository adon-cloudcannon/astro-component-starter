---
import { bandPattern } from "@component-utils/bandStyle.mjs";
import { nestedProps } from "@component-utils/nestedProps.mjs";
import CustomSection from "@builders/custom-section/CustomSection.astro";
import { subtextMeasure } from "@component-utils/subtextMeasure.mjs";
import Heading from "@core-elements/heading/Heading.astro";
import Image from "@core-elements/image/Image.astro";
import List from "@core-elements/list/List.astro";
import Text from "@core-elements/text/Text.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";
import Split from "@wrappers/split/Split.astro";

/* `content` and `style` are the editor's tabs, flattened straight back into
   the names below. `at()` writes the frontmatter path a binding needs. */
const { props, at } = nestedProps(Astro.props, {
  /* `reverse` paints the band's two halves the other way round, so it sits
     with the rest of the band's look rather than with the copy. */
  extraStyleKeys: ["reverse"],
  /* The heading's level and size belong with the heading, and everything
     about the picture with the picture. */
  nest: {
    heading: ["heading", "headingLevel", "headingSize"],
    image: [
      "imageSource",
      "imageAlt",
      "imageAspectRatio",
      "imageOverflow",
      "imageBleed",
      "imageRounded",
    ],
    subtext: ["subtext", "subtextSize", "subtextWidth"],
  },
});

const {
  heading = "",
  headingLevel = "h1",
  headingSize = "2xl",
  subtext = "",
  // The design sets this in Body 3 at 19 or Subtitle 1 at 22; the default
  // keeps the 16 every section used before either was carried through.
  /* The hero's supporting line is Subtitle 1 on all eleven heroes, so the
     size is the component's rather than a per-page choice. Still a prop: the
     pages set it explicitly today and a hidden input keeps working. */
  subtextSize = "xl",
  /**
   * The measure the design sets the supporting line in, in pixels.
   *
   * Not the column it sits in: a centred subtext is drawn at about 580 in the
   * 1040 column, and run the full width it reads as a different block.
   */
  subtextWidth,
  imageSource = "",
  imageAlt = "",
  imageAspectRatio = "none",
  imageBleed = false,
  imageOverflow = 0,
  // The design's hero images run from 38% to 73% of the content column, because
  // they are drawn oversized and overlap the text rather than sitting beside
  // it. No single ratio reproduces all of them; half is the closest one, and
  // sits on the cluster four of the ten pages fall in. Pages whose illustration
  // is drawn past the frame edge are what imageBleed is for.
  distributionMode = "half",
  buttonSections = [],
  note = [],
  reverse = false,
  imageRounded = true,
  sectionLabel,
  maxContentWidth = "xl",
  paddingHorizontal = "gutter",
  paddingVertical = "4xl",
  colorScheme = "inherit",
  lockColorScheme = false,
  /**
   * The band's colour, by the name the design calls it.
   *
   * Passed straight down: the builder knows the names now, and expands each
   * one into the token, the scheme and the lock. This used to be a table here,
   * which was the right shape in the wrong place, since every other section
   * needed it too.
   */
  backgroundColor = "light-sand",
  /**
   * The texture behind the band, by name.
   *
   * The builder's `background` is an image, a video or a pattern, each with
   * its own focal point, fade, overlay and tile size. A hero uses one corner
   * of that: every one of the twelve draws a pattern, nine a grid and three a
   * peg board, and not one sets anything else. So the section takes the name
   * and writes the object, the same way it takes a band colour and writes a
   * token.
   */
  pattern = "grid",
  /** Which edge the texture fades out towards. */
  fade = "none",
  /**
   * Whether the heading sits on a pool of the band's own colour.
   *
   * Where it goes is not a question worth asking: it goes behind the copy, and
   * the design agrees. Eleven of the twelve heroes carry a measured pool, and
   * every one of the nine copy-left heroes centres it between 0.11 and 0.26 of
   * the column while both copy-right heroes put it at 0.67 and 0.70. That is
   * one rule with a mirror in it, not eleven measurements, so it is computed
   * below and the numbers are gone.
   *
   * The switch stays because one hero genuinely has none: the Developers hero
   * is drawn without a pool, on #FFFFFF where every other is #FFFCF3.
   */
  haze = true,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = props;

/* The measure the subtext is set in, as a length. */
const subtextCap = subtextMeasure(subtextWidth);

/**
 * The pattern, as the builder's own background object.
 *
 * `fixed`, `mask` and `overlay` are the builder's defaults written out, so
 * switching a hero's pattern cannot leave a stale key behind from whatever it
 * was before.
 */
const backgroundPattern = bandPattern(pattern, fade);

/**
 * One pool, behind the copy.
 *
 * Averaged off the design's own eleven rather than invented: the copy-left
 * heroes centre between 0.11 and 0.26, mean 0.20, and the two copy-right ones
 * sit at 0.67 and 0.70. Down the band they run 39% to 52%, mean 48%, and their
 * vertical radii 48% to 74%, mean 60%. The horizontal radius is the one that
 * varies most, 366px to 941px on a 1280 frame, so it is taken as a share of
 * the band instead of a length: 45% is 576 there, against a mean of 559.
 */
const hazePool = { x: reverse ? 0.68 : 0.2, y: "48%", rx: "45%", ry: "60%" };

// The design draws hero illustrations wider than their half of the column and
// lets them spill toward the page edge, by anything from 5px to 217px. That is
// a property of the drawing, so it is measured per section rather than guessed
// at: imageOverflow carries it, and imageBleed remains the all-the-way case.
const overflow = Number(imageOverflow) || 0;
const bleedSide =
  imageBleed || overflow > 0 ? (reverse ? "inline-start" : "inline-end") : undefined;
const bleedLimit = !imageBleed && overflow > 0 ? `${overflow}px` : undefined;
const imagePositionHorizontal = imageBleed ? (reverse ? "right" : "left") : "center";
const imagePositionVertical = imageBleed ? "top" : "center";
---

<CustomSection
  label={sectionLabel}
  maxContentWidth={maxContentWidth}
  paddingHorizontal={paddingHorizontal}
  paddingVertical={paddingVertical}
  backgroundColor={backgroundColor}
  background={backgroundPattern}
  haze={haze ? [hazePool] : false}
  class:list={["hero-split", className]}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  <Split
    distributionMode={distributionMode}
    data-bleed={bleedSide}
    style={bleedLimit ? { "--split-bleed-limit": bleedLimit } : undefined}
    alignmentVertical="center"
    reverse={reverse}
    minSplitWidth={800}
    gap="2xl"
    class="hero-split-layout"
  >
    <Fragment slot="first">
      <Heading
        level={headingLevel}
        size={headingSize}
        data-prop={at("heading")}
      >
        {heading}
      </Heading>
      <Text
        class="subtext"
        style={
          subtextCap
            ? `max-inline-size: ${subtextCap}; margin-inline: auto; justify-self: center`
            : undefined
        }
        size={subtextSize}
        data-prop={at("subtext")}
        text={subtext}
        size="xl"
      />
      <ButtonGroup
        class="buttons-container"
        buttonSections={buttonSections}
        data-children-prop={at("buttonSections")}
      />
      <List
        class="note"
        items={note}
        listType="icon"
        direction="horizontal"
        size="sm"
        spaceBefore="snug"
        data-children-prop={at("note")}
      />
    </Fragment>
    <Fragment slot="second">
      <Image
        source={imageSource}
        alt={imageAlt}
        rounded={imageRounded}
        aspectRatio={imageAspectRatio}
        positionHorizontal={imagePositionHorizontal}
        positionVertical={imagePositionVertical}
        sizes={imageBleed ? "(max-width: 800px) 100vw, 60vw" : undefined}
        widths={imageBleed ? [640, 1280, 1920, 2560] : undefined}
        data-prop-src={at("imageSource")}
        data-prop-alt={at("imageAlt")}
        priority={true}
      />
    </Fragment>
  </Split>
</CustomSection>
