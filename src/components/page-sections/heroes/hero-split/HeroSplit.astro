---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Image from "@core-elements/image/Image.astro";
import List from "@core-elements/list/List.astro";
import Text from "@core-elements/text/Text.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";
import Split from "@wrappers/split/Split.astro";

const {
  heading = "",
  headingLevel = "h1",
  headingSize = "2xl",
  subtext = "",
  // The design sets this in Body 3 at 19 or Subtitle 1 at 22; the default
  // keeps the 16 every section used before either was carried through.
  /* The hero's supporting line is Subtitle 1 on all eleven heroes, so the
     size is the component's rather than a per-page choice. Still a prop: the
     pages set it explicitly today and a hidden input keeps working. */
  subtextSize = "xl",
  /**
   * The measure the design sets the supporting line in, in pixels.
   *
   * Not the column it sits in: a centred subtext is drawn at about 580 in the
   * 1040 column, and run the full width it reads as a different block.
   */
  subtextWidth,
  imageSource = "",
  imageAlt = "",
  imageAspectRatio = "none",
  imageBleed = false,
  imageOverflow = 0,
  // The design's hero images run from 38% to 73% of the content column, because
  // they are drawn oversized and overlap the text rather than sitting beside
  // it. No single ratio reproduces all of them; half is the closest one, and
  // sits on the cluster four of the ten pages fall in. Pages whose illustration
  // is drawn past the frame edge are what imageBleed is for.
  distributionMode = "half",
  buttonSections = [],
  note = [],
  reverse = false,
  imageRounded = true,
  sectionLabel,
  maxContentWidth = "xl",
  paddingHorizontal = "gutter",
  paddingVertical = "4xl",
  colorScheme = "inherit",
  lockColorScheme = false,
  backgroundColor = "base",
  background,
  haze = false,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

// The design draws hero illustrations wider than their half of the column and
// lets them spill toward the page edge, by anything from 5px to 217px. That is
// a property of the drawing, so it is measured per section rather than guessed
// at: imageOverflow carries it, and imageBleed remains the all-the-way case.
const overflow = Number(imageOverflow) || 0;
const bleedSide =
  imageBleed || overflow > 0 ? (reverse ? "inline-start" : "inline-end") : undefined;
const bleedLimit = !imageBleed && overflow > 0 ? `${overflow}px` : undefined;
const imagePositionHorizontal = imageBleed ? (reverse ? "right" : "left") : "center";
const imagePositionVertical = imageBleed ? "top" : "center";
---

<CustomSection
  label={sectionLabel}
  maxContentWidth={maxContentWidth}
  paddingHorizontal={paddingHorizontal}
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  lockColorScheme={lockColorScheme}
  backgroundColor={backgroundColor}
  background={background}
  haze={haze}
  class:list={["hero-split", className]}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  <Split
    distributionMode={distributionMode}
    data-bleed={bleedSide}
    style={bleedLimit ? { "--split-bleed-limit": bleedLimit } : undefined}
    alignmentVertical="center"
    reverse={reverse}
    minSplitWidth={800}
    gap="2xl"
    class="hero-split-layout"
  >
    <Fragment slot="first">
      <Heading
        level={headingLevel}
        size={headingSize}
        data-prop="heading"
      >
        {heading}
      </Heading>
      <Text
        class="subtext"
        style={subtextWidth ? `max-inline-size: ${Number(subtextWidth)}px; margin-inline: auto; justify-self: center` : undefined}        size={subtextSize}
        data-prop="subtext"
        text={subtext}
        size="xl"
      />
      <ButtonGroup
        class="buttons-container"
        buttonSections={buttonSections}
        data-children-prop="buttonSections"
      />
      <List
        class="note"
        items={note}
        listType="icon"
        direction="horizontal"
        size="sm"
        spaceBefore="snug"
        data-children-prop="note"
      />
    </Fragment>
    <Fragment slot="second">
      <Image
        source={imageSource}
        alt={imageAlt}
        rounded={imageRounded}
        aspectRatio={imageAspectRatio}
        positionHorizontal={imagePositionHorizontal}
        positionVertical={imagePositionVertical}
        sizes={imageBleed ? "(max-width: 800px) 100vw, 60vw" : undefined}
        widths={imageBleed ? [640, 1280, 1920, 2560] : undefined}
        data-prop-src="imageSource"
        data-prop-alt="imageAlt"
        priority={true}
      />
    </Fragment>
  </Split>
</CustomSection>
