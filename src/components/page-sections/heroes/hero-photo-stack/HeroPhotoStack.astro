---
/**
 * A hero whose picture is a deck of photo prints you can click through.
 *
 * Our Story draws two prints stacked and turned a few degrees from each
 * other, the top one showing the team on the lake. A hero-split cannot draw
 * it: its media slot is one image, and the whole point here is the second
 * photo sitting behind the first.
 *
 * Clicking sends the front print to the back, so two photos loop between
 * themselves and a third or fourth would simply join the cycle. The deck is a
 * button rather than a div, so it answers the keyboard too, and it only
 * becomes one when there is more than one photo: a single print is a picture,
 * not a control.
 *
 * Geometry off the design: a 440x488 card, the photo inset 39 at the sides
 * and top and 60 at the foot, 18 on the photo's corners, a four-stop shadow,
 * and about 3 degrees between the two cards.
 */
import CustomSection from "@builders/custom-section/CustomSection.astro";
import { subtextMeasure } from "@component-utils/subtextMeasure.mjs";
import Heading from "@core-elements/heading/Heading.astro";
import Image from "@core-elements/image/Image.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Text from "@core-elements/text/Text.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";
import Split from "@wrappers/split/Split.astro";
import PhotoStackCard from "./PhotoStackCard.astro";
import StoryPanel from "./StoryPanel.astro";

const {
  eyebrow = "",
  heading = "",
  headingLevel = "h1",
  headingSize = "2xl",
  subtext = "",
  subtextSize = "xl",
  subtextWidth,
  /** The deck, front first. Two in the design; the cycle takes any number. */
  photos = [],
  buttonSections = [],
  /**
   * The two columns under the headline, each with its own fill.
   *
   * Part of this section rather than a band below it because the design
   * changes colour at two different heights: the left column's fill starts
   * 200 above the right one's, which no horizontal boundary can draw.
   */
  panels = [],
  /** How far the first panel starts above the second, in pixels. */
  panelRaise = 200,
  /**
   * A drawing laid over the deck's bottom corner, like the frond the design
   * puts there. Decoration: it is never the subject and carries no alt.
   */
  embellishmentSource = "",
  /** How wide the drawing is drawn, as a share of the deck. */
  embellishmentWidth = 55,
  reverse = false,
  sectionLabel,
  maxContentWidth = "xl",
  paddingHorizontal = "gutter",
  paddingVertical = "4xl",
  colorScheme = "inherit",
  lockColorScheme = false,
  backgroundColor = "light-sand",
  pattern = "grid",
  haze = true,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const subtextCap = subtextMeasure(subtextWidth);

/* The same two writes hero-split makes: the pattern as the builder's object,
   and one pool behind the copy rather than four measured numbers. */
const backgroundPattern =
  pattern && pattern !== "none"
    ? { type: "pattern", pattern, fixed: false, mask: "none", overlay: 0 }
    : undefined;
const hazePool = { x: reverse ? 0.68 : 0.2, y: "48%", rx: "45%", ry: "60%" };

const cards = (Array.isArray(photos) ? photos : []).filter((photo) => photo?.source);
const columns = (Array.isArray(panels) ? panels : []).filter(
  (panel) => panel?.eyebrow || panel?.heading || panel?.body,
);
const interactive = cards.length > 1;

/* A deck you can click is a button; one print is not a control. Rendering the
   tag from a variable keeps one copy of the markup, and the array binding
   lands on whichever it is. */
const Stack = interactive ? "button" : "div";
---

<CustomSection
  label={sectionLabel}
  maxContentWidth={maxContentWidth}
  paddingHorizontal={paddingHorizontal}
  paddingVertical={paddingVertical}
  paddingVerticalEnd={columns.length > 0 ? "none" : undefined}
  backgroundColor={backgroundColor}
  background={backgroundPattern}
  haze={haze ? [hazePool] : false}
  class:list={["hero-photo-stack", className]}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  <Split
    distributionMode="half"
    alignmentVertical="start"
    reverse={reverse}
    minSplitWidth={800}
    gap="2xl"
    class="hero-photo-stack-layout"
  >
    <Fragment slot="first">
      {eyebrow && <SimpleText class="eyebrow" text={eyebrow} data-prop="eyebrow" />}
      <Heading level={headingLevel} size={headingSize} data-prop="heading">
        {heading}
      </Heading>
      <Text
        class="subtext"
        style={subtextCap ? `max-inline-size: ${subtextCap}` : undefined}
        size={subtextSize}
        data-prop="subtext"
        text={subtext}
      />
      <ButtonGroup
        class="buttons-container"
        buttonSections={buttonSections}
        data-children-prop="buttonSections"
      />
    </Fragment>
    <Fragment slot="second">
      <div class="photo-stack-frame">
        <Stack
          type={interactive ? "button" : undefined}
          class="photo-stack"
          aria-label={interactive ? "Show the next photo" : undefined}
          data-interactive={interactive ? "" : undefined}
          data-editable="array"
          data-prop="photos"
        >
          {cards.map((photo, index) => (
            <PhotoStackCard
              {...photo}
              depth={index}
              data-editable="array-item"
              data-id="page-sections/heroes/hero-photo-stack/photo-stack-card"
              data-component="page-sections/heroes/hero-photo-stack/photo-stack-card"
            />
          ))}
        </Stack>
        {embellishmentSource && (
          <span
            class="photo-stack-embellishment"
            style={`--photo-stack-embellishment-width: ${Number(embellishmentWidth) || 55}%`}
          >
            <Image source={embellishmentSource} alt="" decorative={true} />
          </span>
        )}
      </div>
    </Fragment>
  </Split>

  {columns.length > 0 && (
    <div
      class="story-panels"
      style={`--story-panel-raise: ${Number(panelRaise) || 0}px`}
      data-editable="array"
      data-prop="panels"
    >
      {columns.map((panel, index) => (
        <StoryPanel
          {...panel}
          side={index === 0 ? "start" : "end"}
          raised={index === 0 && columns.length > 1}
          data-editable="array-item"
          data-id="page-sections/heroes/hero-photo-stack/story-panel"
          data-component="page-sections/heroes/hero-photo-stack/story-panel"
        />
      ))}
    </div>
  )}
</CustomSection>

<style is:global>
  @layer page-sections {
    .hero-photo-stack {
      /* The design's card, and the turn between the two prints. */
      --photo-stack-card-width: 440;
      --photo-stack-card-height: 488;
      --photo-stack-turn: 3.2deg;
      /* How far each column's fill has to reach to meet the page edge: the
         gutter either side of the content column.

         Not `calc(50% - 50vw)`. That only reaches the edge from something
         centred in the page, and a half-column is not: it put the right
         column's fill 260 past the page and gave the document a horizontal
         scroll. */
      --story-panel-bleed: max(0px, calc((100vw - var(--content-width-xl, 1040px)) / 2));

      /* A print mid-shuffle reaches toward the page edge; clipping it there
         is better than a scrollbar. */
      overflow-x: clip;
    }

    /* The copy starts level with the deck rather than centred against it: the
       design drops the headline 81 below the first print's top edge, and
       centred it sat 90 too low once the deck filled its column.

       On the pane, not on the heading. Split wraps each slot in `.pane`, so a
       rule written against the heading matched nothing; and the pane is a
       flow container, which writes its children's `margin-block-start` from
       `--space-before` and would have won anyway. */
    .hero-photo-stack-layout .pane.first {
      padding-block-start: 81px;
    }

    /* Above the columns, which come after it in the document and paint over
       it otherwise: each column isolates itself to keep its own fill behind
       its own copy, and that fill was passing in front of the deck. */
    .hero-photo-stack-layout {
      position: relative;
      z-index: 1;
    }

    .photo-stack-frame {
      /* The deck is 477 in the design and its column here is wider, so it is
         capped rather than stretched: a print blown up past its own size
         reads as a different object. */
      inline-size: 100%;
      margin-inline-start: auto;
      max-inline-size: 478px;
      position: relative;
    }

    /* A button when there is a deck to cycle and a plain box when there is
       one photo. Reset rather than styled: the control is the photo. */
    .photo-stack {
      aspect-ratio: var(--photo-stack-card-width) / var(--photo-stack-card-height);
      background: none;
      border: 0;
      display: block;
      inline-size: 100%;
      margin: 0;
      /* Room for the turned card and its shadow, which both reach past the
         cards' own box. */
      padding: 4% 5%;
      /* The deck is a real stack, not a pile of z-indexes.

         A print that goes behind another by swapping `z-index` changes which
         is on top in one frame, in the middle of its own slide, which reads
         as a jiggle and a cut. In 3D the browser occludes by depth: the card
         travels back along Z and passes under its neighbour on the way, with
         nothing to switch. */
      perspective: 1400px;
      position: relative;
      transform-style: preserve-3d;
    }

    .photo-stack[data-interactive] {
      cursor: pointer;
    }

    .photo-stack[data-interactive]:focus-visible {
      border-radius: var(--radius-sm, 4px);
      outline: var(--border-width-md, 2px) solid var(--color-brand);
      outline-offset: 6px;
    }

    .photo-stack-card {
      background: var(--white, #fff);
      box-shadow:
        0 0 1px rgb(0 0 0 / 10%),
        0 2px 2px rgb(0 0 0 / 9%),
        0 4px 3px rgb(0 0 0 / 5%),
        0 8px 3px rgb(0 0 0 / 1%);
      inset: 0;
      margin: 0;
      /* 39 at the sides and top and 60 at the foot, on a 440 card: the deeper
         bottom margin is what makes it a print rather than a framed image.
         Percentages so it holds at any width, and every one of them resolves
         against the width, including the bottom. */
      padding: 8.9% 8.9% 13.6%;
      position: absolute;
      transform: var(--photo-stack-resting);
      transition: transform 340ms var(--ease-out, cubic-bezier(0.2, 0.8, 0.2, 1));
    }

    /* Each depth is a place in the deck: a step back along Z, a step up and
       left, and the front one turned the way the design draws it. */
    .photo-stack-card[data-depth="0"] {
      --photo-stack-resting: translate3d(0, 0, 0) rotate(var(--photo-stack-turn));
    }

    .photo-stack-card[data-depth="1"] {
      --photo-stack-resting: translate3d(-2.4%, -2.4%, -40px);
    }

    .photo-stack-card[data-depth="2"] {
      --photo-stack-resting: translate3d(-4.8%, -4.8%, -80px)
        rotate(calc(var(--photo-stack-turn) * -0.6));
    }

    /* Anything deeper than the third sits behind the deck rather than fanned
       out: the design draws two and a fan of five is a different picture. */
    .photo-stack-card:not([data-depth="0"]):not([data-depth="1"]):not([data-depth="2"]) {
      --photo-stack-resting: translate3d(-4.8%, -4.8%, -120px);
    }

    /* The print that was on top goes to the back the long way: out to the
       right, lifted off the deck, then down past its neighbour and into the
       slot it now owns. Its new depth is set before the animation starts, so
       the keyframes carry it from where it was, and the pass under happens in
       Z where the browser draws it rather than in a property swap.

       Right, not left. Left ran it over the origin-story column, which paints
       in its own stacking context, so the print slid under a block of colour
       on its way past. There is 120 of page to the right of the deck and
       nothing in it. */
    .photo-stack-card[data-shuffling] {
      animation: photo-stack-shuffle 620ms var(--ease-in-out, cubic-bezier(0.65, 0, 0.35, 1)) both;
    }

    @keyframes photo-stack-shuffle {
      0% {
        transform: translate3d(0, 0, 0) rotate(var(--photo-stack-turn));
      }

      34% {
        /* Off the deck and toward the reader before it travels, which is what
           stops the two prints reading as one melting through the other.

           16 and not 24: the deck's right edge is 120 from the page's, and a
           print that is also turned and lifted grows past its own box, so a
           bigger swing put 48 of it off the page. The travel it loses
           sideways it takes downward, where there is room. */
        transform: translate3d(16%, 10%, 40px) rotate(calc(var(--photo-stack-turn) * 2.2));
      }

      66% {
        transform: translate3d(12%, 7%, -70px) rotate(calc(var(--photo-stack-turn) * 1.3));
      }

      100% {
        transform: var(--photo-stack-resting);
      }
    }

    /* The print underneath gets out of the way, the other way.
     
       Two cards moving apart is what reads as a deck being shuffled; one card
       crossing a stationary one reads as a card passing through it however
       the depth is drawn. It leans left while the other leaves right, then
       comes back to take the front slot. */
    .photo-stack-card[data-parting] {
      animation: photo-stack-part 620ms var(--ease-in-out, cubic-bezier(0.65, 0, 0.35, 1)) both;
    }

    @keyframes photo-stack-part {
      0% {
        transform: translate3d(-2.4%, -2.4%, -40px);
      }

      38% {
        transform: translate3d(-11%, -1%, -40px) rotate(calc(var(--photo-stack-turn) * -0.9));
      }

      100% {
        transform: var(--photo-stack-resting);
      }
    }

    .photo-stack-card-photo {
      block-size: 100%;
      overflow: hidden;
      /* The 18 the design puts on the photo. The card's own corners are
         square. */
      border-radius: 18px;
    }

    /* Every wrapper, flat, not nested. Image puts `.image > .image-inner >
       picture` between the element the class lands on and the `<img>`, and
       each of those is auto-height: setting the height on the outer one alone
       leaves the photo at its own aspect in the top of the print. Nested
       rules three deep are dropped by the build, so these are written out. */
    .photo-stack-card-photo .image,
    .photo-stack-card-photo .image-inner,
    .photo-stack-card-photo picture {
      block-size: 100%;
      display: block;
      inline-size: 100%;
    }

    .photo-stack-card-photo img {
      block-size: 100%;
      inline-size: 100%;
      object-fit: cover;
    }

    /* Over the deck's bottom corner, like the frond the design lays there. */
    .photo-stack-embellishment {
      inline-size: var(--photo-stack-embellishment-width, 55%);
      inset-block-end: -6%;
      inset-inline-end: -14%;
      pointer-events: none;
      position: absolute;
      z-index: 4;
    }

    .photo-stack-embellishment img {
      inline-size: 100%;
    }

    /* --- the two columns under the headline ------------------------- */

    .story-panels {
      display: grid;
      gap: 0;
      grid-template-columns: 1fr 1fr;
      /* Up into the band above: the design runs the left column's fill over
         the pattern while the right one keeps it, which is the whole reason
         these are in here rather than in a band of their own.

         80 is what the design leaves between the deck's foot and the second
         column's top edge, measured rather than chosen.

         As `--space-before`, not as a margin: the row sits in a flow
         container, which writes `margin-block-start` from that property out
         of the `utils` layer and beats a margin written here. Set as a margin
         alone it came out 24 and the whole lower half sat 51 high. */
      --space-before: 80px;

      margin-block-start: 80px;
    }

    .story-panel {
      isolation: isolate;
      /* The copy sits a long way down inside its block: 91 on the raised
         column, 76 on the other, measured against the design's own edges.

         148 at the foot, which is what the design leaves under the longer
         column's last line. Zero there ran the text hard onto the band's
         bottom edge: the fill is meant to carry on past the copy, and with
         the band's own bottom padding dropped it had nothing else to sit on. */
      padding-block: 76px 148px;
      position: relative;
    }

    .story-panel[data-raised] {
      padding-block-start: 91px;
    }

    /* The fill runs to its own page edge, not to the column's. Drawn as a
       layer rather than by stretching the panel, so the copy stays in the
       content column where the design keeps it. */
    .story-panel::before {
      background: var(--story-panel-fill);
      content: "";
      inset-block: 0;
      inset-inline-end: 0;
      inset-inline-start: 0;
      position: absolute;
      z-index: -1;
    }

    .story-panel[data-side="start"]::before {
      inset-inline-start: calc(var(--story-panel-bleed) * -1);
    }

    .story-panel[data-side="end"]::before {
      inset-inline-end: calc(var(--story-panel-bleed) * -1);
    }

    .story-panel[data-raised] {
      margin-block-start: calc(var(--story-panel-raise, 200px) * -1);
    }

    .story-panel[data-tone="light-sand"] {
      --story-panel-fill: var(--light-sand, #fffcf3);
    }

    .story-panel[data-tone="sand"] {
      --story-panel-fill: var(--sand, #fbf6e9);
    }

    .story-panel[data-tone="dark-sand"] {
      --story-panel-fill: var(--dark-sand, #ebe1c9);
    }

    .story-panel[data-tone="none"] {
      --story-panel-fill: transparent;
    }

    /* The design insets the second column's copy from its own edge by about
       93, where the first column's sits on the content column. */
    .story-panel[data-side="end"] .story-panel-content {
      padding-inline-start: var(--space-2xl, 64px);
    }

    .story-panel-body {
      max-inline-size: 28rem;
    }

    @media (width < 800px) {
      .story-panels {
        grid-template-columns: 1fr;
      }

      /* Stacked, the raise would pull the second column over the first. */
      .story-panel[data-raised] {
        margin-block-start: 0;
      }

      .story-panel[data-side="end"] .story-panel-content {
        padding-inline-start: 0;
      }

      .story-panel::before {
        inset-inline: calc(var(--story-panel-bleed) * -1);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .photo-stack-card {
        transition: none;
      }

      .photo-stack-card[data-shuffling],
      .photo-stack-card[data-parting] {
        animation: none;
      }
    }
  }
</style>

<script>
  import { onPageLoad } from "@component-utils/onPageLoad";
  import { setupAllPhotoStacks } from "./setup";

  onPageLoad(() => setupAllPhotoStacks());
</script>
