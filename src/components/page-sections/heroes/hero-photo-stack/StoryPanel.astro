---
/**
 * One of the two columns under the headline.
 *
 * The design gives each its own fill and runs it to its own page edge, and
 * starts the left one 200 higher than the right, so the band changes colour
 * at two different heights. That stagger is the reason this is one section
 * rather than a hero with a split under it: a horizontal boundary between two
 * stacked bands cannot draw it.
 */
import Heading from "@core-elements/heading/Heading.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Text from "@core-elements/text/Text.astro";
import { rootMirror } from "@component-utils/rootMirror.mjs";

const {
  eyebrow = "",
  /** Header 5, which is what the design sets the origin story's quote in. */
  heading = "",
  headingLevel = "h2",
  body = "",
  /** The panel's own colour, by the name the design calls it. */
  tone = "light-sand",
  /** Which page edge the fill runs to. */
  side = "start",
  /** Whether this panel starts above the other one. */
  raised = false,
  class: className,
  _component,
  ...htmlAttributes
} = Astro.props;

/* The tone, the side and the raise all key off the panel's own root, which is
   a region root in the editor, so they ride on a child and are copied back. */
const mirror = rootMirror({
  "data-tone": tone,
  "data-side": side,
  "data-raised": raised ? "" : null,
});
---

<div
  class:list={["story-panel", className]}
  data-tone={tone}
  data-side={side}
  data-raised={raised ? "" : undefined}
  {...htmlAttributes}
>
  {/* `flow`, like every other section's copy wrapper. Without it the column
      had no rhythm at all: the eyebrow, the quote and the copy sat flush
      against each other, because the spacing every other block on the site
      gets comes from that layer rather than from the components. */}
  <div class="story-panel-content flow" {...mirror}>
    {eyebrow && <SimpleText class="eyebrow" size="sm" text={eyebrow} data-prop="eyebrow" />}
    {/* The gap is set inline, as a custom property, because nothing else
        reaches it. Two rules in `utils` pull these blocks together: an
        eyebrow followed by a heading is tightened to 8 site-wide, and the
        copy under a heading takes the same. `utils` layers over
        `page-sections`, so a rule here loses whatever its specificity, and
        the `spaceBefore` prop only speaks none, tight, snug and loose, none
        of which is the number this wants.

        28 is one step for both columns. The design draws 31 under the
        eyebrow, 26 under the quote and 24 under the other column's eyebrow;
        one value within 4 of all three keeps the two columns level with each
        other, which three separate values would not. */}
    {heading && (
      <Heading
        level={headingLevel}
        size="sm"
        style="--space-before: var(--story-panel-gap)"
        data-prop="heading"
      >
        {heading}
      </Heading>
    )}
    <Text
      class="story-panel-body"
      size="xl"
      style="--space-before: var(--story-panel-gap)"
      text={body}
      data-prop="body"
    />
  </div>
</div>
