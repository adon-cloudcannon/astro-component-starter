---
/**
 * Steps that advance as the page scrolls, with the picture changing beside
 * them and a bar showing how far through you are.
 *
 * The design draws this as copy on one side, a mockup on the other, and a
 * progress rule along the foot of the band. Read as a tabbed selector it grows
 * controls the design has none of; read as a plain split it loses every step
 * but the first. The bar at the bottom is the tell — it fills as you scroll
 * rather than on a click.
 *
 * Thin: ScrollStepper does the scroll binding, the pinning and the bar, so
 * this gives it a band, a heading and the section's padding.
 */
import { bandPattern, bandHaze } from "@component-utils/bandStyle.mjs";
import { nestedProps } from "@component-utils/nestedProps.mjs";
import CustomSection from "@builders/custom-section/CustomSection.astro";
import { subtextMeasure } from "@component-utils/subtextMeasure.mjs";
import ScrollStepper from "@wrappers/scroll-stepper/ScrollStepper.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Text from "@core-elements/text/Text.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";

/* `content` and `style` are the editor's tabs, flattened straight back into
   the names below. `at()` writes the frontmatter path a binding needs. */
const { props, at } = nestedProps(Astro.props);

const {
  eyebrow = "",
  heading = "",
  headingLevel = "h2",
  headingSize = "lg",
  subtext = "",
  // The design sets a section's supporting line in one of two styles, Body 3
  // at 19 or Subtitle 1 at 22. `md` is the 16 every section rendered before
  // either was carried through, so nothing moves unless the design named it.
  subtextSize = "md",
  /**
   * Whether the band's own header is centred over the steps or runs from the
   * left. The design does both with the same parts, so it is read off the
   * heading's own alignment rather than fixed here: "Happy developers" is
   * centred above the Agencies stepper, while every step's own heading inside
   * it stays left whatever this says.
   */
  alignmentHorizontal = "start",
  /**
   * The measure the design sets the supporting line in, in pixels.
   *
   * Not the column it sits in: a centred subtext is drawn at about 580 in the
   * 1040 column, and run the full width it reads as a different block.
   */
  subtextWidth,
  steps = [],
  reverse = false,
  mediaWidth = "half",
  progressStyle = "bar",
  sectionLabel,
  maxContentWidth = "xl",
  paddingHorizontal = "gutter",
  paddingVertical = "4xl",
  colorScheme = "inherit",
  lockColorScheme = false,
  backgroundColor = "light-sand",
  /** The texture behind the band, by name. */
  pattern = "none",
  /** Whether the heading sits on a pool of the band’s own colour. */
  haze = false,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  "data-children-prop": childrenDataProp,
  ...htmlAttributes
} = props;

/* The measure the subtext is set in, as a length. */
const subtextCap = subtextMeasure(subtextWidth);

const hasHeader = Boolean(eyebrow || heading || subtext);
---

<CustomSection
  label={sectionLabel}
  maxContentWidth={maxContentWidth}
  paddingHorizontal={paddingHorizontal}
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  lockColorScheme={lockColorScheme}
  backgroundColor={backgroundColor}
  background={bandPattern(pattern)}
  haze={bandHaze(haze, { reverse, split: true })}
  class:list={["scroll-steps", className]}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  {hasHeader && (
    <Fragment>
      {/* Each guarded on its own content, not on hasHeader. An empty element
          is still a sibling, and the flow layer gives every one after the
          first a space-before — so a band with a heading and nothing else was
          drawing an empty eyebrow and an empty subtext around it and paying
          for both in spacing. */}
      {eyebrow && (
        <SimpleText
          alignmentHorizontal={alignmentHorizontal}
          class="eyebrow"
          size="sm"
          data-prop={at("eyebrow")}
          text={eyebrow}
        />
      )}
      {heading && (
        <Heading
          alignmentHorizontal={alignmentHorizontal}
          level={headingLevel}
          size={headingSize}
          data-prop={at("heading")}
        >
          {heading}
        </Heading>
      )}
      {subtext && (
        <Text
          alignmentHorizontal={alignmentHorizontal}
          class="subtext"
          style={subtextCap ? `max-inline-size: ${subtextCap}; margin-inline: auto; justify-self: center` : undefined}
          size={subtextSize}
          data-prop={at("subtext")}
          text={subtext}
        />
      )}
    </Fragment>
  )}

  <ScrollStepper
    steps={steps}
    reverse={reverse}
    mediaWidth={mediaWidth}
    progressStyle={progressStyle}
    data-children-prop={childrenDataProp ?? (useDefaultEditableBinding ? at("steps") : undefined)}
  />
</CustomSection>

<style is:global>
  /* The step's link is set in Sunset, the same colour as its label above it,
     which is how the design marks a step out from the band it sits on. The
     arrow button's usual pairing — base label, brand arrow — is for buttons
     sitting on the page's own colour, and this band is not that.

     Flat, because rules nested deeper than a couple of levels get dropped (see
     CLAUDE.md). */
  @layer page-sections {
    .scroll-steps .variant-text .button-inner,
    .scroll-steps .variant-text .icon {
      color: var(--sunset);
    }

    /* A link, not a control: no pill padding around it. */
    .scroll-steps .variant-text .button-inner {
      padding-inline: 0;
    }
  }

  /* The copy column sits at the top of the band rather than centred against
     the picture beside it, which is where the design puts it. */
  @layer page-sections {
    .scroll-steps .scroll-stepper-steps {
      align-self: start;
    }

    /* A step whose picture is still a hand export leaves its panel measuring
       nothing, and the whole band folds down around the copy: the design draws
       the media about 730 by 600 beside it. Holding the cell open is the same
       fix as a grid track with no content in it — the space is the design's,
       whether or not the drawing has arrived.

       It also gives the stepper something real to centre the first step
       against. That measurement is a loop, and with a media of no height the
       gap it is closing never closes.

       Styled here rather than in ScrollStepper: the starter's component is
       left alone deliberately, and this is what the design asks of this band
       rather than of every stepper. */
    .scroll-steps .scroll-stepper-media-panel:has(> .scroll-stepper-media-content:empty) {
      aspect-ratio: 730 / 600;
    }
  }
</style>
