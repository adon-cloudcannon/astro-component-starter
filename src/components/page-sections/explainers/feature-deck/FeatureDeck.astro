---
/**
 * A stack of feature cards that pin and stack as the page scrolls.
 *
 * The design draws these as separate panels sitting almost on top of each
 * other, each offset a few pixels from the last, which is a designer's way of
 * showing a deck rather than three sections. Read as three sections they came
 * out as three full-width features one after another.
 *
 * Thin on purpose: ScrollDeck already does the pinning, the stacking and the
 * rail, and its cards are ordinary content blocks, so this only gives the deck
 * a section to live in with its background and padding.
 */
import CustomSection from "@builders/custom-section/CustomSection.astro";
import ScrollDeck from "@wrappers/scroll-deck/ScrollDeck.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Text from "@core-elements/text/Text.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";

const {
  eyebrow = "",
  heading = "",
  headingLevel = "h2",
  headingSize = "lg",
  subtext = "",
  cards = [],
  // A deck card is tall, and the design holds it nearer the middle of the
  // screen than the top. The shipped default pins it right under the nav.
  stickyOffset = "3xl",
  cardColorScheme = "light",
  showRail = true,
  sectionLabel,
  maxContentWidth = "xl",
  paddingHorizontal = "gutter",
  paddingVertical = "4xl",
  colorScheme = "inherit",
  lockColorScheme = false,
  backgroundColor = "base",
  background,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  "data-children-prop": childrenDataProp,
  ...htmlAttributes
} = Astro.props;
---

<CustomSection
  label={sectionLabel}
  maxContentWidth={maxContentWidth}
  paddingHorizontal={paddingHorizontal}
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  lockColorScheme={lockColorScheme}
  backgroundColor={backgroundColor}
  background={background}
  class:list={["feature-deck", className]}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  <SimpleText
    class="eyebrow"
    size="sm"
    data-prop="eyebrow"
    text={eyebrow}
  />
  <Heading
    level={headingLevel}
    size={headingSize}
    data-prop="heading"
  >
    {heading}
  </Heading>
  <Text
    class="subtext"
    data-prop="subtext"
    text={subtext}
  />

  <ScrollDeck
    cards={cards}
    stickyOffset={stickyOffset}
    cardColorScheme={cardColorScheme}
    showRail={showRail}
    label={sectionLabel || heading || "Features"}
    data-children-prop="cards"
  />
</CustomSection>

<style is:global>
  @layer page-sections {
    .feature-deck {
      /* The design centres a 936 card in the 1040 column and stacks the rest
         behind it. The measure goes on the track, not the card: a card is a
         grid item, and a max-width there lets it shrink to its own content
         instead, which collapsed the whole thing to 66px. */
      .scroll-deck-track {
        /* justify-self, not margin auto: the deck's layout is a grid, and an
           auto margin on a grid item shrinks it to its own content instead of
           centring it at width. That collapsed the whole deck to 66px. */
        inline-size: 100%;
        justify-self: center;
        max-inline-size: 936px;
      }

      /* Everything on a card is centred except the illustrations, which are
         centred anyway by their column. */
      .scroll-deck-card .card-content {
        text-align: center;
      }

      /* The three columns beneath the intro: an illustration over a title and
         a line, each column centred on itself.

         No height cap. The illustrations carry the size the design draws them,
         which is not one height, and a cap above that size upscales the file
         Astro generated for it and the mark goes soft. */
      /* Columns start together. Left to itself the grid centres each one on
         its own content, so a short illustration drags its whole column down
         and the titles come out on three different lines. */
      .scroll-deck-card .grid > * {
        align-content: start;
      }

      /* The illustrations are drawn at different heights but their titles sit
         on one line, so they share a block and hang from its foot. */
      .scroll-deck-card .grid .image {
        align-items: end;
        /* A minimum, not a height. Fixed, anything drawn taller than the block
           gets clipped by Image's own overflow: hidden. */
        display: flex;
        justify-content: center;
        margin-inline: auto;
        max-inline-size: 100%;
        min-block-size: 10rem;

        /* Image's own inner is width: 100%, so an illustration stretches to
           its column and the width it was drawn at never gets a say. */
        > .image-inner {
          inline-size: fit-content;
          margin-inline: auto;
          max-inline-size: 100%;
        }
      }

      .scroll-deck-card .grid .image img {
        block-size: auto;
        max-inline-size: 100%;
      }
    }
  }
</style>
