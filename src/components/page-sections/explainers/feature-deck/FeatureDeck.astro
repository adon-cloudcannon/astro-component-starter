---
/**
 * A stack of feature cards that pin and stack as the page scrolls.
 *
 * The design draws these as separate panels sitting almost on top of each
 * other, each offset a few pixels from the last, which is a designer's way of
 * showing a deck rather than three sections. Read as three sections they came
 * out as three full-width features one after another.
 *
 * Thin on purpose: ScrollDeck already does the pinning, the stacking and the
 * rail, and its cards are ordinary content blocks, so this only gives the deck
 * a section to live in with its background and padding.
 */
import { nestedProps } from "@component-utils/nestedProps.mjs";
import CustomSection from "@builders/custom-section/CustomSection.astro";
import { subtextMeasure } from "@component-utils/subtextMeasure.mjs";
import ScrollDeck from "@wrappers/scroll-deck/ScrollDeck.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Text from "@core-elements/text/Text.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";

/* `content` and `style` are the editor's tabs, flattened straight back into
   the names below. `at()` writes the frontmatter path a binding needs. */
const { props, at } = nestedProps(Astro.props);

const {
  eyebrow = "",
  heading = "",
  headingLevel = "h2",
  headingSize = "lg",
  subtext = "",
  // Body 3 at 19 or Subtitle 1 at 22 in the design; `md` keeps the 16 every
  // section rendered before either was carried through.
  subtextSize = "md",
  /**
   * The measure the design sets the supporting line in, in pixels.
   *
   * Not the column it sits in: a centred subtext is drawn at about 580 in the
   * 1040 column, and run the full width it reads as a different block.
   */
  subtextWidth,
  cards = [],
  // A deck card is tall, and the design holds it nearer the middle of the
  // screen than the top. The shipped default pins it right under the nav.
  stickyOffset = "3xl",
  cardColorScheme = "light",
  showRail = true,
  sectionLabel,
  maxContentWidth = "xl",
  paddingHorizontal = "gutter",
  paddingVertical = "4xl",
  colorScheme = "inherit",
  lockColorScheme = false,
  backgroundColor = "light-sand",
  background,
  haze = false,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  "data-children-prop": childrenDataProp,
  ...htmlAttributes
} = props;

/* The measure the subtext is set in, as a length. */
const subtextCap = subtextMeasure(subtextWidth);
---

<CustomSection
  label={sectionLabel}
  maxContentWidth={maxContentWidth}
  paddingHorizontal={paddingHorizontal}
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  lockColorScheme={lockColorScheme}
  backgroundColor={backgroundColor}
  background={background}
  haze={haze}
  class:list={["feature-deck", className]}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  <SimpleText
    class="eyebrow"
    size="sm"
    data-prop={at("eyebrow")}
    text={eyebrow}
  />
  {/* Only when there is one. A bound region with nothing behind it is an
      error card in the Visual Editor, "expect to receive a value of type
      string but instead received undefined", and an empty heading on the page
      that the flow layer still spaces around. */}
  {heading && (
    <Heading
      level={headingLevel}
      size={headingSize}
      data-prop={at("heading")}
    >
      {heading}
    </Heading>
  )}
  <Text
    class="subtext"
    data-prop={at("subtext")}
    style={subtextCap ? `max-inline-size: ${subtextCap}; margin-inline: auto; justify-self: center` : undefined}    size={subtextSize}    text={subtext}
  />

  <ScrollDeck
    cards={cards}
    stickyOffset={stickyOffset}
    cardColorScheme={cardColorScheme}
    showRail={showRail}
    label={sectionLabel || heading || "Features"}
    data-children-prop={at("cards")}
  />
</CustomSection>

<style is:global>
  @layer page-sections {
    .feature-deck {
      /* The design centres a 936 card in the 1040 column and stacks the rest
         behind it. The measure goes on the track, not the card: a card is a
         grid item, and a max-width there lets it shrink to its own content
         instead, which collapsed the whole thing to 66px. */
      .scroll-deck-track {
        /* justify-self, not margin auto: the deck's layout is a grid, and an
           auto margin on a grid item shrinks it to its own content instead of
           centring it at width. That collapsed the whole deck to 66px. */
        inline-size: 100%;
        justify-self: center;
        max-inline-size: 936px;
      }

      /* Everything on a card is centred except the illustrations, which are
         centred anyway by their column. */
      .scroll-deck-card .card-content {
        text-align: center;
      }

      /* The three columns beneath the intro: an illustration over a title and
         a line, each column centred on itself.

         No height cap. The illustrations carry the size the design draws them,
         which is not one height, and a cap above that size upscales the file
         Astro generated for it and the mark goes soft. */
      /* Columns start together. Left to itself the grid centres each one on
         its own content, so a short illustration drags its whole column down
         and the titles come out on three different lines. */
      .scroll-deck-card .grid > * {
        align-content: start;
      }

      /* Every column gives its illustration the same block, so the headings
         below them land on one line whatever shape the art is. The image sits
         at the top of that block and the copy underneath grows down. */
      .scroll-deck-card .grid .image {
        align-items: start;
        block-size: 10rem;
        display: flex;
        justify-content: center;
        margin-inline: auto;
        max-inline-size: 100%;
      }

      /* auto on both with the block capped: a replaced element scales itself
         to fit, so each illustration keeps its shape inside the shared box. */
      .scroll-deck-card .grid .image img {
        block-size: auto;
        inline-size: auto;
        /* The same 10rem, written out rather than as 100%. A percentage
           resolves against <picture>, whose height is auto, so it is ignored
           and the illustration overflows the block it was given. */
        max-block-size: 10rem;
        max-inline-size: 100%;
      }
    }
  }
</style>
