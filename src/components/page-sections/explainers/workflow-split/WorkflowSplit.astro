---
/**
 * Two ways of working, either side of the thing they share.
 *
 * The design uses this to show that two audiences reach the same place: a
 * panel each, in their own colour, with an illustration above and a list of
 * what that audience does, and between them a picture of the common ground.
 * On the homepage that is editors and developers either side of a Git repo.
 *
 * The panels carry the accent, so a reader can tell which column is which
 * before reading a word of it, the same way the story cards do. The middle can
 * be a picture or a third panel of its own: on the homepage the design draws a
 * dark card there, taller than the pair and sharing their bottom edge.
 */
import { nestedProps } from "@component-utils/nestedProps.mjs";
import Component from "@component-utils/renderBlock.astro";
import CustomSection from "@builders/custom-section/CustomSection.astro";
import { subtextMeasure } from "@component-utils/subtextMeasure.mjs";
import Card from "@wrappers/card/Card.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Text from "@core-elements/text/Text.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Icon from "@core-elements/icon/Icon.astro";
import Image from "@core-elements/image/Image.astro";
import List from "@core-elements/list/List.astro";
import Button from "@core-elements/button/Button.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";

type PanelProps = {
  accentColor?: string;
  imageSource?: string;
  imageAlt?: string;
  eyebrow?: string;
  heading?: string;
  items?: { text?: string }[];
  linkText?: string;
  link?: string;
  imageOverlap?: number;
};

/* `content` and `style` are the editor's tabs, flattened straight back into
   the names below. `at()` writes the frontmatter path a binding needs. */
const { props, at } = nestedProps(Astro.props);

const {
  eyebrow = "",
  heading = "",
  headingLevel = "h2",
  headingSize = "lg",
  subtext = "",
  // The design sets a section's supporting line in one of two styles, Body 3
  // at 19 or Subtitle 1 at 22. `md` is the 16 every section rendered before
  // either was carried through, so nothing moves unless the design named it.
  subtextSize = "md",
  /**
   * The measure the design sets the supporting line in, in pixels.
   *
   * Not the column it sits in: a centred subtext is drawn at about 580 in the
   * 1040 column, and run the full width it reads as a different block.
   */
  subtextWidth,
  buttonSections = [],
  panels = [],
  centreImageSource = "",
  centreImageAlt = "",
  /**
   * The panel between the two workflows, which is the common ground they both
   * land in. The design draws it 330x366 in #26262F against the pair's 323x321
   * tints, sharing their bottom edge and reaching 45px higher, so it is a card
   * in its own right rather than a picture of one.
   *
   * Its colour is a value rather than a token on purpose: #26262F is not in
   * the palette, and the nearest thing to it, --gray-900 at #252423, is a
   * different colour by about 12.
   */
  centreColor = "",
  centreMinHeight = 0,
  /**
   * The line across the top of the middle panel. The design draws an icon and
   * a title in 14/700 white, which is its own small scale rather than a rung
   * on the heading ramp — that starts at 20 — so these are their own props and
   * not a heading block inside `centreSections`.
   */
  centreIconName = "",
  centreTitle = "",
  /**
   * The branch the panel is showing, with a status light before it. Closing
   * the header row the way a Git client does.
   */
  centreBranch = "",
  /**
   * The commit rows down the panel. Each is a kind, an author, a message and a
   * hash, which is the four parts the design gives them: 290x30 on a 37 pitch,
   * rounded 8, on white at 5% over the card.
   *
   * `kind` rather than a pair of colours per row: the design draws exactly two
   * of these, an editor in blue and a dev in Sunset, and each sets its dot and
   * its label together.
   */
  centreRows = [],
  centreSections = [],
  sectionLabel,
  maxContentWidth = "xl",
  paddingHorizontal = "gutter",
  paddingVertical = "4xl",
  colorScheme = "inherit",
  lockColorScheme = false,
  backgroundColor = "light-sand",
  background,
  haze = false,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  "data-children-prop": childrenDataProp,
  ...htmlAttributes
} = props;

/* The measure the subtext is set in, as a length. */
const subtextCap = subtextMeasure(subtextWidth);

const panelList: PanelProps[] = Array.isArray(panels) ? panels : [];

/**
 * The commit feed's timing, and the keyframes that drive it.
 *
 * All of the motion in this section is CSS: the track that slides and the two
 * dots that run the connectors are three composited animations sharing one
 * clock, so they stay in step for as long as the page is open without anything
 * measuring or correcting them. The version before this did it in script and
 * paid a forced reflow every cycle for the privilege.
 *
 * The track's keyframes are the one part that depends on how many commits
 * there are, so they are written out here rather than guessed at in a
 * stylesheet. Everything else is static CSS below.
 */
const ROW_PITCH = 37;
const CYCLE_MS = 2900;
/** When the dot reaches the card, which is when the commit it carries lands. */
const LANDS_MS = 652;
const SLIDE_MS = 450;

const feedRows: Record<string, unknown>[] = Array.isArray(centreRows) ? centreRows : [];
const feedSteps = feedRows.length;
const feedName = `workflow-feed-${feedSteps}`;
const feedPeriod = feedSteps * CYCLE_MS;
const stop = (ms: number): string => `${((ms / feedPeriod) * 100).toFixed(4)}%`;

/**
 * Hold, slide, hold, slide. At the end the track has moved by exactly the
 * length of the list, and the second copy of the rows underneath means that
 * position is identical to the start — so it repeats with nothing to reset.
 */
const feedKeyframes = feedSteps
  ? `@keyframes ${feedName}{0%{transform:translateY(0)}${Array.from(
      { length: feedSteps },
      (_unused, index) =>
        `${stop(index * CYCLE_MS + LANDS_MS)}{transform:translateY(${-index * ROW_PITCH}px)}` +
        `${stop(index * CYCLE_MS + LANDS_MS + SLIDE_MS)}{transform:translateY(${-(index + 1) * ROW_PITCH}px)}`,
    ).join("")}100%{transform:translateY(${-feedSteps * ROW_PITCH}px)}}`
  : "";

/* One name for both halves of the region, so they cannot disagree. */
const panelsProp = childrenDataProp ?? (useDefaultEditableBinding ? "panels" : undefined);
---

<CustomSection
  label={sectionLabel}
  maxContentWidth={maxContentWidth}
  paddingHorizontal={paddingHorizontal}
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  lockColorScheme={lockColorScheme}
  backgroundColor={backgroundColor}
  background={background}
  haze={haze}
  class:list={["workflow-split", className]}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  <SimpleText
    class="eyebrow"
    size="sm"
    alignmentHorizontal="center"
    data-prop={at("eyebrow")}
    text={eyebrow}
  />
  <Heading
    level={headingLevel}
    size={headingSize}
    alignmentHorizontal="center"
    data-prop={at("heading")}
  >
    {heading}
  </Heading>
  <Text
    class="subtext"
    style={subtextCap ? `max-inline-size: ${subtextCap}; margin-inline: auto; justify-self: center` : undefined}    size={subtextSize}
    alignmentHorizontal="center"
    data-prop={at("subtext")}
    text={subtext}
  />
  <ButtonGroup
    class="workflow-actions"
    buttonSections={buttonSections}
    direction="row"
    alignmentHorizontal="center"
    data-children-prop={at("buttonSections")}
  />

    {/* Both halves together. `data-editable="array"` with no `data-prop` is
        not a weaker region, it is a fatal one: the editor replaces the whole
        thing with "Array editable regions require a 'data-prop' HTML
        attribute but none was provided". The prop is conditional, so the
        region has to be. */}
  <div
    class="workflow-columns"
    data-editable={panelsProp ? "array" : undefined}
    data-prop={panelsProp}
  >
    {panelList.map((panel, index) => (
      <Fragment>
        <div
          class="workflow-panel"
          data-editable="array-item"
        >
          {panel.imageSource && (
            <Image
              class="workflow-illustration"
              source={panel.imageSource}
              alt={panel.imageAlt}
              style={panel.imageOverlap ? { "--illustration-overlap": `${panel.imageOverlap}px` } : undefined}
              data-prop-src="imageSource"
              data-prop-alt="imageAlt"
            />
          )}
          {/* The line that runs from this panel's card into the one between
              them, in the panel's own accent. Outside the Card because Card
              clips itself with a clip-path, and a sibling of it rather than a
              child of the panel so it can be placed against the card's centre
              — the panel's own centre is higher, since the illustration takes
              the row above. */}
          <div class="workflow-card-slot">
          <Card
            accentColor={panel.accentColor || "none"}
            backgroundColor="accent-tint"
            border={true}
            rounded={true}
            paddingHorizontal="lg"
            paddingVertical="lg"
          >
            <SimpleText
              class="eyebrow"
              size="sm"
              data-prop="eyebrow"
              text={panel.eyebrow}
            />
            <Heading
              level="h3"
              size="xs"
              data-prop="heading"
            >
              {panel.heading}
            </Heading>
            <List
              class="workflow-points"
              items={panel.items}
              listType="icon"
              size="md"
              data-children-prop="items"
            />
            {panel.linkText && (
              <Button
                class="workflow-link"
                variant="text"
                iconName="move-right"
                iconPosition="after"
                text={panel.linkText}
                link={panel.link}
                data-prop="linkText"
              />
            )}
          </Card>
            {index < 2 && (
              <span
                class:list={["workflow-connector", index === 0 ? "to-end" : "to-start"]}
                style={panel.accentColor ? { "--workflow-connector": `var(--${panel.accentColor})` } : undefined}
                data-kind={index === 0 ? "editor" : "dev"}
                aria-hidden="true"
              >
                {/* Which panel feeds which commit is the design's own reading:
                    the editors' column is the blue one and its commits are
                    blue, the developers' is Sunset and so are theirs. */}
                <span class="workflow-pulse" />
              </span>
            )}
          </div>
        </div>

        {/* The common ground goes between the first pair, which is where the
            design puts it. The cell is held even when there is no art for it
            yet: without it the second panel slides into the middle column and
            the row reads as two columns of the wrong width. */}
        {index === 0 &&
          (centreColor || centreSections.length ? (
            <div
              class="workflow-centre-card"
              style={{
                ...(centreColor ? { "--workflow-centre-color": centreColor } : {}),
                ...(centreMinHeight ? { "--workflow-centre-height": `${Number(centreMinHeight)}px` } : {}),
              }}
              data-editable="array"
              data-prop={at("centreSections")}
            >
              {(centreIconName || centreTitle) && (
                <p class="workflow-centre-title">
                  {centreIconName && <Icon name={centreIconName} size="md" />}
                  {centreTitle && <span data-prop={at("centreTitle")}>{centreTitle}</span>}
                  {centreBranch && (
                    <span class="workflow-centre-branch">
                      <span class="workflow-centre-light" aria-hidden="true" />
                      <span data-prop={at("centreBranch")}>{centreBranch}</span>
                    </span>
                  )}
                </p>
              )}
              {centreRows.length > 0 && (
                <div class="workflow-centre-feed">
                  {/* Twice. The track slides by exactly the length of one
                      copy and then repeats, and because the second copy sits
                      where the first started there is nothing to reset and no
                      seam to hide — which is what lets this be CSS at all. */}
                  <ul
                    class="workflow-centre-rows"
                    style={{ animationName: feedName, animationDuration: `${feedPeriod}ms` }}
                  >
                    {[...feedRows, ...feedRows].map((row: Record<string, unknown>, index: number) => (
                      <li
                        class:list={["workflow-centre-row", `kind-${row.kind ?? "editor"}`]}
                        aria-hidden={index >= feedSteps ? "true" : undefined}
                      >
                        <span class="workflow-centre-dot" aria-hidden="true" />
                        <span class="workflow-centre-author">{row.author}</span>
                        <span class="workflow-centre-message">{row.message}</span>
                        <span class="workflow-centre-hash">{row.hash}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              <Component contentSections={centreSections} />
            </div>
          ) : centreImageSource ? (
            <Image
              class="workflow-centre"
              source={centreImageSource}
              alt={centreImageAlt}
              data-prop-src={at("centreImageSource")}
              data-prop-alt={at("centreImageAlt")}
            />
          ) : (
            <div class="workflow-centre-empty" aria-hidden="true"></div>
          ))}
      </Fragment>
    ))}
  </div>
</CustomSection>

<style is:inline set:html={feedKeyframes} />

<!-- Top level on purpose. @keyframes cannot be nested inside a style rule:
     written inside `.workflow-split { … }` they are dropped without warning,
     which is why the dots sat still while the feed ran. -->
<style is:global>
  /* Left to right, then on under the card. */
  @keyframes workflow-pulse-to-end {
    0% {
      opacity: 0;
      translate: 0 -50%;
    }

    1.5% {
      opacity: 1;
      translate: 8.6px -50%;
    }

    18.966% {
      opacity: 1;
      translate: 108px -50%;
    }

    18.97% {
      opacity: 0;
      translate: 0 -50%;
    }

    100% {
      opacity: 0;
      translate: 0 -50%;
    }
  }

  /* Right to left: its far end is the one against its own card, because
     the panel between them is on its other side. */
  @keyframes workflow-pulse-to-start {
    0% {
      opacity: 0;
      translate: 64px -50%;
    }

    1.5% {
      opacity: 1;
      translate: 55.4px -50%;
    }

    18.966% {
      opacity: 1;
      translate: -44px -50%;
    }

    18.97% {
      opacity: 0;
      translate: 64px -50%;
    }

    100% {
      opacity: 0;
      translate: 64px -50%;
    }
  }
</style>

<style is:global>
  @layer page-sections {
    .workflow-split {
      /* Same as the rest of the centred headers: the heading takes the column
         and its line of copy is held to the design's measure. */
      .subtext {
        margin-inline: auto;
        max-inline-size: var(--content-width-measure);
      }

      /* Three columns, not two and a maybe. The design draws 323 / 330 / 323
         with 64 between them, so equal thirds land within a few pixels. auto-fit
         collapsed the middle to nothing while its art is still to be exported,
         which stretched the two cards to 504. */
      .workflow-columns {
        align-items: end;
        display: grid;
        gap: 4rem;
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      /* Shares the pair's bottom edge and reaches above them, which is how the
         design draws it: all three finish at the same line, and this one is 45
         taller. Bottom-aligned rather than given a top offset, so it stays put
         however tall the illustrations above the other two turn out. */
      .workflow-centre-card {
        align-self: end;
        /* Positioned *and* lifted, so it takes part in z-order and wins.
           Position alone is not enough: grid items at the same level paint in
           DOM order, so the left panel's connector went under this correctly
           while the right panel's — which comes after it — ran over the top.
           The pulse has to disappear beneath this from either side. */
        position: relative;
        z-index: 1;
        background-color: var(--workflow-centre-color, var(--color-bg-muted));
        /* --radius-card, not --radius-lg: the cards either side of it round
           at 18 and the generic large radius is 16, so the middle panel was a
           touch squarer than its neighbours. */
        border-radius: var(--radius-card);
        min-block-size: var(--workflow-centre-height, 0);
        /* 20, which is what the design insets its contents by. --spacing-lg
           is 24 and left the rows 4 short of the card's edges. */
        padding: 20px;
      }

      /* 14/700 white, read off the design rather than taken from a rung: the
         heading ramp starts at 20 and the text ramp's nearest is 14.5, so this
         line sets its own size. The icon is the same height as the text. */
      .workflow-centre-title {
        align-items: center;
        /* The rule under the header, measured off the card at #32333D and a
           pixel tall. It runs the content column, inset 20 each side, not the
           card's full width — the first reading said it reached the right edge
           and that was the card's own edge highlight, not the line. */
        border-block-end: 1px solid var(--workflow-panel-rule, #32333d);
        color: var(--white);
        display: flex;
        font-size: 14px;
        font-weight: 700;
        gap: 0.6em;
        line-height: 1.35;
        margin: 0 0 14px;
        /* The design sets the rule 2px under the header, which at the mark's
           own 17 reads fine and at md's 22 does not — the row is taller and
           the line ends up hugging the text. Given room instead. */
        padding-block-end: 12px;

        /* No size of its own: Icon sets its own font-size from the `size`
           prop and the glyph is 1em of that, so pinning a box here just
           overrode the choice. Only the things the row needs. */
        .icon {
          color: currentcolor;
          flex: none;
        }
      }

      /* Closes the header row, pushed over by its own auto margin rather than
         by spacing the row apart, so the icon and title stay together.

         Fragment Mono is what the design sets it in, and the site already
         carries that face as --font-mono. The two colours are literals: this
         is chrome inside a panel depicting a Git client, and neither is in the
         palette — the dot's nearest token is --moss-400, an olive, a hundred
         away from this traffic-light green. */
      .workflow-centre-branch {
        align-items: center;
        color: var(--workflow-branch-color, #cfd2e8);
        display: flex;
        font-family: var(--font-mono);
        font-size: 10.5px;
        font-weight: 400;
        gap: 0.65em;
        margin-inline-start: auto;
      }

      /* Clipped to a whole number of rows, so the one arriving is cut by the
         card's edge rather than half-drawn against it. Eight showing, with the
         ninth queued below — the card takes its height from this, so changing
         the count is the only place the size is set and the 20 of padding
         stays even top and bottom on its own. */
      .workflow-centre-feed {
        --workflow-rows-visible: 8;

        block-size: calc(
          var(--workflow-rows-visible) * 30px + (var(--workflow-rows-visible) - 1) * 7px
        );
        /* Its height is set above rather than by its contents, so the browser
           can skip rendering the sixteen rows inside it whenever the panel is
           off screen without anything moving when it comes back. That is what
           stands in for pausing the animation, now that there is no script to
           pause it with. */
        content-visibility: auto;
        contain-intrinsic-size: auto calc(
          var(--workflow-rows-visible) * 30px + (var(--workflow-rows-visible) - 1) * 7px
        );
        overflow: hidden;
      }

      /* 37px pitch: a 30 row and 7 between, which is what the design measures
         down the panel, and the distance the feed travels on each step. */
      .workflow-centre-rows {
        animation-duration: inherit;
        animation-iteration-count: infinite;
        animation-timing-function: linear;

        display: grid;
        gap: 7px;
        list-style: none;
        margin: 0;
        padding: 0;
      }

      /* White at 5% rather than a flat grey. The fill reads #FFFFFF in the
         file and the opacity sits on the fill, so taking the colour alone
         gives a white bar where the design has a barely-lifted panel. */
      .workflow-centre-row {
        align-items: center;
        background-color: rgb(255 255 255 / 5%);
        block-size: 30px;
        border-radius: 8px;
        color: #cfd2e8;
        display: flex;
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 400;
        gap: 9px;
        /* The row is a grid item, and a grid item's automatic minimum is its
           own min-content — which, with the message set to nowrap, is the
           whole string. So the row sized itself to its longest commit and lost
           its right corners to the feed's clip. Shrinking the message was not
           enough on its own; the row has to be allowed to shrink too. */
        min-inline-size: 0;
        padding-inline: 10px;
      }

      .workflow-centre-row.kind-editor {
        --workflow-row-dot: #4d7dff;
        --workflow-row-author: #7ea6ff;
      }

      .workflow-centre-row.kind-dev {
        --workflow-row-dot: var(--sunset);
        --workflow-row-author: #f0a07a;
      }

      .workflow-centre-dot {
        background-color: var(--workflow-row-dot);
        block-size: 6px;
        border-radius: var(--radius-full);
        flex: none;
        inline-size: 6px;
      }

      .workflow-centre-author {
        color: var(--workflow-row-author);
        flex: none;
      }

      /* Clipped rather than wrapped: the design runs one of them past the
         hash — "content: new team membe" — so a row is always one line. */
      .workflow-centre-message {
        /* Flex items will not shrink below their content unless told to, so
           without this a long message pushed the hash past the row's right
           edge instead of clipping itself. */
        min-inline-size: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .workflow-centre-hash {
        color: #5a6080;
        flex: none;
        margin-inline-start: auto;
      }

      .workflow-centre-light {
        background-color: var(--workflow-branch-light, #28c840);
        block-size: 7px;
        border-radius: var(--radius-full);
        flex: none;
        inline-size: 7px;
      }

      /* A panel is its illustration and its card, stacked, so the cards sit on
         one line however tall the drawings above them are. */
      .workflow-panel {
        display: grid;
        grid-template-rows: auto 1fr;
      }

      .workflow-card-slot {
        display: grid;
        position: relative;
      }

      /* A 2px rule with a 7px dot at each end, measured off nodes 3806:70020
         and 3806:70103. It spans the whole 64 of the grid's gap and sits at
         the card's vertical centre, which is where the design draws it.

         It fades outward, away from the panel between them: the line runs at
         about a quarter (0.25 on the left, 0.28 on the right — one value here,
         the difference is not visible), the dot at the middle card's end is
         solid, and the dot against the panel's own card is a third.

         All of it is opacity on the fill rather than in the colour, which is
         why the first pass drew three solid blue and orange marks where the
         design has a line easing away. Third time that has caught me: the
         workflow panels' own rules and the mega menu's backing were the
         others. */
      .workflow-connector {
        background-color: color-mix(in srgb, var(--workflow-connector, var(--color-brand)) 26%, transparent);
        block-size: 2px;
        border-radius: 1px;
        inline-size: var(--scroll-stepper-gap, 4rem);
        position: absolute;
        top: 50%;
        translate: 0 -50%;
      }

      .workflow-connector.to-end {
        inset-inline-start: 100%;
      }

      .workflow-connector.to-start {
        inset-inline-end: 100%;
      }

      .workflow-connector::before,
      .workflow-connector::after {
        background-color: var(--workflow-connector, var(--color-brand));
        block-size: 7px;
        border-radius: var(--radius-full);
        content: "";
        inline-size: 7px;
        position: absolute;
        top: 50%;
        translate: 0 -50%;
      }

      .workflow-connector::before {
        inset-inline-start: -3px;
      }

      .workflow-connector::after {
        inset-inline-end: -3px;
      }

      /* Which end is the faded one depends on which side of the middle the
         panel is: the solid dot is always the one nearest the card between
         them. */
      /* The one that travels. It runs the line from the panel's own card to the
         card between them, and the commit it is carrying lands when it gets
         there — so the feed is driven by this arriving rather than by a clock
         of its own. Solid, where the line it runs along is a quarter. */
      .workflow-pulse {
        /* The same 7 as the line's own end dots, so the thing travelling is
           the thing that sits at either end of the wire. */
        --workflow-pulse-size: 7px;

        background-color: var(--workflow-connector, var(--color-brand));
        block-size: var(--workflow-pulse-size);
        border-radius: var(--radius-full);
        /* The glow the design gives the connector's own dots: a drop shadow
           with no offset at radius 8, 0.7 on the blue and 0.6 on the orange.
           One value here — at this size the difference is not visible. */
        box-shadow: 0 0 8px color-mix(in srgb, var(--workflow-connector, var(--color-brand)) 65%, transparent);
        inline-size: var(--workflow-pulse-size);
        /* Centred on the line's start, not butted against it. Left at 0 its
