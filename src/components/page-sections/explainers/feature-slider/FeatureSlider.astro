---
import { bandPattern, bandHaze } from "@component-utils/bandStyle.mjs";
import { nestedProps } from "@component-utils/nestedProps.mjs";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Text from "@core-elements/text/Text.astro";
import Heading from "@core-elements/heading/Heading.astro";
import CustomSection from "@builders/custom-section/CustomSection.astro";
import FeatureSliderItem from "@explainers/feature-slider/FeatureSliderItem.astro";
import Carousel from "@wrappers/carousel/Carousel.astro";

type SlideProps = Record<string, unknown>;

/* `content` and `style` are the editor's tabs, flattened straight back into
   the names below. `at()` writes the frontmatter path a binding needs. */
const { props, at } = nestedProps(Astro.props, {
  nest: { heading: ["eyebrow", "heading", "headingLevel", "headingSize"] },
});

const {
  eyebrow = "",
  heading = "",
  headingLevel = "h2",
  headingSize = "lg",
  subtext = "",
  sectionLabel,
  maxContentWidth = "xl",
  paddingHorizontal = "gutter",
  paddingVertical = "4xl",
  colorScheme = "inherit",
  lockColorScheme = false,
  backgroundColor = "light-sand",
  /** The texture behind the band, by name. */
  pattern = "none",
  /** Which edge the texture fades out towards. */
  fade = "none",
  /** Whether the heading sits on a pool of the band’s own colour. */
  haze = false,
  class: className,
  slides = [],
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = props;
---

<CustomSection
  class:list={["feature-slider", className]}
  label={sectionLabel}
  maxContentWidth={maxContentWidth}
  paddingHorizontal={paddingHorizontal}
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  lockColorScheme={lockColorScheme}
  backgroundColor={backgroundColor}
  background={bandPattern(pattern, fade)}
  haze={bandHaze(haze)}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  {(eyebrow || heading || subtext) && (
    <Fragment>
      <SimpleText
        class="eyebrow"
        size="sm"
        data-prop={at("eyebrow")}
        text={eyebrow}
      />
      <Heading
        level={headingLevel}
        size={headingSize}
        data-prop={at("heading")}
      >
        {heading}
      </Heading>
      <Text
        class="subtext"
        data-prop={at("subtext")}
        text={subtext}
      />
    </Fragment>
  )}

  <Carousel
    label={sectionLabel || "Feature slider"}
    slideWidthPercent={100}
    minSlideWidth={0}
    autoPlay={false}
    autoScroll={false}
    data-children-prop={at("slides")}
  >
    {slides?.map((slide: SlideProps, index: number) => (
      <FeatureSliderItem
        index={index}
        aria-label={`Slide ${index + 1} of ${slides.length}`}
        data-editable="array-item"
        data-id="page-sections/explainers/feature-slider/feature-slider-item"
        data-component="page-sections/explainers/feature-slider/feature-slider-item"
        {...slide}
      />
    ))}
  </Carousel>
</CustomSection>
