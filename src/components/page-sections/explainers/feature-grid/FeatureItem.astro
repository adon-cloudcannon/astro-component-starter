---
import Heading from "@core-elements/heading/Heading.astro";
import Icon from "@core-elements/icon/Icon.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Text from "@core-elements/text/Text.astro";
import Button from "@core-elements/button/Button.astro";
import Card from "@wrappers/card/Card.astro";
import Image from "@core-elements/image/Image.astro";
import GridItem from "@wrappers/grid/GridItem.astro";

const {
  title = "",
  headingLevel = "h3",
  description = "",
  iconName = "",
  iconColor = "default",
  iconBackground = true,
  /**
   * The plate behind the icon, filled rather than tinted.
   *
   * The design's benefit cards draw a disc of the card's own colour at full
   * strength with the glyph knocked out of it, where the plate everywhere
   * else is that colour at its 100 step. Off by default: every other grid on
   * the site draws the tinted one.
   */
  iconSolid = false,
  /**
   * The colour of the card's rule.
   *
   * Enterprise's "Custom plans" keeps its accent there and nowhere else — one
   * palette colour per card — and draws it solid, where Card's own accented
   * border is the same colour at 18%.
   */
  accentColor = "none",
  backgroundColor = "light-sand",
  /**
   * A drawing instead of an icon, above the title rather than beside it.
   * The design uses this shape wherever the card is about a capability rather
   * than a setting — six of them under "Fits the way you already build" — and
   * an icon in its place reads as a form row.
   */
  imageSource = "",
  imageAlt = "",
  /**
   * How tall the design draws this particular drawing.
   *
   * Each one gets its own box — 151 to 195 across the two grids that use this
   * card — and the files are served at about three times that, so with only a
   * shared cap every drawing rendered at exactly the cap and a 180 came out
   * 140. Left unset the old cap still applies.
   */
  imageHeight,
  /**
   * A card that points somewhere else: a label for who it is for, a heading
   * big enough to read as a destination, and a link out. The design uses it
   * two-up at the foot of a page — "For agencies" / "For enterprise" — where
   * the other shapes here are one point among several.
   */
  eyebrow = "",
  linkText = "",
  link = "",
  /**
   * Left alone, the shape decides. `lg` is the 46 the design sets here: this
   * project overrides the starter's heading scale, where the same name is 65,
   * so the size has to be read off the page rather than off the token file.
   */
  titleSize,
  /**
   * The card's line, which the design sets at 19 rather than the 16 this was
   * rendering. Six of the seven feature grids in the file put their card body
   * at 19px, which is `lg` in this theme; the seventh, Agencies' "Scale
   * changes nothing", sets 17 and can say so.
   */
  descriptionSize = "lg",
  /**
   * A hairline between the card's head and its line.
   *
   * Careers draws one across all nine of its benefit cards, the full inner
   * width, in the same dark sand the signpost card already rules with. It is
   * off everywhere else, so it is asked for rather than inferred: a rule
   * under a one-line title on a card with no body reads as a strikethrough.
   */
  divider = false,
  alignmentHorizontal = "start",
  class: className,
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const signpost = Boolean(eyebrow || linkText);
// A card with neither a drawing nor an icon is plain copy, and the design sets
// its title at the same 29 as the illustrated ones rather than the larger size
// an icon card takes.
const headingSize = titleSize ?? (signpost ? "lg" : imageSource || !iconName ? "sm" : "md");
---

<GridItem
  class="feature-grid-item"
  {...htmlAttributes}
>
  <Card
    class:list={[
      "feature-item",
      `align-${alignmentHorizontal}`,
      signpost && "is-signpost",
      accentColor !== "none" && "has-accent",
      className,
    ]}
    accentColor={accentColor}
    style={imageHeight ? `--feature-image-height: ${Number(imageHeight)}px` : undefined}
    paddingHorizontal={signpost ? "2xl" : "lg"}
    paddingVertical={signpost ? "2xl" : "lg"}
    rounded
    border
    backgroundColor={backgroundColor}
  >
    {imageSource && (
      <Image
        class="feature-illustration"
        source={imageSource}
        alt={imageAlt}
        data-prop-src="imageSource"
        data-prop-alt="imageAlt"
      />
    )}
    {signpost && imageSource && <div class="feature-rule"></div>}
    {eyebrow && (
      <SimpleText
        class="eyebrow feature-eyebrow"
        alignmentHorizontal={alignmentHorizontal}
        data-prop="eyebrow"
        text={eyebrow}
        size="sm"
      />
    )}
    <div class="feature-item-heading">
      {!imageSource && !signpost && iconName && (
        <Icon
          class="feature-icon"
          name={iconName}
          size="lg"
          color={iconColor}
          background={iconBackground ? (iconSolid ? "solid" : true) : false}
          alignmentHorizontal="start"
        />
      )}
      <Heading
        class="feature-title"
        level={headingLevel}
        size={headingSize}
        alignmentHorizontal={alignmentHorizontal}
        data-prop="title"
      >
        {title}
      </Heading>
    </div>
    {divider && description && <div class="feature-rule feature-divider"></div>}
    <Text
      class="feature-description"
      alignmentHorizontal={alignmentHorizontal}
      size={descriptionSize}
      data-prop="description"
      text={description}
    />
    {linkText && (
      /* The same Button every other arrow link on the site is, rather than an
         anchor of this card's own: side by side with the one in the Publish
         band these were the same size and colour at different weights, 400
         against 600, because only one of them was the component. */
      <Button
        class="feature-link"
        variant="text"
        textColor="sunset"
        iconName="arrow-right"
        iconPosition="after"
        size="md"
        text={linkText}
        link={link}
        data-prop="linkText"
      />
    )}
  </Card>
</GridItem>

<style is:global>
  @layer page-sections {
    /* The title sits level with the icon, not hung from its top.

       The design centres the two against each other on every icon card it
       draws: Careers' disc runs 36 to 96 inside the card and both a one-line
       and a two-line title centre on 66. Hung from the top, a title that
       wraps leaves the disc stranded against its first line. */
    .feature-item-heading {
      align-items: center;
      display: flex;
      gap: var(--spacing-sm);
    }

    .feature-item-heading .feature-icon {
      flex-shrink: 0;
    }

    /* The design's disc is 60 across with a 35 glyph in it, and the disc is
       drawn from the glyph — 0.36em of padding either side — so the size to
       set is the glyph's. Left at the icon's own `lg` it came out 46, which
       beside a 20px title reads as a bullet rather than as the card's mark.
       This rule is in `page-sections`, so it out-ranks the size class the
       icon sets on itself without having to out-specify it. */
    .feature-item .feature-icon .background-solid {
      font-size: 2.1875rem;
    }

    .feature-title {
      flex: 1;
      margin-block: 0;
      min-width: 0;
    }

    .feature-description {
    }
  }

  /* A card built around a drawing: the picture on top, then the title and the
     line under it, all centred. The design draws 380x334 with the art about
     halfway up, so the illustration takes the room it needs and the copy sits
     under it.

     Flat, because rules nested deeper than a couple of levels get dropped (see
     CLAUDE.md). */
  @layer page-sections {
    .feature-item.align-center .feature-item-heading {
      justify-content: center;
    }

    .feature-item.align-center .feature-title {
      flex: 0 1 auto;
    }

    /* Centring the wrapper is not enough: Image puts an `.image-inner` inside
       it that takes the full width, and the picture sits at its start. The
       titles were dead centre while the drawings above them sat 60 to 98 left,
       which reads as six cards each knocked askew. */
    .feature-item .feature-illustration,
    .feature-item .feature-illustration .image-inner {
      display: flex;
      justify-content: center;
    }

    /* The art hangs from the foot of a box as tall as the tallest drawing in
       the row, so every title in the row starts on the same line. The design
       draws 180, 151 and 162 side by side and still keeps them level. */
    .feature-item.align-center .feature-illustration {
      align-items: end;
      block-size: var(--feature-art-row, auto);
    }

    .feature-item.align-center .feature-illustration .image-inner {
      align-items: end;
      block-size: 100%;
    }

    .feature-item .feature-illustration img {
      display: block;
      margin-inline: auto;
    }

    .feature-item .feature-illustration img {
      block-size: auto;
      inline-size: auto;
      max-block-size: var(--feature-image-height, 8.75rem);
      max-inline-size: 100%;
    }
  }

  /* The signpost card: a picture across the top, a rule under it, then who it
     is for, where it goes and a way in. The design draws 503x714 on a 1280
     page, padded 48, with the art sitting nearer the top than the padding
     would put it.

     Flat, because rules nested deeper than a couple of levels get dropped (see
     CLAUDE.md). */
  @layer page-sections {
    /* The design draws this rule solid, one palette colour per card; Card's
       own accented border is the same colour at 18%, which reads as no accent
       at all from a step back. */
    .feature-grid .feature-item.has-accent .card-inner {
      border-color: var(--card-accent);
    }

    /* A set height, not one that follows the copy. */
    .feature-item .card-inner {
      min-block-size: var(--feature-card-height, auto);
    }

    /* With a set height the copy would hang from the top of it. The design
       centres it in the card, which is what makes six cards of one height with
       one to three lines in them read as a set. */
    .feature-item.align-center .card-outer-content,
    .feature-item.align-center .card-content {
      block-size: 100%;
    }

    .feature-item.align-center .card-content {
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .feature-item.is-signpost {
      --feature-art-height: 21rem;
      border-color: var(--dark-sand);
    }

    /* Every gap here is set as --space-before, not as a margin.
       margin-block-start written from a page-sections rule loses outright: the
       flow layer sits in `utils`, which out-ranks this one, and writes the same
       property from --space-before. The first pass set all five gaps as plain
       margins and not one of them applied — what shipped was flow's own
       default, which put the eyebrow 9px under the rule and the body 9px under
       the heading (see CLAUDE.md). */

    /* A block of fixed height, not a picture of whatever size it happens to
       be. The design's two drawings are 305 and 319 tall and both cards put
       the rule under them at the same height; sized to their own art the rules
       came out 26 apart and the cards read as misaligned.

       It also runs wider than the copy column, out to within a few pixels of
       the card's edge: one drawing is inset well inside the padding and the
       other bleeds past it, so the column is the wrong frame for both. */
    .feature-item.is-signpost .feature-illustration {
      align-items: center;
      block-size: var(--feature-art-height);
      margin-block-start: -1.5rem;
      margin-inline: -2.75rem;
    }

    .feature-item.is-signpost .feature-illustration .image-inner {
      align-items: center;
      block-size: 100%;
    }

    /* A length, not a percentage. Image wraps the picture in a <picture>,
       whose own height is auto, so `block-size: 100%` resolved against nothing
       and the drawing fell back to the served file's size — two thirds of what
       the design draws, with air around it (see CLAUDE.md). */
    .feature-item.is-signpost .feature-illustration img {
      block-size: var(--feature-art-height);
      inline-size: auto;
      max-block-size: none;
      max-inline-size: 100%;
      object-fit: contain;
    }

    /* The design draws it 26 under the icon disc and 22 over the line, which
       is the card's own rhythm rather than the signpost's 24. The rule runs
       the card's inner width, so it needs nothing of its own to stretch. */
    .feature-item .feature-divider {
      background-color: var(--dark-sand);
      block-size: var(--border-width-sm, 1px);
      /* A 1px div has no width of its own, so in a centred card it collapsed
         to nothing and measured as applied while drawing no rule at all. */
      align-self: stretch;
      inline-size: 100%;
      --space-before: 1.625rem;
    }

    .feature-item .feature-divider + .feature-description {
      --space-before: 1.375rem;
    }

    .feature-item.is-signpost .feature-rule {
      background-color: var(--dark-sand);
      block-size: var(--border-width-sm, 1px);
      --space-before: 1.5rem;
    }

    .feature-item.is-signpost .feature-eyebrow {
      --space-before: 2rem;
    }

    .feature-item.is-signpost .feature-item-heading {
      --space-before: 0.875rem;
    }

    .feature-item.is-signpost .feature-description {
      --space-before: 1.25rem;
    }

    /* Same text link the testimonials use: Sunset, with the arrow beside the
       label rather than inside it. */
    /* The gap above it is this card's own; everything else about the link now
       comes from the Button component. */
    .feature-item.is-signpost .feature-link {
      --space-before: 0.75rem;
    }

    .feature-item.is-signpost .feature-link .button-inner {
      padding-block: 0;
    }
  }
</style>
