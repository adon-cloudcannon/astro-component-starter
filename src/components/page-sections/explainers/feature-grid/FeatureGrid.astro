---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Text from "@core-elements/text/Text.astro";
import FeatureItem from "@explainers/feature-grid/FeatureItem.astro";
import Grid from "@wrappers/grid/Grid.astro";
import { nextHeadingLevel } from "@component-utils/headingLevel";

type FeatureProps = Record<string, unknown>;

const {
  eyebrow = "",
  heading = "",
  headingLevel = "h2",
  headingSize = "lg",
  subtext = "",
  // The design sets a section's supporting line in one of two styles, Body 3
  // at 19 or Subtitle 1 at 22. `md` is the 16 every section rendered before
  // either was carried through, so nothing moves unless the design named it.
  subtextSize = "md",
  /**
   * The measure the design sets the supporting line in, in pixels.
   *
   * Not the column it sits in: a centred subtext is drawn at about 580 in the
   * 1040 column, and run the full width it reads as a different block.
   */
  subtextWidth,
  features = [],
  /**
   * The design runs these three across when they are one point each, and two
   * across when each card is a destination of its own with its own art.
   */
  columns = 3,
  /**
   * How tall the design draws these cards, in pixels.
   *
   * A set height, not one that follows the copy: every grid in the file draws
   * one height across the whole section — 247 on "Custom plans", 334 on the
   * three illustrated ones — while the lines inside run from one to three.
   */
  cardHeight,
  sectionLabel,
  maxContentWidth = "xl",
  paddingHorizontal = "gutter",
  paddingVertical = "4xl",
  colorScheme = "inherit",
  lockColorScheme = false,
  backgroundColor = "light-sand",
  background,
  haze = false,
  alignmentHorizontal = "center",
  /**
   * The size of each card's line, for the whole grid. A card can still say
   * otherwise: this sits before the spread.
   */
  descriptionSize = "lg",
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const itemHeadingLevel = nextHeadingLevel(headingLevel);

/**
 * The cards sit a shade off the band they are on. The design paints them
 * `--sand` on a `--light-sand` page, which is `surface` against `base`; an
 * icon-only grid keeps the flat card it has always had.
 */
/**
 * A card a shade off the band, whichever way the band goes.
 *
 * On the cream pages that is --sand against --light-sand, which is `surface`
 * against `base`. On a dark band `surface` is #333333 and the design draws
 * #252423, which is `muted`: two steps off on the light theme and one step off
 * here (see CLAUDE.md on the dark cards).
 */
const cardColor =
  colorScheme === "dark" ? "muted" : alignmentHorizontal === "center" ? "surface" : "base";

/**
 * The tallest drawing in the row.
 *
 * Each card's art is drawn at its own height — 180, 151 and 162 on Content
 * Editors — and the design still lands all three titles on the same line, so
 * the art sits in a shared box and hangs from its foot. Sized to each drawing
 * the titles stepped up and down across the row.
 */
const artRow = Math.max(0, ...features.map((feature: FeatureProps) => Number(feature.imageHeight) || 0));
---

<CustomSection
  class:list={["feature-grid", className]}
  label={sectionLabel}
  maxContentWidth={maxContentWidth}
  paddingHorizontal={paddingHorizontal}
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  lockColorScheme={lockColorScheme}
  backgroundColor={backgroundColor}
  background={background}
  haze={haze}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  <SimpleText
    alignmentHorizontal={alignmentHorizontal}
    class="eyebrow"
    data-prop="eyebrow"
    text={eyebrow}
    size="sm"
  />
  <Heading
    level={headingLevel}
    size={headingSize}
    alignmentHorizontal={alignmentHorizontal}
    data-prop="heading"
  >
    {heading}
  </Heading>
  <Text
    class="feature-grid-subtext"
    alignmentHorizontal={alignmentHorizontal}
    style={subtextWidth ? `max-inline-size: ${Number(subtextWidth)}px; margin-inline: auto; justify-self: center` : undefined}    size={subtextSize}
    data-prop="subtext"
    text={subtext}
  />
  <Grid
    gap="lg"
    columns={columns}
    style={[
      artRow ? `--feature-art-row: ${artRow}px` : null,
      cardHeight ? `--feature-card-height: ${Number(cardHeight)}px` : null,
    ]
      .filter(Boolean)
      .join("; ") || undefined}
    class:list={["feature-grid-grid", `feature-grid-${columns}-up`]}
    data-children-prop="features"
  >
    {features?.map((feature: FeatureProps) => (
      <FeatureItem
        data-id="page-sections/explainers/feature-grid/feature-item"
        data-editable="array-item"
        alignmentHorizontal={alignmentHorizontal}
        backgroundColor={cardColor}
        descriptionSize={descriptionSize}
        {...feature}
        headingLevel={itemHeadingLevel}
      />
    ))}
  </Grid>
</CustomSection>

<style is:global>
  @layer page-sections {
  }

  /* A row of picture cards runs wider than the column the copy sits in: the
     design's other content width, 1180. Redefining the token rather than
     fighting CustomSection's own rule, which a page section cannot
     out-specify (see CLAUDE.md).

     Only the centred, illustrated variant. An icon grid keeps the column. */
  @layer page-sections {
    .feature-grid:has(.feature-item.align-center) {
      --content-width-xl: var(--content-width-wide);
    }

    /* On `.grid-inner`, which is the element that is actually the grid. Set on
       the wrapper this did nothing at all: Grid writes --grid-spacing inline
       on the inner div, and an inline custom property beats one inherited
       from the parent. */
    .feature-grid .feature-grid-grid > .grid-inner {
      gap: 1.09375rem;
    }

    /* Two rows of cards are one height in the design, not one height per row:
       "Custom plans" draws all six at 247 while their copy runs from one line
       to three. */
    .feature-grid .feature-grid-grid > .grid-inner {
      grid-auto-rows: 1fr;
    }

    /* Two large cards sit further apart than three small ones: 503 and 509
       with 42 between them, in the 1040 column. */
    .feature-grid .feature-grid-2-up > .grid-inner {
      gap: 2.625rem;
    }

    /* The rule around the card is the sand one, not the generic grey: the
       design draws #EBE1C9, which is --dark-sand. */
    /* :not(.has-accent), because an accented card rules itself in its own
       colour. Equal specificity between the two would otherwise be settled by
       whichever stylesheet Astro emitted last, which it settled the wrong way.

       The sand rule is for the cream bands. A dark band draws its own edge —
       #333333 on the perks cards — and the cream one on it reads as a border
       nobody asked for. CustomSection puts data-theme on its inner
       .outer-content, not on the section the classes are on. */
    .feature-grid .feature-item.align-center:not(.has-accent) .card-inner {
      border-color: var(--dark-sand);
    }

    .feature-grid [data-theme="dark"] .feature-item.align-center:not(.has-accent) .card-inner {
      border-color: var(--color-border);
    }
  }
</style>
