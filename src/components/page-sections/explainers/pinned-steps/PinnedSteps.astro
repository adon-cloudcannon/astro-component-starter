---
/**
 * A band that pins while its steps advance.
 *
 * The difference from `scroll-steps` is what holds still. There, the media is
 * sticky and the copy scrolls past it, so the band's background travels with
 * the page and each step keeps its own slot in a tall column. Here the whole
 * band pins — background, pattern and both columns — and only the contents
 * change, one step at a time, with a bar along the foot saying where you are.
 *
 * Two things follow from that, and they are the reasons this exists:
 *
 *  - It does not depend on there being a picture. The stage's height is the
 *    viewport's and the runway's is the step count, so a step whose media is
 *    still a hand export behaves exactly like one with the art in place.
 *  - The steps share a single cell and cross-fade, so they replace each other
 *    where they stand instead of stacking with the inactive one leaving a
 *    hole the same size.
 *
 * The band itself is still a CustomSection, so colour, pattern, haze, padding
 * and the editable bindings all work the way they do everywhere else. This
 * only wraps it in a runway and makes it sticky.
 */
import CustomSection from "@page-sections/builders/custom-section/CustomSection.astro";
import Component from "@component-utils/renderBlock.astro";
import Heading from "@core-elements/heading/Heading.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Text from "@core-elements/text/Text.astro";
import type { ContentBlock } from "../../../../types";

type Step = Record<string, unknown> & {
  contentSections?: ContentBlock[];
  mediaSections?: ContentBlock[];
};

const {
  eyebrow = "",
  heading = "",
  headingLevel = "h2",
  headingSize = "lg",
  subtext = "",
  subtextSize = "md",
  subtextWidth,
  alignmentHorizontal = "center",
  steps = [],
  reverse = false,
  mediaWidth = "half",
  showProgress = true,
  /**
   * How far the progress bar runs.
   *
   * `full` spans the whole band, which is what the design draws where the
   * sequence owns the band. `content` runs from the media column's edge to the
   * band's, so it sits under the copy alone — 490 of a 1293 band on Low
   * Maintenance, against 1276 of 1352 on Agencies.
   */
  /**
   * Screens of scrolling each step holds for.
   *
   * One screen a step reads as fast: a slide arrives, and the next is already
   * on its way before the copy has been read. This is the only number that
   * decides the pace — the runway is split evenly, so there is no separate
   * pause to tune.
   */
  stepScroll = 1.1,
  /** The palette colour the fill is drawn in. */
  progressColor = "sunset",
  /**
   * The colour of the track behind the fill.
   *
   * Stated, not derived. The design picks one per band and not one of them is
   * a tint of its fill: #6B6157 behind blush on High Performance, #333333
   * behind three different colours, #9FA199 behind moss on Git. Left as the
   * fill at 22% the track came out a pale wash of the accent where the design
   * draws a flat grey.
   */
  progressTrackColor = "",
  sectionLabel,
  maxContentWidth = "xl",
  paddingHorizontal = "gutter",
  paddingVertical = "4xl",
  colorScheme = "inherit",
  lockColorScheme = false,
  backgroundColor = "base",
  background,
  haze = false,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  "data-children-prop": childrenDataProp,
  ...htmlAttributes
} = Astro.props;

const stepList: Step[] = Array.isArray(steps) ? steps : [];
const blocks = (sections: unknown): ContentBlock[] =>
  Array.isArray(sections) ? (sections as ContentBlock[]) : [];

const hasHeader = Boolean(eyebrow || heading || subtext);
const effectiveChildrenProp = childrenDataProp ?? (useDefaultEditableBinding ? "steps" : null);
const arrayDataAttributes = effectiveChildrenProp
  ? { "data-editable": "array", "data-prop": effectiveChildrenProp }
  : {};
---

<div
  class:list={["pinned-steps", `media-${mediaWidth}`, className]}
  {/* One `style`, not two. A second style attribute on the same element wins
      outright and drops the first: adding the accent this way quietly took the
      step count with it, and the runway was then built for a single step — all
      three advanced inside 1800px instead of 5220, which reads as the whole
      thing scrolling past far too fast. */}
  style={{
    "--pinned-steps-accent": `var(--${progressColor})`,
    ...(progressTrackColor
      ? {
          "--pinned-steps-track": progressTrackColor.startsWith("#")
            ? progressTrackColor
            : `var(--${progressTrackColor})`,
        }
      : {}),
    "--pinned-steps-count": Math.max(stepList.length, 1),
    "--pinned-steps-step-scroll": `calc(${Number(stepScroll) || 1.1} * 100dvh)`,
  }}
  {...htmlAttributes}
>
  <CustomSection
    class="pinned-steps-stage"
    label={sectionLabel}
    maxContentWidth={maxContentWidth}
    paddingHorizontal={paddingHorizontal}
    paddingVertical={paddingVertical}
    colorScheme={colorScheme}
    lockColorScheme={lockColorScheme}
    backgroundColor={backgroundColor}
    background={background}
    haze={haze}
  >
    {hasHeader && (
      <div class="pinned-steps-header flow">
        {/* Each guarded on its own content. An empty element is still a
            sibling, and the flow layer pays for every one after the first. */}
        {eyebrow && (
          <SimpleText
            alignmentHorizontal={alignmentHorizontal}
            class="eyebrow"
            size="sm"
            text={eyebrow}
          />
        )}
        {heading && (
          <Heading
            alignmentHorizontal={alignmentHorizontal}
            level={headingLevel}
            size={headingSize}
          >
            {heading}
          </Heading>
        )}
        {subtext && (
          <Text
            alignmentHorizontal={alignmentHorizontal}
            class="subtext"
            size={subtextSize}
            style={subtextWidth
              ? `max-inline-size: ${Number(subtextWidth)}px; margin-inline: auto`
              : undefined}
            text={subtext}
          />
        )}
      </div>
    )}

    <div
      class:list={["pinned-steps-layout", `media-${mediaWidth}`, { reversed: reverse }]}
      {...arrayDataAttributes}
    >
      <div class="pinned-steps-media">
        {stepList.map((step, index) => (
          <div
            class="pinned-steps-panel"
            data-index={index}
            data-active={index === 0 ? "" : undefined}
            aria-hidden={index !== 0}
          >
            <Component contentSections={blocks(step.mediaSections)} />
          </div>
        ))}
      </div>

      <div class="pinned-steps-copy">
        {stepList.map((step, index) => (
          <div
            class="pinned-steps-step flow"
            data-index={index}
            data-active={index === 0 ? "" : undefined}
            data-editable="array-item"
            aria-hidden={index !== 0}
            role="group"
            aria-roledescription="step"
            aria-label={`Step ${index + 1} of ${stepList.length}`}
          >
            {step.number && (
              /* Decorative: it repeats what the progress bar already says, so
                 it is hidden rather than read out as another heading. */
              <span
                class="pinned-steps-step-number"
                aria-hidden="true"
              >
                {step.number}
              </span>
            )}
            <Component contentSections={blocks(step.contentSections)} />
          </div>
        ))}
      </div>
    </div>

    {showProgress && stepList.length > 1 && (
      <div
        class:list={["pinned-steps-progress-rail", { reversed: reverse }]}
        aria-hidden="true"
      >
        <div class="pinned-steps-progress">
          <span class="pinned-steps-progress-fill" />
        </div>
      </div>
    )}
  </CustomSection>
</div>

<style is:global>
  @layer page-sections {
    .pinned-steps {
      /* The runway, and the only thing that decides how long the band holds:
         not the height of whatever is in the media.

         A screen and a tenth per step by default, plus a screen for the stage
         itself. This is a balance, not a maximum: the band is pinned for the
         whole runway, so every extra screen is a screen where scrolling
         appears to do nothing. At 1.6 one band was 5220px of a 9605px page —
         54% of Low Maintenance spent pinned, which reads as the page having
         stopped responding. Split evenly rather than pausing on the first — a
         hold that only the first step gets is a special case, and how long a
         slide lasts is one number.

         `stepScroll` writes it per band, so a long step can be given more
         without changing the rest. */
      min-height: calc(
        100dvh + var(--pinned-steps-count, 1) * var(--pinned-steps-step-scroll, 100dvh)
      );
      position: relative;
    }

    .pinned-steps > .pinned-steps-stage {
      /* One row that takes what is left, so the content box fills the pinned
         band rather than stopping at the copy. The progress rail is positioned
         against `.content` — CustomSection makes it the nearest positioned
         ancestor — so `bottom: 0` was the foot of the COPY, not of the band:
         205px short on High Performance, where the steps are shortest. */
      display: grid;
      /* `minmax(0, 1fr)`, not `1fr`: a grid row's automatic minimum is its
         content's min-content size, so the row grew to whatever was in it and
         took the stage's own height with it. That is what put the content box
         72px past the stage here. */
      grid-template-rows: minmax(0, 1fr);
      /* Exactly the visible area, never taller.
      
         It was a minimum, so content taller than the viewport pushed the stage
         past it, and everything anchored to the stage's foot went with it: on
         a 780-tall window the stage ran to 806 and the progress bar sat 26px
         below the fold. Measured across eight sizes, the bar was off-screen on
         five of them, which is most laptops.
      
         A pinned band is the visible area by definition, so this is a height
         rather than a floor, and what is inside fits itself to it. */
      block-size: calc(100dvh - var(--main-nav-height, 0px));
      position: sticky;
      top: var(--main-nav-height, 0px);
    }

    .pinned-steps > .pinned-steps-stage > .outer-content,
    .pinned-steps > .pinned-steps-stage > .outer-content > .content {
      block-size: 100%;
    }

    /* The steps sit in the middle of what the header leaves, not directly
       under it. The design gives "Happy developers" 228px between its foot
       and the step's heading where flow's own space-before gave 24, and the
       distance is not a number to hardcode: it is whatever is left of the
       band once the header has taken its share. A band with no header gets
       the same treatment with one row, so the four that carry no heading
       centre in the band rather than sitting at its top. */
    .pinned-steps > .pinned-steps-stage > .outer-content > .content {
      display: grid;
      grid-template-rows: minmax(0, 1fr);
    }

    .pinned-steps > .pinned-steps-stage > .outer-content > .content:has(> .pinned-steps-header) {
      grid-template-rows: auto minmax(0, 1fr);
    }

    .pinned-steps > .pinned-steps-stage > .outer-content > .content > .pinned-steps-layout {
      align-self: center;
      /* flow writes margin-block-start from this, and a plain margin loses to
         it. Inside a grid row the row does the spacing. */
      --space-before: 0;
      margin-block: 0;
    }

    /* On the section rather than the layout, so the progress rail can lay
       itself out on the same tracks instead of restating the fractions. */
    .pinned-steps {
      --pinned-steps-columns: 1fr 1fr;
    }

    /* The media takes two thirds and the copy one, which is what both designs
       draw: the copy measures 441 of the 1352 band on Agencies and about 314
       of 1293 on Low Maintenance, a third or less either way.

       These were 2fr 3fr and 3fr 2fr, which gave the copy 60% — the media was
       the narrower column on a band named `media-wide`. */
    .pinned-steps.media-wide {
      --pinned-steps-columns: 2fr 1fr;
    }

    .pinned-steps.media-narrow {
      --pinned-steps-columns: 1fr 2fr;
    }

    .pinned-steps-layout {
      align-items: center;
      display: grid;
      gap: var(--spacing-3xl);
      grid-template-columns: var(--pinned-steps-columns);

      /* Reversing swaps the tracks as well as the order. Moved with `order`
         alone, a wide media came out as the narrow column. */
      &.reversed {
        direction: rtl;

        > * {
          direction: ltr;
        }
      }
    }

    /* Both columns stack their own children in one cell, so a step and its
       picture each replace what came before where they stand. */
    .pinned-steps-media,
    .pinned-steps-copy {
      display: grid;
    }

    /* A media that carries a full-bleed panel is not a picture in a column:
       the design paints that half of the band, corner to corner. So the row
       stretches, the column takes the band's whole height, and the panel
       reaches past the content column to the window's edge. */
    .pinned-steps-layout:has(.stat-panel-panel.fit-fill) {
      align-items: stretch;
      /* The layout has to fill the content box before stretching its columns
         can mean anything: as a flow child it was only as tall as the copy, so
         the panel came out 272 of the band's 820. The content box already
         fills the stage, and the media's negative block margins then take the
         panel back out through its padding. */
      --space-before: 0;
      block-size: 100%;
      margin-block: 0;
    }

    /* Out to the window from the content column's edge. Written from the
       column rather than as a percentage: a percentage margin resolves against
       the element's own grid area — the media column — so `calc(50% - 50vw)`
       took half of THAT and overshot the window by 195px. */
    .pinned-steps-media:has(.stat-panel-panel.fit-fill) {
      /* A negative margin moves the box, it does not grow it: at a plain 100%
         the panel sat 80 above and 80 short of the band's feet, the padding it
         had just been pulled out through. Take the padding back as height. */
      block-size: calc(100% + 2 * var(--spacing-4xl));
      margin-block: calc(-1 * var(--spacing-4xl));
      margin-inline-start: calc(var(--content-width-xl, 1040px) / 2 - 50vw);
    }

    .pinned-steps-layout.reversed .pinned-steps-media:has(.stat-panel-panel.fit-fill) {
      margin-inline-end: calc(var(--content-width-xl, 1040px) / 2 - 50vw);
      margin-inline-start: 0;
    }

    /* And the height has to reach the panel: the media is a grid of stacked
       steps, each one its own box, so stretching the column alone left the
       panel at its content height. */
    .pinned-steps-media:has(.stat-panel-panel.fit-fill) .pinned-steps-panel {
      block-size: 100%;
    }

    .pinned-steps-panel,
    .pinned-steps-step {
      grid-area: 1 / 1;
      opacity: 0;
      pointer-events: none;
      transition:
        opacity var(--duration-md, 0.3s) var(--ease-smooth),
        visibility 0s linear var(--duration-md, 0.3s);
      visibility: hidden;

      &[data-active] {
        opacity: 1;
        pointer-events: auto;
        transition-delay: 0s, 0s;
        visibility: visible;
      }
    }

    /* The design draws the bar across the whole band at its foot, not across
       the column the copy sits in. Absolute against the nearest positioned
       ancestor gave it the column's 1096, so it is centred on the viewport and
       given the viewport's width instead: that holds whatever the section's
       own padding and max-width happen to be. */
    /* Hard on the band's foot, the full width of the window, with the bar
       placed inside it. The design draws both variants 10 thick and sitting on
       the very bottom edge. */
    /* The design draws it at 40 in white above the step's own title; the
       nearest slot is Header 4 at 42. */
    .pinned-steps-step-number {
      display: block;
      font-family: var(--font-family-heading);
      font-size: var(--font-size-heading-md);
      font-weight: var(--font-weight-heading-md);
      line-height: 1;
      margin-block-end: var(--spacing-lg);
    }

    .pinned-steps-progress-rail {
      bottom: 0;
      left: 50%;
      position: absolute;
      transform: translateX(-50%);
      z-index: var(--layer-2);
    }

    /* Under the copy alone. The rail narrows to the content column and borrows
       the layout's own tracks, so the split follows `mediaWidth` rather than
       being restated here; the bar then takes the copy track, eats the gap so
       it starts where the media ends, and bleeds out to the band's edge. */
    .pinned-steps-progress-rail {
      --pinned-steps-rail: min(
        calc(100vw - 2 * var(--spacing-gutter)),
        var(--content-width-xl, 1040px)
      );

      display: grid;
      gap: var(--spacing-3xl);
      grid-template-columns: var(--pinned-steps-columns);
      inline-size: var(--pinned-steps-rail);
    }

    /* Reversed the same way the layout is, so the bar follows the copy to the
       other side. Without it the rail kept `grid-column: 2` on the right while
       the copy moved left, and Git's bar sat at 771 where the design draws it
       at 0. The inline margins are direction-relative, so the gap it eats and
       the edge it bleeds to swap with it — which is why the bar is NOT set
       back to ltr here the way the layout's children are. Doing that resolves
       its margins against its own direction again, and it came out 56 short of
       the window instead of flush to it. The fill is unaffected either way:
       `clip-path` is physical, so it grows from the left, which is the side
       the design fills from in both directions. */
    .pinned-steps-progress-rail.reversed {
      direction: rtl;
    }

    /* Out to the window's edge. Written from the rail's own width rather than
       as a percentage: a percentage margin on a grid item resolves against its
       grid AREA, not its container, so `calc(50% - 50vw)` took half the copy
       track and reached 227px past the window. */
    .pinned-steps-progress-rail > .pinned-steps-progress {
      grid-column: 2;
      margin-inline-end: calc(var(--pinned-steps-rail) / 2 - 50vw);
      margin-inline-start: calc(-1 * var(--spacing-3xl));
    }

    .pinned-steps-progress {
      background-color: var(
        --pinned-steps-track,
        color-mix(in srgb, var(--pinned-steps-accent, var(--sunset)) 22%, transparent)
      );
      block-size: 10px;
      overflow: hidden;
    }

    /* Held at 0 until the band actually pins, so a reader who has not reached
       it yet sees an empty bar rather than one already a step in. The driver
       then jumps it to the first step's share and this slides it there, which
       is the only animation in the block.

       Revealed with clip-path, and the driver writes the whole value rather
       than feeding a custom property into it. A transition never fires when
       what it would animate is derived from an unregistered custom property:
       `scaleX(var(--pinned-steps-progress))` stayed at its initial 0 whatever
       the variable did, and a `calc()` on the same variable then stuck at the
       first value it happened to compute. A concrete value transitions the way
       anything else does, and clipping leaves the fill at full width so
       nothing is laid out again. */
    .pinned-steps-progress-fill {
      background-color: var(--pinned-steps-accent, var(--sunset));
      block-size: 100%;
      /* The first step's share, not empty: this is where the bar starts, and
         it is also exactly what the driver writes on its first pass, so
         nothing animates on arrival. It is the right state with no script
         running too. */
      clip-path: inset(0 calc(100% - 100% / var(--pinned-steps-count, 1)) 0 0);
      display: block;
      transition: clip-path var(--duration-lg, 0.5s) var(--ease-smooth, ease);
    }

    /* One column, everything visible, nothing pinned. The sequence is a
       desktop idea: on a phone there is no room beside the copy for the media
       to hold still in. */
    @media (max-width: 767px) {
      .pinned-steps {
        min-height: 0;
      }

      .pinned-steps > .pinned-steps-stage {
        min-height: 0;
        position: static;
      }

      .pinned-steps-layout {
        grid-template-columns: 1fr;

        &.reversed {
          direction: ltr;
        }
      }

      .pinned-steps-media,
      .pinned-steps-copy {
        display: contents;
      }

      .pinned-steps-panel,
      .pinned-steps-step {
        grid-area: auto;
        opacity: 1;
        pointer-events: auto;
        visibility: visible;
      }

      .pinned-steps-progress {
        display: none;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .pinned-steps-panel,
      .pinned-steps-step,
      .pinned-steps-progress-fill {
        transition: none;
      }
    }
  }
</style>

<script>
  import { onPageLoad } from "@component-utils/onPageLoad";
  import { setupAllPinnedSteps } from "./setup";

  onPageLoad(() => setupAllPinnedSteps());
</script>
