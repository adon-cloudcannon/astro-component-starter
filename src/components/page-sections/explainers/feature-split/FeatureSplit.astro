---
import { bandPattern, bandHaze } from "@component-utils/bandStyle.mjs";
import { nestedProps } from "@component-utils/nestedProps.mjs";
import { rootMirror } from "@component-utils/rootMirror.mjs";
import CustomSection from "@builders/custom-section/CustomSection.astro";
import { subtextMeasure } from "@component-utils/subtextMeasure.mjs";
import Heading from "@core-elements/heading/Heading.astro";
import Image from "@core-elements/image/Image.astro";
import ShapePile from "@wrappers/shape-pile/ShapePile.astro";
import SiteCards from "@wrappers/site-cards/SiteCards.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Text from "@core-elements/text/Text.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";
import Split from "@wrappers/split/Split.astro";

/* `content` and `style` are the editor's tabs, flattened straight back into
   the names below. `at()` writes the frontmatter path a binding needs. */
const { props, at } = nestedProps(Astro.props, {
  nest: { heading: ["eyebrow", "heading", "headingLevel", "headingSize"] },
});

const {
  eyebrow = "",
  heading = "",
  headingLevel = "h2",
  headingSize = "lg",
  subtext = "",
  // The design sets this in Body 3 at 19 or Subtitle 1 at 22; the default
  // keeps the 16 every section used before either was carried through.
  subtextSize = "lg",
  /**
   * The measure the design sets the supporting line in, in pixels.
   *
   * Not the column it sits in: a centred subtext is drawn at about 580 in the
   * 1040 column, and run the full width it reads as a different block.
   */
  subtextWidth,
  buttonSections = [],
  imageSource = "",
  /**
   * A pile of labelled shapes in place of the picture.
   *
   * Opt-in, the way CtaSplit's second picture is: set it and the media half
   * becomes the pile, leave it and nothing about the section changes.
   */
  shapes = [],
  /**
   * The box the pile's own positions are measured in, and whether it drops
   * into place. Low Maintenance's pile is 664x340 and falls, which is where
   * the defaults come from; the Developers one is 481x402 and stands still.
   */
  pileWidth = 664,
  pileHeight = 340,
  pileFall = true,
  /** The corner radius of a square shape in the pile, in pixels. */
  pileRadius = 19,
  /**
   * How far the pile reaches back across the copy column, as a share of the
   * media pane, and how far its head sits below the band's own top padding.
   *
   * Low Maintenance's pile is drawn 664 wide against a 400 pane and starts
   * 107 down, which is where the defaults come from. A pile drawn inside its
   * own half — the Developers one is 679 to 1160 of a 1280 band — wants both
   * at nothing, or it slides under the copy and leaves a hole above itself.
   */
  pileOverhang = 66,
  pileHeadroom = 107,
  /**
   * The stack of environment cards the design draws beside "Publish when
   * you're ready". Takes the media half in place of a picture.
   */
  siteCards,
  imageAlt = "",
  imageAspectRatio = "portrait",
  imageRounded = true,
  imageBleed = false,
  /**
   * How wide the media column is drawn, in pixels.
   *
   * 400 is what every section built before this one used, so it stays the
   * default. The Partner Program's dashboard is drawn 628 against a 386 column
   * of copy, which is the picture carrying the band rather than sitting beside
   * it: left at 400 the mockup is too small to read.
   */
  mediaWidth,
  reverse = false,
  sectionLabel,
  maxContentWidth = "xl",
  paddingHorizontal = "gutter",
  paddingVertical = "4xl",
  colorScheme = "inherit",
  lockColorScheme = false,
  backgroundColor = "light-sand",
  /** The texture behind the band, by name. */
  pattern = "none",
  /** Which edge the texture fades out towards. */
  fade = "none",
  /** Whether the heading sits on a pool of the band’s own colour. */
  haze = false,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = props;

/* The measure the subtext is set in, as a length. */
const subtextCap = subtextMeasure(subtextWidth);

const minSplitWidth = 800;
const bleedSide = imageBleed ? (reverse ? "inline-start" : "inline-end") : undefined;
const imagePositionHorizontal = imageBleed ? (reverse ? "right" : "left") : "center";
const imagePositionVertical = imageBleed ? "top" : "center";

/* Mirrored onto the builder's `.content`: these land on the section's own
   root, which is the element CloudCannon binds the region to and never
   rewrites, so without this they are whatever the page was built with. */
const mirror = rootMirror({ class: { "has-pile": shapes?.length > 0 } });
---

<CustomSection
  mirror={mirror}
  class:list={["feature-split", shapes?.length > 0 && "has-pile", className]}
  label={sectionLabel}
  maxContentWidth={maxContentWidth}
  paddingHorizontal={paddingHorizontal}
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  lockColorScheme={lockColorScheme}
  backgroundColor={backgroundColor}
  background={bandPattern(pattern, fade)}
  haze={bandHaze(haze, { reverse, split: true })}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  <Split
    class="feature-split-layout"
    distributionMode={imageBleed ? "half" : "flexible-fixed"}
    {/* 708 for the site cards, which is the width the design draws that art
        group at: 492 to 1200 of a 1280 frame, against a copy column that is
        only 300 wide and wraps its heading onto two lines because of it. The
        400 every other split uses would shrink the mockup's own type with
        it, since the whole stack scales off its container. */}
    fixedWidth={siteCards?.cards?.length ? "708" : String(Number(mediaWidth) || 400)}
    data-bleed={bleedSide}
    minSplitWidth={minSplitWidth}
    reverse={reverse}
    alignmentVertical="center"
    gap="2xl"
    reverseOrderOnMobile={true}
  >
    <Fragment slot="first">
      <SimpleText
        class="eyebrow"
        data-prop={at("eyebrow")}
        text={eyebrow}
        size="sm"
      />
      <Heading
        level={headingLevel}
        size={headingSize}
        data-prop={at("heading")}
      >
        {heading}
      </Heading>
      <Text
        class="subtext feature-split-subtext"
        {/* A measure, not a centred block. The auto margins came from the
            centred sections and are wrong in a split, where the header runs
            from the column's left edge: they pushed the line in by half the
            slack, so a 342 measure in a 592 column started at 245 and ran to
            575 — straight under the pile. */}
        style={subtextCap ? `max-inline-size: ${subtextCap}` : undefined}
        size={subtextSize}
        data-prop={at("subtext")}
        text={subtext}
      />
      <ButtonGroup
        class="feature-buttons"
        buttonSections={buttonSections}
        direction="row"
        alignmentHorizontal="start"
        data-children-prop={at("buttonSections")}
      />
    </Fragment>
    {siteCards?.cards?.length > 0 ? (
      <SiteCards
        slot="second"
        class="feature-split-site-cards"
        cards={siteCards.cards}
        buttonLabel={siteCards.buttonLabel}
      />
    ) : shapes?.length > 0 ? (
      <ShapePile
        slot="second"
        class="feature-split-pile"
        style={`--pile-overhang: ${Number(pileOverhang) || 0}%; --pile-headroom: ${
          Number(pileHeadroom) || 0
        }px`}
        shapes={shapes}
        designWidth={pileWidth}
        designHeight={pileHeight}
        fall={pileFall}
        radius={pileRadius}
        data-children-prop={at("shapes")}
      />
    ) : (
    <Image
      slot="second"
      class="feature-split-image"
      source={imageSource}
      alt={imageAlt}
      rounded={imageRounded}
      aspectRatio={imageAspectRatio}
      positionHorizontal={imagePositionHorizontal}
      positionVertical={imagePositionVertical}
      sizes={imageBleed ? "(max-width: 800px) 100vw, 60vw" : undefined}
      widths={imageBleed ? [640, 1280, 1920, 2560] : undefined}
      data-prop-src={at("imageSource")}
      data-prop-alt={at("imageAlt")}
    />
    )}
  </Split>
</CustomSection>

<style is:global>
  @layer page-sections {
    /* The design draws the pile 664 wide from x=495, where the media half of
       a 1040 column starts nearer 530 — so it overhangs the copy column
       rather than the columns being resized. The overlap is only over empty
       space: the heading's block ends well above the cards that reach back
       that far.

       And it rests on the band's foot, not on the padding above it, which is
       what makes it a pile on the floor rather than a pile in mid-air. */
    /* The pile reaches back over the copy column, so the heading's own wrap is
       what keeps the two apart — and `text-wrap: balance` was quietly changing
       it. The design wraps "We don't think a website / should need this much /
       looking after", which is what plain wrapping gives at any width over
       500; balance evens the lines instead, at 322/415/462, and the long third
       line ran under the cards. Only where there is a pile to collide with. */
    /* The wrapper takes the measure; the paragraph inside it does not inherit
       one, so it kept `max-inline-size: none` and its lines ran past the box
       that was meant to hold them. Measure the leaf, style the leaf. */
    .feature-split .feature-split-subtext > :where(p, .simple-text-inner) {
      max-inline-size: 100%;
    }

    .feature-split.has-pile .heading,
    .feature-split.has-pile .heading-inner {
      text-wrap: wrap;
    }

    /* `--pile-overhang` and `--pile-headroom` come from the props, inline.

       A share of the pane, not a length: the panes shrink with the column
       below 1096 and a fixed overhang would eat the copy. Low Maintenance's
       media pane is 400 of the 1040 column, so 66% of it is the 264 that
       takes the pile to the design's 664 starting at 496. Its band is 527
       with the 340 pile on its foot, so 187 sits above it, of which the
       band's own top padding is 80 — the other 107 is the headroom. Without
       it that band came out 420, the pile rode up into the copy, and the
       heading ran behind the card that reaches furthest back. */
    .feature-split .feature-split-pile {
      align-self: end;
      margin-block-start: var(--pile-headroom);
      inline-size: calc(100% + var(--pile-overhang));
      margin-block-end: calc(-1 * var(--spacing-4xl));
      margin-inline-start: calc(-1 * var(--pile-overhang));
    }

    /* Stacked, there is no copy column to reach back into. The inline style
       the prop writes is on the element, so this has to out-rank it. */
    @media (max-width: 699px) {
      .feature-split .feature-split-pile {
        --pile-overhang: 0% !important;
      }
    }

    .feature-split-layout {
      container-type: inline-size;
    }
  }
</style>
