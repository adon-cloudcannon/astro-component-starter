---
import { bandPattern, bandHaze } from "@component-utils/bandStyle.mjs";
import { nestedProps } from "@component-utils/nestedProps.mjs";
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Counter from "@core-elements/counter/Counter.astro";
import Heading from "@core-elements/heading/Heading.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Text from "@core-elements/text/Text.astro";

type StatProps = {
  number?: number;
  prefix?: string;
  suffix?: string;
  label?: string;
  sublabel?: string;
};

/* `content` and `style` are the editor's tabs, flattened straight back into
   the names below. `at()` writes the frontmatter path a binding needs. */
const { props, at } = nestedProps(Astro.props);

const {
  eyebrow = "",
  heading = "",
  headingLevel = "h2",
  headingSize = "lg",
  subtext = "",
  stats = [],
  dividers = true,
  sectionLabel,
  maxContentWidth = "xl",
  paddingHorizontal = "gutter",
  paddingVertical = "4xl",
  colorScheme = "inherit",
  lockColorScheme = false,
  backgroundColor = "light-sand",
  /** The texture behind the band, by name. */
  pattern = "none",
  /** Which edge the texture fades out towards. */
  fade = "none",
  /** Whether the heading sits on a pool of the band’s own colour. */
  haze = false,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = props;
---

<CustomSection
  class:list={["stats", className]}
  label={sectionLabel}
  maxContentWidth={maxContentWidth}
  paddingHorizontal={paddingHorizontal}
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  lockColorScheme={lockColorScheme}
  backgroundColor={backgroundColor}
  background={bandPattern(pattern, fade)}
  haze={bandHaze(haze)}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  <SimpleText
    alignmentHorizontal="center"
    class="eyebrow"
    data-prop={at("eyebrow")}
    text={eyebrow}
    size="sm"
  />
  <Heading
    level={headingLevel}
    size={headingSize}
    alignmentHorizontal="center"
    data-prop={at("heading")}
  >
    {heading}
  </Heading>
  <Text
    class="stats-subtext"
    alignmentHorizontal="center"
    data-prop={at("subtext")}
    text={subtext}
  />
  {stats?.length > 0 && (
    <dl
      class:list={["stats-grid", dividers && "dividers"]}
      data-editable="array"
      data-prop={at("stats")}
      data-direction="row"
    >
      {stats?.map((stat: StatProps) => (
        <div
          class="stat"
          data-editable="array-item"
        >
          <dt
            class="stat-label"
            data-editable="text"
            data-prop="label"
          >
            {stat.label}
          </dt>
          <dd class="stat-value">
            <Counter
              number={stat.number}
              prefix={stat.prefix}
              suffix={stat.suffix}
              alignmentHorizontal="center"
            />
          </dd>
          {stat.sublabel && (
            <dd
              class="stat-sublabel"
              data-editable="text"
              data-prop="sublabel"
            >
              {stat.sublabel}
            </dd>
          )}
        </div>
      ))}
    </dl>
  )}
</CustomSection>

<style is:global>
  @layer page-sections {
    .stats {
      .stats-grid {
        display: grid;
        gap: var(--spacing-xl) 0;
        grid-template-columns: repeat(auto-fit, minmax(min(180px, 100%), 1fr));
        --space-before: var(--space-before-loose);

        margin: 0;

        > .stat {
          display: flex;
          flex-direction: column;
          padding: 0 var(--spacing-lg);
          text-align: center;
        }
      }

      /* The number reads first; the <dt> label stays first in source order
         for assistive tech. */
      .stat-label {
        font-size: var(--font-size-sm);
        font-weight: var(--font-weight-semibold);
        letter-spacing: 0.08em;
        order: 2;
        text-transform: uppercase;
      }

      .stat-value {
        margin: 0;
        order: 1;

        .counter {
          margin-top: 0;

          > .counter-inner {
            font-family: var(--font-headings);
            letter-spacing: -0.03em;
            line-height: var(--line-height-tight);
          }
        }
      }

      .stat-sublabel {
        color: var(--color-text-muted);
        font-size: var(--font-size-sm);
        margin: var(--spacing-xs) 0 0;
        order: 3;
      }

      .stats-grid.dividers > .stat {
        border-inline-start: var(--border-width-sm) solid var(--color-border);

        &:first-child {
          border-inline-start: none;
        }
      }

      /* 640px = canonical mobile/stacking breakpoint. */
      @media (width < 640px) {
        .stats-grid.dividers > .stat {
          border-inline-start: none;
          border-top: var(--border-width-sm) solid var(--color-border);
          padding-top: var(--spacing-xl);

          &:first-child {
            border-top: none;
            padding-top: 0;
          }
        }
      }
    }
  }
</style>
