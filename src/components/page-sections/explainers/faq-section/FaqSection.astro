---
import { bandPattern, bandHaze } from "@component-utils/bandStyle.mjs";
import { nestedProps } from "@component-utils/nestedProps.mjs";
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Accordion from "@wrappers/accordion/Accordion.astro";
import { faqItemsFor } from "@component-utils/faqs.mjs";

/* `content` and `style` are the editor's tabs, flattened straight back into
   the names below. `at()` writes the frontmatter path a binding needs. */
const { props, at } = nestedProps(Astro.props, {
  nest: { heading: ["heading", "headingLevel", "headingSize"] },
});

const {
  heading = "Frequently Asked Questions",
  headingLevel = "h2",
  headingSize = "lg",
  items = [],
  /**
   * A topic from `src/data/faqs.json`, whose questions this section shows.
   *
   * Set, the questions come from the data file and the section's own `items`
   * are ignored — which is how one set of answers serves the pricing page,
   * the FAQ page and anywhere else that asks the same questions. Empty, the
   * section carries its own.
   */
  category = "",
  label = "About FAQ",
  sectionLabel,
  maxContentWidth = "xl",
  paddingHorizontal = "gutter",
  paddingVertical = "4xl",
  colorScheme = "inherit",
  lockColorScheme = false,
  backgroundColor = "light-sand",
  /** The texture behind the band, by name. */
  pattern = "none",
  /** Which edge the texture fades out towards. */
  fade = "none",
  /** Whether the heading sits on a pool of the band’s own colour. */
  haze = false,
  accordionVariant = "card",
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = props;

const topicItems = faqItemsFor(category);
const fromData = topicItems !== null;
const shownItems = fromData ? topicItems : items;
---

<CustomSection
  {...htmlAttributes}
  class:list={["faq-section", className]}
  label={sectionLabel}
  maxContentWidth={maxContentWidth}
  paddingHorizontal={paddingHorizontal}
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  lockColorScheme={lockColorScheme}
  backgroundColor={backgroundColor}
  background={bandPattern(pattern, fade)}
  haze={bandHaze(haze)}
  useDefaultEditableBinding={useDefaultEditableBinding}
>
  <Heading
    level={headingLevel}
    size={headingSize}
    alignmentHorizontal="center"
    text={heading}
    data-prop={at("heading")}
  />

  {/* The design leaves about 52 between the heading's foot and the first
      card, against flow's own 24, which read as the cards being tucked
      under the heading. */}
  <Accordion
    spaceBefore="loose"
    variant={accordionVariant}
    label={label}
    singleOpen={true}
    openFirst={false}
    items={shownItems}
    {...(fromData ? {} : { "data-children-prop": at("items") })}
  />
</CustomSection>
