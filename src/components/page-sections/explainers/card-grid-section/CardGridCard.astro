---
import Heading from "@core-elements/heading/Heading.astro";
import Icon from "@core-elements/icon/Icon.astro";
import Text from "@core-elements/text/Text.astro";
import Button from "@core-elements/button/Button.astro";
import Card from "@wrappers/card/Card.astro";
import Image from "@core-elements/image/Image.astro";
import GridItem from "@wrappers/grid/GridItem.astro";
import { nestedProps } from "@component-utils/nestedProps.mjs";

/* The card carries its own `content` and `style`, the same two tabs the block
   has, so `tabbed: true` on its structure draws them. They arrive nested and
   this body wants them flat; `at()` writes the path a binding needs, which is
   relative to the card because the card is the array item. */
const { props, at } = nestedProps(Astro.props, {
  extraStyleKeys: ["accentColor", "iconSolid", "iconBackground", "divider", "alignmentHorizontal"],
  /* A heading with its size, and a line with its size: each pair is one
     decision, so each is one object, the same way a section bundles its own.
     The names are the section's too — heading and subtext, not title and
     description — so a card reads like everything else on the site. */
  nest: { heading: ["heading", "headingSize"], subtext: ["subtext", "subtextSize"] },
});

const {
  heading = "",
  headingLevel = "h3",
  subtext = "",
  iconName = "",
  iconColor = "default",
  iconBackground = true,
  /**
   * The plate behind the icon, filled rather than tinted.
   *
   * The design's benefit cards draw a disc of the card's own colour at full
   * strength with the glyph knocked out of it, where the plate everywhere
   * else is that colour at its 100 step. Off by default: every other grid on
   * the site draws the tinted one.
   */
  iconSolid = false,
  /**
   * The colour of the card's rule.
   *
   * Enterprise's "Custom plans" keeps its accent there and nowhere else — one
   * palette colour per card — and draws it solid, where Card's own accented
   * border is the same colour at 18%.
   */
  accentColor = "none",
  backgroundColor = "light-sand",
  /**
   * Left alone, the shape decides. `lg` is the 46 the design sets here: this
   * project overrides the starter's heading scale, where the same name is 65,
   * so the size has to be read off the page rather than off the token file.
   */
  headingSize,
  /**
   * The card's line, which the design sets at 19 rather than the 16 this was
   * rendering. Six of the seven feature grids in the file put their card body
   * at 19px, which is `lg` in this theme; the seventh, Agencies' "Scale
   * changes nothing", sets 17 and can say so.
   */
  subtextSize = "lg",
  /**
   * A hairline between the card's head and its line.
   *
   * Careers draws one across all nine of its benefit cards, the full inner
   * width, in the dark sand this card rules with. It is
   * off everywhere else, so it is asked for rather than inferred: a rule
   * under a one-line title on a card with no body reads as a strikethrough.
   */
  divider = false,
  /**
   * Draws the icon on a scratched panel across the card's top instead of
   * beside the title.
   *
   * The open-source tools the design lists are drawn this way: a 374x198
   * panel in the tool's own colour with its mark large and dark on it, then
   * the copy under. Beside the title the same card reads as a feature rather
   * than as a thing with a face.
   */
  iconPanel = false,
  /**
   * The mark drawn on the panel, where a tool has one of its own.
   *
   * The open-source tools are brand marks rather than icons — an acorn, a
   * compass, a bucket — so the panel takes a file. Falls back to `iconName`
   * where there is none.
   */
  panelImage = "",
  /** What the mark is masked to. The design draws every one near-black. */
  panelImageColor = "color-text-strong",
  /**
   * The panel's own colour.
   *
   * Separate from `accentColor`, which also rules the card: the design gives
   * each tool a loud panel and every card the same quiet sand border.
   */
  panelColor = "harbour",
  /** Label for the link out of the card. Empty draws no link. */
  linkText = "",
  link = "",
  alignmentHorizontal = "start",
  class: className,
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = props;

// A card with neither a drawing nor an icon is plain copy, and the design sets
// its title at the same 29 as the illustrated ones rather than the larger size
// an icon card takes.
/* `auto` is the editor's word for "let the card decide", and an older block
   may still say "". Both mean the same here. */
const chosen = (value?: string) => (value && value !== "auto" ? value : undefined);
const drawnHeadingSize = chosen(headingSize) ?? (iconName ? "md" : "sm");
---

<GridItem
  {/* Not `card-grid-item`: that is the class the `card-grid` building block
      styles its own items with — a bordered, 12px-radius panel — and this
      wrapper was picking it up by name alone. The card inside draws its own
      18px border, so the two sat one inside the other at different radii. */}
  class="card-grid-section-item"
  {...htmlAttributes}
>
  <Card
    class:list={[
      "card-grid-card",
      iconPanel && "has-panel",
      `align-${alignmentHorizontal}`,
      accentColor !== "none" && "has-accent",
      className,
    ]}
    accentColor={accentColor}
    {/* A panelled card pads its own children instead: the padding utilities
        sit in `utils`, which out-ranks `page-sections`, so a rule here could
        not take it off the content and the panel stopped short of the card's
        edges. */}
    paddingHorizontal={iconPanel ? "none" : "lg"}
    paddingVertical={iconPanel ? "none" : "lg"}
    rounded
    border
    backgroundColor={backgroundColor}
  >
    {iconPanel && (iconName || panelImage) && (
      /* `.scratched` is the shared sheet: it paints `--scratch-fill` and
         generates the scratches in `--scratch-ink`, so no texture has to be
         loaded or exported. */
      <div
        class="card-grid-panel scratched"
        style={`--scratch-fill: var(--${panelColor})`}
        aria-hidden="true"
      >
        {panelImage ? (
          /* A mask rather than an `<img>`: the marks are single-colour files
             with their fill baked in, so an image of one is black wherever
             the design wants the panel's own ink (see CLAUDE.md). */
          <span
            class="card-grid-panel-mark is-mask"
            style={`--card-grid-mark: url("${panelImage}"); --card-grid-mark-ink: var(--${panelImageColor})`}
          />
        ) : (
          <Icon
            class="card-grid-panel-mark"
            name={iconName}
            size="none"
          />
        )}
      </div>
    )}
    <div class="card-grid-card-heading">
      {!iconPanel && iconName && (
        <Icon
          class="card-grid-icon"
          name={iconName}
          size="lg"
          color={accentColor && accentColor !== "none" ? accentColor : iconColor}
          background={iconSolid ? "solid" : false}
          alignmentHorizontal="start"
        />
      )}
      <Heading
        class="card-grid-title"
        level={headingLevel}
        size={drawnHeadingSize}
        alignmentHorizontal={alignmentHorizontal}
        data-prop={at("heading")}
      >
        {heading}
      </Heading>
    </div>
    {divider && subtext && <div class="card-grid-rule card-grid-divider"></div>}
    <Text
      class="card-grid-description"
      alignmentHorizontal={alignmentHorizontal}
      size={chosen(subtextSize) ?? "lg"}
      data-prop={at("subtext")}
      text={subtext}
    />
    {linkText && (
      /* The site's arrow link, which is the Button rather than an anchor of
         this card's own — see CLAUDE.md. It takes the card's accent so the
         three read as a set, the way the design draws them. */
      <Button
        class="card-grid-link"
        text={linkText}
        link={link}
        iconName="arrow-right"
        iconPosition="after"
        variant="text"
        size="sm"
        data-prop={at("linkText")}
      />
    )}
  </Card>
</GridItem>

<style is:global>
  @layer page-sections {
    /* The title sits level with the icon, not hung from its top.

       The design centres the two against each other on every icon card it
       draws: Careers' disc runs 36 to 96 inside the card and both a one-line
       and a two-line title centre on 66. Hung from the top, a title that
       wraps leaves the disc stranded against its first line. */
    /* The panel runs the card's full width at its top, so the card's own
       padding has to come off it: `Card` pads every child, and the design
       draws the panel edge to edge with the copy inset under it. 198 of a
       420 card is the design's proportion, carried as a ratio so it holds
       at any card width. */
    /* The sand rule, like every other cream card on these pages: the design
       draws #EBE1C9 where the generic border token is a neutral grey. */
    .card-grid-card.has-panel > .card-inner {
      border-color: var(--dark-sand);
    }

    .card-grid-panel {
      align-items: center;
      aspect-ratio: 374 / 198;
      display: flex;
      justify-content: center;
    }

    .card-grid-panel .card-grid-panel-mark svg {
      block-size: 4rem;
      color: var(--color-text-strong);
      inline-size: 4rem;
    }

    .card-grid-panel .card-grid-panel-mark.is-mask {
      background-color: var(--card-grid-mark-ink, var(--color-text-strong));
      block-size: 4rem;
      display: block;
      inline-size: 5.5rem;
      mask-image: var(--card-grid-mark);
      mask-position: center;
      mask-repeat: no-repeat;
      mask-size: contain;
    }

    /* Everything after the panel takes the padding the card gave up. */
    .card-grid-card.has-panel .card-content > :not(.card-grid-panel) {
      margin-inline: var(--spacing-xl);
    }

    .card-grid-card.has-panel .card-content > .card-grid-card-heading {
      margin-block-start: var(--spacing-lg);
    }

    .card-grid-card.has-panel .card-content > .card-grid-link {
      margin-block-end: var(--spacing-lg);
    }

    .card-grid-card-heading {
      align-items: center;
      display: flex;
      gap: var(--spacing-sm);
    }

    .card-grid-card-heading .card-grid-icon {
      flex-shrink: 0;
    }


    /* The design's disc is 60 across with a 35 glyph in it, and the disc is
       drawn from the glyph — 0.36em of padding either side — so the size to
       set is the glyph's. Left at the icon's own `lg` it came out 46, which
       beside a 20px title reads as a bullet rather than as the card's mark.
       This rule is in `page-sections`, so it out-ranks the size class the
       icon sets on itself without having to out-specify it. */
    .card-grid-card .card-grid-icon .background-solid {
      font-size: 2.1875rem;
    }

    .card-grid-title {
      flex: 1;
      margin-block: 0;
      min-width: 0;
    }

    .card-grid-description {
    }
  }

  /* The centred arrangement: the icon over the copy rather than beside it.

     Flat, because rules nested deeper than a couple of levels get dropped (see
     CLAUDE.md). */
  @layer page-sections {
    .card-grid-card.align-center .card-grid-card-heading {
      justify-content: center;
    }

    .card-grid-card.align-center .card-grid-title {
      flex: 0 1 auto;
    }





  }

  @layer page-sections {
    /* The design draws this rule solid, one palette colour per card; Card's
       own accented border is the same colour at 18%, which reads as no accent
       at all from a step back. */
    .card-grid .card-grid-card.has-accent .card-inner {
      border-color: var(--card-accent);
    }


    /* The copy would otherwise hang from the top of a card that is taller
       than it. `grid-auto-rows: 1fr` draws every card in the section at one
       height, so the short ones have room under them; the design centres the
       copy in that, which is what makes cards of one to three lines read as a
       set. */
    .card-grid-card.align-center .card-outer-content,
    .card-grid-card.align-center .card-content {
      block-size: 100%;
    }

    .card-grid-card.align-center .card-content {
      display: flex;
      flex-direction: column;
      justify-content: center;
    }


    /* Every gap here is set as --space-before, not as a margin.
       margin-block-start written from a page-sections rule loses outright: the
       flow layer sits in `utils`, which out-ranks this one, and writes the same
       property from --space-before. The first pass set all five gaps as plain
       margins and not one of them applied — what shipped was flow's own
       default, which put the eyebrow 9px under the rule and the body 9px under
       the heading (see CLAUDE.md). */




    /* The design draws it 26 under the icon disc and 22 over the line, which
       is this card's own rhythm. The rule runs
       the card's inner width, so it needs nothing of its own to stretch. */
    .card-grid-card .card-grid-divider {
      background-color: var(--dark-sand);
      block-size: var(--border-width-sm, 1px);
      /* A 1px div has no width of its own, so in a centred card it collapsed
         to nothing and measured as applied while drawing no rule at all. */
      align-self: stretch;
      inline-size: 100%;
      --space-before: 1.625rem;
    }

    .card-grid-card .card-grid-divider + .card-grid-description {
      --space-before: 1.375rem;
    }





    /* Same text link the testimonials use: Sunset, with the arrow beside the
       label rather than inside it. */

  }
</style>
