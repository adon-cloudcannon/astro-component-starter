---
import { bandPattern, bandHaze } from "@component-utils/bandStyle.mjs";
import { nestedProps } from "@component-utils/nestedProps.mjs";
import { rootMirror } from "@component-utils/rootMirror.mjs";
import CustomSection from "@builders/custom-section/CustomSection.astro";
import { subtextMeasure } from "@component-utils/subtextMeasure.mjs";
import Heading from "@core-elements/heading/Heading.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Text from "@core-elements/text/Text.astro";
import Timeline from "@wrappers/timeline/Timeline.astro";

/* `content` and `style` are the editor's tabs, flattened straight back into
   the names below. `at()` writes the frontmatter path a binding needs. */
const { props, at } = nestedProps(Astro.props);

const {
  eyebrow = "",
  heading = "",
  headingLevel = "h2",
  headingSize = "lg",
  subtext = "",
  // Body 3 at 19 or Subtitle 1 at 22 in the design; `md` keeps the 16 every
  // section rendered before either was carried through.
  subtextSize = "md",
  /**
   * The measure the design sets the supporting line in, in pixels.
   *
   * Not the column it sits in: a centred subtext is drawn at about 580 in the
   * 1040 column, and run the full width it reads as a different block.
   */
  subtextWidth,
  entries = [],
  layout = "vertical",
  sectionLabel,
  maxContentWidth = "xl",
  paddingHorizontal = "gutter",
  paddingVertical = "4xl",
  colorScheme = "inherit",
  lockColorScheme = false,
  backgroundColor = "light-sand",
  /** The texture behind the band, by name. */
  pattern = "none",
  /** Whether the heading sits on a pool of the band’s own colour. */
  haze = false,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = props;

/* The measure the subtext is set in, as a length. */
const subtextCap = subtextMeasure(subtextWidth);

/**
 * A section whose heading is the band above it renders no header at all.
 *
 * Left in, the empty heading is still a sibling, so the flow layer gives the
 * timeline after it a space-before it has not earned: 48px of nothing under a
 * section that already carries its own padding. Where the design puts about
 * 100 between the copy and the first step, this put 208.
 */
const hasHeader = Boolean(eyebrow || heading || subtext);

const gutter =
  paddingHorizontal && paddingHorizontal !== "none" ? `var(--spacing-${paddingHorizontal})` : "0px";

/* Mirrored onto the builder's `.content`, because the flag lands on the
   section's root and the editor never rewrites a region root. */
const mirror = rootMirror({ "data-no-header": !hasHeader ? "" : null });
---

<CustomSection
  mirror={mirror}
  class:list={["timeline-section", className]}
  data-no-header={!hasHeader ? "" : undefined}
  label={sectionLabel}
  maxContentWidth={maxContentWidth}
  paddingHorizontal={paddingHorizontal}
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  lockColorScheme={lockColorScheme}
  backgroundColor={backgroundColor}
  background={bandPattern(pattern)}
  haze={bandHaze(haze)}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  {hasHeader && (
    <Fragment>
      <SimpleText
        alignmentHorizontal="center"
        class="eyebrow"
        data-prop={at("eyebrow")}
        text={eyebrow}
        size="sm"
      />
      <Heading
        level={headingLevel}
        size={headingSize}
        alignmentHorizontal="center"
        data-prop={at("heading")}
      >
        {heading}
      </Heading>
      <Text
        class="section-subtext timeline-section-subtext"
        alignmentHorizontal="center"
        data-prop={at("subtext")}
        style={subtextCap ? `max-inline-size: ${subtextCap}; margin-inline: auto; justify-self: center` : undefined}        size={subtextSize}        text={subtext}
      />
    </Fragment>
  )}
  <Timeline
    entries={entries}
    spaceBefore="loose"
    layout={layout}
    data-children-prop={at("entries")}
    style={`--timeline-gutter: ${gutter}`}
  />
</CustomSection>

<style is:global>
  @layer page-sections {
    .timeline-section {
      min-width: 0;
    }
  }
</style>

<style is:global>
  /* A rail whose heading is the band above it carries no space of its own over
     its first entry: the gap under the copy is the whole gap.

     Measured in the file, not eyeballed. The subtext (3806:74049) ends at
     2679 and the first marker disc (3806:74098) starts at 2761, so the design
     draws 82 — which is what the band above contributes on its own. The two
     frames even overlap by 11. Two abutting bands at the usual 4xl gave 160,
     and shrinking both ends took the foot of the band down to 32 where the
     design has 113, so this is the top alone.

     In `overrides`, not `page-sections`: the padding comes from a `pad-y-4xl`
     spacing utility, and `utils` out-ranks `page-sections` in the layer order.
     Flat, because rules nested deeper than a couple of levels get dropped
     (see CLAUDE.md). */
  @layer overrides {
    .timeline-section[data-no-header] .content {
      padding-block-start: 0;
    }
  }
</style>
