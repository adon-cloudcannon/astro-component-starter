---
import { spaceBeforeAttr } from "@component-utils/spaceBefore.mjs";
const {
  html,
  aspectRatio = "landscape",
  spaceBefore = "default",
  class: className,
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;
---

<div
  class:list={["embed-wrapper", "stackable", className]}
  {...htmlAttributes}
>
  <div
    class:list={["embed-content", `ratio-${aspectRatio}`]}
    data-space-before={spaceBeforeAttr(spaceBefore)}
  >
    <template data-unsafe-external-media>
      <slot>
        <Fragment set:html={html} />
      </slot>
    </template>
    <div class="external-media-placeholder">
      <p>External content is disabled until you allow external media across this site.</p>
      <span class="button external-media-allow">
        <button
          class="button-inner variant-primary size-md"
          type="button"
          data-external-media-enable
        >
          <span class="label-text">Allow all external media</span>
        </button>
      </span>
    </div>
  </div>
</div>

<style is:global>
  @layer components {
    .embed-wrapper {
      > .embed-content {
        > .external-media-placeholder {
          align-items: center;
          color: var(--color-text-muted);
          display: flex;
          flex-direction: column;
          gap: var(--spacing-lg);
          height: 100%;
          justify-content: center;
          min-height: 10rem;
          padding: var(--spacing-md);
          text-align: center;

          p {
            margin: 0;
          }

          &[data-external-media-mounted] {
            padding: 0;
          }

          iframe {
            border: none;
            display: block;
            height: 100%;
            width: 100%;
          }
        }

        &.ratio-square {
          aspect-ratio: var(--ratio-square);
        }

        &.ratio-landscape {
          aspect-ratio: var(--ratio-landscape);
        }

        &.ratio-portrait {
          aspect-ratio: var(--ratio-portrait);
        }

        &.ratio-widescreen {
          aspect-ratio: var(--ratio-widescreen);
        }
      }
    }
  }
</style>

<script>
  import { onPageLoad } from "@component-utils/onPageLoad";
  import { setupEmbeds } from "./setup";

  onPageLoad(() => setupEmbeds());
</script>
