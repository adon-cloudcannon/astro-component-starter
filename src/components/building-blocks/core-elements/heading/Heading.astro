---
import { isNonEmptyString } from "@component-utils/isNonEmptyString";
import { spaceBeforeAttr } from "@component-utils/spaceBefore.mjs";
import { renderMarkdownInline } from "@component-utils/markdown";
import { slugifyLabel } from "@component-utils/slugify";
import Icon from "@core-elements/icon/Icon.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";

/**
 * The eyebrow belongs to the heading it labels, so this draws it.
 *
 * It used to be whatever the author put above a heading: 33 sections each
 * rendered their own SimpleText with `class="eyebrow"` on it, and inside a
 * card or a step it was a loose text block with the class typed into the
 * frontmatter by hand — which no input declared, so an editor could neither
 * see it nor remove it.
 *
 * It is still drawn as a sibling rather than inside the `<h_>`: an eyebrow
 * nested in a heading joins its accessible name, so a screen reader would
 * announce "OUR TEAM Meet the team" as one title. Sibling also keeps the
 * `.eyebrow + .heading` rules that zero the heading's top margin, and makes
 * the markup identical to what the sections emitted before this.
 *
 * `eyebrowAlignment` is its own prop because one band wants the two apart:
 * the team roster centres its heading over a left-aligned eyebrow.
 */
const {
  text,
  level = "h2",
  size = "default",
  alignmentHorizontal = "start",
  eyebrow,
  eyebrowSize = "sm",
  eyebrowAlignment,
  eyebrowClass,
  iconName,
  iconColor = "default",
  iconPosition = "before",
  spaceBefore = "default",
  class: className,
  useDefaultEditableBinding = false,
  "data-prop": customDataProp,
  "data-eyebrow-prop": eyebrowDataProp,
  _component,
  ...htmlAttributes
} = Astro.props;

// h2/h3 without an id cannot be cited as `#section`. Prefer `text`; most page
// sections pass the title as the default slot instead. h1 (heroes, posts) is left
// alone. Duplicate titles on the same page get a numeric suffix.
function plainTextFromHtml(html: string): string {
  return html
    .replace(/<[^>]+>/g, " ")
    .replace(/&nbsp;/gi, " ")
    .replace(/&amp;/gi, "&")
    .replace(/&lt;/gi, "<")
    .replace(/&gt;/gi, ">")
    .replace(/&quot;/gi, '"')
    .replace(/&#39;/gi, "'")
    .replace(/\s+/g, " ")
    .trim();
}

// CloudCannon's editable-regions re-render has no Astro.locals — use a
// one-shot Set so this heading still gets an id, without sharing de-dupe.
const usedHeadingIds: Set<string> = Astro.locals
  ? (Astro.locals.headingIds ??= new Set())
  : new Set();

if (htmlAttributes.id) {
  usedHeadingIds.add(String(htmlAttributes.id));
} else if (level === "h2" || level === "h3") {
  let slugSource = isNonEmptyString(text) ? text : "";

  if (!slugSource && Astro.slots.has("default")) {
    slugSource = plainTextFromHtml(await Astro.slots.render("default"));
  }

  const slug = slugSource ? slugifyLabel(slugSource) : "";

  if (slug) {
    let id = slug;
    let n = 2;

    while (usedHeadingIds.has(id)) {
      id = `${slug}-${n++}`;
    }

    usedHeadingIds.add(id);
    htmlAttributes.id = id;
  }
}

const effectiveDataProp = customDataProp ?? (useDefaultEditableBinding ? "text" : null);
const textDataAttributes = effectiveDataProp
  ? { "data-editable": "text", "data-prop": effectiveDataProp }
  : {};

let MarkdownText = renderMarkdownInline(text);

MarkdownText = MarkdownText.replace(/\n/g, "<br />");
const Tag = level;

const hasText = isNonEmptyString(text);
const hasSlotContent = Astro.slots.has("default");
const hasEyebrow = isNonEmptyString(eyebrow);
const hasHeading = hasText || hasSlotContent || Boolean(_component);

/* An eyebrow with nothing under it is still worth drawing: a band can label
   itself and carry its title further down. The `<h_>` is what drops when
   there is no title, not the component. */
if (!_component && !hasText && !hasSlotContent && !hasEyebrow) return;

const eyebrowClasses = ["eyebrow", eyebrowClass].filter(Boolean).join(" ");
---

{hasEyebrow && (
  <SimpleText
    class={eyebrowClasses}
    size={eyebrowSize}
    alignmentHorizontal={eyebrowAlignment ?? alignmentHorizontal}
    data-prop={eyebrowDataProp}
    text={eyebrow}
  />
)}
{hasHeading && (
  <Tag
    class:list={["heading", "stackable", className]}
    {...htmlAttributes}
  >
    <span
      class:list={[
        "heading-inner",
        size && size !== "default" && `size-${size}`,
        `align-${alignmentHorizontal}`,
      ]}
      data-space-before={spaceBeforeAttr(spaceBefore)}
    >
      {iconPosition == "before" && (
        <Icon
          name={iconName}
          color={iconColor}
          size="none"
          class="heading-icon"
          aria-hidden="true"
        />
      )}
      <span
        class="heading-text"
        {...textDataAttributes}
      >
        <slot>{text && <Fragment set:html={MarkdownText} />}</slot>
      </span>
      {iconPosition === "after" && (
        <Icon
          name={iconName}
          color={iconColor}
          size="none"
          class="heading-icon heading-icon-after"
          aria-hidden="true"
        />
      )}
    </span>
  </Tag>
)}

<style is:global>
  @layer components {
    .heading {
      --space-before: var(--space-before-loose);

      margin-block: 0;

      > .heading-inner {
        display: block;

        .heading-icon {
          bottom: 0.1em;
          display: inline-block;
          font-size: 0.9em;
          margin-inline-end: var(--spacing-em-xs);
          position: relative;
          vertical-align: middle;

          &.heading-icon-after {
            margin-inline: var(--spacing-em-xs) 0;
          }
        }

        /* A size override takes the whole style with it: weight and tracking
           as well as the line. In this design a style is a bundle, so Header 3
           is 46px AND bold AND tracked -1.15. Overriding the size alone left a
           section heading at Header 3's size in Header 2's weight, with no
           tracking at all. */
        &.size-xs {
          font-size: var(--font-size-heading-xs);
          font-weight: var(--font-weight-heading-xs);
          letter-spacing: var(--letter-spacing-heading-xs);
          line-height: var(--line-height-heading-xs);
        }

        &.size-sm {
          font-size: var(--font-size-heading-sm);
          font-weight: var(--font-weight-heading-sm);
          letter-spacing: var(--letter-spacing-heading-sm);
          line-height: var(--line-height-heading-sm);
        }

        &.size-md {
          font-size: var(--font-size-heading-md);
          font-weight: var(--font-weight-heading-md);
          letter-spacing: var(--letter-spacing-heading-md);
          line-height: var(--line-height-heading-md);
        }

        &.size-lg {
          font-size: var(--font-size-heading-lg);
          font-weight: var(--font-weight-heading-lg);
          letter-spacing: var(--letter-spacing-heading-lg);
          line-height: var(--line-height-heading-lg);
        }

        &.size-xl {
          font-size: var(--font-size-heading-xl);
          font-weight: var(--font-weight-heading-xl);
          letter-spacing: var(--letter-spacing-heading-xl);
          line-height: var(--line-height-heading-xl);
        }

        &.size-2xl {
          font-size: var(--font-size-heading-2xl);
          font-weight: var(--font-weight-heading-2xl);
          letter-spacing: var(--letter-spacing-heading-2xl);
          line-height: var(--line-height-heading-2xl);
        }

        &.size-3xl {
          font-size: var(--font-size-heading-3xl);
          /* No ratio is defined this far up the ramp; the tightest one that is
             defined is the right neighbour. */
          line-height: var(--line-height-heading-3xl, var(--line-height-heading-2xl));
        }

        &.size-4xl {
          font-size: var(--font-size-heading-4xl);
          /* No ratio is defined this far up the ramp; the tightest one that is
             defined is the right neighbour. */
          line-height: var(--line-height-heading-4xl, var(--line-height-heading-2xl));
        }

        &.align-start {
          text-align: start;
        }

        &.align-center {
          text-align: center;
        }

        &.align-end {
          text-align: end;
        }
      }
    }
  }
</style>
