---
import { getIcon, suggestIconNames } from "@component-utils/icons";
import { isNonEmptyString } from "@component-utils/isNonEmptyString";

const {
  name,
  size = "lg",
  color = "default",
  /**
   * What sits behind the glyph.
   *
   * `true` is the tinted plate this has always drawn: the colour at its 100
   * step with the glyph at 500, which is a label. `"solid"` is the disc the
   * design draws on a benefit card — the colour at full strength, round, with
   * the glyph in whatever reads on it.
   */
  background = false,
  alignmentHorizontal = "",
  class: className,
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const isValidName = isNonEmptyString(name);
const icon = isValidName ? getIcon(String(name)) : null;

// Ids come from editable content, so warn while authoring rather than failing
// the build — same as renderBlock.astro does for an unknown `_component`.
if (isValidName && !icon && import.meta.env.DEV) {
  const suggestions = suggestIconNames(String(name));
  const hint = suggestions.length ? ` Did you mean: ${suggestions.join(", ")}?` : "";

  console.warn(`[icon] Unknown icon "${String(name).trim()}".${hint}`);
}

if (!icon) {
  return;
}
---

<span
  class:list={["icon", className]}
  {...htmlAttributes}
>
  <span
    class:list={[
      "icon-inner",
      `size-${size}`,
      `color-${color}`,
      background && "background",
      background === "solid" && "background-solid",
      alignmentHorizontal && alignmentHorizontal !== "none" && `align-${alignmentHorizontal}`,
    ]}
  >
    <svg
      {...icon.attributes}
      set:html={icon.body}
    />
  </span>
</span>

<style is:global>
  @layer components {
    .icon {
      display: block;
      line-height: var(--line-height-none);
      vertical-align: middle;

      > .icon-inner {
        border-radius: var(--radius-xs);
        color: var(--icon-accent, inherit);
        display: block;
        line-height: var(--line-height-none);
        vertical-align: middle;

        &.background {
          background-color: var(--icon-accent-bg, var(--color-bg-surface));
          padding: var(--spacing-em-xs);
          width: fit-content;
        }

        /* The colour at full strength, in a circle, with the glyph in the
           ink that reads on it.

           The split is the design's own and is not a tint of anything: a
           sunset or a moss disc takes a near-white glyph, a golden, peachy or
           harbour one takes near-black. Written out rather than computed,
           because CSS has no contrast function that ships everywhere, and
           because the four dark ones are a fact about this palette rather
           than a threshold worth guessing at.

           The disc is sized off the glyph, so one rule holds at every icon
           size: 0.36em either side of a 35px glyph is the 60 the design
           draws. */
        &.background-solid {
          /* Each pairing below names its own ink: a bare `.background-solid`
             ties with `.color-pacific` on specificity and loses on order, so
             a disc that only set the fill here drew a pacific glyph on a
             pacific ground. */
          --icon-accent: var(--white, #fff);
          --icon-accent-bg: var(--color-bg-surface);

          aspect-ratio: 1;
          border-radius: 50%;
          display: grid;
          padding: 0.36em;
          place-items: center;
        }

        &.background-solid.color-pacific {
          --icon-accent: var(--white, #fff);
          --icon-accent-bg: var(--pacific);
        }

        &.background-solid.color-moss {
          --icon-accent: var(--white, #fff);
          --icon-accent-bg: var(--moss);
        }

        &.background-solid.color-sunset {
          --icon-accent: var(--white, #fff);
          --icon-accent-bg: var(--sunset);
        }

        &.background-solid.color-kiwi {
          --icon-accent: var(--white, #fff);
          --icon-accent-bg: var(--kiwi);
        }

        &.background-solid.color-golden {
          --icon-accent: var(--color-text-strong, #393939);
          --icon-accent-bg: var(--golden);
        }

        &.background-solid.color-peachy {
          --icon-accent: var(--color-text-strong, #393939);
          --icon-accent-bg: var(--peachy);
        }

        &.background-solid.color-harbour {
          --icon-accent: var(--color-text-strong, #393939);
          --icon-accent-bg: var(--harbour);
        }

        &.background-solid.color-blush {
          --icon-accent: var(--color-text-strong, #393939);
          --icon-accent-bg: var(--blush);
        }

        &.color-pacific {
          --icon-accent: var(--pacific-500);
          --icon-accent-bg: var(--pacific-100);
        }

        &.color-moss {
          --icon-accent: var(--moss-500);
          --icon-accent-bg: var(--moss-100);
        }

        &.color-golden {
          --icon-accent: var(--golden-400);
          --icon-accent-bg: var(--golden-100);
        }

        &.color-peachy {
          --icon-accent: var(--peachy-500);
          --icon-accent-bg: var(--peachy-100);
        }

        &.color-sunset {
          --icon-accent: var(--sunset-500);
          --icon-accent-bg: var(--sunset-100);
        }

        &.color-kiwi {
          --icon-accent: var(--kiwi-500);
          --icon-accent-bg: var(--kiwi-100);
        }

        &.color-blush {
          --icon-accent: var(--blush-500);
          --icon-accent-bg: var(--blush-100);
        }

        &.color-harbour {
          --icon-accent: var(--harbour-500);
          --icon-accent-bg: var(--harbour-100);
        }

        /* Explicit so the picker's "None" is a real choice, not a class that
           happens to match no rule. */
        &.size-none {
          font-size: inherit;
        }

        &.size-sm {
          font-size: var(--font-size-sm);
        }

        &.size-md {
          font-size: var(--font-size-xl);
        }

        &.size-lg {
          font-size: var(--font-size-2xl);
        }

        &.size-xl {
          font-size: var(--font-size-3xl);
        }

        &.size-2xl {
          font-size: var(--font-size-4xl);
        }

        &.size-3xl {
          font-size: var(--font-size-5xl);
        }

        &.align-start {
          display: block;
          width: fit-content;
        }

        &.align-center {
          display: block;
          margin-inline: auto;
          width: fit-content;
        }

        &.align-end {
          display: block;
          margin-inline-start: auto;
          width: fit-content;
        }

        svg {
          max-height: 100%;
        }
      }
    }
  }
</style>
