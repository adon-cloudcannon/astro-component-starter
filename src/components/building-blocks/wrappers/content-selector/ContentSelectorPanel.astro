---
import RenderBlock from "@component-utils/renderBlock.astro";
import { slugifyLabel } from "@component-utils/slugify";
import Tab from "@component-utils/tabs/Tab.astro";
import TabPanel from "@component-utils/tabs/TabPanel.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Icon from "@core-elements/icon/Icon.astro";

const {
  title,
  subtext,
  iconName,
  iconColor,
  contentSections,
  useDefaultEditableBinding = false,
  selected = false,
  groupName = "content-selector-tabs",
  navigationPosition = "start",
  tablistLabel,
  class: className,
  _component,
  "data-children-prop": childrenDataProp,
  "data-prop-title": customDataPropTitle,
  "data-prop-subtext": customDataPropSubtext,
  ...htmlAttributes
} = Astro.props;

const uniqueId = title ? `${groupName}-${slugifyLabel(title)}` : crypto.randomUUID();
const panelId = `panel-${uniqueId}`;
const tabLabelId = `tablabel-${uniqueId}`;

const effectiveChildrenProp =
  childrenDataProp ?? (useDefaultEditableBinding ? "contentSections" : null);
const arrayDataAttributes = effectiveChildrenProp
  ? { "data-editable": "array", "data-prop": effectiveChildrenProp }
  : {};

const effectiveTitleProp = customDataPropTitle ?? (useDefaultEditableBinding ? "title" : null);
const effectiveSubtextProp =
  customDataPropSubtext ?? (useDefaultEditableBinding ? "subtext" : null);
const subtextDataAttributes = effectiveSubtextProp
  ? { "data-editable": "text", "data-prop": effectiveSubtextProp }
  : {};
---

<div
  class:list={["content-selector-item", className]}
  {...htmlAttributes}
>
  {/* The array-item root has to hold both the tab and its panel, but a
      `tablist` may contain only tabs — so the tab gets its own `tablist`
      wrapper here, a sibling of the panel. setup.ts reads the orientation
      from this element and stamps `aria-posinset`/`aria-setsize` on every
      tab, so the split lists still announce "2 of 5", not "1 of 1". */}
  <div
    class="content-selector-tablist"
    role="tablist"
    aria-label={tablistLabel || "Content sections"}
    aria-orientation={navigationPosition === "start" ? "vertical" : "horizontal"}
  >
    <Tab
      class="content-selector-tab"
      id={tabLabelId}
      controls={panelId}
      selected={selected}
    >
      {/* `level="span"`, not a real heading: a tab label is not a section title,
        and an h3 per tab injects the whole tab strip into the page outline. */}
      {/* The label sits above the title, which is how the design orders a
          step: "STEP 01" small over "Build with your favorite tools". */}
      {subtext && (
        <span
          class:list={["content-selector-tab-subtext", "align-start"]}
          {...subtextDataAttributes}
        >
          {subtext}
        </span>
      )}
      <Heading
        text={title}
        level="span"
        size="sm"
        iconName={iconName}
        iconColor={iconColor}
        alignmentHorizontal="start"
        class="content-selector-tab-heading"
        data-prop={effectiveTitleProp}
      />
      <Icon
        name="chevron-down"
        size="none"
        class="content-selector-tab-chevron"
        aria-hidden="true"
      />
    </Tab>
  </div>
  <TabPanel
    class="content-selector-panel"
    id={panelId}
    labelledBy={tabLabelId}
    selected={selected}
  >
    <div
      class="content-selector-panel-content flow"
      {...arrayDataAttributes}
    >
      <slot>
        {contentSections && (
          <RenderBlock
            contentSections={contentSections}
            useDefaultEditableBinding={!!effectiveChildrenProp}
          />
        )}
      </slot>
    </div>
  </TabPanel>
</div>

<style is:global>
  /* Flat, because rules nested deeper get dropped (see CLAUDE.md).

     The design's step strip, measured: the label is 11px/500 and the title
     17px/500, both left-aligned, with the whole tab carrying a rule along its
     top — Sunset on the step you are on, grey on the rest. Colour does the
     work of saying which is selected: Sunset over white when it is, grey over
     a muted grey when it is not. */
  @layer components {
    .content-selector-items.nav-top .content-selector-tab {
      align-items: start;
      /* 2px, #34322E when idle and Sunset when current, which is what the
         Tablist - Steps component draws. */
      border-block-start: 2px solid #34322e;
      padding-block-start: var(--spacing-sm);
      text-align: start;
    }

    .content-selector-items.nav-top .content-selector-tab[aria-selected="true"] {
      border-block-start-color: var(--sunset);
    }

    /* The step label is an eyebrow: the design sets it in a mono face at
       0.2em of tracking, which is the site's eyebrow convention, so it takes
       --font-mono rather than the mono the section happens to be drawn in. */
    .content-selector-items.nav-top .content-selector-tab-subtext {
      /* #A5A099. --gray-500 is #B8B4AD, two steps light of it. */
      color: #a5a099;
      font-family: var(--font-mono);
      font-size: 0.6875rem;
      font-weight: var(--font-weight-medium);
      letter-spacing: 0.2em;
      line-height: 1.27;
      text-transform: uppercase;
    }

    .content-selector-items.nav-top
      .content-selector-tab[aria-selected="true"]
      .content-selector-tab-subtext {
      color: var(--sunset);
    }

    /* On the text, not the wrapper. Heading's own size class sets a font-size
       on .heading-inner, so a rule on the outer span was overridden and the
       tab titles stayed at 26px where the design sets 17. */
    /* The title sits on a narrow measure inside its tab, so it wraps the way
       the design sets it — 126px of text in a 400px tab for "Build with your
       favorite tools", 151 for "Set up the editing environment". Given the
       full width they each came out as one long line. */
    .content-selector-items.nav-top .content-selector-tab-heading,
    .content-selector-items.nav-top .content-selector-tab-heading .heading-inner {
      /* `display: block` as well as the measure: the Heading renders a span,
         and a max-inline-size on an inline box does nothing — the titles
         stayed 299px wide on one line. */
      display: block;
      max-inline-size: 9.5rem;
    }

    .content-selector-items.nav-top .content-selector-tab-heading,
    .content-selector-items.nav-top .content-selector-tab-heading .heading-inner,
    .content-selector-items.nav-top .content-selector-tab-heading .heading-text {
      font-size: 1.0625rem;
      font-weight: var(--font-weight-medium);
      line-height: 1.29;
    }

    .content-selector-items.nav-top .content-selector-tab:not([aria-selected="true"]) {
      color: var(--color-text-muted);
    }

    /* The chevron is a phone affordance; the strip shows every step already. */
    .content-selector-items.nav-top .content-selector-tab-chevron {
      display: none;
    }

    /* The panel is a split: copy on the left, the picture on the right. */
    .content-selector-items.nav-top .content-selector-panel-content {
      align-items: center;
      display: grid;
      gap: var(--spacing-2xl);
      grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
    }
  }

  @layer components {
    /*
     * Each item overlays the WHOLE items grid and re-exposes the parent's
     * tracks with `subgrid`, so its tab and its panel land in different grid
     * areas while the item itself stays one real box. It has to be a box: this
     * is the array-item region root, and `display: contents` leaves the editor
     * nothing to select or drag. Overlapping boxes would swallow each other's
     * clicks, hence pointer-events passing through to the children.
     * The tablist's own row/column comes from `:nth-of-type` in ContentSelector;
     * the tab fills that box.
     */
    .content-selector-item {
      display: grid;
      grid-area: 1 / 1 / -1 / -1;
      grid-template-columns: subgrid;
      grid-template-rows: subgrid;
      pointer-events: none;

      > * {
        pointer-events: auto;
      }
    }

    .content-selector-tab {
      background: transparent;
      border: none;
      cursor: pointer;
      display: block;
      padding: var(--spacing-md);
      position: relative;
      transition: background-color var(--animation-normal) var(--ease-in-out);

      &::before {
        background: transparent;
        content: "";
        position: absolute;
        transition:
          transform var(--animation-normal),
          background var(--animation-normal);
      }

      &:hover {
        background: var(--color-state-hover);
      }

      > .content-selector-tab-heading {
        margin: 0;
      }
    }

    .content-selector-tab-subtext {
      color: var(--color-text-muted);
      display: block;
      font-size: var(--font-size-xs);
      font-weight: var(--font-weight-normal);
      margin-top: var(--spacing-xs);

      &.align-center {
        text-align: center;
      }

      &.align-start {
        text-align: start;
      }
    }

    .content-selector-tab-chevron {
      display: none;
      flex: 0 0 auto;
      transition: transform var(--animation-normal) var(--ease-out);
    }

    .content-selector-tab[aria-selected="true"]::before {
      background: var(--color-border-strong);
    }

    .content-selector-panel {
      animation: fade-in var(--animation-slow) var(--ease-in-out) forwards;
      container-type: inline-size;
      display: block;

      &[hidden] {
        display: none;
      }
    }
  }
</style>
