---
import Heading from "@core-elements/heading/Heading.astro";
import Icon from "@core-elements/icon/Icon.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import { isNonEmptyString } from "@component-utils/isNonEmptyString";
import { toText } from "@component-utils/toText";

const {
  year: _year,
  date: rawDate,
  title: rawTitle,
  body: rawBody,
  iconName = "",
  accentColor = "",
  layout = "vertical",
  grouped = false,
  headingLevel = "h3",
  headingSize = "xs",
  bodySize = "sm",
  useDefaultEditableBinding = false,
  class: className,
  _component,
  ...htmlAttributes
} = Astro.props;

const date = toText(rawDate);
const title = toText(rawTitle);
const body = toText(rawBody);

const hasTitle = isNonEmptyString(title);
const hasBody = isNonEmptyString(body);
const hasDate = isNonEmptyString(date);
const isHorizontal = layout === "horizontal";
// The rail draws the same markup as the split, down one side. Left out of
// this test the entries fell through to the vertical branch and lost their
// markers entirely — a bare dot where the design has a coloured disc.
const isSplit = layout === "split" || layout === "rail";

// The marker takes the entry's own colour, which is how the design tells the
// steps apart. Left unset it falls back to the timeline's brand colour.
//
// The mark inside it needs to read against that colour, and the design picks
// per colour rather than using one ink throughout: white on moss and sunset,
// near-black on harbour and golden. CSS has no contrast function to do this
// for us, so the pairing is written down.
const MARKER_INK = {
  moss: "var(--light-sand)",
  sunset: "var(--light-sand)",
  pacific: "var(--light-sand)",
  golden: "var(--black)",
  harbour: "var(--black)",
  peachy: "var(--black)",
};

const accentStyle =
  accentColor && accentColor !== "none"
    ? {
        "--timeline-accent": `var(--${accentColor})`,
        "--timeline-accent-ink": MARKER_INK[accentColor] ?? "var(--light-sand)",
      }
    : undefined;

const dateBinding =
  useDefaultEditableBinding && hasDate ? { "data-editable": "text", "data-prop": "date" } : {};
---

<li
  class:list={["timeline-entry", className]}
  style={accentStyle}
  {...htmlAttributes}
>
  {isSplit ? (
    <>
      <div class="timeline-split-content">
        {hasDate && (
          <span
            class="timeline-date"
            {...dateBinding}
          >
            {date}
          </span>
        )}
        {hasTitle && (
          <Heading
            class="timeline-title"
            level={headingLevel}
            size={headingSize}
            data-prop={useDefaultEditableBinding ? "title" : undefined}
          >
            {title}
          </Heading>
        )}
        {hasBody && (
          <SimpleText
            class="timeline-body"
            size={bodySize}
            data-prop={useDefaultEditableBinding ? "body" : undefined}
            text={body}
          />
        )}
      </div>
      <span
        class="timeline-split-marker"
        aria-hidden="true"
      >
        {isNonEmptyString(iconName) ? (
          /* `md` is 22 in a 44 disc. At `sm` the glyph was 15, a third of the
             circle, which reads as a dot with something printed on it. */
          <Icon
            name={iconName}
            size="md"
          />
        ) : (
          <span class="timeline-dot" />
        )}
      </span>
    </>
  ) : isHorizontal ? (
    hasDate && (
      <div
        class="timeline-label"
        {...dateBinding}
      >
        {date}
      </div>
    )
  ) : grouped ? (
    <>
      {hasDate && (
        <span
          class="timeline-month"
          {...dateBinding}
        >
          {date}
        </span>
      )}
      <span
        class="timeline-dot"
        aria-hidden="true"
      />
    </>
  ) : (
    <span
      class="timeline-date"
      {...dateBinding}
    >
      {date}
    </span>
  )}
  {!isSplit && isHorizontal ? (
    <div
      class="timeline-band"
      aria-hidden="true"
    >
      <span class="timeline-dot" />
    </div>
  ) : (
    !isSplit &&
    !grouped && (
      <div class="timeline-content">
        <span
          class="timeline-dot"
          aria-hidden="true"
        />
        {hasTitle && (
          <Heading
            class="timeline-title"
            level={headingLevel}
            size="xs"
            data-prop={useDefaultEditableBinding ? "title" : undefined}
          >
            {title}
          </Heading>
        )}
        {hasBody && (
          <SimpleText
            class="timeline-body"
            size="sm"
            data-prop={useDefaultEditableBinding ? "body" : undefined}
            text={body}
          />
        )}
      </div>
    )
  )}
  {!isSplit && (isHorizontal || grouped) && hasTitle && (
    <Heading
      class="timeline-title"
      level={headingLevel}
      size="xs"
      data-prop={useDefaultEditableBinding ? "title" : undefined}
    >
      {title}
    </Heading>
  )}
  {!isSplit && (isHorizontal || grouped) && hasBody && (
    <SimpleText
      class="timeline-body"
      size="sm"
      data-prop={useDefaultEditableBinding ? "body" : undefined}
      text={body}
    />
  )}
</li>
