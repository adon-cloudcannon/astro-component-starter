---
import RenderBlock from "@component-utils/renderBlock.astro";
import Icon from "@core-elements/icon/Icon.astro";

const {
  title,
  contentSections,
  useDefaultEditableBinding = false,
  isOpen = false,
  accordionName,
  variant = "plain",
  class: className,
  _component,
  "data-children-prop": childrenDataProp,
  "data-prop-title": customDataPropTitle,
  ...htmlAttributes
} = Astro.props;

const effectiveChildrenProp =
  childrenDataProp ?? (useDefaultEditableBinding ? "contentSections" : null);
const arrayDataAttributes = effectiveChildrenProp
  ? { "data-editable": "array", "data-prop": effectiveChildrenProp }
  : {};

const effectiveTitleProp = customDataPropTitle ?? (useDefaultEditableBinding ? "title" : null);
const titleDataAttributes = effectiveTitleProp
  ? { "data-editable": "text", "data-prop": effectiveTitleProp }
  : {};
---

<details
  class:list={["accordion-item", `variant-${variant}`, className]}
  open={isOpen}
  name={accordionName}
  {...htmlAttributes}
>
  <summary class="accordion-item-title">
    <span
      class="accordion-item-title-text"
      {...titleDataAttributes}
    >
      {title}
    </span>
    {/* The card variant marks its state with a plus that becomes a minus in
        a ring, which is what the design draws; the plain one keeps the
        chevron that rotates. Both are rendered and one is shown, rather than
        swapping the name at runtime, so there is no flash on toggle. */}
    {variant === "card" ? (
      <span class="accordion-item-mark" aria-hidden="true">
        <Icon name="plus" size="none" class="accordion-item-mark-closed" />
        <Icon name="minus" size="none" class="accordion-item-mark-open" />
      </span>
    ) : (
      <Icon
        name="chevron-down"
        size="none"
        class="accordion-item-icon"
      />
    )}
  </summary>
  {/* The grid row collapses to nothing, so the row's item must have no box of
      its own: a border or padding on it survives the collapse and snaps away
      at the end. All of that is on `.accordion-item-detail` inside. */}
  <div class="accordion-item-panel">
    <div
      class="accordion-item-detail flow"
      {...arrayDataAttributes}
    >
      <slot>
        {contentSections && (
          <RenderBlock
            contentSections={contentSections}
            useDefaultEditableBinding={!!effectiveChildrenProp}
          />
        )}
      </slot>
    </div>
  </div>
</details>

<style is:global>
  @layer components {
    /* The card variant, measured off 4146:57067 and 4146:57076: each item is
       its own surface with a sand rule, the question at 24, and a ringed mark
       on the end. Open, a rule runs under the question and the answer sits
       below it. */
    .accordion-item.variant-card {
      /* Lighter than the band, not the same as it. `--color-bg` is the band's
         own colour, so on the cream pages the card and the band were both
         #fffcf3 and the card read as nothing at all. The design draws white on
         cream; a band that wants something else sets the token. */
      /* 44 top and bottom, 56 either side, measured off the export rather
         than the node boxes: card 1 rules at y=5120 and y=5247, its question
         frame opens at y=5165, and the card's own left edge is at x=119 with
         the question at x=177. Both are off the spacing scale, so they are
         named here rather than rounded to a step that is 8 out. */
      --accordion-card-padding-block: 2.75rem;
      --accordion-card-padding-inline: 3.5rem;

      background-color: var(--accordion-card-bg, var(--white));
      border: var(--border-width-sm) solid var(--dark-sand);
      border-radius: var(--radius-card);
      padding: var(--accordion-card-padding-block) var(--accordion-card-padding-inline);
    }

    /* 20 between cards, which the export rules at 5248..5267. `spacing-md`
       is 16 and `lg` is 24; `space-before-snug` is the 1.25rem that is
       actually it. */
    .accordion-item.variant-card + .accordion-item.variant-card {
      --space-before: var(--space-before-snug);
      margin-block-start: var(--space-before-snug);
    }

    .accordion-item.variant-card .accordion-item-title {
      align-items: center;
      border-block-end: 0;
      gap: var(--spacing-lg);
      padding: 0;
    }

    /* The whole card answers the pointer, not the words in it. The summary
       carries the starter's own hover tint, which filled the row in the plain
       variant and reads as the item; inside a card it is a patch behind the
       text with the card's padding still cold around it. */
    .accordion-item.variant-card .accordion-item-title:hover,
    .accordion-item.variant-card .accordion-item-title:focus-visible {
      background-color: transparent;
    }

    .accordion-item.variant-card {
      transition: border-color var(--animation-normal) var(--ease-out);
    }

    /* Pointer only, plus a real keyboard ring. `:focus-within` held the
       card lit after a click, because clicking a summary leaves it focused:
       open it, close it, move the mouse away and the item still read as
       selected. `:focus-visible` does not match a mouse click, so the
       keyboard still gets its indicator and the pointer does not leave one
       behind. */
    .accordion-item.variant-card:hover,
    .accordion-item.variant-card:has(> .accordion-item-title:focus-visible) {
      border-color: var(--earth);
    }

    .accordion-item.variant-card:hover .accordion-item-mark,
    .accordion-item.variant-card:has(> .accordion-item-title:focus-visible) .accordion-item-mark {
      border-color: var(--earth);
    }

    /* 29.1/600 in the strong ink, which is Header 5 and exactly what the
       design sets the question in. `heading-xs` is 20 and read as a bolded
       line of body copy rather than a question. */
    .accordion-item.variant-card .accordion-item-title-text {
      color: var(--color-text-strong);
      font-size: var(--font-size-heading-sm);
      font-weight: var(--font-weight-semibold);
    }

    /* The rule belongs to the open state, under the question. */
    /* Not gated on `[open]`: these flipped in and out instantly while the row
       animated, which is the jump. The row clips them when it is closed. */
    .accordion-item.variant-card .accordion-item-detail {
      border-block-start: var(--border-width-sm) solid var(--dark-sand);
      margin-block-start: var(--spacing-lg);
      padding-block-start: var(--spacing-lg);
    }

    .accordion-item.variant-card .accordion-item-mark {
      align-items: center;
      /* 44, which is what the design's ring measures. It is taller than the
         question's own line box and overhangs it, which is why the card
         comes out a few px over the design's 128. */
      block-size: 2.75rem;
      border: var(--border-width-sm) solid var(--color-border);
      border-radius: 999px;
      display: inline-flex;
      flex-shrink: 0;
      inline-size: 2.75rem;
      justify-content: center;
      transition: border-color var(--animation-normal) var(--ease-out);
    }

    .accordion-item.variant-card .accordion-item-mark svg {
      block-size: 1rem;
      inline-size: 1rem;
    }

    /* One mark per state. */
    .accordion-item.variant-card .accordion-item-mark-open,
    .accordion-item.variant-card[open] .accordion-item-mark-closed {
      display: none;
    }

    .accordion-item.variant-card[open] .accordion-item-mark-open {
      display: inline-flex;
    }

    .accordion-item {
      border-bottom: var(--border-width-sm) solid var(--color-border-subtle);
      container-type: inline-size;

      > .accordion-item-title {
        align-items: center;
        cursor: pointer;
        display: flex;
        font-size: var(--font-size-xl);
        font-weight: var(--font-weight-bold);
        justify-content: space-between;

        /* Hides the disclosure marker in Firefox (summary is display: list-item) */
        list-style-type: none;
        padding: var(--spacing-md);
        transition: background-color var(--animation-normal) var(--ease-out);
        -webkit-user-select: none;
        user-select: none;

        &:hover {
          background-color: var(--color-bg-surface);
        }

        &::-webkit-details-marker {
          display: none;
        }

        .accordion-item-icon {
          transition: transform var(--animation-normal) var(--ease-out);
        }
      }

      > .accordion-item-detail {
        padding-inline: var(--spacing-md);
        padding-bottom: var(--spacing-md);
      }
    }

    .accordion-item[open] > .accordion-item-title .accordion-item-icon {
      transform: rotate(180deg);
    }

    /* Opening and closing both animate, from a grid row rather than a height.
       `0fr` to `1fr` interpolates on its own, so nothing has to know the
       content's height — which is what `height: 0` to `auto` needed
       `interpolate-size` for, and that is Chromium-only.

       `content-visibility` is the other half: the UA hides a closed details
       outright, so without a discrete transition the content disappeared the
       instant `open` went and only the leftover box slid up. It stays visible
       for the collapse and flips at the end. */
    @supports selector(::details-content) {
      .accordion-item::details-content {
        display: grid;
        grid-template-rows: 0fr;
        overflow: clip;
        transition:
          grid-template-rows var(--animation-normal) var(--ease-out),
          content-visibility var(--animation-normal) var(--ease-out) allow-discrete;
      }

      .accordion-item[open]::details-content {
        grid-template-rows: 1fr;
      }

      /* A grid item floors at its content height unless told otherwise, which
         would hold the row open at full height and animate nothing. `overflow`
         also gives the panel its own formatting context, so the detail's top
         margin is clipped with it rather than collapsing through and holding
         the item open. */
      .accordion-item > .accordion-item-panel {
        min-block-size: 0;
        overflow: hidden;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .accordion-item::details-content {
        transition: none;
      }
    }
  }
</style>
