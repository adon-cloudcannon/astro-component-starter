---
/**
 * The stack of site cards the design draws beside "Publish when you're ready".
 *
 * Three cards of one environment each — the live site, a staging site, a
 * branch — overlapping down and to the right, with a Publish button under
 * them and a connector running from it back to the live card.
 *
 * Measured off node 3806:72842, the art group on Visual Editing. That group
 * is 708 x 421 and every number below is a share of it, so the whole thing
 * scales with its container rather than at breakpoints:
 *
 *   card         259 wide, radius 8.5, image 150 tall
 *   production     0,   0   247 tall   one information row
 *   staging      211,  50   279 tall   two rows, and it sits on top
 *   branch       449, 139   279 tall
 *   button       286, 370   110 x 51
 *
 * The cards are drawn rather than exported because the design's own are
 * drawn: each is a frame with a photo at the top and type under it, and the
 * type in it is real text at 15/22.5 rather than part of a picture.
 */
import Image from "@core-elements/image/Image.astro";
import Icon from "@core-elements/icon/Icon.astro";

type Card = {
  /**
   * Which environment this is. The flow runs branch to staging to
   * production, and the publish control appears on whichever card is next.
   */
  env?: string;
  badge?: string;
  title?: string;
  subtitle?: string;
  image?: string;
  imageAlt?: string;
  domain?: string;
  built?: string;
  /** Left and top, as shares of the 708 x 421 the design draws it in. */
  x?: number;
  y?: number;
};

const {
  cards = [],
  /** The label on the publish control. Empty leaves the stack static. */
  buttonLabel = "",
  /** What the control says once every environment matches. */
  syncedLabel = "All in sync",
  /** The label on the control that puts it back to the start. */
  resetLabel = "Start over",
  class: className,
  _component,
  ...htmlAttributes
} = Astro.props;

// The design's own three positions, used in order for any card that does not
// carry its own. A fourth would stack on the third rather than guessing.
const PLACES = [
  { x: 0, y: 0 },
  { x: 211 / 708, y: 40 / 421 },
  { x: 449 / 708, y: 82 / 421 },
];

// Branch publishes to staging, staging to production. Written here rather
// than inferred from the order the cards are given, because the order they
// are drawn in and the order the work flows in are different things: the
// cascade runs production, staging, branch down the page.
const NEXT: Record<string, string> = { branch: "staging", staging: "production" };

const placed = (cards as Card[]).slice(0, 3).map((card, index) => ({
  ...card,
  env: card.env || ["production", "staging", "branch"][index],
  left: card.x ?? PLACES[Math.min(index, 2)].x,
  top: card.y ?? PLACES[Math.min(index, 2)].y,
}));

// The one the control starts on: the furthest from production that has
// somewhere to publish to.
const first = placed.find((card) => card.env === "branch") ? "branch" : "staging";
---

{placed.length > 0 && (
  <div
    class:list={["site-cards", className]}
    data-flow={buttonLabel ? first : undefined}
    {...htmlAttributes}
  >
    {/* The graph, drawn in the stage's own 708 x 421 so it lands the same way
        at every size. Two edges rather than the design's one, because the
        picture is now a sequence: branch publishes to staging, staging
        publishes to production, and each arrow points at the card it feeds.

        Both run through the band under the cards. The branch card reaches
        y=404 of 421, so there is no room beneath it; the edges use the strip
        left of it instead, which is clear once staging's bottom is past. */}
    {buttonLabel && (
      <svg
        class="site-cards-wire"
        viewBox="0 0 708 421"
        fill="none"
        aria-hidden="true"
        preserveAspectRatio="none"
      >
        <path class="site-cards-edge" data-edge="branch" d="M449 347 H 340 V 313" />
        <path class="site-cards-edge" data-edge="branch" d="M330 326 L340 310 L350 326" />
        <path class="site-cards-edge" data-edge="staging" d="M211 305 H 114 V 249" />
        <path class="site-cards-edge" data-edge="staging" d="M104 262 L114 246 L124 262" />
      </svg>
    )}

    {placed.map((card, index) => (
      <article
        class="site-cards-card"
        data-index={index}
        data-env={card.env}
        data-next={NEXT[card.env] || undefined}
        style={`--site-card-x: ${(card.left * 100).toFixed(3)}%; --site-card-y: ${(card.top * 100).toFixed(3)}%`}
      >
        {card.image && (
          <span class="site-cards-photo" data-photo>
            <Image
              source={card.image}
              alt={card.imageAlt}
              decorative={!card.imageAlt}
              data-prop-src="image"
              data-prop-alt="imageAlt"
            />
          </span>
        )}

        <div class="site-cards-info">
          <div class="site-cards-head-row">
            {card.badge && (
              <span class="site-cards-badge" aria-hidden="true">{card.badge}</span>
            )}
            <span class="site-cards-names">
              {card.title && <span class="site-cards-title" data-prop="title">{card.title}</span>}
              {card.subtitle && (
                /* No icon. The file has an `account_tree` node here, drawn at
                   the same x as the text rather than beside it, which is an
                   unused part of the instance: the design draws the site's
                   name on its own. */
                <span class="site-cards-subtitle">
                  <span data-prop="subtitle">{card.subtitle}</span>
                </span>
              )}
            </span>
          </div>

          {(card.domain || card.built) && (
            <div class="site-cards-rows">
              {card.domain && (
                <span class="site-cards-row">
                  <Icon name="earth" size="none" />
                  <span data-prop="domain">{card.domain}</span>
                </span>
              )}
              {card.built && (
                <span class="site-cards-row">
                  <Icon name="wrench-circle" size="none" />
                  <span data-prop="built">{card.built}</span>
                </span>
              )}
            </div>
          )}
        </div>
      </article>
    ))}

    {buttonLabel && (
      /* One control, on the card whose turn it is. The design draws a single
         pill under the stack, which reads as a control for the picture; this
         one belongs to a card, so it sits on that card's foot and travels
         with the work. */
      <button class="site-cards-publish" type="button" data-publish>
        <span class="site-cards-publish-label" data-prop="buttonLabel">{buttonLabel}</span>
      </button>
    )}

    {buttonLabel && (
      <p class="site-cards-synced" aria-live="polite">
        <span data-prop="syncedLabel">{syncedLabel}</span>
        <button class="site-cards-reset" type="button" data-reset>{resetLabel}</button>
      </p>
    )}
  </div>
)}

<style is:global>
  @layer components {
    /* Every size in here is in cqi, a share of the stage's own width, so the
       mockup scales as one picture. The stage holds the design's 708 x 421. */
    .site-cards {
      /* The app's own face, not the site's.

         These cards are a picture of CloudCannon, and the app is set in the
         system UI stack. Red Hat Display here would be the marketing site
         drawing a screenshot of itself in its own brand font, which is the
         one thing a mockup of a product must not do. */
      font-family:
        -apple-system, blinkmacsystemfont, "Segoe UI", "Noto Sans", arial, helvetica, sans-serif,
        "Apple Color Emoji", "Segoe UI Emoji";
      aspect-ratio: 708 / 421;
      container-type: inline-size;
      inline-size: 100%;
      position: relative;
    }

    .site-cards-card {
      /* 259 of 708. */
      inline-size: 36.582cqi;
      inset-block-start: var(--site-card-y, 0);
      inset-inline-start: var(--site-card-x, 0);
      position: absolute;
      /* 8.53 of 708. */
      border-radius: 1.204cqi;
      background: var(--white);
      /* The design's hairline, 0.85 at #CFCFCF, floored at a device pixel so
         it does not vanish on a narrow container. box-sizing keeps the card
         259 wide when the live one takes a heavier rule. */
      border: max(1px, 0.12cqi) solid #cfcfcf;
      box-sizing: border-box;
      overflow: hidden;
      transition:
        border-color var(--animation-normal) var(--ease-in-out),
        box-shadow var(--animation-normal) var(--ease-in-out);
    }

    /* The card the flow is on.

       The design marks its front card exactly this way: 1.92 at #333333 with
       a drop shadow, against the 0.85 hairline the other two carry. Here that
       mark travels, so the card you can act on is the one that stands out,
       and a card that has published drops back to the hairline. */
    /* `.site-cards` in the selector on purpose. The resting order below is
       `.site-cards-card[data-env="..."]`, which is two classes-worth of
       specificity, the same as this was; equal rules fall to source order and
       the env ones come later, so the live card took the heavy rule and
       stayed behind its neighbour. */
    .site-cards .site-cards-card[data-live] {
      border-color: #333333;
      /* The second pixel of the rule is a ring just outside the border, not a
         wider border and not an inset shadow.

         A wider border takes its width out of the content at border-box, and
         two pixels was enough to truncate the branch card's title. An inset
         shadow is painted under the card's own children, so the photo running
         to the top edge covered that part of it and the rule came out thin
         along the top and full thickness at the foot. A 0-offset spread sits
         outside the box, where nothing in the card can paint over it, and it
         follows the radius. */
      box-shadow:
        0 0 0 max(1px, 0.151cqi) #333333,
        0 1.98cqi 2.646cqi color-mix(in srgb, #000 10%, transparent);
      z-index: 4;
    }

    /* The cascade's resting order, which the live card above overrides. A
       card that has published falls back into it. */
    .site-cards-card[data-env="branch"] {
      z-index: 3;
    }

    .site-cards-card[data-env="staging"] {
      z-index: 2;
    }

    .site-cards-card[data-env="production"] {
      z-index: 1;
    }

    .site-cards-photo {
      /* 150 of 421 against a 259-wide card: the photo is a fixed slab at the
         top of the card, not an aspect the picture chooses. */
      aspect-ratio: 259 / 150;
      display: block;
      inline-size: 100%;
      overflow: hidden;
    }

    .site-cards-photo img,
    .site-cards-photo picture,
    .site-cards-photo .image-inner {
      block-size: 100%;
      display: block;
      inline-size: 100%;
      object-fit: cover;
    }

    .site-cards-info {
      display: grid;
      /* 9 of 708. */
      gap: 0.8cqi;
      padding: 1.27cqi;
    }

    .site-cards-head-row {
      align-items: start;
      display: flex;
      gap: 1.27cqi;
    }

    /* 43 x 45.5 at radius 7.5, which is near enough a square. */
    .site-cards-badge {
      align-items: center;
      aspect-ratio: 1;
      background: #212121;
      border-radius: 1.06cqi;
      color: var(--white);
      display: flex;
      flex: none;
      font-size: 3.044cqi;
      font-weight: 700;
      inline-size: 6.09cqi;
      justify-content: center;
      line-height: 1;
    }

    .site-cards-names {
      display: grid;
      min-inline-size: 0;
    }

    /* 15 over 22.5 in the file, which is 1.5. */
    .site-cards-title {
      color: #212121;
      font-size: 2.118cqi;
      font-weight: 700;
      line-height: 1.5;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .site-cards-subtitle,
    .site-cards-row {
      align-items: center;
      color: #757575;
      display: flex;
      font-size: 2.118cqi;
      font-weight: 400;
      gap: 0.9cqi;
      line-height: 1.5;
      min-inline-size: 0;
    }

    .site-cards-subtitle > span:last-child,
    .site-cards-row > span:last-child {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    /* 16.5 of 708. The file's own mark is 18.7 in a 22.5 box, and both read
       heavy here: these are solid discs rather than the outline glyphs the
       rest of the site uses, so they carry more ink at the same size than the
       15px text beside them. Just over the text's cap height is where they
       sit level with it. */
    .site-cards-subtitle .icon,
    .site-cards-row .icon {
      block-size: 2.331cqi;
      flex: none;
      font-size: 2.331cqi;
      inline-size: 2.331cqi;
    }

    .site-cards-rows {
      display: grid;
      gap: 0.25cqi;
    }

    /* The control sits on the foot of whichever card is next, half over it,
       so it reads as that card's button rather than the picture's. It is
       placed from the card's own custom properties, which the stage sets as
       the flow advances. */
    .site-cards-publish {
      background: var(--sunset, #d85a2c);
      border: 0;
      border-radius: 999px;
      color: var(--white);
      cursor: pointer;
      font: inherit;
      font-size: 2.118cqi;
      font-weight: 700;
      inline-size: 15.536cqi;
      block-size: 7.203cqi;
      position: absolute;
      z-index: 4;
      /* Centred under the active card, clear of its foot. Astride the edge it
         sat over the card's last information row, which is content rather
         than space the button is free to take. */
      inset-inline-start: calc(var(--flow-x, 40%) + 18.291cqi - 7.768cqi);
      inset-block-start: calc(var(--flow-bottom, 82%) + 1.4cqi);
      transition:
        inset-inline-start var(--animation-slow, 0.45s) var(--ease-in-out),
        inset-block-start var(--animation-slow, 0.45s) var(--ease-in-out),
        opacity var(--animation-normal) var(--ease-in-out),
        transform var(--animation-normal) var(--ease-in-out);
    }

    .site-cards-publish:hover,
    .site-cards-publish:focus-visible {
      transform: translateY(-0.3cqi);
    }

    /* Nothing left to publish. */
    .site-cards[data-flow="synced"] .site-cards-publish {
      opacity: 0;
      pointer-events: none;
    }

    .site-cards-synced {
      align-items: center;
      display: flex;
      gap: 1.5cqi;
      font-size: 2.118cqi;
      inset-block-end: 0;
      inset-inline-start: 0;
      justify-content: flex-start;
      margin: 0;
      opacity: 0;
      pointer-events: none;
      position: absolute;
      transition: opacity var(--animation-normal) var(--ease-in-out);
      z-index: 4;
    }

    .site-cards[data-flow="synced"] .site-cards-synced {
      opacity: 1;
      pointer-events: auto;
    }

    .site-cards-reset {
      background: none;
      border: 0;
      color: inherit;
      cursor: pointer;
      font: inherit;
      padding: 0;
      text-decoration: underline;
      text-underline-offset: 0.35em;
    }

    /* The travel is the whole point of the graphic, so it is not removed for
       a reader who asks for less motion, only shortened to a cut. The picture
       still changes card, which is the information. */
    @media (prefers-reduced-motion: reduce) {
      .site-cards {
        --site-cards-travel: 0.01s;
      }

      .site-cards-publish {
        transition: opacity var(--animation-normal) var(--ease-in-out);
      }
    }

    /* The picture that travels. A copy of the source photo, laid over the
       stage in its coordinates and moved to the target's box; the real swap
       happens underneath when it lands. */
    .site-cards-ghost {
      overflow: hidden;
      pointer-events: none;
      position: absolute;
      z-index: 5;
      border-radius: 1.204cqi;
      box-shadow: 0 1cqi 2.5cqi color-mix(in srgb, var(--midnight) 22%, transparent);
      transition:
        inset-inline-start var(--site-cards-travel, 0.6s) var(--ease-in-out),
        inset-block-start var(--site-cards-travel, 0.6s) var(--ease-in-out),
        inline-size var(--site-cards-travel, 0.6s) var(--ease-in-out),
        block-size var(--site-cards-travel, 0.6s) var(--ease-in-out);
    }

    .site-cards-ghost img,
    .site-cards-ghost picture,
    .site-cards-ghost .image-inner {
      block-size: 100%;
      display: block;
      inline-size: 100%;
      object-fit: cover;
    }

    .site-cards-wire {
      inset: 0;
      position: absolute;
      inline-size: 100%;
      block-size: 100%;
      /* Behind the cards and the button, which is how a connector reads: the
         line runs to the card rather than over it. */
      z-index: 0;
    }

    .site-cards-wire path {
      stroke: #212121;
      stroke-width: 1.75;
      opacity: 0.22;
      transition: opacity var(--animation-normal) var(--ease-in-out),
        stroke var(--animation-normal) var(--ease-in-out);
      /* The viewBox is stretched to the stage, so a stroke in its own units
         would squash with it. */
      vector-effect: non-scaling-stroke;
    }

    /* The edge about to be used is the only one drawn at full strength, so
       the graph says which way the work goes next. */
    .site-cards[data-flow="branch"] .site-cards-edge[data-edge="branch"],
    .site-cards[data-flow="staging"] .site-cards-edge[data-edge="staging"] {
      opacity: 1;
      stroke: var(--sunset, #d85a2c);
    }

    .site-cards-head {
      fill: none;
    }
  }
</style>

<script>
  import { onPageLoad } from "@component-utils/onPageLoad";
  import { setupAllSiteCards } from "./setup";

  onPageLoad(() => setupAllSiteCards());
</script>
