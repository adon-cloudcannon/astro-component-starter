---
import { rootMirror } from "@component-utils/rootMirror.mjs";
/**
 * A picture on a panel with stat callouts laid over it.
 *
 * Pulled out of the Stat Panel section so a stepper's media can hold one too:
 * High Performance draws the same pill over a graph on its third slide, and a
 * page section cannot nest inside a step. The section is now a header plus one
 * of these.
 *
 * The figures are `Counter`, which already animates from a share of the value
 * when it is scrolled to, respects reduced motion, groups thousands and keeps
 * the target's own precision.
 */
import Counter from "@core-elements/counter/Counter.astro";
import Icon from "@core-elements/icon/Icon.astro";
import Image from "@core-elements/image/Image.astro";

type StatProps = {
  number?: number;
  prefix?: string;
  suffix?: string;
  label?: string;
  iconName?: string;
  iconColor?: string;
};

/**
 * The mark's colour, from a palette family name.
 *
 * Lifted to the family's 400 shade. The mark sits on the card's own #333333
 * chip, where a family's base tone reads as a smudge: Moss at #687E00 is
 * barely a step off the chip it is on, and #869833 is legible. The fallback
 * keeps a value that already names a shade, such as `moss-400`, working as
 * written.
 */
const markColour = (name: string) => `var(--${name}-400, var(--${name}))`;

const {
  imageSource = "",
  imageAlt = "",
  imageAnchor = "foot",
  /**
   * Where the picture sits on the panel.
   *
   * `inset` is the Enterprise placement, 102,91 of a 1160x679 panel. `center`
   * puts it in the middle, which is what High Performance draws: a graph at
   * 99,193 of a media column 800 wide, with roughly even air either side.
   */
  imagePlacement = "inset",
  /** How wide it is, as a share of the panel. */
  imageWidth = 62,
  panelImage = "",
  panelColor = "",
  /**
   * Draw the panel's scratched sheet instead of loading one.
   *
   * A palette name or a hex. Every exported sheet was a flat colour with the
   * whole texture in its alpha channel, so a new colour meant a new file;
   * `.scratched` generates the texture and takes the colour from here.
   */
  panelScratch = "",
  /** What a scratch shows. Defaults to the fill lifted toward white. */
  panelScratchInk = "",
  stats = [],
  statsPosition = "end",
  statsAlign = "start",
  /**
   * How the panel sits in whatever holds it.
   *
   * `card` is the Enterprise shape: a rounded box of its own proportions.
   * `fill` is the High Performance one, where the sheet is not a card at all —
   * it is the whole half of the band, 1280x723 at 0,0 with square corners and
   * the copy side painted over it.
   */
  panelFit = "card",
  /** The panel's shape when it is a card. The design draws it 1160 by 679. */
  ratioWidth = 1160,
  ratioHeight = 679,
  class: className,
  useDefaultEditableBinding = false,
  _component,
  "data-children-prop": childrenDataProp,
  ...htmlAttributes
} = Astro.props;

const statList: StatProps[] = Array.isArray(stats) ? stats : [];

/* The stats are a region only where the caller says so, like every other
   wrapper's array. Written unconditionally they claimed one wherever the
   panel was drawn, including the pinned stepper's media column, which is the
   same `steps` array rendered a second time and owns no paths: a label there
   asked for `steps.stats.0.label`, a key with no index in front of it. */
const effectiveChildrenProp =
  childrenDataProp ?? (useDefaultEditableBinding ? "stats" : null);
const arrayDataAttributes = effectiveChildrenProp
  ? { "data-editable": "array", "data-prop": effectiveChildrenProp }
  : {};

/** A palette name, or a literal the design states outright. */
const colour = (value: string) => (value.startsWith("#") ? value : `var(--${value})`);

/* The root's own prop-driven attributes, mirrored for the Visual Editor.
   CloudCannon keeps a region's root element and swaps only its contents, so
   these never change there without it. */
const mirror = rootMirror({
  class: {
    ...Object.fromEntries(["cover", "contain", "fill"].map((fit) => [`fit-${fit}`, panelFit === fit])),
    scratched: Boolean(panelScratch),
  },
  style: {
    "--stat-panel-ground": panelColor ? colour(panelColor) : null,
    "--scratch-fill": panelScratch ? colour(panelScratch) : null,
    "--scratch-ink": panelScratchInk ? colour(panelScratchInk) : null,
    "--stat-panel-ratio-w": String(Number(ratioWidth) || 1160),
    "--stat-panel-ratio-h": String(Number(ratioHeight) || 679),
  },
});
---

<div
  class:list={["stat-panel-panel", `fit-${panelFit}`, { scratched: panelScratch }, className]}
  style={[
    /* A palette name, or a literal the design states outright: High
       Performance lays its sheet over #FFFFFF rather than over a token. */
    panelColor ? `--stat-panel-ground: ${colour(panelColor)}` : "",
    panelScratch ? `--scratch-fill: ${colour(panelScratch)}` : "",
    panelScratchInk ? `--scratch-ink: ${colour(panelScratchInk)}` : "",
  `--stat-panel-ratio-w: ${Number(ratioWidth) || 1160}`,
  `--stat-panel-ratio-h: ${Number(ratioHeight) || 679}`,
  ].filter(Boolean).join("; ")}
  {...htmlAttributes}
  >
  {/* Carries this component's own root attributes for the Visual Editor,
      which never rewrites a region root. See utils/rootMirror.mjs. */}
  <span class="root-mirror" hidden {...mirror} />
  {panelImage && (
    <Image
      class="stat-panel-ground"
      source={panelImage}
      decorative={true}
      data-prop-src="panelImage"
    />
  )}
  {imageSource && (
    <Image
      class:list={[
        "stat-panel-shot",
        `anchor-${imageAnchor}`,
        `place-${imagePlacement}`,
      ]}
      style={`--stat-panel-shot-width: ${Number(imageWidth) || 62}%`}
      source={imageSource}
      alt={imageAlt}
      data-prop-src={effectiveChildrenProp ? "imageSource" : undefined}
      data-prop-alt={effectiveChildrenProp ? "imageAlt" : undefined}
    />
  )}
  {/* `data-prop` on the list below, not `data-children-prop`. The latter is
      the prop one component passes another; written onto a plain element it
      is an attribute the editor does not read, so the array never said which
      key it was and a stat's label asked for `pageSections.2.0.label`, an
      index with no array in front of it. */}
  {statList.length > 0 && (
    <dl
      class:list={["stat-panel-stats", `at-${statsPosition}`, `align-${statsAlign}`]}
      {...arrayDataAttributes}
    >
      {statList.map((stat) => (
        <div
          class="stat-panel-stat"
          data-editable={effectiveChildrenProp ? "array-item" : undefined}
          style={stat.iconColor ? `--stat-panel-mark: ${markColour(stat.iconColor)}` : undefined}
        >
          {stat.iconName && (
            <span class="stat-panel-mark">
              <Icon
                name={stat.iconName}
                size="lg"
              />
            </span>
          )}
          <div class="stat-panel-figures">
            <dd class="stat-panel-value">
              <Counter
                number={stat.number}
                prefix={stat.prefix}
                suffix={stat.suffix}
                size="xl"
                spaceBefore="none"
              />
            </dd>
            <dt
              class="stat-panel-label"
              data-editable={effectiveChildrenProp ? "text" : undefined}
              data-prop={effectiveChildrenProp ? "label" : undefined}
            >
              {stat.label}
            </dt>
          </div>
        </div>
      ))}
    </dl>
  )}
  </div>

<style is:global>
  /* Flat, because rules nested deeper than a couple of levels get dropped
     (see CLAUDE.md). */
  @layer components {
    /* Everything inside is measured against the panel rather than the window,
       so the whole arrangement holds its proportions at any width: the design
       states it all against a 1160x679 box, and one design unit is
       100cqi/1160. */
    .stat-panel-panel {
      aspect-ratio: var(--stat-panel-ratio-w, 1160) / var(--stat-panel-ratio-h, 679);
      background-color: var(--stat-panel-ground, transparent);
      border-radius: var(--radius-card);
      container-type: inline-size;
      inline-size: 100%;
      /* The screenshot runs past the panel's foot in the design — 91 down and
         608 tall inside 679 — so the panel cuts it off rather than growing. */
      overflow: hidden;
      position: relative;
    }

    /* Edge to edge. Image nests an `.image-inner` and a `<picture>` between
       the class and the `<img>`, and neither takes a height of its own — so
       sizing the wrapper and the img alone left the sheet at its natural
       height with the panel's colour showing under it. Every level between
       has to be told, which is the same reason the marks came out small. */
    /* Edge to edge: no corners of its own, and it takes the height of
       whatever holds it rather than a ratio. */
    .stat-panel-panel.fit-fill {
      aspect-ratio: auto;
      block-size: 100%;
      border-radius: 0;
    }

    .stat-panel-ground,
    .stat-panel-ground .image-inner,
    .stat-panel-ground picture {
      block-size: 100%;
      display: block;
      inline-size: 100%;
    }

    .stat-panel-ground {
      inset: 0;
      position: absolute;
    }

    /* Scoped through the panel to out-specify Image's own `height: auto`,
       which otherwise wins and leaves the sheet at its natural aspect — 367
       of the 455 the panel needs, with the backing colour showing beneath. */
    .stat-panel-panel > .stat-panel-ground img {
      block-size: 100%;
      inline-size: 100%;
      object-fit: cover;
    }

    /* 102,91 and 719 wide of the design's 1160. */
    .stat-panel-shot {
      --space-before: 0;
      inline-size: var(--stat-panel-shot-width, 61.98%);
      margin: 0;
      position: absolute;
    }

    /* 102,91 of the design's 1160x679. */
    .stat-panel-shot.place-inset {
      inset-block-start: 13.4%;
      inset-inline-start: 8.79%;
    }

    /* Middle of the panel, both ways. */
    .stat-panel-shot.place-center {
      inset-block-start: 50%;
      inset-inline-start: 50%;
      translate: -50% -50%;
    }

    /* Down to the foot and past it, cut off by the panel. The design's slot is
       719x608, a ratio of 1.18, and a picture wider than that — the PaperCut
       screenshot is 1.55 — stops short and floats unless it is told to fill
       the height and crop. */
    .stat-panel-shot.place-inset.anchor-foot {
      block-size: 89.5%;
    }

    .stat-panel-shot.place-inset.anchor-foot .image-inner,
    .stat-panel-shot.place-inset.anchor-foot picture {
      block-size: 100%;
      display: block;
    }

    .stat-panel-shot.place-inset.anchor-foot img {
      block-size: 100%;
      inline-size: 100%;
      /* From the top: the head of a screenshot is the part worth keeping. */
      object-fit: cover;
      object-position: top center;
    }

    /* The design rounds the picture's top corners and leaves its bottom ones
       square — `rectangleCornerRadii: [18, 18, 0, 0]` — because the panel cuts
       that edge off anyway. Left at its own height there is no cut edge, so it
       is rounded all the way round. */
    .stat-panel-shot img {
      border-start-end-radius: var(--radius-card);
      border-start-start-radius: var(--radius-card);
    }

    .stat-panel-shot.place-center img,
    .stat-panel-shot.anchor-top img {
      border-radius: var(--radius-card);
    }

    /* The column of pills: 366 of 1160 wide, 95 in from the edge, 77 down. */
    .stat-panel-stats {
      display: flex;
      flex-direction: column;
      gap: 4.12cqi;
      inline-size: 31.55%;
      inset-block: 11.34% 11.34%;
      margin: 0;
      position: absolute;
    }

    .stat-panel-stats.at-end {
      inset-inline-end: 8.19%;
    }

    .stat-panel-stats.at-start {
      inset-inline-start: 8.19%;
    }

    /* One centred, two apart, three stacked from the top — the arrangements
       the same panel is asked for with different numbers of stats. */
    .stat-panel-stats.align-start { justify-content: flex-start; }
    .stat-panel-stats.align-center { justify-content: center; }
    .stat-panel-stats.align-end { justify-content: flex-end; }
    .stat-panel-stats.align-between { justify-content: space-between; }

    .stat-panel-stat {
      align-items: center;
      background-color: var(--stat-panel-card, #1d1b17);
      border-radius: var(--radius-card);
      display: flex;
      gap: 1.98cqi;
      padding: 2.07cqi;
    }

    /* The mark sits in a circle a shade lighter than the pill, and takes the
       stat's own colour. */
    .stat-panel-mark {
      align-items: center;
      aspect-ratio: 1;
      background-color: var(--stat-panel-mark-ground, #333333);
      border-radius: var(--radius-full);
      color: var(--stat-panel-mark, var(--moss));
      display: flex;
      flex-shrink: 0;
      inline-size: 7.5cqi;
      justify-content: center;
    }

    /* Size and centre the element that actually draws, not the one the class
       lands on. Icon puts an `.icon-inner` inside carrying the real size —
       `size-lg` here — so sizing the outer span alone left the svg at 27px in
       a 44px box, sitting at its top-left: both too small and off-centre.
       These three have to agree or the mark drifts. */
    .stat-panel-mark .icon,
    .stat-panel-mark .icon-inner {
      align-items: center;
      block-size: 100%;
      display: flex;
      inline-size: 100%;
      justify-content: center;
    }

    /* The design draws the mark at 49 to 54 inside an 87 circle, so a little
       over half of it. */
    .stat-panel-mark svg {
      block-size: 4.7cqi;
      inline-size: 4.7cqi;
    }

    .stat-panel-figures {
      display: grid;
      min-inline-size: 0;
    }

    /* Counter carries its own size token; the design draws the figure at 65,
       which is Header 2, and it has to shrink with the panel rather than the
       window. */
    .stat-panel-value {
      margin: 0;
    }

    /* Scoped through the panel to out-specify Counter's own `size-xl`, which
       is a flat 65px and ties on specificity. Left to win, the figure stayed
       65 whatever the panel measured — fine at Enterprise's 1040, but it
       overran the pill on High Performance's 651, where the same share is 36.
       The point of sizing in `cqi` is that the pill holds its proportions
       wherever it is put, so the rule has to actually land. */
    .stat-panel-panel .stat-panel-value .counter-inner {
      color: var(--stat-panel-figure, #ffffff);
      font-size: 5.6cqi;
      line-height: 1.15;
    }

    .stat-panel-label {
      color: var(--stat-panel-label, #c2cbd8);
      font-size: 1.9cqi;
      line-height: 1.3;
    }

    /* Overlaid is a desktop idea. Narrow, the panel stops holding a fixed
       shape and the stats fall in under the picture. */
    @media (max-width: 767px) {
      .stat-panel-panel {
        aspect-ratio: auto;
        padding: var(--spacing-lg);
      }

      .stat-panel-shot.anchor-foot {
        block-size: auto;
      }

      .stat-panel-shot.place-inset.anchor-foot img {
        block-size: auto;
        object-fit: fill;
      }

      .stat-panel-shot,
      .stat-panel-stats {
        inline-size: 100%;
        inset: auto;
        position: static;
      }

      .stat-panel-stats {
        gap: var(--spacing-md);
        margin-block-start: var(--spacing-lg);
      }

      .stat-panel-stat {
        gap: var(--spacing-md);
        padding: var(--spacing-md);
      }

      .stat-panel-mark {
        inline-size: 3rem;
      }

      .stat-panel-mark svg {
        block-size: 1.7rem;
        inline-size: 1.7rem;
      }

      .stat-panel-value .counter-inner {
        font-size: var(--font-size-heading-md);
      }

      .stat-panel-label {
        font-size: var(--font-size-md);
      }
    }
  }
</style>
