---
import { rootMirror } from "@component-utils/rootMirror.mjs";
import { resolveImageSource } from "@component-utils/resolveImageSource";
/**
 * A pile of labelled shapes that fall into place.
 *
 * The design draws the pile at rest: six shapes, each at its own position and
 * angle, overlapping in a set order, with the text readable in every one. That
 * is why this is scripted rather than simulated — a solver cannot be told to
 * come to rest exactly here, so a real engine would give a different pile on
 * every load and put the copy at angles nobody chose.
 *
 * What sells the fall instead is four cheap things: the shapes resting on the
 * floor land before the ones resting on them, the drop accelerates rather than
 * easing out, each one bounces a little on landing, and the tilt arrives a beat
 * after the position.
 *
 * Positions are in the design's own units, inside a box the section scales as a
 * whole, so the arrangement holds at any width.
 *
 * A shape carries either a label or a mark. The Developers page's pile is the
 * second kind: seven tool marks in palette colours, at rest. `fall: false`
 * leaves the pile standing, which is what that one wants — it sits beside the
 * copy as a picture rather than arriving.
 */
type Shape = {
  text?: string;
  /**
   * A single-colour mark in place of the label, drawn as a mask so one file
   * takes whatever colour the shape gives it. Centred in the shape.
   */
  image?: string;
  imageAlt?: string;
  /** The mark's box, in the same design units as the shape's own. */
  imageWidth?: number;
  imageHeight?: number;
  /** The mark's colour, by palette name or as a hex. */
  imageColor?: string;
  /** Which of the three scratched sheets colours it. */
  tone?: string;
  /**
   * The sheet's colour by palette name or hex, for a pile outside those three.
   * Out-ranks `tone`, which stays for the piles already built on it.
   */
  color?: string;
  /** The wedge's own colour, which is a tint of the shape it falls on. */
  shadowColor?: string;
  /** Design units, from the top left of the pile box. */
  x?: number;
  y?: number;
  width?: number;
  height?: number;
  /** Where it comes to rest, in degrees. */
  rotation?: number;
  /** Label size, in the same design units as the box. */
  fontSize?: number;
  strong?: boolean;
  /**
   * The wedge another shape casts onto this one, in design units from this
   * shape's own top left. Carried by the shape that receives it, because that
   * is what clips it.
   */
  shadowX?: number;
  shadowY?: number;
  shadowWidth?: number;
  shadowHeight?: number;
  /**
   * Which shape casts it, counting from 1 in the order they are listed.
   *
   * Stated rather than worked out: the caster never overlaps the wedge by
   * much — it sits above it — so picking the shape with the largest overlap
   * chooses the neighbouring floor card every time.
   */
  shadowFrom?: number;
  round?: boolean;
  lightText?: boolean;
};

const {
  shapes = [],
  /**
   * How the shapes are laid out.
   *
   * `stacked` builds them from the floor up, each card sized by its label,
   * which is what an editor adding a card wants: there is nothing to place.
   * `placed` is the hand-drawn collage — a card tucked into the gap between
   * two others, a shadow crossing from one to the next — and every shape in
   * it carries its own coordinates.
   */
  arrangement = "stacked",
  /** The box the positions above are measured in. */
  designWidth = 664,
  designHeight = 340,
  /**
   * Whether the pile drops into place when it is scrolled to.
   *
   * The Low Maintenance pile is the fall; the Developers one is the same
   * arrangement standing still. Off, nothing is held back and no observer is
   * attached, so the shapes are simply there.
   */
  fall = true,
  /** The corner radius of a square shape, in pixels. */
  radius = 19,
  class: className,
  /* Taken rather than spread: the root writes a style of its own, and an
     explicit attribute wins over `...htmlAttributes`, so a host's style was
     being dropped without a word. */
  style: hostStyle = "",
  "data-children-prop": childrenDataProp,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const placed = arrangement === "placed";

/**
 * How many an auto pile draws.
 *
 * Nine is three rows of three in the design's 664-wide box with the label
 * still readable. Past that the rows are thinner than the cards are tall and
 * it stops reading as a pile of things and starts reading as a table.
 */
const MAX_AUTO = 9;

const all: Shape[] = Array.isArray(shapes) ? shapes : [];
const list: Shape[] = placed ? all : all.slice(0, MAX_AUTO);

/**
 * Where a stacked pile's cards land, in the order they are added.
 *
 * Drawn rather than worked out. A pile laid out by a rule comes out a grid,
 * because that is what a rule makes: every card the same height, every row
 * filled to the width, nothing tucked under anything. These are places —
 * each with its own size and lean, each overlapping the one it rests on —
 * so the first card always lands in the same spot at the foot, the second
 * beside it, and the fourth on the shoulders of the first two.
 *
 * Measured in the design's own 664 box, with `up` the distance from its
 * floor, so the box can grow a row at a time without any of them moving.
 *
 * `shadowFrom` is the slot whose card casts the wedge on this one, and it
 * is drawn only when that card is there: four cards cast one shadow, seven
 * cast three.
 */
type Slot = {
  x: number;
  up: number;
  width: number;
  height: number;
  rotation: number;
  shadowFrom?: number;
  shadow?: { x: number; y: number; width: number; height: number };
};

/** The floor of each row, measured from the box's own floor. */
const ROW_UP = [0, 136, 272];

/* Three to a row, each row inset from the one under it so the pile narrows
   as it goes up, and each card leaning a little differently. The wedge on a
   card is cast by the card that lands on it, which is the one three along. */
const SLOTS: Slot[] = [
  {
    x: 0,
    up: ROW_UP[0],
    width: 212,
    height: 148,
    rotation: 0,
    shadowFrom: 3,
    shadow: { x: 32, y: 1, width: 212, height: 34 },
  },
  {
    x: 226,
    up: ROW_UP[0],
    width: 212,
    height: 164,
    rotation: -1.5,
    shadowFrom: 4,
    shadow: { x: 22, y: 1, width: 212, height: 34 },
  },
  {
    x: 452,
    up: ROW_UP[0],
    width: 212,
    height: 148,
    rotation: 1,
    shadowFrom: 5,
    shadow: { x: -40, y: 1, width: 212, height: 34 },
  },

  {
    x: 32,
    up: ROW_UP[1],
    width: 200,
    height: 140,
    rotation: -2.5,
    shadowFrom: 6,
    shadow: { x: 40, y: 1, width: 190, height: 32 },
  },
  {
    x: 248,
    up: ROW_UP[1],
    width: 200,
    height: 152,
    rotation: 1.5,
    shadowFrom: 7,
    shadow: { x: 24, y: 1, width: 190, height: 32 },
  },
  {
    x: 464,
    up: ROW_UP[1],
    width: 200,
    height: 140,
    rotation: -1,
    shadowFrom: 8,
    shadow: { x: -36, y: 1, width: 190, height: 32 },
  },

  { x: 72, up: ROW_UP[2], width: 180, height: 132, rotation: 2 },
  { x: 272, up: ROW_UP[2], width: 180, height: 144, rotation: -2 },
  { x: 472, up: ROW_UP[2], width: 180, height: 132, rotation: 3 },
];

/** The rows a count fills, which is what the box has to be tall enough for. */
const ROW_SIZE = 3;
const rowsUsed = Math.min(Math.ceil(list.length / ROW_SIZE), ROW_UP.length);
const stackedHeight = placed
  ? designHeight
  : ROW_UP[Math.max(0, rowsUsed - 1)] +
    Math.max(...SLOTS.slice(0, list.length).map((slot) => slot.height), 0);

/** The box every position below is a share of. */
const boxWidth = designWidth;
const boxHeight = placed ? designHeight : stackedHeight;

/** A stacked card's place, which is its slot rather than anything it carries. */
const slotOf = (index: number): Slot => SLOTS[index % SLOTS.length];

/** The y a slot's top edge sits at, measured from the box's head. */
const topOf = (slot: Slot) => boxHeight - slot.up - slot.height;

/* The root's own prop-driven attributes, mirrored for the Visual Editor.
   CloudCannon keeps a region's root element and swaps only its contents, so
   these never change there without it. */
const mirror = rootMirror({
  class: { falls: fall !== false },
  style: {
    "--pile-design-width": String(designWidth),
    "--pile-design-height": String(boxHeight),
    "--pile-radius": `${Number(radius) || 19}px`,
  },
});

/* A palette name or a hex. Named colours go through the token so a theme
   change carries, which a copied hex would not. */
const paint = (value?: string) =>
  !value ? undefined : value.startsWith("#") ? value : `var(--${value})`;

/**
 * Lowest edge falls first, which is the whole trick: a card that comes to rest
 * on another has to arrive after it, or it lands on nothing.
 *
 * Worked out from the geometry rather than carried in the data, so an editor
 * moving a shape — or adding one to a stacked pile — does not also have to
 * restate the order.
 */
const bottomOf = (shape: Shape, index: number) =>
  placed ? (Number(shape.y) || 0) + (Number(shape.height) || 0) : boxHeight - slotOf(index).up;

const byLowest = list
  .map((shape, index) => ({ index, bottom: bottomOf(shape, index) }))
  .sort((a, b) => b.bottom - a.bottom);
const rank = new Map(byLowest.map((entry, position) => [entry.index, position]));

const STAGGER_MS = 95;
const FALL_MS = 620;
/** The point in the fall where a shape reaches its place, before the bounce. */
const LANDS_AT = 0.58;
/** How far above its place a shape starts. */
const RISE = 190;

/** When a shape touches down, measured from the first one being let go. */
const landingOf = (index: number) =>
  Math.round((rank.get(index) ?? 0) * STAGGER_MS + FALL_MS * LANDS_AT);

/** Everything down, for a shadow that does not say what casts it. */
const settled = Math.round((list.length - 1) * STAGGER_MS + FALL_MS);

/* The pile is the array its shapes are items of. `data-children-prop` was
   being written onto the div as a plain attribute, which means nothing to the
   editor, so every shape was an array item with no array around it. */
const effectiveChildrenProp = childrenDataProp ?? (useDefaultEditableBinding ? "shapes" : null);
const arrayDataAttributes = effectiveChildrenProp
  ? { "data-editable": "array", "data-prop": effectiveChildrenProp }
  : {};
---

<div
  class:list={["shape-pile", !placed && "is-auto", fall !== false && "falls", className]}
  style={[
    `--pile-design-width: ${boxWidth}`,
    `--pile-design-height: ${boxHeight}`,
    `--pile-radius: ${Number(radius) || 19}px`,
    hostStyle,
  ]
    .filter(Boolean)
    .join("; ")}
  {...arrayDataAttributes}
  {...htmlAttributes}
>
  {/* Carries this component's own root attributes for the Visual Editor,
      which never rewrites a region root. See utils/rootMirror.mjs. */}
  <span
    class="root-mirror"
    hidden
    {...mirror}
  />

  {list.map((shape, index) => {
    /* A placed card is where it says it is. A stacked one is in its slot,
       which is also where its wedge and its turn in the fall come from. */
    const slot = slotOf(index);
    const geometry = placed
      ? {
          x: Number(shape.x) || 0,
          y: Number(shape.y) || 0,
          width: Number(shape.width) || 0,
          height: Number(shape.height) || 0,
          rotation: Number(shape.rotation) || 0,
        }
      : {
          x: slot.x,
          y: topOf(slot),
          width: slot.width,
          height: slot.height,
          rotation: slot.rotation,
        };

    const wedge = placed
      ? Number(shape.shadowWidth) > 0
        ? {
            x: Number(shape.shadowX) || 0,
            y: Number(shape.shadowY) || 0,
            width: Number(shape.shadowWidth),
            height: Number(shape.shadowHeight) || 0,
            from: Number(shape.shadowFrom) || 0,
          }
        : null
      : slot.shadow && slot.shadowFrom !== undefined && slot.shadowFrom < list.length
        ? { ...slot.shadow, from: slot.shadowFrom + 1 }
        : null;

    return (
      <div
        class:list={[
          "shape-pile-shape",
          "scratched",
          `tone-${shape.tone || "golden"}`,
          placed && shape.round && "is-round",
          shape.lightText && "is-light-text",
          shape.strong && "is-strong",
        ]}
        data-editable={effectiveChildrenProp ? "array-item" : undefined}
        style={[
          shape.color ? `--scratch-fill: ${paint(shape.color)}` : "",
          shape.shadowColor ? `--pile-shadow-color: ${paint(shape.shadowColor)}` : "",
          shape.imageColor ? `--pile-mark-color: ${paint(shape.imageColor)}` : "",
          `--pile-x: ${(geometry.x / boxWidth) * 100}%`,
          `--pile-y: ${(geometry.y / boxHeight) * 100}%`,
          `--pile-w: ${(geometry.width / boxWidth) * 100}%`,
          `--pile-h: ${(geometry.height / boxHeight) * 100}%`,
          `--pile-font: ${Number(shape.fontSize) || 20}`,
          /* The card's own width in design units, which is what its label is
             scaled against: the card is the query container, not the pile. */
          `--pile-units: ${geometry.width || boxWidth}`,
          `--pile-rot: ${geometry.rotation}deg`,
          /* It comes in at a steeper angle than it settles at, so the tilt is
             still moving when the position has stopped. */
          `--pile-tilt: ${geometry.rotation - 9}deg`,
          `--pile-rise: ${-RISE}px`,
          `--pile-delay: ${(rank.get(index) ?? 0) * STAGGER_MS}ms`,
        ]
          .filter(Boolean)
          .join("; ")}
      >
        {shape.image ? (
          /* A mask, not a picture: the marks are single-colour and the colour
             belongs to the shape under them, so one file serves a white rose
             on sunset and a dark bookshelf on blush. */
          <span
            class="shape-pile-mark logo-mark"
            role={shape.imageAlt ? "img" : undefined}
            aria-label={shape.imageAlt || undefined}
            aria-hidden={shape.imageAlt ? undefined : "true"}
            style={[
              `--logo-mark-source: url("${resolveImageSource(shape.image)}")`,
              `--mark-w: ${((Number(shape.imageWidth) || 0) / (geometry.width || 1)) * 100}%`,
              `--mark-h: ${((Number(shape.imageHeight) || 0) / (geometry.height || 1)) * 100}%`,
            ].join("; ")}
          />
        ) : (
          <span
            class="shape-pile-text"
            data-prop="text"
          >
            {shape.text}
          </span>
        )}
        {wedge && (
          <span
            class="shape-pile-shadow"
            aria-hidden="true"
            style={[
              `--shadow-delay: ${wedge.from > 0 ? landingOf(wedge.from - 1) : settled}ms`,
              `--shadow-x: ${(wedge.x / (geometry.width || 1)) * 100}%`,
              `--shadow-y: ${(wedge.y / (geometry.height || 1)) * 100}%`,
              `--shadow-w: ${(wedge.width / (geometry.width || 1)) * 100}%`,
              `--shadow-h: ${(wedge.height / (geometry.height || 1)) * 100}%`,
            ].join("; ")}
          />
        )}
      </div>
    );
  })}
</div>

<script>
  import { onPageLoad } from "@component-utils/onPageLoad";
  import { setupAllShapePiles } from "./setup";

  onPageLoad(setupAllShapePiles);
</script>

<style is:global>
  @layer components {
    .shape-pile {
      aspect-ratio: var(--pile-design-width) / var(--pile-design-height);
      /* So the labels can be sized against the pile rather than the viewport.
         The design sets them in its own units — 20 on a card, 64 on the badge
         — and they have to shrink with the pile, not with the window. */
      container-type: inline-size;
      inline-size: 100%;
      position: relative;
    }

    /* An auto pile is a real layout rather than a coordinate space: the cards
       build from the floor up and wrap into rows above it, so three fall as
       one row across the bottom and nine as three rows. The box's own ratio
       goes with it — the rows decide the height, and a pile of two should not
       hold the room nine would need. */
    .shape-pile-shape {
      align-items: center;
      /* Its own query container, stated here rather than inherited.

         `.scratched` sets this too, so these shapes were containers whether
         this component wanted it or not, and the labels — written as a share
         of the pile — silently started measuring against one card instead.
         Owning it means the label's own sum below is the only thing that has
         to agree with it. */
      container-type: inline-size;
      /* The sheet is drawn, not loaded. It used to be three exports, one per
         tone, each a flat colour with the whole texture in its alpha; the ink
         is the pale fill their scratches punched through to.

         Set the token rather than the colour: `.scratched` is in `utils`,
         which out-ranks this. */
      --scratch-ink: var(--pile-backing, #f9e6df);
      block-size: var(--pile-h);
      border-radius: var(--pile-radius, 19px);
      display: flex;
      inline-size: var(--pile-w);
      inset-block-start: var(--pile-y);
      inset-inline-start: var(--pile-x);
      justify-content: center;
      /* So a wedge drawn wider than its card is cut off by it, rounded corners
         and all. The design relies on this: two of the three are the same
         triangle in the same place, duplicated into neighbouring cards, and it
         is the clipping that makes them read as one shadow crossing both. */
      overflow: hidden;
      /* `.scratched` positions its host so the sheet cannot escape it, and
         `utils` out-ranks this layer, so the arrangement is stated through
         the token that rule reads rather than by repeating `position`. */
      --scratch-position: absolute;
      /* The padding is on the label, not here.

         `cqi` measures a container's content box, so 8px of padding on the
         shape took 8px off what 100cqi means and the labels came out at 18.6
         where the design sets 20. On the label it holds the text off the
         shape's edges exactly as before, and leaves the shape's own width as
         the thing its size is a share of. */
      position: absolute;
      rotate: var(--pile-rot);
      text-align: center;
    }

    .shape-pile-shape.is-round {
      border-radius: var(--radius-full);
    }

    /* Sized as a share of its own shape, which is the container here, the same
       way the label's size is. `.logo-mark` paints it in `currentColor`, so
       the colour is one declaration rather than a second file per tile. */
    .shape-pile-mark {
      block-size: var(--mark-h, 60%);
      color: var(--pile-mark-color, #1d1b17);
      inline-size: var(--mark-w, 60%);
    }

    .shape-pile-text {
      color: #1d1b17;
      padding: var(--spacing-sm);
      /* A share of the shape, which is the container, not of the pile.

         Against the pile's 664 this read 20/664 of a 224-wide card and came
         out at 6px. The shape's width in its own design units is what turns
         100cqi back into the design's number: 20 of a 221-wide card is 20 of
         the pile's 664 when the card is 221 of 664. */
      font-size: calc(var(--pile-font, 20) / var(--pile-units, 221) * 100cqi);
      font-weight: 500;
      /* The design's 27 on 20. */
      line-height: 1.35;
    }

    .shape-pile-shape.is-strong > .shape-pile-text {
      font-weight: 700;
    }

    /* A right triangle: top left, top right, bottom right. A wedge under the
       shape's top edge that deepens across it.

       The colour is a pale blue at multiply, which is how the design gets that
       dark olive over orange — it is a colour trick, not a grey shadow. The
       multiply is on the *fill* in Figma while the node's own blend mode reads
       PASS_THROUGH, so reading the node alone loses it, the same way a fill's
       opacity hides separately from its colour.

       Inside the shape rather than on the one casting it, so it darkens this
       card's own scratched texture instead of flatly covering it, and so it
       travels with the card when the pile falls. */
    .shape-pile-shadow {
      background-color: var(--pile-shadow-color, #a6c1fa);
      block-size: var(--shadow-h);
      clip-path: polygon(0 0, 100% 0, 100% 100%);
      inline-size: var(--shadow-w);
      inset-block-start: var(--shadow-y);
      inset-inline-start: var(--shadow-x);
      mix-blend-mode: multiply;
      position: absolute;
    }

    .shape-pile-shape.is-light-text > .shape-pile-text {
      color: #ffffff;
    }

    /* The design's own colours, off the fully opaque pixels of each export.
       None of the three is a palette entry: rust is 17 from Sunset, coral 46
       from Peachy, golden 56 from Golden. */
    .shape-pile-shape.tone-rust {
      --scratch-fill: #d06522;
    }

    .shape-pile-shape.tone-coral {
      --scratch-fill: #e98057;
    }

    .shape-pile-shape.tone-golden {
      --scratch-fill: #e4a831;
    }

    /* Held back only where there is something to run the fall. Without this the
       pile would be invisible to a reader with no scripting, and gating it on a
       class the script adds instead shows the pile first and then hides it. */
    @media (scripting: enabled) {
      /* Only a pile that falls is held back. One that does not never gets
         `data-fallen`, so without this gate it would stay invisible. */
      .shape-pile.falls > .shape-pile-shape {
        opacity: 0;
      }

      .shape-pile.falls[data-fallen] > .shape-pile-shape {
        animation: shape-pile-drop 620ms var(--pile-delay) both;
      }

      /* Each one arrives as the shape that casts it touches down, not when the
         whole pile has finished: the card above the PHP one lands at 645 and
         the card above the other two at 740, where a shared timer held all
         three back to 1100 and left a dead beat after everything had settled.

         Quick, too. A shadow appears because something hit — 320ms read as it
         being faded up by hand. */
      .shape-pile.falls .shape-pile-shadow {
        opacity: 0;
      }

      .shape-pile.falls[data-fallen] .shape-pile-shadow {
        animation: shape-pile-shadow-in 150ms var(--shadow-delay, 1100ms) both;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .shape-pile.falls > .shape-pile-shape,
      .shape-pile.falls[data-fallen] > .shape-pile-shape,
      .shape-pile.falls .shape-pile-shadow,
      .shape-pile.falls[data-fallen] .shape-pile-shadow {
        animation: none;
        opacity: 1;
      }
    }
  }

  /* Top level: a keyframes block nested inside a style rule is dropped without
     a warning, which is how the workflow split's pulses came to sit still. */
  @keyframes shape-pile-drop {
    from {
      /* Accelerating, the way a falling thing does. An ease-out here reads as
         the shape being lowered into place rather than dropped. */
      animation-timing-function: cubic-bezier(0.5, 0, 0.9, 0.4);
      opacity: 0;
      rotate: var(--pile-tilt);
      translate: 0 var(--pile-rise);
    }

    8% {
      opacity: 1;
    }

    58% {
      animation-timing-function: cubic-bezier(0.25, 0, 0.3, 1);
      opacity: 1;
      rotate: var(--pile-rot);
      translate: 0 0;
    }

    74% {
      animation-timing-function: cubic-bezier(0.6, 0, 0.95, 0.5);
      rotate: var(--pile-rot);
      translate: 0 -9px;
    }

    to {
      opacity: 1;
      rotate: var(--pile-rot);
      translate: 0 0;
    }
  }

  @keyframes shape-pile-shadow-in {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }
</style>
