---
import { spaceBeforeAttr } from "@component-utils/spaceBefore.mjs";
import { slugifyLabel } from "@component-utils/slugify";
import ScrollDeckCard from "./ScrollDeckCard.astro";

type CardProps = Record<string, unknown>;

const {
  cards = [],
  stickyOffset = "md",
  cardColorScheme = "light",
  showRail = true,
  spaceBefore = "default",
  label,
  class: className,
  "data-children-prop": childrenDataProp,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

if (!htmlAttributes.id && label) {
  htmlAttributes.id = slugifyLabel(label);
}

const cardList: CardProps[] = Array.isArray(cards) ? cards : [];
const deckSlug = slugifyLabel(label || "deck") || "deck";
const cardId = (index: number) => `${deckSlug}-card-${index + 1}`;
const effectiveChildrenProp = childrenDataProp ?? (useDefaultEditableBinding ? "cards" : null);
const arrayDataAttributes = effectiveChildrenProp
  ? { "data-editable": "array", "data-prop": effectiveChildrenProp }
  : {};
const hasCards = cardList.length > 0;
const hasSlotContent = Astro.slots.has("default");

if (!_component && !hasCards && !hasSlotContent) return;
---

<div
  class:list={["scroll-deck", "stackable", className]}
  {...htmlAttributes}
>
  <div
    class:list={["scroll-deck-layout", `offset-${stickyOffset}`]}
    data-space-before={spaceBeforeAttr(spaceBefore)}
  >
    <div
      class="scroll-deck-track"
      {...arrayDataAttributes}
    >
      <slot>
        {cardList.map((card: CardProps, index: number) => (
          <ScrollDeckCard
            id={cardId(index)}
            cardColorScheme={cardColorScheme}
            aria-label={`Card ${index + 1} of ${cardList.length}`}
            data-editable="array-item"
            data-id="building-blocks/wrappers/scroll-deck/scroll-deck-card"
            useDefaultEditableBinding={!!effectiveChildrenProp}
            {...card}
          />
        ))}
      </slot>
    </div>

    {showRail && cardList.length > 1 && (
      <nav
        class="scroll-deck-rail"
        aria-label={label ? `${label} cards` : "Cards"}
      >
        {cardList.map((_card: CardProps, index: number) => (
          <a
            class="scroll-deck-rail-link"
            href={`#${cardId(index)}`}
            aria-current={index === 0 ? "true" : undefined}
          >
            <span class="scroll-deck-rail-dot" />
            <span class="visually-hidden">Card {index + 1}</span>
          </a>
        ))}
        {/* One marker for the whole rail rather than a state on each dot, so
            it travels between them. Rendered at the first centre, which is
            where it stays if the setup script never runs. */}
        <span
          class="scroll-deck-rail-marker"
          aria-hidden="true"
        />
      </nav>
    )}
  </div>
</div>

<script>
  import { onPageLoad } from "@component-utils/onPageLoad";
  import { setupAllScrollDecks } from "./setup";

  onPageLoad(setupAllScrollDecks);
</script>

<style is:global>
  /* The card keeps its full vertical padding on a phone.

     `pad-y-xl` steps down to 16 below 640, which is the site's own one-step
     mobile reduction and right nearly everywhere. It is wrong here: these
     cards are a screen tall with a button as the last thing in them, so 16 put
     the button hard against the card's foot while the sides kept 32.

     In `overrides`, not `components`: the spacing utilities are in `utils`,
     which out-ranks `components`, so no amount of specificity down there wins
     (see CLAUDE.md on the layer order). The deck opts out rather than the
     utility changing for every section on the site. */
  @layer overrides {
    @media (width < 640px) {
      .scroll-deck-card .card-content.pad-y-xl {
        padding-block: var(--spacing-xl);
      }
    }
  }

  @layer components {
    .scroll-deck {
      --deck-offset: var(--spacing-md);
      --deck-peek: var(--spacing-xl);
      --deck-entry-gap: var(--spacing-sm);
      --deck-index: 0;
      --deck-top: calc(var(--main-nav-height, 0px) + var(--deck-offset));
      --deck-rail-hit: 24px;
      /* Read off the design's rail: 7px markers on 80px centres, the one you
         are on drawn as a 7x12 pill rather than a bigger dot, and a 2px line
         running the length of them. */
      --deck-rail-dot: 7px;
      --deck-rail-active-length: 12px;
      --deck-rail-pitch: 80px;
      --deck-rail-line: 2px;
      /* Slower than the shared normal, which at 200ms read as a snap rather
         than a slide over the rail's 80px pitch. */
      --deck-rail-travel: var(--animation-slow);
      --deck-covered: 0;
      --deck-cover-scale: 0.04;
      --deck-cover-dim: 0.12;
      --deck-exit-runway: var(--spacing-none);

      /* `--deck-offset` has to resolve here, not on `.scroll-deck-layout`
         where the `.offset-*` class actually lives: `--deck-top` below (and
         `--deck-entry-gap`/the runway margin further down) are declared on
         this element, and a custom property only ever sees an override made
         on itself or an ancestor, never one made on a descendant. The class
         still can't move to this root element instead — CloudCannon keeps
         the root and swaps its content on a re-render, so a prop-driven
         class here would go stale — hence reading it back via `:has()`. */
      /* `0px`, not `var(--spacing-none)`: that token is a bare `0`, and
         `--deck-top` below adds it to `--main-nav-height` inside a `calc()`
         — a length plus a unitless number is invalid, so `top` silently
         fell back to `auto` and the card didn't stick at all. */
      &:has(> .scroll-deck-layout.offset-none) {
        --deck-offset: 0px;
      }

      &:has(> .scroll-deck-layout.offset-sm) {
        --deck-offset: var(--spacing-sm);
      }

      &:has(> .scroll-deck-layout.offset-lg) {
        --deck-offset: var(--spacing-lg);
      }

      /* The scale stopped at 24px, which pins a card right under the nav. A
         tall card wants to sit nearer the middle of the screen as it holds,
         and 24 is nowhere near enough room for that. */
      &:has(> .scroll-deck-layout.offset-xl) {
        --deck-offset: var(--spacing-xl);
      }

      &:has(> .scroll-deck-layout.offset-2xl) {
        --deck-offset: var(--spacing-2xl);
      }

      &:has(> .scroll-deck-layout.offset-3xl) {
        --deck-offset: var(--spacing-3xl);
      }

      position: relative;
      > .scroll-deck-layout {
        display: grid;
        gap: var(--spacing-lg);
        grid-template-columns: minmax(0, 1fr);
      }

      .scroll-deck-track {
        display: block;
        padding-block-end: calc((var(--deck-last-index, 0) + 1) * var(--deck-peek));
      }

      .scroll-deck-track > .scroll-deck-card {
        display: grid;
        margin-block-end: calc(
          var(--spacing-sm) + (var(--deck-last-index, 0) - var(--deck-index)) * var(--deck-peek)
        );
        min-block-size: var(--deck-card-height, 0px);
      }

      /* Each card fits its own content on a phone.
 
         The shared height is what gives the stack its even chrome where the
         cards sit on top of each other, and the deck only pins from 768 up.
         Below that they are three cards in a column, and holding them all to
         the tallest one left the short ones with the difference as dead space
         under their button: 34, 80 and 57 from the foot on the homepage, for
         three cards that should read the same. */
      @media (width < 640px) {
        .scroll-deck-track > .scroll-deck-card {
          min-block-size: 0;
        }

        /* Nothing is reserved after the last card.
 
           The track holds a bottom padding of one peek per card, and every
           card carries a peek margin, so the stack has somewhere to sit when
           the cards are piled on top of each other. Unpinned they are a plain
           column, and that reserve became 168px of empty band under the last
           card before the section's own padding had even started: 216 to the
           next band. The gap between cards stays as it is — that is the
           column's rhythm, not the stack's. */
        .scroll-deck-track {
          padding-block-end: 0;
        }

        .scroll-deck-track > .scroll-deck-card:last-child {
          margin-block-end: 0;
        }
      }

      .scroll-deck-card > .scroll-deck-card-inner {
        filter: brightness(calc(1 - var(--deck-covered) * var(--deck-cover-dim)));
        height: 100%;
        scale: calc(1 - var(--deck-covered) * var(--deck-cover-scale));
        transform-origin: top center;
        transition:
          filter var(--animation-normal) var(--ease-in-out),
          scale var(--animation-normal) var(--ease-in-out);
      }

      .scroll-deck-rail {
        display: none;
      }

      @media (min-width: 768px) {
        --deck-entry-gap: max(
          var(--spacing-4xl),
          calc(100dvh - var(--deck-card-height, 0px) - var(--deck-top))
        );
        --deck-exit-runway: calc(
          var(--deck-entry-gap) + (var(--deck-last-index, 0) + 1) * var(--deck-peek)
        );

        margin-block-end: calc(-1 * var(--deck-exit-runway));
        z-index: var(--layer-1);

        > .scroll-deck-layout {
          grid-template-columns: minmax(0, 1fr) auto;
        }

        .scroll-deck-track > .scroll-deck-card {
          margin-block-end: calc(
            var(--deck-entry-gap) + (var(--deck-last-index, 0) - var(--deck-index)) *
              var(--deck-peek)
          );
          position: sticky;
          top: calc(var(--deck-top) + var(--deck-index) * var(--deck-peek));
          z-index: var(--deck-index);
        }

        .scroll-deck-track > .scroll-deck-card:last-child {
          margin-block-end: var(--deck-entry-gap);
        }

        .scroll-deck-track > .scroll-deck-card:nth-child(2) {
          --deck-index: 1;
        }

        .scroll-deck-track > .scroll-deck-card:nth-child(3) {
          --deck-index: 2;
        }

        .scroll-deck-track > .scroll-deck-card:nth-child(4) {
          --deck-index: 3;
        }

        .scroll-deck-track > .scroll-deck-card:nth-child(5) {
          --deck-index: 4;
        }

        .scroll-deck-track > .scroll-deck-card:nth-child(n + 6) {
          --deck-index: 5;
        }

        .scroll-deck-rail {
          align-self: start;
          display: grid;
          /* The pitch is centre to centre, so the gap is what is left of it
             once the hit area is taken out. The target stays 24 either way. */
          gap: calc(var(--deck-rail-pitch) - var(--deck-rail-hit));
          justify-items: center;
          position: sticky;
          /* Centered on the pinned card, not on the viewport: the stack pins
             at `--deck-top` near the top of the screen, so a viewport-centered
             rail floats below the cards with nothing beside it. A real pixel
             `top` rather than `50%` + a `-50%` translate — the translate keeps
             applying while the rail is still in normal flow, lifting it over
             the section above. */
          top: calc(
            var(--deck-top) +
              max(0px, (var(--deck-card-height, 0px) - var(--deck-rail-height, 0px)) / 2)
          );
          transform: translateY(var(--deck-rail-release, 0px));
        }
      }

      /* The line the markers sit on, from the first centre to the last. Its
         own colour rather than a border token: on the design's dark band it is
         #4B4A46, which is lighter than any of them.

         No `position` on the rail to hang this off. It is already sticky,
         which is a positioned value, so absolute resolves against it — and
         setting `relative` here overrode the sticky further up and sent the
         whole rail scrolling away with the page while the cards stayed pinned. */
      .scroll-deck-rail::before {
        background-color: var(--deck-rail-line-color, #4b4a46);
        block-size: auto;
        content: "";
        inline-size: var(--deck-rail-line);
        inset-block: calc(var(--deck-rail-hit) / 2);
        inset-inline-start: 50%;
        position: absolute;
        translate: -50% 0;
      }

      .scroll-deck-rail-link {
        display: grid;
        height: var(--deck-rail-hit);
        place-items: center;
        /* Above the line rather than behind it, so the markers read as sitting
           on the rail rather than being crossed by it. */
        position: relative;
        width: var(--deck-rail-hit);

        > .scroll-deck-rail-dot {
          background-color: var(--deck-rail-dot-color, #919191);
          border-radius: var(--radius-full);
          height: var(--deck-rail-dot);
          transition:
            background-color var(--animation-normal) var(--ease-in-out),
            height var(--animation-normal) var(--ease-in-out);
          width: var(--deck-rail-dot);
        }

      }

      /* Longer, not larger: the one you are on is a pill the same width as the
         rest, which is what the design draws. It is a single element the
         script moves, so it slides from one dot to the next instead of one
         dot changing colour while another changes back.

         The offset is written as a concrete length by the script. A custom
         property holding the distance does not transition — an animated value
         derived from an unregistered property sticks at whatever it first
         computed, which is how the pinned stepper's bar sat at zero. */
      .scroll-deck-rail-marker {
        background-color: var(--deck-rail-active-color, var(--sunset));
        block-size: var(--deck-rail-active-length);
        border-radius: var(--radius-full);
        inline-size: var(--deck-rail-dot);
        inset-block-start: calc(
          (var(--deck-rail-hit) - var(--deck-rail-active-length)) / 2
        );
        inset-inline-start: 50%;
        /* The rail is sticky, which is already a positioned value, so this
           resolves against it without a `position` of its own up there. */
        position: absolute;
        pointer-events: none;
        translate: -50% 0;
        transition: translate var(--deck-rail-travel) var(--ease-in-out);
      }
    }
  }
</style>
