---
import RenderBlock from "@component-utils/renderBlock.astro";
import Badge from "@core-elements/badge/Badge.astro";
import Image from "@core-elements/image/Image.astro";
import { isNonEmptyString } from "@component-utils/isNonEmptyString";

/**
 * A drawing beside a bordered card with a pill on the card's top edge.
 *
 * The design draws it twice — the Partner Program teaser on Pricing and the
 * migration price on Migration — at the same measurements both times: a
 * 1280x515 band with a 363x304 card against the column's right edge. So the
 * card is a fixed width hard right and the drawing takes whatever is left of
 * the column, rather than the two being a ratio an author sets. That is the
 * whole reason this lives in CTA Showcase and not in the generic split.
 */
const {
  imageSource = "",
  imageAlt = "",
  badgeText = "",
  badgeColor = "harbour",
  cardColor = "white",
  contentSections = [],
  class: className,
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;

const hasBadge = isNonEmptyString(badgeText);
---

<div
  class:list={["offer-card", className]}
  {...htmlAttributes}
>
  {isNonEmptyString(imageSource) && (
    <div class="offer-card-art">
      <Image
        source={imageSource}
        alt={imageAlt}
        decorative={!imageAlt}
        aspectRatio="none"
      />
    </div>
  )}

  <div
    class="offer-card-panel"
    style={`--offer-card-bg: var(--${cardColor === "base" ? "color-bg" : cardColor})`}
  >
    {hasBadge && (
      <Badge
        class="offer-card-badge"
        variant="neutral"
        size="md"
        text={badgeText}
        data-prop="badgeText"
        style={`--offer-card-badge: var(--${badgeColor})`}
      />
    )}
    <div
      class="offer-card-content flow"
      data-editable={useDefaultEditableBinding ? "array" : undefined}
      data-prop={useDefaultEditableBinding ? "contentSections" : undefined}
    >
      <RenderBlock
        contentSections={contentSections}
        useDefaultEditableBinding={useDefaultEditableBinding}
      />
    </div>
  </div>
</div>

<style is:global>
  @layer components {
    /* `auto` on the right, so the card keeps its measured width whatever the
       band is, and the drawing takes the rest. The design's two instances put
       the card at 363 against the column's right edge both times. */
    .offer-card {
      --offer-card-width: 22.6875rem;

      align-items: end;
      display: grid;
      grid-template-columns: 1fr var(--offer-card-width);
    }

    /* The drawing runs under the card rather than stopping at its edge: the
       design's creature disappears behind the rule, which is what lets the
       two sit as close as they do. On top it covered the card's first line
       instead. Grid items only take part in z-order once they are
       positioned, so both carry `position` as well as the index. */
    .offer-card .offer-card-art {
      grid-column: 1;
      grid-row: 1;
      justify-self: end;
      margin-inline-end: calc(-1 * var(--spacing-xl));
      position: relative;
      z-index: 0;
    }

    /* Capped, or the drawing sets the row's height and towers over the card
       it is meant to stand beside: the design draws it 292 against a 304
       card, so the two are about the same height. A length, not a
       percentage — `max-block-size: 100%` against a row the drawing itself
       is sizing resolves to nothing. */
    .offer-card .offer-card-art img {
      display: block;
      height: auto;
      max-block-size: var(--offer-card-art-height, 18.25rem);
      max-inline-size: 100%;
      width: auto;
    }

    .offer-card .offer-card-panel {
      background-color: var(--offer-card-bg, var(--white));
      border: var(--border-width-sm) solid var(--color-text-strong);
      border-radius: var(--radius-card);
      grid-column: 2;
      grid-row: 1;
      padding: var(--spacing-xl);
      position: relative;
      z-index: 1;
    }

    /* On the card's top edge, centred, the way every badged card on the site
       sits. `inset-inline: 0` sets both edges and the margin does the
       centring — a `left: auto` after it would leave `right: 0` standing. */
    .offer-card .offer-card-badge {
      inset-block-start: calc(-1 * var(--spacing-md));
      inset-inline: 0;
      margin-inline: auto;
      position: absolute;
      width: fit-content;
    }

    /* The paint is on `.badge-inner`, which is the element that draws.
       Mixed to 45% over white rather than taken flat: the design's pill reads
       rgb(216,228,251) where Harbour itself is rgb(166,193,250), so the flat
       colour came out a good deal heavier than the band it sits on. Mixing
       rather than naming a second token keeps any pill colour at the same
       weight. */
    .offer-card .offer-card-badge > .badge-inner {
      --offer-card-badge-size: 1.125rem;

      background-color: color-mix(in srgb, var(--offer-card-badge, var(--harbour)) 45%, var(--white));
      border-color: transparent;
      color: var(--pacific);
      /* 18, which is what the design sets. Badge's own scale stops at 14.5,
         and at that size the pill read as a tag rather than the label the
         design draws. */
      font-size: var(--offer-card-badge-size);
      /* The design's pill is 110 x 40 around a 56-wide label. Left at the
         badge's own padding it came out 91 x 37, and a label that fills its
         pill that much more closely reads as larger type rather than as a
         tighter pill. */
      padding: 0.375rem 1.625rem;
    }

    /* The card's own copy runs tight: the design sets "Includes:" and the
       list it introduces as one 19px text node, so what separates them is a
       line gap, not the base layer's paragraph margin. The rules go on the
       markdown's own children — the block renders into `.text-inner`, so a
       rule on the content wrapper's direct children never reaches them. */
    .offer-card .offer-card-content > * + * {
      --space-before: var(--spacing-sm);

      margin-block-start: var(--spacing-sm);
    }

    .offer-card .offer-card-content :is(p, ul, ol) {
      margin-block: 0;
    }

    .offer-card .offer-card-content :is(p, ul, ol) + :is(p, ul, ol) {
      margin-block-start: var(--spacing-sm);
    }

    .offer-card .offer-card-content :is(ul, ol) {
      padding-inline-start: var(--spacing-lg);
    }

    .offer-card .offer-card-content li::marker {
      color: var(--color-text-muted);
    }

    /* 420, not the usual 640: this sits in the media half of a showcase
       band, which is about 616 at a 1280 window — a 640 breakpoint matched
       there and stacked the card under the drawing on every screen. */
    @container (width < 420px) {
      .offer-card {
        grid-template-columns: 1fr;
      }

      .offer-card .offer-card-art,
      .offer-card .offer-card-panel {
        grid-column: 1;
      }

      .offer-card .offer-card-art {
        grid-row: 2;
        justify-self: center;
        margin-inline-end: 0;
      }
    }
  }
</style>
