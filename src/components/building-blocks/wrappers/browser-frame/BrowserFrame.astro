---
/**
 * A window chrome to put a demo inside.
 *
 * Content Editors' "Here's what you're working with" draws its whole demo as
 * a flat screenshot of the real editor, so there is no structure in the file
 * to read: a 1108x787 rectangle with two image fills and the flower photo
 * placed over it. What the picture shows is a browser window, and that is the
 * part worth having as a component rather than as a picture.
 *
 * Chrome only. Whatever goes inside is the caller's, so the same frame can
 * hold the editor demo, a mockup, or a still.
 */
const {
  /** The address shown in the bar. Left empty, the bar carries only the dots. */
  label = "",
  /**
   * How the window is lit.
   *
   * `light` is the design's: a white bar on a white window. `dark` is for a
   * frame sitting on one of the dark bands, where a white chrome shouts.
   */
  tone = "light",
  /**
   * The dots.
   *
   * `color` is the Mac's own red, amber and green. `muted` draws them in the
   * frame's own border colour, which is quieter beside a page that already
   * has a lot of colour in it.
   */
  dots = "color",
  class: className,
  _component,
  ...htmlAttributes
} = Astro.props;
---

<div
  class:list={["browser-frame", `tone-${tone}`, `dots-${dots}`, className]}
  {...htmlAttributes}
>
  {/* Decorative: it is a picture of a window, not a window. A reader who
      cannot see it gains nothing from "three circles and an address". */}
  <div
    class="browser-frame-bar"
    aria-hidden="true"
  >
    <span class="browser-frame-dots">
      <span class="browser-frame-dot"></span>
      <span class="browser-frame-dot"></span>
      <span class="browser-frame-dot"></span>
    </span>
    {label && <span class="browser-frame-label">{label}</span>}
  </div>

  <div class="browser-frame-body">
    <slot />
  </div>
</div>

<style is:global>
  @layer components {
    .browser-frame {
      background-color: var(--browser-frame-bg, var(--white));
      border: 1px solid var(--browser-frame-border, var(--color-text-strong));
      border-radius: var(--radius-md);
      display: flex;
      flex-direction: column;
      /* So the body's corners are the frame's, and anything inside that runs
         to an edge is cut by it rather than hanging past. */
      overflow: hidden;
    }

    .browser-frame.tone-dark {
      --browser-frame-bg: var(--midnight);
      --browser-frame-border: var(--color-border);
    }

    .browser-frame-bar {
      align-items: center;
      /* The rule under the bar is the frame's own, so the two read as one
         window rather than as a strip stacked on a box. */
      border-block-end: 1px solid var(--browser-frame-border, var(--color-text-strong));
      display: flex;
      gap: var(--spacing-md);
      flex-shrink: 0;
      padding: var(--spacing-sm) var(--spacing-md);
    }

    .browser-frame-dots {
      display: flex;
      gap: 0.375rem;
    }

    .browser-frame-dot {
      block-size: 0.6875rem;
      border-radius: 50%;
      display: block;
      inline-size: 0.6875rem;
    }

    /* The Mac's own three, in the order it draws them. */
    .browser-frame.dots-color .browser-frame-dot:nth-child(1) {
      background-color: #ff5f57;
    }

    .browser-frame.dots-color .browser-frame-dot:nth-child(2) {
      background-color: #febc2e;
    }

    .browser-frame.dots-color .browser-frame-dot:nth-child(3) {
      background-color: #28c840;
    }

    .browser-frame.dots-muted .browser-frame-dot {
      background-color: var(--browser-frame-border, var(--color-border));
      opacity: 0.45;
    }

    .browser-frame-label {
      color: var(--color-text-muted);
      font-size: var(--font-size-sm);
      /* Centred in the bar rather than beside the dots, which is where a
         browser puts it. The dots keep their corner because the flex row
         starts there. */
      margin-inline: auto;
      padding-inline-end: calc(3 * 0.6875rem + 2 * 0.375rem);
    }

    .browser-frame-body {
      /* min-block-size: 0 so a scrolling child inside a flex column can
         actually shrink rather than pushing the frame taller. */
      display: flex;
      flex: 1;
      flex-direction: column;
      min-block-size: 0;
    }
  }
</style>
