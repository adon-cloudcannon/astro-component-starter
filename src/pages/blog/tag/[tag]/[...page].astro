---
import BlogPostListingGrid from "@component-utils/BlogPostListingGrid.astro";
import { slugifyLabel } from "@component-utils/slugify";
import { categoryLabel } from "@component-utils/postCategory.mjs";
import Page from "@layouts/Page.astro";
import RenderBlock from "@component-utils/renderBlock.astro";
import CustomSection from "@page-sections/builders/custom-section/CustomSection.astro";
import {
  blogLabel,
  getBlogPostsSortedByDate,
  loadBlogPageContext,
  withListingHeading,
  withoutHeroBreadcrumbs,
} from "../../../../utils/blog";

type Paginate = (_data: any[], _opts: { pageSize: number; params: Record<string, string> }) => any;

export interface Props {
  page: { data: any[]; currentPage: number };
}

export async function getStaticPaths({ paginate }: { paginate: Paginate }) {
  const blogPosts = await getBlogPostsSortedByDate();

  const tagSlugs = new Set<string>();

  for (const post of blogPosts) {
    for (const raw of post.data.tags ?? []) {
      const key = slugifyLabel(raw.trim());

      if (key) tagSlugs.add(key);
    }
  }

  return [...tagSlugs].flatMap((tag) => {
    const filtered = blogPosts.filter((p: any) =>
      (p.data.tags ?? []).some((t: string) => slugifyLabel(t.trim()) === tag)
    );

    return paginate(filtered, { pageSize: 12, params: { tag } });
  });
}

const { page } = Astro.props as Props;
const tagSlug = Astro.params.tag ?? "";

const { blogPage, heroSections, closingSections } = await loadBlogPageContext();

const baseTitle = blogLabel(blogPage);
const displayTag =
  page.data[0]?.data.tags.find((t: string) => slugifyLabel(t.trim()) === tagSlug)?.trim() ??
  tagSlug;
const displayLabel = categoryLabel(displayTag);
const tagListingTitle = `${baseTitle}: ${displayLabel}`;
const pageTitle =
  page.currentPage > 1 ? `${tagListingTitle} – Page ${page.currentPage}` : tagListingTitle;
const baseTagDescription = `Browse every blog post filed under ${displayLabel}, sorted by date.`;
const pageDescription =
  page.currentPage > 1
    ? `${baseTagDescription} Page ${page.currentPage} of this archive.`
    : baseTagDescription;

const baseTagHeading = `Posts in ${displayLabel}`;
const listingHeading =
  page.currentPage > 1 ? `${baseTagHeading} – Page ${page.currentPage}` : baseTagHeading;
---

<Page
  frontmatter={{
    title: pageTitle,
    description: pageDescription,
    pageSections: withoutHeroBreadcrumbs(withListingHeading(heroSections, listingHeading)),
  }}
  disablePagefind
>
  <CustomSection
    maxContentWidth="2xl"
    paddingHorizontal="lg"
    paddingVertical="4xl"
    colorScheme="inherit"
    backgroundColor="dark"
  >
    <BlogPostListingGrid
      page={page}
      emptyMessage="No posts with this tag."
      activeTag={displayTag}
      tagBreadcrumb={{
        allPostsHref: "/blog/",
        allPostsLabel: baseTitle,
        currentLabel: displayLabel,
      }}
    />
  </CustomSection>

  {/* Past the listing rather than with the hero, and outside Page's editable
      array: the indices there would not line up with the sections it holds. */}
  <RenderBlock
    contentSections={closingSections}
    useDefaultEditableBinding={false}
  />
</Page>
