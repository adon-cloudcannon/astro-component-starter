---
import BlogPostListingGrid from "@component-utils/BlogPostListingGrid.astro";
import Page from "@layouts/Page.astro";
import RenderBlock from "@component-utils/renderBlock.astro";
import BlogFeaturedCarousel from "@component-utils/BlogFeaturedCarousel.astro";
import CustomSection from "@page-sections/builders/custom-section/CustomSection.astro";
import {
  getBlogPostsSortedByDate,
  listingHeadingOf,
  loadBlogPageContext,
  withListingHeading,
} from "../../utils/blog";

type Paginate = (_data: any[], _opts: { pageSize: number }) => any;

export interface Props {
  page: { data: any[]; currentPage: number };
}

export async function getStaticPaths({ paginate }: { paginate: Paginate }) {
  const blogPosts = await getBlogPostsSortedByDate();

  return paginate(blogPosts, { pageSize: 12 });
}

const { page } = Astro.props as Props;

const { blogPage, heroSections, closingSections } = await loadBlogPageContext();

const basePageTitle = blogPage?.data?.title ?? "Blog";
const pageTitle =
  page.currentPage > 1 ? `${basePageTitle} – Page ${page.currentPage}` : basePageTitle;
const baseDescription =
  blogPage?.data?.description ??
  "Read our latest articles and insights on web development, design, and technology.";
const pageDescription =
  page.currentPage > 1
    ? `${baseDescription} Page ${page.currentPage} of the blog archive.`
    : baseDescription;

const baseHeading = listingHeadingOf(heroSections);
const listingHeading = baseHeading
  ? page.currentPage > 1
    ? `${baseHeading} – Page ${page.currentPage}`
    : baseHeading
  : undefined;
---

<Page
  frontmatter={{
    title: pageTitle,
    description: pageDescription,
    pageSections: listingHeading ? withListingHeading(heroSections, listingHeading) : heroSections,
  }}
  disablePagefind={page.currentPage > 1}
>
  {page.currentPage === 1 && (blogPage?.data?.featured?.length ?? 0) > 0 && (
    <CustomSection
      class="blog-featured-band"
      sectionLabel="Featured posts"
      maxContentWidth="2xl"
      paddingHorizontal="lg"
      paddingVertical="4xl"
      paddingVerticalStart="none"
      colorScheme="inherit"
      backgroundColor="dark"
      background={{ type: "pattern", pattern: "grid", fixed: false, mask: "none", overlay: 0 }}
    >
      <BlogFeaturedCarousel featured={blogPage.data.featured} />
    </CustomSection>
  )}

  <CustomSection
    maxContentWidth="wide"
    paddingHorizontal="lg"
    paddingVertical="4xl"
    paddingVerticalStart={page.currentPage === 1 ? "none" : undefined}
    colorScheme="inherit"
    backgroundColor="dark"
  >
    <BlogPostListingGrid
      page={page}
      emptyMessage="No blog posts yet. Check back soon!"
    />
  </CustomSection>

  {/* Past the listing rather than with the hero, and outside Page's editable
      array: the indices there would not line up with the sections it holds. */}
  <RenderBlock
    contentSections={closingSections}
    useDefaultEditableBinding={false}
  />
</Page>
