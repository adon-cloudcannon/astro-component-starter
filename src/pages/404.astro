---
import Button from "@core-elements/button/Button.astro";
import footerData from "@data/footer.json";
import mainNavData from "@data/mainNav.json";
import seoData from "@data/seo.json";
import Page from "@layouts/Page.astro";

const canonical = new URL("/404.html", Astro.site ?? seoData.url).href;
---

<Page
  title="Page not found"
  description="This URL does not exist on this site. Use the navigation or go home to find what you need."
  canonical={canonical}
  mainNav={mainNavData}
  footer={footerData}
>
  <section class="not-found">
    <p class="not-found-code">404</p>
    <h1 class="not-found-title glitch">Nothing here</h1>
    <p class="not-found-copy">
      Wrong turn. This page doesn't exist, or it got deleted at 2am like the demos did.
    </p>
    <div class="not-found-actions">
      <Button
        text="Go home"
        link="/"
        variant="primary"
        size="lg"
        hideText={false}
        iconName=""
        iconPosition="before"
      />
      <Button
        text="Listen instead"
        link="/music/"
        variant="tertiary"
        size="lg"
        hideText={false}
        iconName="play"
        iconPosition="before"
      />
    </div>
  </section>
</Page>

<style>
  .not-found {
    box-sizing: border-box;
    margin-inline: auto;
    max-width: 44rem;
    padding: var(--spacing-6xl) var(--spacing-xl);
    text-align: center;
  }

  /* Outlined and oversized, so the number reads as a wall stencil rather than an error code. */
  .not-found-code {
    -webkit-text-stroke: 3px var(--pink-hot);
    color: transparent;
    font-family: var(--font-headings);
    font-size: clamp(8rem, 26vw, 18rem);
    font-weight: var(--font-weight-bold);
    line-height: 0.8;
    margin: 0;
  }

  .not-found-title {
    font-size: var(--font-size-heading-2xl);
    margin: var(--spacing-md) 0 var(--spacing-sm);
  }

  .not-found-copy {
    color: var(--color-text-muted);
    margin: 0 auto var(--spacing-2xl);
    max-width: 34ch;
  }

  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-md);
    justify-content: center;
  }
</style>
