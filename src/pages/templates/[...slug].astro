---
/**
 * One template's page.
 *
 * The body is the template's own markdown, which `npm run templates:readmes`
 * fills from the repository's README.
 */
import { accentInk } from "@component-utils/accentInk.mjs";
import { ssgName } from "@component-utils/ssgNames.mjs";
import { breadcrumbListJsonLd } from "@component-utils/breadcrumbTrail";
import Badge from "@core-elements/badge/Badge.astro";
import Button from "@core-elements/button/Button.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Image from "@core-elements/image/Image.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import breadcrumbsData from "@data/breadcrumbs.json";
import Page from "@layouts/Page.astro";
import CustomSection from "@page-sections/builders/custom-section/CustomSection.astro";
import { getCollection, getEntry, render, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const templates = await getCollection("templates", ({ data }) => !data.draft);

  return templates.map((template: CollectionEntry<"templates">) => ({
    params: { slug: template.id },
    props: { template },
  }));
}

interface Props {
  template: CollectionEntry<"templates">;
}

const { template } = Astro.props;
const { Content } = await render(template);
const { title, description, image, imageAlt, previewUrl, repoUrl } = template.data;

/* A starter's sidebar is a different sidebar: what you get and what is built
   with it, where a template's offers a generator and a deploy. */
const isStarter = template.data.starter === true;
const spec = template.data.spec ?? [];
const bonus = template.data.bonus;
const buildWith = template.data.buildWith ?? [];

/* The pill a template carries here is the one the listing page filters by, in
   the same words and the same colour, so the two read as one thing. Both come
   from the listing's own block rather than from a copy kept here. */
const listing = await getEntry("pages", "templates");
const grid = ((listing?.data?.pageSections ?? []) as any[]).find((block) =>
  String(block?._component ?? "").endsWith("/template-grid")
);
const pills: { id?: string; name?: string; accent?: string }[] = grid?.content?.pills ?? [];

/* The marks beside these are the generators' icons rather than their
   wordmarks: an icon exists for every one, a wordmark does not. */
const label = (id: string) => ssgName(id);

/* Every collection the template is in, not just the first: five of them carry
   two. In the listing's pill order rather than the template's own, so two
   templates in the same pair read the same way round. */
const badges = pills.filter((pill) => (template.data.collections ?? []).includes(pill.id ?? ""));
const ssgs = template.data.ssgs ?? [];
const ssgLogos: Record<string, { src: string }> = Object.fromEntries(
  Object.entries(
    import.meta.glob("../../assets/images/marketing/ssgs/*.svg", { eager: true, query: "?url" })
  ).map(([file, url]) => [file.split("/").pop()!.replace(".svg", ""), { src: (url as any).default }])
);

/**
 * The template before and after this one.
 *
 * Within a collection first, in the order the listing page draws it, and then
 * on into the collection beside it — so walking next from the last Featured
 * template lands on the first Starter one, and the walk wraps at either end
 * rather than stopping.
 */
const everyTemplate = (await getCollection("templates", ({ data }) => !data.draft)).sort(
  (a, b) =>
    (a.data.order ?? 9) - (b.data.order ?? 9) || a.data.title.localeCompare(b.data.title)
);

const pillOrder = pills.map((pill) => pill.id).filter(Boolean) as string[];
const collectionOf = (entry: CollectionEntry<"templates">) =>
  (entry.data.collections ?? []).find((id) => pillOrder.includes(id)) ?? pillOrder[0] ?? "";

/* Flattened in collection order, so a step past the end of one is a step into
   the next without any of the edges being a special case. */
const walk = pillOrder
  .map((id) => everyTemplate.filter((entry) => collectionOf(entry) === id))
  .filter((group) => group.length > 0)
  .flat();

const here = walk.findIndex((entry) => entry.id === template.id);
const step = (by: number) =>
  walk.length > 1 && here !== -1 ? walk[(here + by + walk.length) % walk.length] : undefined;
const previous = step(-1);
const next = step(1);

const breadcrumbJsonLd = breadcrumbListJsonLd(
  [{ label: "Templates", url: "/templates/" }, { label: title }],
  { homeLabel: breadcrumbsData.homeLabel, base: Astro.site ?? Astro.url }
);
---

<Page
  title={title}
  description={description}
  image={image}
  type="article"
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbJsonLd).replace(/</g, "\\u003c")}
  ></script>

  <CustomSection
    class="template-page-hero"
    maxContentWidth="xl"
    paddingHorizontal="gutter"
    paddingVertical="4xl"
    backgroundColor="light-sand"
    background={{ type: "pattern", pattern: "grid" }}
  >
    <div class="template-page-head">
      <div class="template-page-intro flow">
        <p class="template-page-eyebrow">Templates</p>
        {/* `lg` is the 46 the design sets: "Jetstream" measures 213 wide
            there, against 202 at this size and 292 one step up. */}
        <Heading
          level="h1"
          size="lg"
          class="template-page-title"
        >
          {title}
        </Heading>
        <SimpleText
          size="lg"
          class="template-page-line"
        >
          {description}
        </SimpleText>
        {/* A div, not a p: Badge renders a div, and the parser closes a
            paragraph in front of one, which left the pills loose in the hero
            with the flex row empty behind them. */}
        {badges.length > 0 && (
          <div class="template-page-badges">
            {badges.map((pill) => (
              <Badge
                class="template-page-badge"
                style={
                  pill.accent
                    ? `--template-page-pill: var(--${pill.accent}); --template-page-ink: ${accentInk(pill.accent)}`
                    : undefined
                }
                text={pill.name ?? label(pill.id ?? "")}
                showArrow={false}
                variant="strong"
              />
            ))}
          </div>
        )}
      </div>
      {previewUrl ? (
        /* The live site, not a screenshot: each frame lays the page out at
           twice its box and is scaled to half, so the desktop one renders a
           real 1040-wide viewport and the phone one a real 390, rather than a
           squeezed version of this column. Hard-coded here because it is the
           one page that shows a template running. */
        <div class="template-page-preview">
          <div class="template-page-frame template-page-frame-desktop">
            <iframe
              src={previewUrl}
              title={`${title} previewed on a desktop screen`}
              loading="lazy"
              referrerpolicy="no-referrer"
              sandbox="allow-scripts allow-same-origin"
              tabindex="-1"
            />
          </div>
          <div class="template-page-frame template-page-frame-phone">
            <iframe
              src={previewUrl}
              title={`${title} previewed on a phone`}
              loading="lazy"
              referrerpolicy="no-referrer"
              sandbox="allow-scripts allow-same-origin"
              tabindex="-1"
              aria-hidden="true"
            />
          </div>
        </div>
      ) : (
        <Image
          class="template-page-shot"
          source={image}
          alt={imageAlt ?? `${title} screenshot`}
          rounded
        />
      )}
    </div>
  </CustomSection>

  <CustomSection
    class="template-page-body"
    maxContentWidth="xl"
    paddingHorizontal="gutter"
    paddingVertical="4xl"
    backgroundColor="light-sand"
  >
    <div class="template-page-columns">
      <aside class="template-page-aside">
        <div class="template-page-aside-inner">
        {isStarter && spec.length > 0 && (
          <div class="template-page-panel">
            <p class="template-page-panel-label">What you'll get</p>
            <dl class="template-page-spec">
              {spec.map((item) => (
                <div class="template-page-spec-row">
                  <dt>{item.label}:</dt>
                  <dd>{item.value}</dd>
                </div>
              ))}
            </dl>
            {previewUrl && (
              <Button
                text="Preview site"
                link={previewUrl}
                iconName="arrow-right"
                iconPosition="after"
                variant="text"
                size="md"
              />
            )}
          </div>
        )}

        {isStarter && (bonus?.label || (bonus?.links?.length ?? 0) > 0) && (
          <div class="template-page-panel">
            <p class="template-page-panel-label">Bonus features</p>
            {bonus?.label && <p class="template-page-panel-line">{bonus.label}</p>}
            {(bonus?.links?.length ?? 0) > 0 && (
              <ul class="template-page-link-list">
                {(bonus?.links ?? []).map((link) => (
                  <li>{link.link ? <a href={link.link}>{link.text}</a> : link.text}</li>
                ))}
              </ul>
            )}
          </div>
        )}

        {/* Its own panel: hung off the bonus features, a starter with none —
            Hugo and the multilingual one — lost its repository link. */}
        {isStarter && repoUrl && (
          <div class="template-page-panel">
            <Button
              text="View on GitHub"
              link={repoUrl}
              iconName="arrow-right"
              iconPosition="after"
              variant="text"
              size="md"
            />
          </div>
        )}

        {isStarter && buildWith.length > 0 && (
          <div class="template-page-panel">
            <p class="template-page-panel-label">Build with starter</p>
            <ul class="template-page-link-list">
              {buildWith.map((link) => (
                <li>{link.link ? <a href={link.link}>{link.text}</a> : link.text}</li>
              ))}
            </ul>
          </div>
        )}

        {!isStarter && ssgs.length > 0 && (
          <div class="template-page-panel">
            <p class="template-page-panel-label">Choose your SSG:</p>
            <ul class="template-page-ssgs">
              {ssgs.map((ssg, index) => (
                /* The first is the one the page is showing. Every template
                   here has one generator, so this is a statement of which,
                   not a control — the list is ready for the day a template
                   ships for two. */
                <li class="template-page-ssg" aria-current={index === 0 ? "true" : undefined}>
                  {ssgLogos[ssg] && (
                    <img
                      class="template-page-ssg-mark"
                      src={ssgLogos[ssg].src}
                      alt=""
                      loading="lazy"
                    />
                  )}
                  <span class="template-page-ssg-name">{label(ssg)}</span>
                </li>
              ))}
            </ul>
            <Button
              class="template-page-deploy"
              text="Deploy to CloudCannon"
              link={`https://app.cloudcannon.com/register?repo=${encodeURIComponent(repoUrl ?? "")}`}
              iconName="arrow-right"
              iconPosition="after"
              variant="text"
              size="md"
            />
          </div>
        )}
        {!isStarter && (
        <div class="template-page-panel">
          {repoUrl && (
            <Button
              text="View on GitHub"
              link={repoUrl}
              iconName="arrow-right"
              iconPosition="after"
              variant="text"
              size="md"
            />
          )}
          {previewUrl && (
            <Button
              text="Preview site"
              link={previewUrl}
              iconName="arrow-right"
              iconPosition="after"
              variant="text"
              size="md"
            />
          )}
        </div>
        )}
        </div>
      </aside>

      <div class="template-page-content prose">
        <Content />
      </div>
    </div>
  </CustomSection>

  {(previous || next) && (
    <CustomSection
      class="template-page-walk"
      label="More templates"
      maxContentWidth="xl"
      paddingHorizontal="gutter"
      paddingVertical="3xl"
      backgroundColor="pacific"
    >
      <div class="template-page-walk-pair">
        {previous && (
          <a class="template-page-walk-link is-previous" href={`/templates/${previous.id}/`}>
            <span class="template-page-walk-arrow" aria-hidden="true">←</span>
            <span class="template-page-walk-name">{previous.data.title}</span>
          </a>
        )}
        {next && (
          <a class="template-page-walk-link is-next" href={`/templates/${next.id}/`}>
            <span class="template-page-walk-name">{next.data.title}</span>
            <span class="template-page-walk-arrow" aria-hidden="true">→</span>
          </a>
        )}
      </div>
    </CustomSection>
  )}
</Page>

<style is:global>
  /* The hero is copy beside the screenshot, which runs wider than its half
     and is cropped by the band — the shape the design draws for every
     template. */
  .template-page-head {
    align-items: center;
    display: grid;
    gap: var(--spacing-3xl);
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
  }

  .template-page-eyebrow {
    color: var(--sunset);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.2em;
    margin: 0;
    text-transform: uppercase;
  }

  .template-page-title {
    --space-before: var(--spacing-lg);
  }

  .template-page-line {
    --space-before: var(--spacing-lg);
  }

  .template-page-badges {
    --space-before: var(--spacing-xl);

    display: flex;
    flex-wrap: wrap;
    /* The gap the listing page sets between the same pills. */
    gap: 1.125rem;
    margin-block: var(--spacing-xl) 0;
  }

  /* The pill takes the colour the listing page filters that collection in.
     The design draws it black, which says nothing about which collection it
     is; the listing already gives each one a colour. */
  .template-page-badge > .badge-inner {
    background-color: var(--template-page-pill, var(--midnight));
    border-color: transparent;
    color: var(--template-page-ink, var(--white));
  }

  .template-page-shot img {
    block-size: auto;
    inline-size: 100%;
  }

  /* The phone overlaps the desktop's lower-right corner, which is how the
     design draws the pair. */
  .template-page-preview {
    position: relative;
  }

  .template-page-frame {
    background-color: var(--white);
    border: var(--border-width-md) solid var(--color-border-strong);
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  /* The frame is laid out at 1 / --template-page-scale of its box and scaled
     back down, so the page inside sees a real viewport of that width. An
     iframe sized to the box would hand the site a 520-wide viewport and it
     would answer with its phone layout. */
  .template-page-frame iframe {
    block-size: calc(100% / var(--template-page-scale));
    border: 0;
    display: block;
    inline-size: calc(100% / var(--template-page-scale));
    transform: scale(var(--template-page-scale));
    transform-origin: 0 0;
  }

  .template-page-frame-desktop {
    --template-page-scale: 0.5;

    aspect-ratio: 520 / 360;
    inline-size: 100%;
  }

  .template-page-frame-phone {
    --template-page-scale: 0.4;

    aspect-ratio: 147 / 323;
    inline-size: 28%;
    inset-block-start: 22%;
    inset-inline-end: -4%;
    position: absolute;
  }

  /* The sidebar holds its place while the body scrolls past it, which is what
     the design draws: the panels sit against the band's left edge all the way
     down a README that runs several screens. */
  .template-page-columns {
    display: grid;
    gap: var(--spacing-4xl);
    grid-template-columns: minmax(0, 17.5rem) minmax(0, 1fr);
  }

  /* The design runs the sidebar as its own column of sand, ruled off the
     body and reaching past the content column to the band's edge. */
  .template-page-aside {
    align-self: stretch;
    background-color: var(--sand);
    border-inline-end: var(--border-width-sm) solid var(--dark-sand);
    /* Half the window, less half this column. Written without a percentage
       because the scroller inside reuses it: a percentage would resolve
       against whichever box it landed in, and the two boxes differ. */
    --aside-bleed: calc(50vw - 8.75rem);

    margin-block: calc(var(--spacing-4xl) * -1);
    margin-inline-start: calc(var(--aside-bleed) * -1);
    padding-block: var(--spacing-4xl);
  }

  /* Pinned, and no taller than what is left of the window: a starter's
     sidebar runs about 690, so on a laptop the repository link sat below the
     fold of a panel that cannot be scrolled to. It scrolls itself instead,
     and only when it has to. */
  .template-page-aside-inner {
    max-block-size: calc(100dvh - var(--main-nav-height) - var(--spacing-2xl));
    overflow-y: auto;
    position: sticky;
    scrollbar-gutter: stable;
    top: calc(var(--main-nav-height) + var(--spacing-xl));
    /* The inset belongs to the scroller rather than to the column around it:
       padding on the column sits outside this box, and a wheel over that sand
       scrolled the page instead of the panel. */
    padding-inline: var(--aside-bleed) var(--spacing-2xl);
  }

  .template-page-panel {
    border-block-end: var(--border-width-sm) solid var(--dark-sand);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    padding-block: var(--spacing-xl);
  }

  .template-page-panel:last-child {
    border-block-end: 0;
  }

  .template-page-panel-label {
    color: var(--sunset);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.2em;
    margin: 0;
    text-transform: uppercase;
  }

  /* A starter's spec: each line is a label and its answer, run together the
     way the design sets them. */
  .template-page-spec {
    margin: 0;
  }

  .template-page-spec-row {
    margin-block-end: var(--spacing-md);
  }

  .template-page-spec dt,
  .template-page-spec dd {
    display: inline;
    margin: 0;
  }

  .template-page-spec dt {
    font-weight: var(--font-weight-semibold);
  }

  .template-page-spec dd {
    color: var(--color-text-muted);
    /* The two run together as one line, so the space between them has to be
       drawn: there is no whitespace between a dt and its dd in the markup. */
    margin-inline-start: 0.35em;
  }

  .template-page-panel-line {
    font-weight: var(--font-weight-semibold);
    margin: 0;
  }

  .template-page-link-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    margin: 0;
    padding-inline-start: var(--spacing-lg);
  }

  .template-page-ssgs {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* The generator the page is showing, drawn as the chosen one of a list:
     the mark of a radio beside the wordmark, across the sidebar. */
  .template-page-ssg {
    align-items: center;
    border: var(--border-width-sm) solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    color: var(--color-text-strong);
    display: flex;
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    gap: var(--spacing-md);
    padding: var(--spacing-sm) var(--spacing-md);
  }

  .template-page-ssg[aria-current] {
    border-color: var(--pacific);
    border-width: var(--border-width-md);
  }

  .template-page-ssg::before {
    aspect-ratio: 1;
    border: var(--border-width-md) solid var(--color-border-strong);
    border-radius: 50%;
    content: "";
    flex-shrink: 0;
    inline-size: 0.875rem;
  }

  .template-page-ssg[aria-current]::before {
    background-color: var(--pacific);
    border-color: var(--pacific);
    box-shadow: inset 0 0 0 2px var(--white);
  }

  /* Square-ish box whatever the mark's own ratio: these come from eight
     projects and range from 0.84 to 1.35 wide for their height. */
  .template-page-ssg-mark {
    block-size: 1.25rem;
    flex-shrink: 0;
    inline-size: 1.25rem;
    object-fit: contain;
  }

  /* A README is written for GitHub, where the body is set at 16 and the
     headings carry a whole page. Here it is one column of one, which the
     design sets at 19 under headings of 29. */
  /* On the children, not the column: the prose layer sets `p, ul, ol` at 16
     itself, so a size on their parent never reaches them. */
  .template-page-content p,
  .template-page-content ul,
  .template-page-content ol,
  .template-page-content li {
    font-size: var(--font-size-lg);
  }

  .template-page-content h2 {
    font-size: var(--font-size-heading-sm);
    margin-block: var(--spacing-3xl) var(--spacing-lg);
  }

  .template-page-content h3 {
    font-size: var(--font-size-heading-xs);
    margin-block: var(--spacing-xl) var(--spacing-md);
  }

  /* Under h3, not over it. Left to the base scale a README's h4 came out
     larger than the h3 above it, which reads as the outline running
     backwards. */
  .template-page-content h4,
  .template-page-content h5,
  .template-page-content h6 {
    font-size: var(--font-size-lg);
    margin-block: var(--spacing-lg) var(--spacing-sm);
  }

  /* The opening paragraph sits in a box of its own, which is how the design
     draws the line that introduces the template. Only when the body opens
     with one: a README that opens on a heading has no such line. */
  .template-page-content > p:first-child {
    background-color: var(--light-sand);
    border: var(--border-width-sm) solid var(--dark-sand);
    border-radius: var(--radius-card);
    margin-block: 0 var(--spacing-xl);
    padding: var(--callout-pad-block, 1.75rem) var(--callout-pad-inline, 2.25rem);
  }

  /* A README's code is quoted from a terminal or a file, and a good deal of
     it is drawn rather than written — directory trees, aligned comments. The
     base layer wraps a highlighted block to avoid a scrollbar, which folds
     those into nonsense; the block scrolls instead. */
  .template-page-content .astro-code code {
    white-space: pre;
  }

  /* A README's own asides. GitHub's `> [!NOTE]` marker is rewritten when the
     README is pulled in, leaving a blockquote whose label carries the kind as
     a class; the colours below are GitHub's own, in this palette's words.
     The base layer indents a blockquote, which is right for a quote inside
     running text and wrong for a panel that is its own block. */
  .template-page-content blockquote {
    --callout-accent: var(--pacific);
    /* Measured off the design's own panel: 28 over the disc, 41 either side.
       Named here because neither is a step on the spacing scale, which goes
       24 then 32 and 32 then 48. */
    --callout-pad-block: 1.75rem;
    --callout-pad-inline: 2.5625rem;

    background-color: color-mix(in srgb, var(--callout-accent) 12%, transparent);
    border: var(--border-width-sm) solid var(--callout-accent);
    border-radius: var(--radius-card);
    color: var(--color-text-strong);
    margin-block: var(--spacing-xl);
    margin-inline: 0;
    padding: var(--callout-pad-block) var(--callout-pad-inline);
  }

  .template-page-content blockquote > p:first-child {
    margin-block: 0;
  }

  /* The paragraph's own 1em would win the collapse against anything smaller
     set on the label above it. */
  .template-page-content blockquote > p + p {
    margin-block-start: var(--spacing-sm);
  }

  .template-page-content blockquote > p:last-child {
    margin-block-end: 0;
  }

  .template-page-content .callout-label {
    align-items: center;
    color: var(--callout-accent);
    display: flex;
    font-size: var(--font-size-lg);
    gap: var(--spacing-md);
  }

  /* The disc is the element's own background and the mark sits on it as an
     image, so one element draws both and the colour stays the callout's. A
     mask would have cut the disc away with it.

     The mark is lucide's `info` without its circle, which the disc is. */
  .template-page-content .callout-label::before {
    aspect-ratio: 1;
    background-color: var(--callout-accent);
