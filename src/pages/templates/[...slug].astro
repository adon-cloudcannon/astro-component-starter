---
/**
 * One template's page.
 *
 * The body is the template's own markdown. The old site downloaded the
 * repository's README at build time and rendered that instead, which is where
 * the design's "Features" list comes from; nothing in the ported data carries
 * it, so a template with no body shows its chrome and its gallery.
 */
import { breadcrumbListJsonLd } from "@component-utils/breadcrumbTrail";
import Badge from "@core-elements/badge/Badge.astro";
import Button from "@core-elements/button/Button.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Image from "@core-elements/image/Image.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import breadcrumbsData from "@data/breadcrumbs.json";
import Page from "@layouts/Page.astro";
import CustomSection from "@page-sections/builders/custom-section/CustomSection.astro";
import { getCollection, getEntry, render, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const templates = await getCollection("templates", ({ data }) => !data.draft);

  return templates.map((template: CollectionEntry<"templates">) => ({
    params: { slug: template.id },
    props: { template },
  }));
}

interface Props {
  template: CollectionEntry<"templates">;
}

const { template } = Astro.props;
const { Content } = await render(template);
const { title, description, image, imageAlt, previewUrl, repoUrl } = template.data;

/* The pill a template carries here is the one the listing page filters by, in
   the same words and the same colour, so the two read as one thing. Both come
   from the listing's own block rather than from a copy kept here. */
const listing = await getEntry("pages", "templates");
const pills: { id?: string; name?: string; accent?: string }[] =
  (listing?.data?.pageSections ?? [])
    .find((block: any) => String(block?._component ?? "").endsWith("/template-grid"))
    ?.content?.pills ?? [];

const label = (id: string) => id.charAt(0).toUpperCase() + id.slice(1);
const badgeId = (template.data.collections ?? [])[0];
const badgePill = pills.find((pill) => pill.id === badgeId);
const badgeText = badgePill?.name ?? (badgeId ? label(badgeId) : "");
const badgeAccent = badgePill?.accent;
const ssgs = template.data.ssgs ?? [];
const gallery = (template.data.gallery ?? []).filter((shot) => shot?.image);

const breadcrumbJsonLd = breadcrumbListJsonLd(
  [{ label: "Templates", url: "/templates/" }, { label: title }],
  { homeLabel: breadcrumbsData.homeLabel, base: Astro.site ?? Astro.url }
);
---

<Page
  title={title}
  description={description}
  image={image}
  type="article"
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbJsonLd).replace(/</g, "\\u003c")}
  ></script>

  <CustomSection
    class="template-page-hero"
    maxContentWidth="xl"
    paddingHorizontal="gutter"
    paddingVertical="4xl"
    backgroundColor="light-sand"
    background={{ type: "pattern", pattern: "grid" }}
  >
    <div class="template-page-head">
      <div class="template-page-intro flow">
        <p class="template-page-eyebrow">Templates</p>
        <Heading
          level="h1"
          size="2xl"
          class="template-page-title"
        >
          {title}
        </Heading>
        <SimpleText
          size="lg"
          class="template-page-line"
        >
          {description}
        </SimpleText>
        {badgeText && (
          <Badge
            class="template-page-badge"
            style={badgeAccent ? `--template-page-pill: var(--${badgeAccent})` : undefined}
            text={badgeText}
            showArrow={false}
            variant="strong"
          />
        )}
      </div>
      {previewUrl ? (
        /* The live site, not a screenshot: each frame lays the page out at
           twice its box and is scaled to half, so the desktop one renders a
           real 1040-wide viewport and the phone one a real 390, rather than a
           squeezed version of this column. Hard-coded here because it is the
           one page that shows a template running. */
        <div class="template-page-preview">
          <div class="template-page-frame template-page-frame-desktop">
            <iframe
              src={previewUrl}
              title={`${title} previewed on a desktop screen`}
              loading="lazy"
              referrerpolicy="no-referrer"
              sandbox="allow-scripts allow-same-origin"
              scrolling="no"
              tabindex="-1"
            />
          </div>
          <div class="template-page-frame template-page-frame-phone">
            <iframe
              src={previewUrl}
              title={`${title} previewed on a phone`}
              loading="lazy"
              referrerpolicy="no-referrer"
              sandbox="allow-scripts allow-same-origin"
              scrolling="no"
              tabindex="-1"
              aria-hidden="true"
            />
          </div>
        </div>
      ) : (
        <Image
          class="template-page-shot"
          source={image}
          alt={imageAlt ?? `${title} screenshot`}
          rounded
        />
      )}
    </div>
  </CustomSection>

  <CustomSection
    class="template-page-body"
    maxContentWidth="xl"
    paddingHorizontal="gutter"
    paddingVertical="4xl"
    backgroundColor="light-sand"
  >
    <div class="template-page-columns">
      <aside class="template-page-aside">
        {ssgs.length > 0 && (
          <div class="template-page-panel">
            <p class="template-page-panel-label">Choose your SSG:</p>
            <ul class="template-page-ssgs">
              {ssgs.map((ssg) => (
                <li class="template-page-ssg">{label(ssg)}</li>
              ))}
            </ul>
            <Button
              class="template-page-deploy"
              text="Deploy to CloudCannon"
              link={`https://app.cloudcannon.com/register?repo=${encodeURIComponent(repoUrl ?? "")}`}
              iconName="arrow-right"
              iconPosition="after"
              variant="text"
              size="md"
            />
          </div>
        )}
        <div class="template-page-panel">
          {repoUrl && (
            <Button
              text="View on GitHub"
              link={repoUrl}
              iconName="arrow-right"
              iconPosition="after"
              variant="text"
              size="md"
            />
          )}
          {previewUrl && (
            <Button
              text="Preview site"
              link={previewUrl}
              iconName="arrow-right"
              iconPosition="after"
              variant="text"
              size="md"
            />
          )}
        </div>
      </aside>

      <div class="template-page-content prose">
        <Content />
        {gallery.length > 0 && (
          <div class="template-page-gallery">
            {gallery.map((shot) => (
              <Image
                class="template-page-gallery-shot"
                source={shot.image}
                alt={shot.alt ?? ""}
                rounded
              />
            ))}
          </div>
        )}
      </div>
    </div>
  </CustomSection>
</Page>

<style is:global>
  /* The hero is copy beside the screenshot, which runs wider than its half
     and is cropped by the band — the shape the design draws for every
     template. */
  .template-page-head {
    align-items: center;
    display: grid;
    gap: var(--spacing-3xl);
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
  }

  .template-page-eyebrow {
    color: var(--sunset);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.2em;
    margin: 0;
    text-transform: uppercase;
  }

  .template-page-title {
    --space-before: var(--spacing-lg);
  }

  .template-page-line {
    --space-before: var(--spacing-lg);
  }

  .template-page-badge {
    --space-before: var(--spacing-xl);
  }

  /* The pill takes the colour the listing page filters that collection in.
     The design draws it black, which says nothing about which collection it
     is; the listing already gives each one a colour. */
  .template-page-badge > .badge-inner {
    background-color: var(--template-page-pill, var(--midnight));
    border-color: transparent;
    color: var(--white);
  }

  .template-page-shot img {
    block-size: auto;
    inline-size: 100%;
  }

  /* The phone overlaps the desktop's lower-right corner, which is how the
     design draws the pair. */
  .template-page-preview {
    position: relative;
  }

  .template-page-frame {
    background-color: var(--white);
    border: var(--border-width-md) solid var(--color-border-strong);
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  /* The frame is laid out at 1 / --template-page-scale of its box and scaled
     back down, so the page inside sees a real viewport of that width. An
     iframe sized to the box would hand the site a 520-wide viewport and it
     would answer with its phone layout. */
  .template-page-frame iframe {
    block-size: calc(100% / var(--template-page-scale));
    border: 0;
    display: block;
    inline-size: calc(100% / var(--template-page-scale));
    transform: scale(var(--template-page-scale));
    transform-origin: 0 0;
  }

  .template-page-frame-desktop {
    --template-page-scale: 0.5;

    aspect-ratio: 520 / 360;
    inline-size: 100%;
  }

  .template-page-frame-phone {
    --template-page-scale: 0.4;

    aspect-ratio: 147 / 323;
    inline-size: 28%;
    inset-block-start: 22%;
    inset-inline-end: -4%;
    position: absolute;
  }

  /* The sidebar holds its place while the body scrolls past it, which is what
     the design draws: the panels sit against the band's left edge all the way
     down a README that runs several screens. */
  .template-page-columns {
    display: grid;
    gap: var(--spacing-4xl);
    grid-template-columns: minmax(0, 17.5rem) minmax(0, 1fr);
  }

  .template-page-aside {
    align-self: start;
    position: sticky;
    top: calc(var(--main-nav-height) + var(--spacing-xl));
  }

  .template-page-panel {
    border-block-end: var(--border-width-sm) solid var(--dark-sand);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    padding-block: var(--spacing-xl);
  }

  .template-page-panel:last-child {
    border-block-end: 0;
  }

  .template-page-panel-label {
    color: var(--sunset);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.2em;
    margin: 0;
    text-transform: uppercase;
  }

  .template-page-ssgs {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* The design draws this as the one generator the page is showing, picked
     from a list: a bordered pill with the mark of a chosen radio beside the
     name, not a button. */
  .template-page-ssg {
    align-items: center;
    border: var(--border-width-md) solid var(--pacific);
    border-radius: var(--radius-card);
    color: var(--color-text-strong);
    display: flex;
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    gap: var(--spacing-md);
    inline-size: fit-content;
    padding: var(--spacing-md) var(--spacing-lg);
  }

  .template-page-ssg::before {
    aspect-ratio: 1;
    border: var(--border-width-md) solid var(--pacific);
    border-radius: 50%;
    content: "";
    inline-size: 1rem;
  }

  .template-page-gallery {
    display: grid;
    gap: var(--spacing-lg);
    margin-block-start: var(--spacing-3xl);
  }

  .template-page-gallery-shot img {
    block-size: auto;
    inline-size: 100%;
  }

  @media (width < 900px) {
    .template-page-head,
    .template-page-columns {
      grid-template-columns: minmax(0, 1fr);
    }

    .template-page-aside {
      position: static;
    }
  }
</style>
