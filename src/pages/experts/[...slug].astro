---
/**
 * One agency's page in the expert directory.
 *
 * The body is the agency's own longer description, and `work` is the client
 * projects it shows underneath — one panel each, the way the design draws
 * them.
 */
import { breadcrumbListJsonLd } from "@component-utils/breadcrumbTrail";
import { bandHaze } from "@component-utils/bandStyle.mjs";
import Button from "@core-elements/button/Button.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Image from "@core-elements/image/Image.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Text from "@core-elements/text/Text.astro";
import SsgMarks from "@component-utils/ssg-marks/SsgMarks.astro";
import Carousel from "@wrappers/carousel/Carousel.astro";
import CtaForm from "@page-sections/conversion/cta-form/CtaForm.astro";
import breadcrumbsData from "@data/breadcrumbs.json";
import Page from "@layouts/Page.astro";
import CustomSection from "@page-sections/builders/custom-section/CustomSection.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import ProseCodeCopy from "@component-utils/prose-code-copy/ProseCodeCopy.astro";
import CodeAnnotations from "@component-utils/code-annotations/CodeAnnotations.astro";

export async function getStaticPaths() {
  const experts = await getCollection("experts", ({ data }) => !data.draft);

  return experts.map((expert: CollectionEntry<"experts">) => ({
    params: { slug: expert.id },
    props: { expert },
  }));
}

interface Props {
  expert: CollectionEntry<"experts">;
}

const { expert } = Astro.props;
const { Content } = await render(expert);
const { title, description, image, imageAlt, location, siteUrl } = expert.data;

const work = (expert.data.work ?? []).filter((item) => item?.title);

/* The track only bleeds, and the neighbours only peek, where there are enough
   projects to loop past: with two, Embla gives up the loop and clamps the last
   snap, leaving a card stranded off-centre. */
const peeking = work.length > 2;

/* The agency's own links, in the order the design lists them. */
const links = [
  { label: "Visit website", href: siteUrl },
  { label: "LinkedIn", href: expert.data.linkedinUrl },
  { label: "X", href: expert.data.twitterUrl },
  { label: "Facebook", href: expert.data.facebookUrl },
  { label: "Instagram", href: expert.data.instagramUrl },
].filter((link) => link.href);

/* The track runs the width of the window so the neighbouring projects show,
   while a card stays the width the design draws it. */
const WORK_SLIDE_WIDTH =
  "--slide-width: calc(min(60rem, 100vw - 2 * var(--spacing-gutter)) + var(--slide-gap))";

/* The fields the design's contact form carries. */
const CONTACT_FIELDS = [
  { _component: "building-blocks/forms/input", label: "First name", name: "first-name", type: "text", required: true, autocomplete: "given-name", class: "cta-form-half" },
  { _component: "building-blocks/forms/input", label: "Last name", name: "last-name", type: "text", required: true, autocomplete: "family-name", class: "cta-form-half" },
  { _component: "building-blocks/forms/input", label: "Email", name: "email", type: "email", required: true, autocomplete: "email", class: "cta-form-half" },
  { _component: "building-blocks/forms/input", label: "Company name", name: "company", type: "text", required: true, autocomplete: "organization", class: "cta-form-half" },
  {
    _component: "building-blocks/forms/select",
    label: "How can we help?",
    name: "help",
    required: true,
    options: [
      { value: "developer-support", label: "Developer support" },
      { value: "new-website", label: "A new website" },
      { value: "migration", label: "A migration" },
      { value: "something-else", label: "Something else" },
    ],
  },
  { _component: "building-blocks/forms/textarea", label: "Project scope", name: "scope", required: true, rows: 5 },
  { _component: "building-blocks/forms/submit", text: "Submit" },
];

const breadcrumbJsonLd = breadcrumbListJsonLd(
  [{ label: "Expert directory", url: "/experts/" }, { label: title }],
  { homeLabel: breadcrumbsData.homeLabel, base: Astro.site ?? Astro.url }
);
---

<Page
  title={title}
  description={description}
  image={image}
  type="article"
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbJsonLd).replace(/</g, "\\u003c")}
  ></script>

  <CustomSection
    class="expert-page-hero"
    maxContentWidth="xl"
    paddingHorizontal="gutter"
    {/* The design's band is 480 tall against the 435 this was drawing. */}
    paddingVertical="5xl"
    backgroundColor="dark"
    background={{ type: "pattern", pattern: "grid" }}
  >
    <div class="expert-page-head">
      {/* `flow`, or the `--space-before` each block below sets reaches
          nothing: the flow layer only spaces the children of a flow parent. */}
      <div class="expert-page-intro flow">
        <p class="expert-page-eyebrow">Experts</p>
        <Heading
          level="h1"
          size="lg"
          class="expert-page-title"
        >
          {title}
        </Heading>
        <SimpleText
          size="lg"
          class="expert-page-line"
        >
          {description}
        </SimpleText>
        {location && <p class="expert-page-location">{location}</p>}
        <SsgMarks
          class="expert-page-ssgs"
          ssgs={expert.data.ssgs}
        />
      </div>
      {image && (
        <Image
          class="expert-page-shot"
          source={image}
          alt={imageAlt ?? `${title} website`}
          rounded
        />
      )}
    </div>
  </CustomSection>

  <CustomSection
    class="expert-page-body"
    maxContentWidth="lg"
    paddingHorizontal="gutter"
    paddingVertical="4xl"
    backgroundColor="light-sand"
  >
    <div class="expert-page-copy prose">
      <Content />
    </div>
    {links.length > 0 && (
      <div class="expert-page-links">
        {links.map((link) => (
          <Button
            text={link.label}
            link={link.href}
            iconName="arrow-right"
            iconPosition="after"
            variant="text"
            size="md"
          />
        ))}
      </div>
    )}
  </CustomSection>

  {work.length > 0 && (
    <CustomSection
      class="expert-page-work"
      sectionLabel="Client work"
      maxContentWidth="2xl"
      paddingHorizontal="lg"
      paddingVertical="4xl"
      backgroundColor="dark"
      background={{ type: "pattern", pattern: "grid", fixed: false, mask: "none", overlay: 0 }}
      haze={bandHaze(true, { split: false })}
    >
      <p class="expert-page-work-eyebrow">{title}</p>
      <Heading
        level="h2"
        size="lg"
        alignmentHorizontal="center"
        class="expert-page-work-heading"
      >
        Check out their work
      </Heading>

      <Carousel
        class:list={["expert-work", peeking && "is-peeking"]}
        label="Client work"
        showArrows={work.length > 1}
        showIndicators={work.length > 1}
        loop={work.length > 1}
        gap="xl"
        style={peeking ? WORK_SLIDE_WIDTH : undefined}
      >
        {work.map((item) => (
          <article
            class="slide expert-work-slide"
            role="group"
            aria-roledescription="slide"
          >
            <div class="slide__content expert-work-card">
              <div class="expert-work-copy">
                <h3 class="expert-work-title">{item.title}</h3>
                <Text
                  class="expert-work-body"
                  size="lg"
                  text={item.body ?? ""}
                />
                {item.link && (
                  <p class="expert-work-more">
                    <a
                      class="expert-work-link"
                      href={item.link}
                      target="_blank"
                      rel="noopener"
                    >
                      See project <span aria-hidden="true">→</span>
                    </a>
                  </p>
                )}
              </div>
              {item.image && (
                <div class="expert-work-art">
                  <Image
                    source={item.image}
                    alt=""
                    decorative={true}
                    aspectRatio="none"
                  />
                </div>
              )}
            </div>
          </article>
        ))}
      </Carousel>
    </CustomSection>
  )}

  {/* The design centres the heading on the band above the card, where the
      form component would otherwise draw it inside. */}
  <CustomSection
    class="expert-page-contact"
    sectionLabel="Contact"
    maxContentWidth="xl"
    paddingHorizontal="gutter"
    paddingVertical="4xl"
    paddingVerticalEnd="none"
    backgroundColor="dark-sand"
  >
    <Heading
      level="h2"
      size="lg"
      alignmentHorizontal="center"
    >
      Contact {title}
    </Heading>
    <SimpleText
      class="expert-page-contact-line"
      size="lg"
      alignmentHorizontal="center"
    >
      Love what you see? Need help with a project? Get in touch with {title}.
    </SimpleText>
  </CustomSection>

  <CtaForm
    heading=""
    subtext=""
    formAction={siteUrl ?? "/contact/"}
    formBlocks={CONTACT_FIELDS}
    backgroundColor="dark-sand"
    maxContentWidth="xl"
    paddingHorizontal="gutter"
    paddingVertical="4xl"
    paddingVerticalStart="2xl"
  />

  <ProseCodeCopy />
  <CodeAnnotations />
</Page>

<style is:global>
  /* Copy beside the agency's own site, which is what the design draws. */
  .expert-page-head {
    align-items: center;
    display: grid;
    gap: var(--spacing-3xl);
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
  }

  .expert-page-eyebrow {
    color: var(--sunset);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.2em;
    margin: 0;
    text-transform: uppercase;
  }

  .expert-page-title {
    --space-before: var(--spacing-lg);
  }

  .expert-page-line {
    --space-before: var(--spacing-lg);
  }

  .expert-page-location {
    color: var(--color-text-muted);
    font-size: var(--font-size-md);
    margin-block: var(--spacing-lg) 0;
  }

  /* The generators the agency works in, under its copy rather than only on
     its card in the directory. */
  .expert-page-ssgs {
    margin-block-start: var(--spacing-xl);
  }

  .expert-page-shot img {
    block-size: auto;
    inline-size: 100%;
  }

  /* The agency's own words, set the way a README is on a template page. */
  .expert-page-copy p,
  .expert-page-copy ul,
  .expert-page-copy ol,
  .expert-page-copy li {
    font-size: var(--font-size-lg);
  }

  .expert-page-copy > p:first-child {
    background-color: var(--light-sand);
    border: var(--border-width-sm) solid var(--dark-sand);
    border-radius: var(--radius-card);
    margin-block: 0 var(--spacing-xl);
    padding: 1.75rem 2.25rem;
  }

  .expert-page-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xl);
    margin-block-start: var(--spacing-2xl);
  }

  .expert-page-contact-line {
    --space-before: var(--spacing-lg);
  }

  .expert-page-work-eyebrow {
    color: var(--sunset);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.2em;
    margin: 0;
    text-align: center;
    text-transform: uppercase;
  }

  .expert-page-work-heading {
    --space-before: var(--spacing-lg);

    margin-block-end: var(--spacing-3xl);
  }

  /* The track runs edge to edge of the window while the band around it stays
     contained, so the projects either side of the current one show. */
  .expert-work.carousel.is-peeking {
    inline-size: auto;
    margin-inline: calc(50% - 50vw);
  }

  /* Copy down the left, the project's picture filling the rest. */
  .expert-work-card {
    background-color: var(--color-bg-muted);
    border: var(--border-width-sm) solid var(--color-border);
    border-radius: var(--radius-card);
    display: grid;
    gap: 0;
    grid-template-columns: minmax(0, 376fr) minmax(0, 582fr);
    overflow: hidden;
    position: relative;
    transition: border-color var(--animation-normal) var(--ease-out);
  }

  .expert-work-card:hover,
  .expert-work-card:has(a:focus-visible) {
    border-color: var(--earth);
  }

  .expert-work-copy {
    display: flex;
    flex-direction: column;
    padding: var(--spacing-xl) 2.5rem;
  }

  /* 24 against the 19 of the copy under it: at a step apart the two read as
     one block of text. */
  .expert-work-title {
    font-size: 1.5rem;
    font-weight: var(--font-weight-normal);
    line-height: var(--line-height-heading-sm);
    /* A plain margin, not `--space-before`: the flow layer only spaces the
       children of a flow parent, and this column is not one. */
    margin-block: 0 var(--spacing-md);
  }

  /* Through to the leaf: Text writes its own colour and leading on the
     paragraphs, so dimming the wrapper reaches nothing. */
  .expert-work-body,
  .expert-work-body p {
    color: var(--color-text-muted);
  }

  .expert-work-body p {
    line-height: 1.37;
  }

  .expert-work-body p + p {
    margin-block-start: var(--spacing-md);
  }

  .expert-work-more {
    margin-block: var(--spacing-xl) 0;
  }

  .expert-work-link {
    color: var(--color-link);
    font-size: var(--font-size-md);
    text-decoration: none;
  }

  .expert-work-link:hover,
  .expert-work-link:focus-visible {
    text-decoration: underline;
  }

  /* The picture fills the card's full height; Image nests three boxes between
     this one and the `img`, each needing the height passed down. */
  .expert-work-art .image,
  .expert-work-art .image-inner,
  .expert-work-art picture {
    block-size: 100%;
  }

  .expert-work-card .expert-work-art img {
    block-size: 100%;
    display: block;
    inline-size: 100%;
    object-fit: cover;
  }

  @media (width < 900px) {
    .expert-page-head {
      grid-template-columns: minmax(0, 1fr);
    }

    .expert-work-card {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
